{%- liquid
  assign s = section.settings
  assign fallback = 'https://images.unsplash.com/photo-1485231183945-fffde7cc051e?auto=format&fit=crop&w=1100&q=85'
  assign img_alt = s.heading_line1 | default: 'Editorial'
-%}

<section
  id="section-{{ section.id }}"
  class="hno-section hno--{{ s.scheme }}"
  data-section-id="{{ section.id }}"
>
  {%- if s.watermark != blank -%}
    <span class="hno-watermark" aria-hidden="true">{{ s.watermark }}</span>
  {%- endif -%}

  <div class="hno-grid">
    <div class="hno-copy">
      {%- if s.meta_left != blank or s.meta_right != blank -%}
        <div class="hno-masthead">
          {%- if s.meta_left != blank -%}<span>{{ s.meta_left }}</span>{%- endif -%}
          <span class="hno-masthead__rule" aria-hidden="true"></span>
          {%- if s.meta_right != blank -%}<span>{{ s.meta_right }}</span>{%- endif -%}
        </div>
      {%- endif -%}

      {%- if s.eyebrow != blank -%}<span class="hno-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}

      <h1 class="hno-title">
        {%- if s.heading_line1 != blank -%}<span class="hno-title__l">{{ s.heading_line1 }}</span>{%- endif -%}
        {%- if s.heading_line2 != blank -%}<span class="hno-title__l hno-title__l--em"><em>{{ s.heading_line2 }}</em></span>{%- endif -%}
        {%- if s.heading_line3 != blank -%}<span class="hno-title__l">{{ s.heading_line3 }}</span>{%- endif -%}
      </h1>

      {%- if s.description != blank -%}<p class="hno-desc">{{ s.description }}</p>{%- endif -%}

      <div class="hno-ctas">
        {%- if s.btn1_label != blank -%}<a href="{{ s.btn1_link | default: '#' }}" class="hno-btn hno-btn--solid">{{ s.btn1_label }}</a>{%- endif -%}
        {%- if s.btn2_label != blank -%}<a href="{{ s.btn2_link | default: '#' }}" class="hno-btn hno-btn--line">{{ s.btn2_label }} <span aria-hidden="true">&#8599;</span></a>{%- endif -%}
      </div>

      {%- if s.scroll_label != blank -%}
        <span class="hno-scroll" aria-hidden="true">
          <span class="hno-scroll__line"></span>{{ s.scroll_label }}
        </span>
      {%- endif -%}
    </div>

    <div class="hno-media">
      <span class="hno-media__glow" aria-hidden="true"></span>
      <div class="hno-media__frame">
        {%- if s.image != blank -%}
          {{ s.image | image_url: width: 1100 | image_tag:
            loading: 'eager', fetchpriority: 'high', class: 'hno-media__img',
            sizes: '(max-width:900px) 92vw, 44vw', widths: '600,900,1100', alt: img_alt }}
        {%- else -%}
          <img class="hno-media__img" src="{{ fallback }}" alt="{{ img_alt | escape }}" loading="eager" fetchpriority="high" />
        {%- endif -%}
        {%- if s.tag_label != blank -%}
          <span class="hno-tag"><span class="hno-tag__dot"></span>{{ s.tag_label }}</span>
        {%- endif -%}
      </div>
      <span class="hno-media__outline" aria-hidden="true"></span>
      {%- if s.index_label != blank -%}<span class="hno-index">{{ s.index_label }}</span>{%- endif -%}
    </div>
  </div>

  {%- if s.ticker != blank -%}
    <div class="hno-ticker" aria-hidden="true">
      <div class="hno-ticker__track">
        {%- for i in (1..8) -%}<span>{{ s.ticker }}</span><span class="hno-ticker__sep">&#9670;</span>{%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

<style>
  #section-{{ section.id }}.hno--light {
    --bg:#ECE9E2; --fg:#18181A; --acc:var(--gold,#9A7B43);
    --mut:rgba(24,24,26,.55); --bdr:rgba(24,24,26,.16);
    --btn-bg:#18181A; --btn-fg:#ECE9E2; --wm:rgba(24,24,26,.05);
  }
  #section-{{ section.id }}.hno--dark {
    --bg:#161618; --fg:#ECE9E2; --acc:var(--gold,#C8A96E);
    --mut:rgba(236,233,226,.52); --bdr:rgba(236,233,226,.16);
    --btn-bg:#ECE9E2; --btn-fg:#161618; --wm:rgba(236,233,226,.045);
  }
  #section-{{ section.id }}.hno--warm {
    --bg:#E7DCCB; --fg:#241D15; --acc:var(--gold,#8E4F2A);
    --mut:rgba(36,29,21,.55); --bdr:rgba(36,29,21,.2);
    --btn-bg:#241D15; --btn-fg:#E7DCCB; --wm:rgba(36,29,21,.05);
  }
  #section-{{ section.id }}.hno--theme {
    --bg:var(--background,#161618); --fg:var(--foreground,#ECE9E2); --acc:var(--gold,#C8A96E);
    --mut:var(--muted,rgba(236,233,226,.52)); --bdr:var(--border,rgba(236,233,226,.16));
    --btn-bg:var(--gold,#C8A96E); --btn-fg:var(--black,#0A0A0A); --wm:rgba(236,233,226,.045);
  }

  #section-{{ section.id }} {
    position: relative; background: var(--bg); color: var(--fg);
    overflow: hidden; isolation: isolate;
    /* header + announcement bar sit on top (absolute) — reserve their space
       so nothing overlaps, then keep the composition tight: no forced 100vh */
    padding: clamp(128px, 17svh, 190px) var(--side-padding,5vw) 0;
  }

  /* Oversized outlined watermark word — depth layer behind everything */
  #section-{{ section.id }} .hno-watermark {
    position: absolute; z-index: 0; right: -2vw; top: clamp(70px, 9svh, 120px);
    font-family: var(--ff-display,'Cormorant Garamond',serif);
    font-size: clamp(120px, 22vw, 340px); font-weight: 300; line-height: 1;
    text-transform: uppercase; letter-spacing: .02em;
    color: transparent; -webkit-text-stroke: 1px var(--wm);
    pointer-events: none; user-select: none; white-space: nowrap;
  }

  #section-{{ section.id }} .hno-grid {
    position: relative; z-index: 1;
    display: grid; grid-template-columns: 1.04fr .96fr;
    gap: clamp(28px, 5vw, 84px); align-items: center;
    max-width: var(--container-width,1440px); margin: 0 auto;
    padding-bottom: clamp(48px, 7svh, 84px);
  }

  #section-{{ section.id }} .hno-masthead {
    display: flex; align-items: center; gap: 16px;
    font-family: var(--ff-body,'Outfit',sans-serif); font-size: 10px; font-weight: 500;
    letter-spacing: .26em; text-transform: uppercase; color: var(--mut);
    margin-bottom: clamp(26px, 4svh, 44px);
    animation: hnoUp{{ section.id }} .7s both;
  }
  #section-{{ section.id }} .hno-masthead__rule { flex: 0 0 clamp(30px,4vw,64px); height: 1px; background: var(--bdr); }

  #section-{{ section.id }} .hno-eyebrow {
    display: inline-flex; align-items: center; gap: 10px;
    font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: 11px; font-weight: 500; letter-spacing: .28em; text-transform: uppercase;
    color: var(--acc); margin-bottom: clamp(16px, 2.6svh, 26px);
    animation: hnoUp{{ section.id }} .7s .08s both;
  }
  #section-{{ section.id }} .hno-eyebrow::before { content:''; width: 7px; height: 7px; border-radius: 50%; background: var(--acc); }

  #section-{{ section.id }} .hno-title {
    font-family: var(--ff-display,'Cormorant Garamond',serif); font-weight: 300;
    font-size: calc(clamp(46px, 6.6vw, 104px) * var(--heading-scale,1));
    line-height: .92; letter-spacing: .005em; text-transform: uppercase; margin: 0;
  }
  #section-{{ section.id }} .hno-title__l { display: block; animation: hnoUp{{ section.id }} .85s both; }
  #section-{{ section.id }} .hno-title__l:nth-child(1){ animation-delay:.14s; }
  #section-{{ section.id }} .hno-title__l:nth-child(2){ animation-delay:.24s; }
  #section-{{ section.id }} .hno-title__l:nth-child(3){ animation-delay:.34s; }
  #section-{{ section.id }} .hno-title__l--em { color: var(--acc); padding-left: clamp(24px,3.6vw,84px); }
  #section-{{ section.id }} .hno-title__l--em em { font-style: italic; }

  #section-{{ section.id }} .hno-desc {
    font-family: var(--ff-body,'Outfit',sans-serif); font-size: clamp(14px,1.05vw,16px);
    line-height: 1.75; color: var(--mut); max-width: 420px;
    margin: clamp(22px, 3.4svh, 36px) 0 0; animation: hnoUp{{ section.id }} .85s .46s both;
  }
  #section-{{ section.id }} .hno-ctas { display: flex; flex-wrap: wrap; gap: 14px; margin-top: clamp(24px,3.6svh,36px); animation: hnoUp{{ section.id }} .85s .56s both; }
  #section-{{ section.id }} .hno-btn {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--ff-body,'Outfit',sans-serif); font-size: 11px; font-weight: 500;
    letter-spacing: .16em; text-transform: uppercase; padding: 15px 30px; text-decoration: none;
    transition: transform .22s, background .22s, color .22s, border-color .22s, box-shadow .22s;
  }
  #section-{{ section.id }} .hno-btn--solid { background: var(--btn-bg); color: var(--btn-fg); }
  #section-{{ section.id }} .hno-btn--solid:hover { transform: translateY(-2px); box-shadow: 0 14px 34px -14px rgba(0,0,0,.5); }
  #section-{{ section.id }} .hno-btn--line { border: 1px solid var(--bdr); color: var(--fg); }
  #section-{{ section.id }} .hno-btn--line:hover { background: var(--btn-bg); color: var(--btn-fg); border-color: var(--btn-bg); }

  #section-{{ section.id }} .hno-scroll {
    display: inline-flex; align-items: center; gap: 12px;
    margin-top: clamp(30px, 5svh, 54px);
    font-family: var(--ff-body,'Outfit',sans-serif); font-size: 10px; font-weight: 500;
    letter-spacing: .26em; text-transform: uppercase; color: var(--mut);
    animation: hnoUp{{ section.id }} .85s .66s both;
  }
  #section-{{ section.id }} .hno-scroll__line { width: 44px; height: 1px; background: var(--acc); animation: hnoPulse{{ section.id }} 2.4s ease-in-out infinite; transform-origin: left; }

  /* — Media composition: glow + frame + offset outline + index — */
  #section-{{ section.id }} .hno-media { position: relative; animation: hnoFade{{ section.id }} 1.1s .18s both; }
  #section-{{ section.id }} .hno-media__glow {
    position: absolute; inset: -18% -22%; z-index: 0; pointer-events: none;
    background: radial-gradient(48% 42% at 62% 38%, color-mix(in srgb, var(--acc) 26%, transparent) 0%, transparent 70%);
    filter: blur(6px);
  }
  #section-{{ section.id }} .hno-media__frame {
    position: relative; z-index: 2; aspect-ratio: 4/5; overflow: hidden;
    background: var(--bdr); max-height: min(72svh, 720px); width: 100%;
  }
  #section-{{ section.id }} .hno-media__img { width: 100%; height: 100%; object-fit: cover; display: block; animation: hnoKen{{ section.id }} 16s ease-out forwards; }
  #section-{{ section.id }} .hno-media__outline {
    position: absolute; z-index: 1; inset: 0;
    transform: translate(clamp(10px,1.4vw,22px), clamp(10px,1.4vw,22px));
    border: 1px solid var(--acc); opacity: .55; pointer-events: none;
  }
  #section-{{ section.id }} .hno-tag {
    position: absolute; left: 14px; bottom: 14px; z-index: 3;
    display: inline-flex; align-items: center; gap: 8px;
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--bdr); color: var(--fg); padding: 9px 14px;
    font-family: var(--ff-body,'Outfit',sans-serif); font-size: 10px; font-weight: 500;
    letter-spacing: .2em; text-transform: uppercase;
  }
  #section-{{ section.id }} .hno-tag__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--acc); }
  #section-{{ section.id }} .hno-index {
    position: absolute; z-index: 3; top: -18px; right: -6px;
    font-family: var(--ff-display,'Cormorant Garamond',serif);
    font-size: clamp(40px,4.6vw,72px); font-weight: 300; line-height: 1; color: var(--acc);
  }

  #section-{{ section.id }} .hno-ticker {
    position: relative; z-index: 1; overflow: hidden; border-top: 1px solid var(--bdr);
    margin: 0 calc(-1 * var(--side-padding,5vw)); padding: 14px 0;
  }
  #section-{{ section.id }} .hno-ticker__track { display: inline-flex; align-items: center; white-space: nowrap; animation: hnoMarq{{ section.id }} 28s linear infinite; }
  #section-{{ section.id }} .hno-ticker__track span {
    font-family: var(--ff-display,'Cormorant Garamond',serif); font-size: clamp(18px,2vw,28px);
    font-weight: 300; text-transform: uppercase; letter-spacing: .05em; padding: 0 22px; color: var(--fg); opacity: .8;
  }
  #section-{{ section.id }} .hno-ticker__sep { color: var(--acc) !important; font-size: 12px !important; opacity: 1 !important; }

  @keyframes hnoUp{{ section.id }}    { from { opacity:0; transform: translateY(26px);} to { opacity:1; transform:none; } }
  @keyframes hnoFade{{ section.id }}  { from { opacity:0; transform: scale(1.015);} to { opacity:1; transform:none; } }
  @keyframes hnoKen{{ section.id }}   { from { transform: scale(1.08);} to { transform: scale(1);} }
  @keyframes hnoMarq{{ section.id }}  { from { transform: translateX(0);} to { transform: translateX(-50%);} }
  @keyframes hnoPulse{{ section.id }} { 0%,100% { transform: scaleX(.35); opacity:.5;} 50% { transform: scaleX(1); opacity:1;} }

  @media (max-width: 900px) {
    #section-{{ section.id }} { padding-top: clamp(116px, 15svh, 150px); }
    #section-{{ section.id }} .hno-grid { grid-template-columns: 1fr; gap: 30px; padding-bottom: 40px; }
    #section-{{ section.id }} .hno-media { order: -1; }
    #section-{{ section.id }} .hno-media__frame { aspect-ratio: 4/5; max-height: 54svh; }
    #section-{{ section.id }} .hno-index { top: auto; bottom: -14px; right: 6px; }
    #section-{{ section.id }} .hno-watermark { font-size: clamp(90px, 26vw, 160px); top: 84px; right: -6vw; }
    #section-{{ section.id }} .hno-masthead { flex-wrap: wrap; gap: 10px; margin-bottom: 18px; }
    #section-{{ section.id }} .hno-masthead__rule { flex-basis: 24px; }
    #section-{{ section.id }} .hno-scroll { display: none; }
  }
</style>

{% schema %}
{
  "name": "Hero Noir",
  "tag": "section",
  "class": "section-hero-noir",
  "settings": [
    {
      "type": "select", "id": "scheme", "label": "Color scheme",
      "options": [
        { "value": "light", "label": "Light (bone)" },
        { "value": "dark",  "label": "Dark (graphite)" },
        { "value": "warm",  "label": "Warm (sand)" },
        { "value": "theme", "label": "Follow theme" }
      ],
      "default": "dark"
    },
    { "type": "image_picker", "id": "image", "label": "Hero image (right)" },
    { "type": "header", "content": "Masthead row (above headline)" },
    { "type": "text", "id": "meta_left",  "label": "Masthead left",  "default": "Collection Nº 04" },
    { "type": "text", "id": "meta_right", "label": "Masthead right", "default": "Autumn / Winter 2025" },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Noir Edit" },
    { "type": "text", "id": "heading_line1", "label": "Headline line 1", "default": "Form" },
    { "type": "text", "id": "heading_line2", "label": "Headline line 2 (accent, italic)", "default": "Meets" },
    { "type": "text", "id": "heading_line3", "label": "Headline line 3", "default": "Function" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Sharp tailoring and uncompromising lines. A modern wardrobe built on contrast — architectural, deliberate, and quietly powerful." },
    { "type": "text", "id": "btn1_label", "label": "Primary button", "default": "Shop the Collection" },
    { "type": "url",  "id": "btn1_link",  "label": "Primary button link" },
    { "type": "text", "id": "btn2_label", "label": "Secondary button", "default": "View Lookbook" },
    { "type": "url",  "id": "btn2_link",  "label": "Secondary button link" },
    { "type": "text", "id": "scroll_label", "label": "Scroll cue label", "default": "Scroll" },
    { "type": "header", "content": "Accents" },
    { "type": "text", "id": "watermark",   "label": "Watermark word (outlined, background)", "default": "Noir" },
    { "type": "text", "id": "tag_label",   "label": "Floating image tag", "default": "New Arrivals" },
    { "type": "text", "id": "index_label", "label": "Index number", "default": "04" },
    { "type": "header", "content": "Bottom ticker" },
    { "type": "text", "id": "ticker", "label": "Ticker phrase", "default": "Made to Last" }
  ],
  "presets": [ { "name": "Hero Noir" } ]
}
{% endschema %}
