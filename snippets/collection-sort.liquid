<div class="sort-by">
  <label for="sort-select" class="sort-by__label">{{ 'collections.sorting.sort_by' | t }}</label>
  <select id="sort-select" class="sort-by__select" data-sort-select onchange="location.href=this.value">
    {%- for option in collection.sort_options -%}
      <option value="{{ collection.url }}?sort_by={{ option.value }}"
        {% if collection.sort_by == option.value or collection.default_sort_by == option.value and collection.sort_by == blank %}selected{% endif %}>
        {{ option.name }}
      </option>
    {%- endfor -%}
  </select>
</div>

{%- comment -%}
  Styles for this snippet live in assets/theme.css, with the rest of the
  collection toolbar. They were inline here, and a snippet's styles land
  in the page after theme.css, so this block silently overrode the
  stylesheet -- the sort label stayed at 10px however theme.css was
  edited. Same fault as the section-level block removed earlier.
{%- endcomment -%}
