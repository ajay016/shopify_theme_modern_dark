<!doctype html>
<html
  {% render 'mn-html-attrs' %}
>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}
  <title>{{ shop.name }}</title>
  {%- render 'mn-fonts' -%}
  {{ content_for_header }}
  {%- render 'css-variables' -%}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ 'mn-core.css' | asset_url | stylesheet_tag }}
  {{ 'mn-header.css' | asset_url | stylesheet_tag }}
  {{ 'mn-motion.css' | asset_url | stylesheet_tag }}
  {{ 'mn-shopify.css' | asset_url | stylesheet_tag }}
  {{ 'mn-collection.css' | asset_url | stylesheet_tag }}
  {{ 'mn-pages.css' | asset_url | stylesheet_tag }}
</head>
<body class="template-password" data-scroll-reveal="false">
  {%- render 'mn-icons' -%}
  <main id="MainContent">{{ content_for_layout }}</main>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  <script src="{{ 'mn.js' | asset_url }}" defer></script>
</body>
</html>
