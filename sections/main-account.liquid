{%- comment -%}
  Account overview, in the design's language: greeting, account navigation,
  order history (a table on wide screens, cards on phones) and the default
  address.
{%- endcomment -%}
{%- assign ss = section.settings -%}
{%- paginate customer.orders by 20 -%}
<div class="mn-acct" id="section-{{ section.id }}">
  <div class="mn-container">
    <div class="mn-acct__head">
      <div>
        <span class="mn-eyebrow">{{ 'mn.acct.eyebrow' | t }}</span>
        <h1 class="section-title">
          {%- if customer.first_name != blank -%}{{ 'mn.acct.welcome_html' | t: name: customer.first_name }}{%- else -%}{{ 'mn.acct.welcome_plain_html' | t }}{%- endif -%}
        </h1>
        <p class="mn-acct__sub">{{ customer.email }}</p>
      </div>
    </div>

    <div class="mn-acct__grid">
      {%- render 'mn-account-nav', current: 'orders' -%}

      <div class="mn-acct__main">
        <h2 class="mn-acct__title">{{ 'customer.orders.title' | t }}{%- if customer.orders_count > 0 -%}<span class="mn-acct__count">{{ customer.orders_count }}</span>{%- endif -%}</h2>
        {%- if customer.orders.size > 0 -%}
          <div class="mn-orders" role="table" aria-label="{{ 'customer.orders.title' | t }}">
            <div class="mn-orders__row mn-orders__row--head" role="row">
              <span role="columnheader">{{ 'customer.orders.order_number' | t }}</span>
              <span role="columnheader">{{ 'customer.orders.date' | t }}</span>
              <span role="columnheader">{{ 'customer.orders.payment_status' | t }}</span>
              <span role="columnheader">{{ 'customer.orders.fulfillment_status' | t }}</span>
              <span role="columnheader" class="mn-orders__num">{{ 'customer.orders.total' | t }}</span>
            </div>
            {%- for order in customer.orders -%}
              <a href="{{ order.customer_url }}" class="mn-orders__row" role="row" aria-label="{{ 'mn.acct.view_order' | t: name: order.name | escape }}">
                <span role="cell" class="mn-orders__name">{{ order.name }}</span>
                <span role="cell" data-label="{{ 'customer.orders.date' | t }}">{{ order.created_at | date: '%B %-d, %Y' }}</span>
                <span role="cell" data-label="{{ 'customer.orders.payment_status' | t }}"><span class="badge mn-status mn-status--{{ order.financial_status }}">{{ order.financial_status_label }}</span></span>
                <span role="cell" data-label="{{ 'customer.orders.fulfillment_status' | t }}"><span class="badge mn-status mn-status--{{ order.fulfillment_status }}">{{ order.fulfillment_status_label }}</span></span>
                <span role="cell" class="mn-orders__num" data-label="{{ 'customer.orders.total' | t }}">{{ order.total_price | money }}<svg class="icon icon--sm" aria-hidden="true"><use href="#i-chevron-right"></use></svg></span>
              </a>
            {%- endfor -%}
          </div>
          {%- if paginate.pages > 1 -%}{%- render 'mn-pagination', paginate: paginate -%}{%- endif -%}
        {%- else -%}
          <div class="mn-acct__empty">
            <span class="mn-cartpage__empty-icon"><svg class="icon icon--lg" aria-hidden="true"><use href="#i-bag"></use></svg></span>
            <p>{{ 'customer.orders.none' | t }}</p>
            <a href="{{ routes.all_products_collection_url }}" class="mn-btn mn-btn--sm">{{ 'customer.account.start_shopping' | t }}</a>
          </div>
        {%- endif -%}
      </div>

      <aside class="mn-acct__aside">
        <div class="mn-acct__card">
          <h2 class="mn-acct__card-title">{{ 'mn.acct.default_address' | t }}</h2>
          {%- if customer.default_address -%}
            <address class="mn-acct__address">{{ customer.default_address | format_address }}</address>
          {%- else -%}
            <p class="mn-acct__muted">{{ 'mn.acct.no_address' | t }}</p>
          {%- endif -%}
          <a href="{{ routes.account_addresses_url }}" class="link-arrow">{{ 'mn.acct.manage_addresses' | t: count: customer.addresses_count }}<svg class="icon" aria-hidden="true"><use href="#i-arrow-right"></use></svg></a>
        </div>
        {%- if ss.help_text != blank -%}
          <div class="mn-acct__card mn-acct__card--soft">
            <h2 class="mn-acct__card-title">{{ 'mn.acct.help' | t }}</h2>
            <div class="rte mn-acct__muted">{{ ss.help_text }}</div>
          </div>
        {%- endif -%}
      </aside>
    </div>
  </div>
</div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Account",
  "tag": "section",
  "class": "section-main-account",
  "settings": [
    { "type": "richtext", "id": "help_text", "label": "Help text", "info": "Shown in a card beside the orders, for example how to reach client care.", "default": "<p>Questions about an order? Write to our client care team and we will reply within one working day.</p>" }
  ],
  "presets": [{ "name": "Account" }]
}
{% endschema %}
