{%- liquid
  assign s = section.settings
  assign col = collections[s.collection]

  assign demo_names = 'Champagne Silk Gown,Velvet Smoking Jacket,Satin Slip Dress,Sculpted Wool Column,Pearl Drop Earrings,Bias-Cut Skirt' | split: ','
  assign demo_prices = '$1,480|$1,120|$620|$980|$340|$450' | split: '|'
  assign demo_cats = 'Eveningwear,Tailoring,Silks,Outerwear,Jewellery,Skirts' | split: ','
  assign v1 = 'https://images.unsplash.com/photo-1469334031218-e382a71b716b?auto=format&fit=crop&w=700&q=80'
  assign v2 = 'https://images.unsplash.com/photo-1566174053879-31528523f8ae?auto=format&fit=crop&w=700&q=80'
  assign v3 = 'https://images.unsplash.com/photo-1496217590455-aa63a8350eea?auto=format&fit=crop&w=700&q=80'
  assign v4 = 'https://images.unsplash.com/photo-1539109136881-3be0616acf4b?auto=format&fit=crop&w=700&q=80'
  assign v5 = 'https://images.unsplash.com/photo-1543163521-1bf539c55dd2?auto=format&fit=crop&w=700&q=80'
  assign v6 = 'https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=700&q=80'
  assign demo_imgs_str = v1 | append: '||' | append: v2 | append: '||' | append: v3 | append: '||' | append: v4 | append: '||' | append: v5 | append: '||' | append: v6
  assign demo_imgs = demo_imgs_str | split: '||'
-%}

<section
  id="section-{{ section.id }}"
  class="pvt-section pvt--{{ s.scheme }}"
  data-section-id="{{ section.id }}"
  data-qv-scheme="{{ s.scheme }}"
>
  <div class="pvt-inner">
    {%- comment -%}Left: sticky editorial panel{%- endcomment -%}
    <div class="pvt-panel">
      <div class="pvt-panel__stick reveal">
        {%- if s.eyebrow != blank -%}<span class="pvt-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="pvt-heading">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<p class="pvt-text">{{ s.text }}</p>{%- endif -%}
        {%- if s.cta_label != blank -%}
          <a href="{{ col.url | default: s.cta_url | default: '/collections/all' }}" class="pvt-cta">{{ s.cta_label }}</a>
        {%- endif -%}
        {%- if s.note != blank -%}
          <span class="pvt-note"><span class="pvt-note__rule"></span>{{ s.note }}</span>
        {%- endif -%}

        {%- comment -%}Featured editorial image keeps the sticky column visually full{%- endcomment -%}
        {%- assign panel_fallback = 'https://images.unsplash.com/photo-1487412720507-e7ab37603c6f?auto=format&fit=crop&w=700&q=80' -%}
        <span class="pvt-panel__media">
          {%- if s.panel_image != blank -%}
            {{ s.panel_image | image_url: width: 700 | image_tag: loading: 'lazy', class: 'pvt-panel__img', sizes: '(max-width:900px) 92vw, 26vw', widths: '350,500,700', alt: s.heading | default: 'Editorial' }}
          {%- else -%}
            <img class="pvt-panel__img" src="{{ panel_fallback }}" alt="{{ s.heading | escape }}" loading="lazy" />
          {%- endif -%}
          {%- if s.panel_caption != blank -%}<span class="pvt-panel__cap">{{ s.panel_caption }}</span>{%- endif -%}
        </span>
      </div>
    </div>

    {%- comment -%}Right: staggered two-column product wall (unified cards){%- endcomment -%}
    <div class="pvt-wall">
      {%- if col != blank and col.products.size > 0 -%}
        {%- for product in col.products limit: s.products_to_show -%}
          <div class="pvt-item reveal">{%- render 'product-card', product: product, scheme: s.scheme, number: forloop.index -%}</div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..6) -%}
          {%- if forloop.index > s.products_to_show -%}{%- break -%}{%- endif -%}
          {%- assign idx = forloop.index0 -%}
          <div class="pvt-item reveal">{%- render 'product-card',
            scheme: s.scheme, number: forloop.index,
            demo_index: idx,
            demo_title: demo_names[idx],
            demo_price: demo_prices[idx],
            demo_category: demo_cats[idx],
            demo_image: demo_imgs[idx],
            demo_url: '/collections/all' -%}</div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  #section-{{ section.id }}.pvt--light { --bg:var(--s2-bg); --fg:var(--s2-fg); --acc:var(--gold); --mut:var(--s2-mut); --bdr:var(--s2-bdr); }
  #section-{{ section.id }}.pvt--dark  { --bg:var(--s1-bg); --fg:var(--s1-fg); --acc:var(--gold); --mut:var(--s1-mut); --bdr:var(--s1-bdr); }
  #section-{{ section.id }}.pvt--warm  { --bg:var(--s3-bg); --fg:var(--s3-fg); --acc:var(--gold); --mut:var(--s3-mut); --bdr:var(--s3-bdr); }
  #section-{{ section.id }}.pvt--theme { --bg:var(--s1-bg); --fg:var(--s1-fg); --acc:var(--gold); --mut:var(--s1-mut); --bdr:var(--s1-bdr); }

  #section-{{ section.id }} { background: var(--bg); color: var(--fg); padding: var(--section-spacing,80px) var(--side-padding,5vw); }
  #section-{{ section.id }} .pvt-inner {
    display: grid; grid-template-columns: minmax(280px, .74fr) 1.26fr;
    gap: clamp(32px, 5vw, 90px);
    max-width: var(--container-width,1440px); margin: 0 auto;
    align-items: start;
  }

  /* — Sticky editorial panel — */
  #section-{{ section.id }} .pvt-panel__stick { position: sticky; top: clamp(110px, 15vh, 150px); }
  #section-{{ section.id }} .pvt-eyebrow {
    display: block; font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: calc(11px * var(--fs-scale, 1)); font-weight: 500; letter-spacing: .3em; text-transform: uppercase;
    color: var(--acc); margin-bottom: 16px;
  }
  #section-{{ section.id }} .pvt-heading {
    font-family: var(--ff-display,'Cormorant Garamond',serif);
    font-size: calc(clamp(34px, 4.2vw, 60px) * var(--heading-scale,1));
    font-weight: 300; line-height: 1.04; text-transform: uppercase; margin: 0 0 20px;
  }
  #section-{{ section.id }} .pvt-text {
    font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: calc(clamp(13px, 1vw, 15px) * var(--fs-scale, 1)); line-height: 1.75; color: var(--mut);
    max-width: 340px; margin: 0 0 26px;
  }
  #section-{{ section.id }} .pvt-cta {
    display: inline-block;
    font-family: var(--ff-body,'Outfit',sans-serif); font-size: calc(11px * var(--fs-scale, 1)); font-weight: 500;
    letter-spacing: .18em; text-transform: uppercase; text-decoration: none;
    color: var(--on-gold); background: var(--acc); padding: 15px 34px; border-radius: 999px;
    transition: transform .22s, box-shadow .22s;
  }
  #section-{{ section.id }} .pvt-cta:hover { transform: translateY(-2px); box-shadow: 0 16px 36px -16px color-mix(in srgb, var(--acc) 70%, transparent); }
  #section-{{ section.id }} .pvt-note {
    display: flex; align-items: center; gap: 12px;
    margin-top: clamp(28px, 4vh, 44px);
    font-family: var(--ff-body,'Outfit',sans-serif); font-size: calc(10px * var(--fs-scale, 1)); font-weight: 500;
    letter-spacing: .24em; text-transform: uppercase; color: var(--mut);
  }
  #section-{{ section.id }} .pvt-note__rule { width: 36px; height: 1px; background: var(--acc); flex: 0 0 auto; }
  #section-{{ section.id }} .pvt-panel__media {
    position: relative; display: block; margin-top: clamp(24px, 3.4vh, 38px);
    aspect-ratio: 4/5; overflow: hidden; border-radius: 3px; background: var(--bdr);
  }
  #section-{{ section.id }} .pvt-panel__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #section-{{ section.id }} .pvt-panel__cap {
    position: absolute; left: 12px; bottom: 12px; z-index: 2;
    background: var(--s1-bg); color: var(--s1-fg);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    padding: 8px 14px; border-radius: 999px;
    font-family: var(--ff-body,'Outfit',sans-serif); font-size: calc(10px * var(--fs-scale, 1)); font-weight: 500;
    letter-spacing: .18em; text-transform: uppercase;
  }

  /* — Product wall: 2 columns, right column offset down — */
  #section-{{ section.id }} .pvt-wall {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: clamp(18px, 2.4vw, 40px);
  }
  #section-{{ section.id }} .pvt-item:nth-child(even) { transform: translateY(clamp(28px, 4.5vw, 76px)); }

  #section-{{ section.id }} .reveal.reveal-armed { opacity: 0; transition: opacity .7s ease, transform .7s ease; }
  #section-{{ section.id }} .pvt-panel__stick.reveal-armed { transform: translateY(24px); }
  #section-{{ section.id }} .reveal.is-visible { opacity: 1; }
  #section-{{ section.id }} .pvt-panel__stick.is-visible { transform: none; }
  #section-{{ section.id }} .pvt-wall .pvt-item:nth-child(2){transition-delay:.06s;}
  #section-{{ section.id }} .pvt-wall .pvt-item:nth-child(3){transition-delay:.12s;}
  #section-{{ section.id }} .pvt-wall .pvt-item:nth-child(4){transition-delay:.18s;}

  @media (max-width: 900px) {
    #section-{{ section.id }} .pvt-inner { grid-template-columns: 1fr; gap: 34px; }
    #section-{{ section.id }} .pvt-panel__stick { position: static; }
    #section-{{ section.id }} .pvt-item:nth-child(even) { transform: translateY(clamp(18px, 6vw, 34px)); }
  }
</style>

<script>
(function(){
  var SEC='{{ section.id }}';
  function arm(root){
    var els=root.querySelectorAll('.reveal');
    els.forEach(function(el){el.classList.add('reveal-armed');});
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('is-visible');io.unobserve(e.target);}});},{threshold:.08});
    els.forEach(function(el){io.observe(el);});
    setTimeout(function(){els.forEach(function(el){el.classList.add('is-visible');});},800);
  }
  function root(){return document.getElementById('section-'+SEC);}
  document.addEventListener('DOMContentLoaded',function(){var r=root();if(r)arm(r);});
  document.addEventListener('shopify:section:load',function(e){if(e.detail.sectionId!==SEC)return;var r=root();if(r){arm(r);r.querySelectorAll('.reveal').forEach(function(el){el.classList.add('is-visible');});}});
})();
</script>

{% schema %}
{
  "name": "Product Vitrine",
  "tag": "section",
  "class": "section-product-vitrine",
  "settings": [
    {
      "type": "select", "id": "scheme", "label": "Surface tone",
      "options": [
        { "value": "light", "label": "Alternate surface (soft)" },
        { "value": "dark",  "label": "Primary surface" },
        { "value": "warm",  "label": "Deep surface" },
        { "value": "theme", "label": "Primary surface (follow theme)" }
      ],
      "default": "dark"
    },
    { "type": "paragraph", "content": "Card design, image ratio, hover behaviour, wishlist and quick view all follow Theme settings → Product Cards. Demo items show until a collection is connected." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Vitrine" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pieces of Light" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "A cabinet of the season's most luminous pieces — silks that hold candlelight, tailoring that carves shadow." },
    { "type": "collection", "id": "collection", "label": "Collection (demo items if empty)" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 6, "step": 1, "default": 6 },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Shop the Vitrine" },
    { "type": "url",  "id": "cta_url",   "label": "CTA link" },
    { "type": "text", "id": "note", "label": "Small note under CTA", "default": "Complimentary shipping worldwide" },
    { "type": "image_picker", "id": "panel_image", "label": "Panel editorial image" },
    { "type": "text", "id": "panel_caption", "label": "Panel image caption", "default": "From the atelier" }
  ],
  "presets": [ { "name": "Product Vitrine" } ]
}
{% endschema %}
