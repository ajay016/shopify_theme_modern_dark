{%- comment -%}
  A password field in the design's .input with a show / hide button
  (assets/mn.js, [data-pw-toggle]).

  Accepts: id, section_id, name, autocomplete, label (optional, rendered
  above the field when given).
{%- endcomment -%}
{%- assign pw_id = id | append: '-' | append: section_id -%}
{%- if label != blank -%}<label class="mn-field__label" for="{{ pw_id }}">{{ label }}</label>{%- endif -%}
<span class="mn-pw">
  <input class="input" type="password" id="{{ pw_id }}" name="{{ name }}" autocomplete="{{ autocomplete }}" required>
  <button type="button" class="mn-pw__btn" data-pw-toggle aria-controls="{{ pw_id }}" aria-pressed="false" aria-label="{{ 'mn.acct.show_password' | t }}" data-label-hide="{{ 'mn.acct.hide_password' | t }}" data-label-show="{{ 'mn.acct.show_password' | t }}">
    <svg class="icon icon--sm mn-pw__show" aria-hidden="true"><use href="#i-eye"></use></svg>
    <svg class="icon icon--sm mn-pw__hide" aria-hidden="true"><use href="#i-eye-off"></use></svg>
  </button>
</span>
