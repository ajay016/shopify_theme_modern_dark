<!doctype html>
{%- liquid
  case settings.color_scheme
    when 'light'
      assign mn_scheme = 'light'
    when 'ivory-wine'
      assign mn_scheme = 'wine'
    when 'warm'
      assign mn_scheme = 'warm'
    when 'custom', 'olive'
      assign mn_scheme = 'custom'
    else
      assign mn_scheme = 'dark'
  endcase
  assign mn_motion = 'full'
  if settings.motion_level == 'off'
    assign mn_motion = 'reduced'
  elsif settings.motion_reduce_mode == 'strict'
    assign mn_motion = 'system'
  endif
  case settings.header_style
    when 'v2'
      assign mn_header = 'centred'
    when 'v3'
      assign mn_header = 'minimal'
    when 'v4'
      assign mn_header = 'floating'
    else
      assign mn_header = 'classic'
  endcase
  case settings.mega_menu_style
    when 'v2'
      assign mn_mega = 'visual'
    when 'v3'
      assign mn_mega = 'flyout'
    else
      assign mn_mega = 'columns'
  endcase
  assign mn_announce = settings.announcement_style | default: 'ticker'
  if mn_announce == 'rotating'
    assign mn_announce = 'rotate'
  endif
-%}
<html
  class="no-js{% if settings.motion_reduce_mode == 'strict' %} motion-strict{% endif %}"
  data-scheme="{{ mn_scheme }}"
  data-corners="{{ settings.corner_radius | default: 'soft' }}"
  data-buttons="{% if settings.button_shape == 'pill' %}pill{% else %}default{% endif %}"
  data-motion="{{ mn_motion }}"
  data-motion-level="{{ settings.motion_level | default: 'expressive' }}"
  data-header="{{ mn_header }}"
  data-announce="{{ mn_announce }}"
  data-mega="{{ mn_mega }}"
  data-mega-images="{% if settings.mega_menu_images == false %}off{% else %}on{% endif %}"
  data-footer="{{ settings.footer_style | default: 'columns' }}"
  lang="{{ request.locale.iso_code }}"
  dir="ltr"
>
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height">
  <meta name="theme-color" content="{{ settings.color_black }}">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {%- liquid
    case settings.font_pairing
      when 'newsreader_geist'
        assign gf_url = 'https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,300..500;1,6..72,300..500&display=swap'
      when 'custom'
        assign gf_url = 'https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&display=swap'
      when 'instrument_intertight'
        assign gf_url = 'https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter+Tight:ital,wght@0,300;0,400;0,500;0,600;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap'
      when 'intertight_solo'
        assign gf_url = 'https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap'
      when 'bodoni_jost'
        assign gf_url = 'https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;1,6..96,400&family=Jost:ital,wght@0,300;0,400;0,500;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap'
      when 'fraunces_jakarta'
        assign gf_url = 'https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300,50;0,9..144,400,50;1,9..144,300,50;1,9..144,400,50&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap'
      when 'bodoni_instrument'
        assign gf_url = 'https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;1,6..96,400&family=Instrument+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap'
      when 'playfair_inter'
        assign gf_url = 'https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,700;1,400;1,500&family=Inter:wght@300;400;500&family=IBM+Plex+Mono:wght@400;500&display=swap'
      when 'libre_raleway'
        assign gf_url = 'https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Raleway:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap'
      when 'dm_serif_dm_sans'
        assign gf_url = 'https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&family=IBM+Plex+Mono:wght@400;500&display=swap'
      else
        assign gf_url = 'https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Outfit:wght@200;300;400;500&family=IBM+Plex+Mono:wght@400;500&display=swap'
    endcase
  -%}
  <link href="{{ gf_url }}" rel="stylesheet">

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  {%- comment -%}OG / Social meta{%- endcomment -%}
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:type" content="website">
  {%- if page_description -%}
    <meta property="og:description" content="{{ page_description | escape }}">
  {%- endif -%}
  {%- if page_image -%}
    <meta property="og:image" content="http:{{ page_image | image_url: width: 1200 }}">
  {%- endif -%}

  {{ content_for_header }}

  {%- comment -%}Dynamic CSS custom properties (colors, fonts, layout){%- endcomment -%}
  {%- render 'css-variables' -%}

  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {%- comment -%}The Claude Design system: loaded after theme.css so its components win.{%- endcomment -%}
  {{ 'mn-core.css' | asset_url | stylesheet_tag }}
  {{ 'mn-header.css' | asset_url | stylesheet_tag }}
  {{ 'mn-product.css' | asset_url | stylesheet_tag }}
  {{ 'mn-footer.css' | asset_url | stylesheet_tag }}
  {{ 'mn-motion.css' | asset_url | stylesheet_tag }}
  {{ 'mn-shopify.css' | asset_url | stylesheet_tag }}
  {{ 'mn-collection.css' | asset_url | stylesheet_tag }}
  {{ 'mn-pages.css' | asset_url | stylesheet_tag }}
</head>

<body
  class="template-{{ request.page_type }}{% unless settings.animations_hover %} anim-hover-off{% endunless %}"
  data-cursor-style="{{ settings.custom_cursor_style }}"
  data-scroll-reveal="{{ settings.animations_scroll_reveal }}"
  data-reveal-style="{{ settings.animations_reveal_style }}"
  data-free-shipping-threshold="{{ settings.cart_free_shipping_threshold }}"
>

  {%- comment -%}Custom cursor (conditionally rendered){%- endcomment -%}
  {%- if settings.custom_cursor -%}
    <div class="cursor" id="cursor" aria-hidden="true"></div>
    <div class="cursor-ring" id="cursorRing" aria-hidden="true"></div>
  {%- endif -%}

  {%- render 'mn-icons' -%}

  {%- comment -%}Skip link{%- endcomment -%}
  <a class="skip-to-content-link button visually-hidden" href="#MainContent">
    {{ 'accessibility.skip_to_text' | t }}
  </a>

  {%- comment -%}Announcement Bar{%- endcomment -%}
  {%- if settings.announcement_enabled -%}
    {%- section 'announcement-bar' -%}
  {%- endif -%}

  {%- comment -%}Header{%- endcomment -%}
  {%- section 'header' -%}

  {%- comment -%}Cart drawer + notification (drawer and notification modes){%- endcomment -%}
  {%- unless settings.cart_type == 'page' -%}
    {%- section 'cart-drawer' -%}
  {%- endunless -%}
  {%- if settings.product_card_show_compare -%}{%- render 'mn-compare' -%}{%- endif -%}
  {%- if settings.wishlist_enabled -%}{%- render 'mn-wishlist' -%}{%- endif -%}

  {%- comment -%}Quick View Modal (global, filled via JS){%- endcomment -%}
  {%- if settings.quickview_enabled -%}
    <div class="overlay overlay--modal" id="ov-quick" role="dialog" aria-modal="true" aria-labelledby="ov-quick-t">
      <div class="overlay__scrim" data-close></div>
      <div class="overlay__panel"><span class="sheet-handle"></span><button type="button" class="icon-btn qv__close" data-close aria-label="{{ 'mn.pdp.close_quick' | t }}"><svg class="icon" aria-hidden="true"><use href="#i-close"></use></svg></button><div id="qvBody" style="min-height:0;display:flex;flex-direction:column"></div></div>
    </div>
  {%- endif -%}

  {%- comment -%}Main content{%- endcomment -%}
  <main
    id="MainContent"
    class="content-for-layout"
    role="main"
    tabindex="-1"
  >
    {{ content_for_layout }}
  </main>

  {%- comment -%}Footer{%- endcomment -%}
  {%- section 'footer' -%}

  {%- comment -%}Toast notification (JS appended){%- endcomment -%}

  {%- comment -%}Accessibility: page refresh message{%- endcomment -%}
  <ul hidden id="a11y-refresh-page-message">
    <li>{{ 'accessibility.refresh_page' | t }}</li>
  </ul>

  {%- comment -%}Scripts{%- endcomment -%}
  <script>
    window.routes = {
      root_url:        "{{ routes.root_url }}",
      cart_url:        "{{ routes.cart_url }}",
      cart_add_url:    "{{ routes.cart_add_url }}",
      cart_change_url: "{{ routes.cart_change_url }}",
      search_url:      "{{ routes.search_url }}",
      all_products_url: "{{ routes.all_products_collection_url }}"
    };
    window.MN_STRINGS = {
      products:         {{ 'mn.products' | t | json }},
      collections:      {{ 'mn.collections' | t | json }},
      pages:            {{ 'mn.pages' | t | json }},
      view_all_results: {{ 'mn.view_all_results' | t: terms: '__TERMS__' | json }},
      no_results:       {{ 'mn.no_results' | t: terms: '__TERMS__' | json }},
      cart_only_left:   {{ 'mn.cart.only_left' | t: count: '__N__' | json }},
      cart_error:       {{ 'mn.cart.error' | t | json }},
      cart_demo:        {{ 'mn.cart.demo' | t | json }},
      in_compare:       {{ 'mn.pdp.in_compare' | t | json }},
      add:              {{ 'mn.card.add' | t | json }},
      choose:           {{ 'mn.card.choose' | t | json }},
      cmp:              {
        added: {{ 'mn.compare.added' | t | json }}, max: {{ 'mn.compare.max' | t | json }}, remove: {{ 'mn.compare.remove' | t: title: '__T__' | json }},
        count: {{ 'mn.compare.count' | t: n: '__N__' | json }}, diff: {{ 'mn.compare.diff' | t | json }}, empty: {{ 'mn.compare.empty' | t | json }},
        add_title: {{ 'mn.compare.add_title' | t | json }}, add_hint: {{ 'mn.compare.add_hint' | t | json }},
        price: {{ 'mn.compare.price' | t | json }}, rating: {{ 'mn.compare.rating' | t | json }}, material: {{ 'mn.compare.material' | t | json }},
        origin: {{ 'mn.compare.origin' | t | json }}, care: {{ 'mn.compare.care' | t | json }}, colours: {{ 'mn.compare.colours' | t | json }},
        sizes: {{ 'mn.compare.sizes' | t | json }}, availability: {{ 'mn.compare.availability' | t | json }}, in_stock: {{ 'mn.compare.in_stock' | t | json }},
        sold_out: {{ 'mn.compare.sold_out' | t | json }}, only_left: {{ 'mn.compare.only_left' | t: n: '__N__' | json }}, reviews: {{ 'mn.compare.reviews' | t: n: '__N__' | json }}
      },
      wish:             {
        title: {{ 'mn.wish.title' | t | json }}, title_count: {{ 'mn.wish.title_count' | t: n: '__N__' | json }}, empty: {{ 'mn.wish.empty' | t | json }},
        browse: {{ 'mn.wish.browse' | t | json }}, remove: {{ 'mn.wish.remove' | t | json }}
      }
    };
    window.theme_strings = {
      added_to_cart:           {{ 'cart.added' | t | json }},
      free_shipping_message:   {{ 'cart.free_shipping_message' | t | json }},
      free_shipping_achieved:  {{ 'cart.free_shipping_achieved' | t | json }},
      wishlist_added:          {{ 'wishlist.added' | t | json }},
      wishlist_removed:        {{ 'wishlist.removed' | t | json }}
    };
    window.theme_settings = {
      cart_type:        {{ settings.cart_type | json }},
      money_format:     {{ shop.money_format | json }},
      custom_cursor:    {{ settings.custom_cursor | json }},
      wishlist_enabled: {{ settings.wishlist_enabled | json }},
      quickview_enabled:{{ settings.quickview_enabled | json }},
      quickview_show_description: {{ settings.quickview_show_description | json }},
      quickview_show_shipping:    {{ settings.quickview_show_shipping | json }},
      size_guide_url:   {{ settings.size_guide_url | json }},
      animations:       {{ settings.animations_scroll_reveal | json }},
      animations_hover: {{ settings.animations_hover | json }},
      reveal_style:     {{ settings.animations_reveal_style | json }}
    };
  </script>

  {%- if settings.show_layout_explorer -%}
    {%- render 'demo-explorer' -%}
  {%- endif -%}

  {{ 'theme.js' | asset_url | script_tag }}
  {{ 'mn.js' | asset_url | script_tag }}
  {{ 'mn-product.js' | asset_url | script_tag }}

  {%- if settings.custom_cursor -%}
    {{ 'custom-cursor.js' | asset_url | script_tag }}
  {%- endif -%}

</body>
</html>
