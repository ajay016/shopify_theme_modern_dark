{%- comment -%}
  Not found, in the design's language: a large display "404", the message,
  two buttons, the design's search field and a few pieces to carry on with.
{%- endcomment -%}
{%- liquid
  assign ss = section.settings
  assign pick = collections[ss.collection]
  capture pick_probe
    echo pick.id
  endcapture
  if pick_probe == ''
    assign pick = collections['all']
  endif
  capture pick_probe
    echo pick.products.size
  endcapture
  assign pick_n = pick_probe | plus: 0
-%}
<div class="mn-content mn-404" id="section-{{ section.id }}">
  <div class="mn-container">
    <div class="mn-404__inner">
      <p class="mn-404__code" aria-hidden="true">404</p>
      <span class="mn-eyebrow">{{ 'mn.notfound.eyebrow' | t }}</span>
      <h1 class="section-title">{{ ss.heading }}</h1>
      <p class="mn-content__lead">{{ '404.subtext' | t }}</p>
      {%- if ss.show_search -%}
        <form action="{{ routes.search_url }}" method="get" role="search" class="mn-searchpage__form mn-404__search">
          <input type="hidden" name="options[prefix]" value="last">
          <label class="mn-searchpage__field">
            <svg class="icon" aria-hidden="true"><use href="#i-search"></use></svg>
            <input type="search" name="q" placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ '404.search_label' | t }}">
          </label>
          <button type="submit" class="mn-btn">{{ 'general.search.submit' | t }}</button>
        </form>
      {%- endif -%}
      <div class="mn-404__actions">
        <a href="{{ routes.root_url }}" class="mn-btn mn-btn--secondary">{{ '404.homepage_link' | t }}</a>
        <a href="{{ routes.all_products_collection_url }}" class="link-arrow">{{ '404.shop_link' | t }}<svg class="icon" aria-hidden="true"><use href="#i-arrow-right"></use></svg></a>
      </div>
    </div>

    {%- if ss.show_products and pick_n > 0 -%}
      <div class="mn-section__head mn-404__picks">
        <div><span class="mn-eyebrow">{{ 'mn.searchpage.picks_eyebrow' | t }}</span><h2 class="section-title">{{ ss.products_heading }}</h2></div>
        <a href="{{ pick.url }}" class="link-arrow">{{ 'mn.searchpage.view_all' | t }}<svg class="icon" aria-hidden="true"><use href="#i-arrow-right"></use></svg></a>
      </div>
      <div class="product-grid product-grid--4" data-view="grid">
        {%- for product in pick.products limit: 4 -%}{%- render 'product-card', product: product -%}{%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "404 Page",
  "tag": "section",
  "class": "section-main-404",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "This page has <em>moved on</em>" },
    { "type": "checkbox", "id": "show_search", "label": "Show Search Bar", "default": true },
    { "type": "checkbox", "id": "show_products", "label": "Show products", "default": true },
    { "type": "collection", "id": "collection", "label": "Products from", "info": "Empty uses all products." },
    { "type": "inline_richtext", "id": "products_heading", "label": "Products heading", "default": "Perhaps <em>these</em>" }
  ],
  "presets": [{ "name": "404 Page" }]
}
{% endschema %}
