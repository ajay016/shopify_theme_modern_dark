{%- layout none -%}
<!doctype html>
<html
  {% render 'mn-html-attrs' %}
>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex">
  {%- assign gc_value = gift_card.initial_value | money_without_trailing_zeros -%}
  {%- assign gc_balance = gift_card.balance | money -%}
  <title>{{ 'gift_cards.issued.title' | t: value: gc_value, shop: shop.name }}</title>
  {%- render 'mn-fonts' -%}
  {{ content_for_header }}
  {%- render 'css-variables' -%}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ 'mn-core.css' | asset_url | stylesheet_tag }}
  {{ 'mn-shopify.css' | asset_url | stylesheet_tag }}
  {{ 'mn-pages.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
</head>
<body class="template-gift-card">
  {%- render 'mn-icons' -%}
  <main class="mn-gift">
    <a href="{{ shop.url }}" class="mn-pwpage__logo">
      {%- if settings.logo -%}
        {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
        {{ settings.logo | image_url: width: 400 | image_tag: alt: logo_alt, style: 'max-width:160px;height:auto' }}
      {%- else -%}
        {{ settings.logo_text | default: shop.name }}
      {%- endif -%}
    </a>

    <span class="mn-eyebrow">{{ 'gift_cards.issued.title' | t: value: gc_value, shop: shop.name }}</span>
    <h1 class="section-title">{{ 'mn.gift.heading_html' | t }}</h1>

    <div class="mn-gift__card{% if gift_card.enabled == false or gift_card.expired %} is-expired{% endif %}">
      <div class="mn-gift__top">
        <span class="mn-gift__shop">{{ shop.name }}</span>
        <span class="mn-gift__amount">{{ gc_value }}</span>
      </div>
      <div class="mn-gift__bottom">
        <span class="mn-gift__label">{{ 'gift_cards.issued.gift_card_code' | t }}</span>
        <span class="mn-gift__code" id="GiftCardCode">{{ gift_card.code | format_code }}</span>
      </div>
    </div>

    <div class="mn-gift__status">
      {%- if gift_card.enabled == false or gift_card.expired -%}
        <span class="badge badge--soldout">{{ 'gift_cards.issued.expired' | t }}</span>
      {%- else -%}
        {%- if gift_card.balance != gift_card.initial_value -%}<span class="badge">{{ 'gift_cards.issued.remaining_html' | t: balance: gc_balance }}</span>{%- endif -%}
        {%- if gift_card.expires_on -%}{%- assign exp = gift_card.expires_on | date: '%B %-d, %Y' -%}<span class="mn-acct__muted">{{ 'mn.gift.expires' | t: date: exp }}</span>{%- endif -%}
      {%- endif -%}
    </div>

    <p class="mn-content__lead">{{ 'gift_cards.issued.subtext' | t }}</p>

    <div class="mn-gift__actions">
      <button type="button" class="mn-btn mn-btn--secondary" data-copy-link="{{ gift_card.code }}" data-copied="{{ 'mn.gift.copied' | t }}"><svg class="icon icon--sm" aria-hidden="true"><use href="#i-link"></use></svg>{{ 'mn.gift.copy' | t }}</button>
      <a href="{{ shop.url }}" class="mn-btn">{{ 'gift_cards.issued.shop_link' | t }}</a>
    </div>

    <div class="mn-gift__extra">
      <div class="mn-gift__qr" id="GiftCardQr" data-identifier="{{ gift_card.qr_identifier }}" aria-label="{{ 'gift_cards.issued.qr_image_alt' | t }}" role="img"></div>
      {%- if gift_card.pass_url -%}
        <a href="{{ gift_card.pass_url }}" class="mn-gift__wallet"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="{{ 'mn.gift.wallet' | t }}" loading="lazy"></a>
      {%- endif -%}
      <button type="button" class="link-quiet" onclick="window.print()">{{ 'gift_cards.issued.print' | t }}</button>
    </div>
  </main>
  <script>
    window.addEventListener('DOMContentLoaded', function () {
      var el = document.getElementById('GiftCardQr');
      if (el && window.QRCode) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120, colorDark: '#1a1a1a', colorLight: '#ffffff' });
      document.addEventListener('click', function (e) {
        var b = e.target.closest('[data-copy-link]'); if (!b) return;
        var done = function () { var t = b.lastChild.textContent; b.lastChild.textContent = b.dataset.copied; setTimeout(function () { b.lastChild.textContent = t; }, 1800); };
        if (navigator.clipboard) navigator.clipboard.writeText(b.dataset.copyLink).then(done, done); else done();
      });
    });
  </script>
</body>
</html>
