{%- liquid
  assign s = section.settings
  assign fallback = 'https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=2000&q=85'
-%}

<section
  id="section-{{ section.id }}"
  class="hau"
  data-section-id="{{ section.id }}"
  style="--hau-minh: {{ s.min_height }}svh;"
>
  <div class="hau-bg" aria-hidden="true">
    {%- if s.image != blank -%}
      {{ s.image | image_url: width: 2200 | image_tag: loading: 'eager', fetchpriority: 'high', class: 'hau-bg__img', sizes: '100vw', widths: '900,1400,2000,2200', alt: '' }}
    {%- else -%}
      <img class="hau-bg__img" src="{{ fallback }}" alt="" fetchpriority="high" />
    {%- endif -%}
    <span class="hau-bg__scrim"></span>
  </div>

  <div class="hau-inner">
    <div class="hau-copy reveal">
      {%- if s.eyebrow != blank -%}<span class="hau-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
      {%- if s.heading != blank -%}<h1 class="hau-title">{{ s.heading }}</h1>{%- endif -%}
      {%- if s.description != blank -%}<p class="hau-desc">{{ s.description }}</p>{%- endif -%}

      {%- if s.btn1_label != blank or s.btn2_label != blank -%}
        <div class="hau-actions">
          {%- if s.btn1_label != blank -%}
            <a href="{{ s.btn1_link | default: '/collections/all' }}" class="hau-btn">{{ s.btn1_label }}</a>
          {%- endif -%}
          {%- if s.btn2_label != blank -%}
            <a href="{{ s.btn2_link | default: '/collections/all' }}" class="hau-link">
              {{ s.btn2_label }}<span class="hau-link__arrow" aria-hidden="true">&#8594;</span>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if s.marker != blank -%}<span class="hau-marker">{{ s.marker }}</span>{%- endif -%}
</section>

<style>
  #section-{{ section.id }} {
    position: relative;
    display: flex;
    min-height: var(--hau-minh, 88svh);
    align-items: flex-end;
    overflow: hidden;
    isolation: isolate;
    background: var(--img-placeholder, #1A1714);
  }
  #section-{{ section.id }} .hau-bg { position: absolute; z-index: 0; inset: 0; }
  #section-{{ section.id }} .hau-bg__img {
    display: block; width: 100%; height: 100%;
    object-fit: cover; object-position: center;
    filter: saturate(.74) contrast(1.02);
  }
  /* Scrim is deliberately dark in every scheme: it exists to make white
     type legible on a photograph, so it must not follow the page surface. */
  #section-{{ section.id }} .hau-bg__scrim {
    position: absolute; inset: 0;
    background: linear-gradient(100deg, rgba(10,10,11,.62) 0%, rgba(10,10,11,.34) 46%, rgba(10,10,11,.14) 100%);
  }

  #section-{{ section.id }} .hau-inner {
    position: relative; z-index: 2;
    width: 100%;
    padding: clamp(56px,9vh,104px) var(--side-padding,5vw);
  }
  #section-{{ section.id }} .hau-copy { max-width: 560px; }

  #section-{{ section.id }} .hau-eyebrow {
    display: block; margin-bottom: 20px;
    font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: calc(12px * var(--fs-scale, 1));
    font-weight: 600; letter-spacing: .22em; text-transform: uppercase;
    color: var(--on-image, #FFFFFF);
  }
  #section-{{ section.id }} .hau-title {
    margin: 0 0 22px;
    font-family: var(--ff-display,'Cormorant Garamond',serif);
    font-weight: 300;
    font-size: calc(clamp(48px,7.2vw,96px) * var(--heading-scale,1));
    line-height: .98; letter-spacing: .005em;
    color: var(--on-image, #FFFFFF);
  }
  #section-{{ section.id }} .hau-desc {
    max-width: 420px; margin: 0 0 32px;
    font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: calc(15px * var(--fs-scale, 1));
    line-height: 1.62;
    color: var(--on-image-mut, rgba(255,255,255,.78));
  }

  #section-{{ section.id }} .hau-actions {
    display: flex; align-items: center; flex-wrap: wrap;
    gap: clamp(18px,2.4vw,28px);
  }
  /* Controls sitting on photography use the scheme-independent on-photo
     pair, never a page-surface token — a surface token goes white on a
     pale image and disappears. */
  #section-{{ section.id }} .hau-btn {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 50px; padding: 0 30px;
    font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: calc(12px * var(--fs-scale, 1));
    font-weight: 600; letter-spacing: .16em; text-transform: uppercase;
    text-decoration: none;
    background: var(--onphoto-light, rgba(252,251,249,.96));
    color: var(--onphoto-light-fg, #16130F);
    border: 1px solid transparent;
    transition: background .22s ease, color .22s ease, transform .22s ease;
  }
  #section-{{ section.id }} .hau-btn:hover {
    background: var(--onphoto-dark, rgba(20,17,13,.94));
    color: var(--onphoto-dark-fg, #F4EFE6);
    transform: translateY(-2px);
  }
  #section-{{ section.id }} .hau-link {
    display: inline-flex; align-items: center; gap: 9px;
    padding-bottom: 4px;
    border-bottom: 1px solid currentColor;
    font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: calc(12px * var(--fs-scale, 1));
    font-weight: 600; letter-spacing: .16em; text-transform: uppercase;
    text-decoration: none;
    color: var(--on-image, #FFFFFF);
  }
  #section-{{ section.id }} .hau-link__arrow { transition: transform .22s ease; }
  #section-{{ section.id }} .hau-link:hover .hau-link__arrow { transform: translateX(4px); }

  #section-{{ section.id }} .hau-marker {
    position: absolute; z-index: 2; right: var(--side-padding,5vw); bottom: 26px;
    font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: calc(11px * var(--fs-scale, 1));
    font-weight: 500; letter-spacing: .2em; text-transform: uppercase;
    color: var(--on-image-mut, rgba(255,255,255,.78));
  }

  #section-{{ section.id }} .reveal.reveal-armed { opacity: 0; transform: translateY(22px); transition: opacity .8s ease, transform .8s ease; }
  #section-{{ section.id }} .reveal.is-visible { opacity: 1; transform: none; }

  @media (max-width: 900px) {
    #section-{{ section.id }} .hau-bg__scrim {
      background: linear-gradient(180deg, rgba(10,10,11,.30) 0%, rgba(10,10,11,.66) 100%);
    }
    #section-{{ section.id }} .hau-bg__img { object-position: 64% center; }
    #section-{{ section.id }} .hau-marker { display: none; }
  }
  @media (max-width: 560px) {
    #section-{{ section.id }} .hau-btn { width: 100%; }
    #section-{{ section.id }} .hau-actions { gap: 18px; }
  }
</style>

<script>
(function(){
  var SEC='{{ section.id }}';
  function arm(root){
    var els=root.querySelectorAll('.reveal');
    els.forEach(function(el){el.classList.add('reveal-armed');});
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('is-visible');io.unobserve(e.target);}});},{threshold:.15});
    els.forEach(function(el){io.observe(el);});
    setTimeout(function(){els.forEach(function(el){el.classList.add('is-visible');});},700);
  }
  function root(){return document.getElementById('section-'+SEC);}
  document.addEventListener('DOMContentLoaded',function(){var r=root();if(r)arm(r);});
  document.addEventListener('shopify:section:load',function(e){if(e.detail.sectionId!==SEC)return;var r=root();if(r){arm(r);r.querySelectorAll('.reveal').forEach(function(el){el.classList.add('is-visible');});}});
})();
</script>

{% schema %}
{
  "name": "Hero Aureline",
  "tag": "section",
  "class": "section-hero-aureline",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "range", "id": "min_height", "label": "Minimum height", "min": 60, "max": 95, "step": 5, "unit": "vh", "default": 85 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Summer 2026 Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Summer 2026" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "An exercise in clarity. Precise tailoring, fluid silk, and considered pieces designed for a life in motion." },
    { "type": "text", "id": "btn1_label", "label": "Primary button label", "default": "Discover the collection" },
    { "type": "url",  "id": "btn1_link",  "label": "Primary button link" },
    { "type": "text", "id": "btn2_label", "label": "Secondary link label", "default": "View campaign" },
    { "type": "url",  "id": "btn2_link",  "label": "Secondary link" },
    { "type": "text", "id": "marker", "label": "Corner marker", "default": "Campaign 01 / 05" }
  ],
  "presets": [{ "name": "Hero Aureline" }]
}
{% endschema %}
