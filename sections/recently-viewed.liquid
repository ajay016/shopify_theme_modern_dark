{%- comment -%}
  Recently viewed, built to the Claude Design reference: section head with
  eyebrow, title and Clear, then a row of compact product cards. Handles
  are kept in the browser; each card is rendered by Shopify through the
  product.mn-card template, so it matches every other card.
{%- endcomment -%}
{%- assign ss = section.settings -%}
<section class="mn-section recently-viewed" id="section-{{ section.id }}" hidden>
  <div class="mn-container">
    <div class="mn-section__head">
      <div>
        {%- if ss.eyebrow != blank -%}<span class="mn-eyebrow">{{ ss.eyebrow }}</span>{%- endif -%}
        {%- if ss.heading != blank -%}<h2 class="section-title">{{ ss.heading }}</h2>{%- endif -%}
      </div>
      <button type="button" class="link-quiet" data-recent-clear>{{ 'mn.recent.clear' | t }}</button>
    </div>
    <div class="row-cards row-cards--6 row-cards--mini" style="--cols:{{ ss.columns }}"></div>
  </div>
</section>
<script>
  (() => {
    const KEY = 'mn_recent', s = document.getElementById('section-{{ section.id }}');
    const current = {{ product.handle | json }};
    const limit = {{ ss.products_to_show }};
    let seen = [];
    try { seen = JSON.parse(localStorage.getItem(KEY) || '[]').filter(h => typeof h === 'string'); } catch (e) {}
    seen = seen.filter(h => h !== current);
    if (current) { try { localStorage.setItem(KEY, JSON.stringify([current].concat(seen).slice(0, 12))); } catch (e) {} }
    const show = seen.slice(0, limit), row = s && s.querySelector('.row-cards');
    if (!show.length || !row) return;
    const root = ((window.routes && window.routes.root_url) || '/').replace(/\/?$/, '/');
    Promise.all(show.map(h => fetch(`${root}products/${encodeURIComponent(h)}?view=mn-card`).then(r => (r.ok ? r.text() : '')).catch(() => '')))
      .then(cards => { row.innerHTML = cards.filter(c => c.includes('data-pcard')).join(''); s.hidden = !row.children.length; });
    s.querySelector('[data-recent-clear]').addEventListener('click', () => {
      try { localStorage.setItem(KEY, JSON.stringify(current ? [current] : [])); } catch (e) {}
      s.hidden = true;
    });
  })();
</script>

{% schema %}
{
  "name": "Recently viewed",
  "tag": "div",
  "class": "section-recently-viewed",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Your history" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Recently <em>viewed</em>" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "select", "id": "columns", "label": "Columns on desktop", "default": "6", "options": [
      { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" }, { "value": "6", "label": "6" }
    ] }
  ],
  "presets": [{ "name": "Recently viewed" }]
}
{% endschema %}
