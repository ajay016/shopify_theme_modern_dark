{%- liquid
  assign s = section.settings
  assign blog = blogs[s.blog]

  assign demo_meta = 'Atelier / 7 min,Materials / 5 min,Portraits / 4 min' | split: ','
  assign demo_titles = 'The architecture of a well-made coat,Why texture matters,In conversation with Elia Noor' | split: ','
  assign e1 = 'A study in balance, construction, and the details that let a garment age beautifully.'
  assign e2 = 'Natural fibres chosen for touch, movement and longevity.'
  assign e3 = 'On restraint, personal rituals, and dressing with instinct.'
  assign demo_excerpts_str = e1 | append: '||' | append: e2 | append: '||' | append: e3
  assign demo_excerpts = demo_excerpts_str | split: '||'
  assign j1 = 'https://images.unsplash.com/photo-1525507119028-ed4c629a60a3?auto=format&fit=crop&w=1200&q=85'
  assign j2 = 'https://images.unsplash.com/photo-1520975954732-35dd22299614?auto=format&fit=crop&w=900&q=85'
  assign j3 = 'https://images.unsplash.com/photo-1485462537746-965f33f7f6a7?auto=format&fit=crop&w=900&q=85'
  assign demo_imgs_str = j1 | append: '||' | append: j2 | append: '||' | append: j3
  assign demo_imgs = demo_imgs_str | split: '||'
-%}

<section
  id="section-{{ section.id }}"
  class="jtr jtr--{{ s.scheme }}"
  data-section-id="{{ section.id }}"
>
  <div class="jtr-inner">
    <div class="jtr-head reveal">
      <div>
        {%- if s.eyebrow != blank -%}<p class="jtr-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="jtr-heading">{{ s.heading }}</h2>{%- endif -%}
      </div>
      {%- if s.cta_label != blank -%}
        <a class="jtr-cta" href="{{ blog.url | default: s.cta_url | default: '/blogs/news' }}">
          {{ s.cta_label }}<span aria-hidden="true">&#8594;</span>
        </a>
      {%- endif -%}
    </div>

    <div class="jtr-grid">
      {%- if blog != blank and blog.articles_count > 0 -%}
        {%- for article in blog.articles limit: 3 -%}
          <article class="jtr-story reveal{% if forloop.first %} jtr-story--lead{% endif %}">
            <a class="jtr-link" href="{{ article.url }}">
              <div class="jtr-media">
                {%- if article.image != blank -%}
                  {{ article.image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'jtr-img', sizes: '(max-width: 900px) 92vw, 40vw', widths: '600,900,1200', alt: article.title }}
                {%- else -%}
                  <img class="jtr-img" src="{{ demo_imgs[forloop.index0] }}" alt="{{ article.title }}" loading="lazy" />
                {%- endif -%}
              </div>
              <p class="jtr-meta">
                {{ article.published_at | date: '%b %d, %Y' }}
                {%- if article.tags.size > 0 %} / {{ article.tags.first }}{% endif -%}
              </p>
              <h3 class="jtr-title">{{ article.title }}</h3>
              {%- if article.excerpt_or_content != blank -%}
                <p class="jtr-excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
              {%- endif -%}
            </a>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          {%- assign idx = forloop.index0 -%}
          <article class="jtr-story reveal{% if forloop.first %} jtr-story--lead{% endif %}">
            <a class="jtr-link" href="{{ s.cta_url | default: '/blogs/news' }}">
              <div class="jtr-media">
                <img class="jtr-img" src="{{ demo_imgs[idx] }}" alt="{{ demo_titles[idx] }}" loading="lazy" />
              </div>
              <p class="jtr-meta">{{ demo_meta[idx] }}</p>
              <h3 class="jtr-title">{{ demo_titles[idx] }}</h3>
              <p class="jtr-excerpt">{{ demo_excerpts[idx] }}</p>
            </a>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  #section-{{ section.id }}.jtr--light { --bg:var(--s2-bg,#131313); --fg:var(--s2-fg,#F5F0E8); --acc:var(--gold,#C8A96E); --mut:var(--s2-mut,rgba(245,240,232,.62)); }
  #section-{{ section.id }}.jtr--dark  { --bg:var(--s1-bg,#0A0A0A); --fg:var(--s1-fg,#F5F0E8); --acc:var(--gold,#C8A96E); --mut:var(--s1-mut,rgba(245,240,232,.62)); }
  #section-{{ section.id }}.jtr--warm  { --bg:var(--s3-bg,#1A1714); --fg:var(--s3-fg,#F5F0E8); --acc:var(--gold,#C8A96E); --mut:var(--s3-mut,rgba(245,240,232,.62)); }
  #section-{{ section.id }}.jtr--theme { --bg:var(--s1-bg,#0A0A0A); --fg:var(--s1-fg,#F5F0E8); --acc:var(--gold,#C8A96E); --mut:var(--s1-mut,rgba(245,240,232,.62)); }

  #section-{{ section.id }} { background: var(--bg); color: var(--fg); padding: clamp(72px,9vh,112px) 0; }
  #section-{{ section.id }} .jtr-inner { padding: 0 var(--side-padding,5vw); }

  #section-{{ section.id }} .jtr-head {
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: clamp(20px,4vw,44px); margin-bottom: clamp(26px,3.6vh,38px);
  }
  #section-{{ section.id }} .jtr-eyebrow {
    margin: 0 0 12px;
    font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: calc(12px * var(--fs-scale, 1));
    font-weight: 600; letter-spacing: .22em; text-transform: uppercase;
    color: var(--acc);
  }
  #section-{{ section.id }} .jtr-heading {
    margin: 0;
    font-family: var(--ff-display,'Cormorant Garamond',serif);
    font-weight: 300;
    font-size: calc(clamp(34px,4.4vw,58px) * var(--heading-scale,1));
    line-height: 1.02;
  }
  #section-{{ section.id }} .jtr-cta {
    flex: 0 0 auto;
    display: inline-flex; align-items: center; gap: 10px;
    padding-bottom: 4px; border-bottom: 1px solid currentColor;
    font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: calc(12px * var(--fs-scale, 1));
    font-weight: 600; letter-spacing: .16em; text-transform: uppercase;
    text-decoration: none; color: var(--fg);
  }
  #section-{{ section.id }} .jtr-cta:hover { color: var(--acc); }

  #section-{{ section.id }} .jtr-grid { display: grid; grid-template-columns: 1.3fr .7fr .7fr; gap: clamp(24px,2vw,32px) 10px; }
  #section-{{ section.id }} .jtr-link { display: block; text-decoration: none; color: inherit; }
  #section-{{ section.id }} .jtr-media {
    aspect-ratio: .86; overflow: hidden;
    background: var(--img-placeholder, #1A1714);
  }
  #section-{{ section.id }} .jtr-story--lead .jtr-media { aspect-ratio: 1.2; }
  #section-{{ section.id }} .jtr-img {
    display: block; width: 100%; height: 100%;
    object-fit: cover; filter: saturate(.62);
    transition: transform .55s ease;
  }
  #section-{{ section.id }} .jtr-story:hover .jtr-img { transform: scale(1.03); }
  #section-{{ section.id }} .jtr-meta {
    margin: 16px 0 8px;
    font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: calc(11px * var(--fs-scale, 1));
    font-weight: 600; letter-spacing: .2em; text-transform: uppercase;
    color: var(--acc);
  }
  #section-{{ section.id }} .jtr-title {
    margin: 0 0 10px;
    font-family: var(--ff-display,'Cormorant Garamond',serif);
    font-weight: 300;
    font-size: calc(clamp(22px,2vw,30px) * var(--heading-scale,1));
    line-height: 1.14;
  }
  #section-{{ section.id }} .jtr-excerpt {
    max-width: 520px; margin: 0;
    font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: calc(14px * var(--fs-scale, 1));
    line-height: 1.62; color: var(--mut);
  }

  #section-{{ section.id }} .reveal.reveal-armed { opacity: 0; transform: translateY(22px); transition: opacity .75s ease, transform .75s ease; }
  #section-{{ section.id }} .reveal.is-visible { opacity: 1; transform: none; }

  @media (max-width: 1000px) {
    #section-{{ section.id }} .jtr-grid { grid-template-columns: 1fr 1fr; }
    #section-{{ section.id }} .jtr-story--lead { grid-column: span 2; }
  }
  @media (max-width: 700px) {
    #section-{{ section.id }} .jtr-head { flex-direction: column; align-items: flex-start; gap: 16px; }
    #section-{{ section.id }} .jtr-grid { grid-template-columns: 1fr; gap: 34px; }
    #section-{{ section.id }} .jtr-story--lead { grid-column: auto; }
    #section-{{ section.id }} .jtr-media,
    #section-{{ section.id }} .jtr-story--lead .jtr-media { aspect-ratio: .95; }
  }
</style>

<script>
(function(){
  var SEC='{{ section.id }}';
  function arm(root){
    var els=root.querySelectorAll('.reveal');
    els.forEach(function(el){el.classList.add('reveal-armed');});
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('is-visible');io.unobserve(e.target);}});},{threshold:.12});
    els.forEach(function(el){io.observe(el);});
    setTimeout(function(){els.forEach(function(el){el.classList.add('is-visible');});},800);
  }
  function root(){return document.getElementById('section-'+SEC);}
  document.addEventListener('DOMContentLoaded',function(){var r=root();if(r)arm(r);});
  document.addEventListener('shopify:section:load',function(e){if(e.detail.sectionId!==SEC)return;var r=root();if(r){arm(r);r.querySelectorAll('.reveal').forEach(function(el){el.classList.add('is-visible');});}});
})();
</script>

{% schema %}
{
  "name": "Journal Trio",
  "tag": "section",
  "class": "section-journal-trio",
  "settings": [
    {
      "type": "select", "id": "scheme", "label": "Surface tone",
      "options": [
        { "value": "light", "label": "Alternate surface (soft)" },
        { "value": "dark",  "label": "Primary surface" },
        { "value": "warm",  "label": "Deep surface" },
        { "value": "theme", "label": "Primary surface (follow theme)" }
      ],
      "default": "light"
    },
    { "type": "blog", "id": "blog", "label": "Blog", "info": "Leave empty to show demo stories." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From the atelier" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Journal" },
    { "type": "text", "id": "cta_label", "label": "Link label", "default": "View all stories" },
    { "type": "url",  "id": "cta_url",   "label": "Link" }
  ],
  "presets": [{ "name": "Journal Trio" }]
}
{% endschema %}
