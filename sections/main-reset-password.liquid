{%- comment -%}
  Reset password: reached from the link in Shopify's customer email. The design's
  fields and buttons, laid out like the sign-in page without the side panel.
{%- endcomment -%}
<div class="mn-acct mn-auth mn-auth--single" id="section-{{ section.id }}">
  <div class="mn-container mn-auth__grid">
    <div class="mn-auth__main">
      <div class="mn-auth__view">
        <span class="mn-eyebrow">{{ 'mn.acct.eyebrow' | t }}</span>
        <h1 class="section-title">{{ section.settings.heading }}</h1>
        <p class="mn-auth__lead">{{ 'mn.acct.reset_lead' | t }}</p>
        {%- form 'reset_customer_password', class: 'mn-auth__form', novalidate: 'novalidate' -%}
          {%- if form.errors -%}
            <div class="mn-alert mn-alert--error" role="alert" tabindex="-1">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          {%- liquid
            assign l1 = 'mn.acct.new_password' | t
            assign l2 = 'mn.acct.confirm_password' | t
          -%}
          <div class="mn-field">{%- render 'mn-password', id: 'Password', section_id: section.id, name: 'customer[password]', autocomplete: 'new-password', label: l1 -%}</div>
          <div class="mn-field">{%- render 'mn-password', id: 'PasswordConfirm', section_id: section.id, name: 'customer[password_confirmation]', autocomplete: 'new-password', label: l2 -%}</div>
          <button type="submit" class="mn-btn mn-btn--block">{{ 'mn.acct.reset_submit' | t }}</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Reset password",
  "tag": "section",
  "class": "section-main-reset-password",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Choose a new <em>password</em>" }
  ],
  "presets": [{ "name": "Reset password" }]
}
{% endschema %}
