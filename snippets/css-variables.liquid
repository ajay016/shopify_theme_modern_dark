  :root {
    /* Semantic aliases used by "Follow theme" section variants */
    --background: var(--s1-bg);
    --foreground: var(--s1-fg);

    --card-bg: var(--s2-bg);
    --card-fg: var(--s2-fg);
    --card-mut: var(--s2-mut);
    --card-bdr: var(--s2-bdr);

    /* A scrim dims the page behind a modal, so it is always dark. Deriving
       it from the surface produced a white scrim under a white modal. */
    --modal-scrim: rgba(10, 10, 11, 0.74);

    /* Imagery is photographic, not themed. Anything drawn on top of a photo
       keeps its own always-legible colors in every scheme. */
    --img-placeholder: #1A1714;
    --img-scrim: rgba(10, 10, 11, 0.55);
    --img-scrim-strong: rgba(10, 10, 11, 0.78);
    --on-image: #FFFFFF;
    --on-image-mut: rgba(255, 255, 255, 0.78);
    --onphoto-light: rgba(252, 251, 249, 0.96);
    --onphoto-light-fg: #16130F;
    --onphoto-dark: rgba(20, 17, 13, 0.94);
    --onphoto-dark-fg: #F4EFE6;

    /* Typography */
    {%- liquid
      assign pairing = settings.font_pairing | default: 'cormorant_outfit'
      assign body_size = settings.type_body_size | default: 14
      assign hscale = settings.type_heading_size_scale | default: 'medium'
    -%}
    {%- if pairing == 'playfair_inter' -%}
      --ff-display: "Playfair Display", Georgia, serif;
      --ff-body: Inter, system-ui, sans-serif;
    {%- elsif pairing == 'libre_raleway' -%}
      --ff-display: "Libre Baskerville", Georgia, serif;
      --ff-body: Raleway, system-ui, sans-serif;
    {%- elsif pairing == 'dm_serif_dm_sans' -%}
      --ff-display: "DM Serif Display", Georgia, serif;
      --ff-body: "DM Sans", system-ui, sans-serif;
    {%- else -%}
      --ff-display: "Cormorant Garamond", Georgia, serif;
      --ff-body: Outfit, system-ui, sans-serif;
    {%- endif -%}

    --fs-base: {{ body_size }}px;
    --fs-scale: {{ body_size | times: 1.0 | divided_by: 14.0 }};
    {%- if hscale == 'small' -%}
      --heading-scale: 0.80;
    {%- elsif hscale == 'large' -%}
      --heading-scale: 1.24;
    {%- else -%}
      --heading-scale: 1;
    {%- endif -%}

    /* Layout */
    --container-width: {{ settings.layout_container_width | default: '1440px' }};
    --section-spacing: {{ settings.layout_section_spacing | default: 80 }}px;
    --side-padding: {{ settings.layout_side_padding | default: 40 }}px;

    /* Transitions */
    --ease-out: cubic-bezier(0.25, 0.46, 0.45, 0.94);
    --ease-in: cubic-bezier(0.55, 0.055, 0.675, 0.19);
    --transition: 0.3s var(--ease-out);

    /* Z-index layers — nav must be lower than drawers/modals */
    --z-base: 1;
    --z-raised: 10;
    --z-nav: 100;
    --z-overlay: 150;
    /* Above the page and the header, but deliberately below the cart drawer
       and quick view, so the demo panel can never cover a real interaction. */
    --z-explorer: 300;
    --z-drawer: 400;
    --z-modal: 500;
    --z-cursor: 9999;
  }
</style>
