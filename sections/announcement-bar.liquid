{%- comment -%}
  Announcement bar, as in the Claude Design reference (assets/mn-header.css).
  All three modes are rendered; html[data-announce] (Theme settings →
  Announcement Bar → Bar Style) shows one: ticker, rotating or static.
  Messages come from the Message settings; each may hold several
  announcements separated by ✦ or |.
{%- endcomment -%}
{%- if settings.announcement_enabled -%}
  {%- liquid
    assign raw = settings.announcement_text_1
    if settings.announcement_text_2 != blank
      assign raw = raw | append: '|' | append: settings.announcement_text_2
    endif
    if settings.announcement_text_3 != blank
      assign raw = raw | append: '|' | append: settings.announcement_text_3
    endif
    if settings.announcement_text_4 != blank
      assign raw = raw | append: '|' | append: settings.announcement_text_4
    endif
    assign raw = raw | replace: '✦', '|'
    assign parts = raw | split: '|'
    assign surface = settings.announcement_surface | default: 'invert'
  -%}
  <div class="announce" data-surface="{{ surface }}" role="region" aria-label="{{ 'mn.announcements' | t }}">
    <div class="announce__ticker">
      <div class="announce__track">
        {%- for i in (1..2) -%}
          {%- for m in parts -%}
            {%- assign msg = m | strip -%}
            {%- if msg != blank -%}<span class="announce__item"{% if i == 2 %} aria-hidden="true"{% endif %}>{{ msg }}</span>{%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
    <div class="announce__rotate">
      <button type="button" class="icon-btn announce__prev" aria-label="{{ 'accessibility.previous_slide' | t }}"><svg class="icon icon--sm" aria-hidden="true"><use href="#i-chevron-left"></use></svg></button>
      <div class="announce__slides" aria-live="polite">
        {%- assign n = 0 -%}
        {%- for m in parts -%}
          {%- assign msg = m | strip -%}
          {%- if msg != blank -%}
            <p class="announce__slide{% if n == 0 %} is-active{% endif %}"><span>{{ msg }}</span></p>
            {%- assign n = n | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
      <button type="button" class="icon-btn announce__next" aria-label="{{ 'accessibility.next_slide' | t }}"><svg class="icon icon--sm" aria-hidden="true"><use href="#i-chevron-right"></use></svg></button>
    </div>
    <p class="announce__static">
      {{- parts.first | strip -}}
      {%- if settings.announcement_link != blank and settings.announcement_link_text != blank %} · <a href="{{ settings.announcement_link }}">{{ settings.announcement_link_text }}</a>{%- endif -%}
    </p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "class": "announcement-bar-section",
  "limit": 1,
  "settings": [
    {
      "type": "paragraph",
      "content": "Configure the announcement bar (on/off, style, messages, surface) in Theme Settings → Announcement Bar."
    }
  ],
  "presets": [{ "name": "Announcement Bar" }]
}
{% endschema %}
