{%- comment -%}
  Address form fields in the design's .mn-field / .input markup. Each
  wrapper keeps .form-field: theme.js fills the province list from the
  chosen country and hides that field (closest('.form-field')) for
  countries without provinces. Native selects become the design select.
  Accepts: form (a customer_address form)
{%- endcomment -%}
{%- assign fid = form.id | default: 'new' -%}
<div class="mn-addr__fields">
  <label class="mn-field form-field"><span class="mn-field__label">{{ 'customer.addresses.first_name' | t }}</span>
    <input class="input" type="text" id="address-first-name-{{ fid }}" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name"></label>
  <label class="mn-field form-field"><span class="mn-field__label">{{ 'customer.addresses.last_name' | t }}</span>
    <input class="input" type="text" id="address-last-name-{{ fid }}" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name"></label>
  <label class="mn-field form-field mn-addr__wide"><span class="mn-field__label">{{ 'customer.addresses.company' | t }}</span>
    <input class="input" type="text" id="address-company-{{ fid }}" name="address[company]" value="{{ form.company }}" autocomplete="organization"></label>
  <label class="mn-field form-field mn-addr__wide"><span class="mn-field__label">{{ 'customer.addresses.address1' | t }}</span>
    <input class="input" type="text" id="address1-{{ fid }}" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1"></label>
  <label class="mn-field form-field mn-addr__wide"><span class="mn-field__label">{{ 'customer.addresses.address2' | t }}</span>
    <input class="input" type="text" id="address2-{{ fid }}" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2"></label>
  <label class="mn-field form-field"><span class="mn-field__label">{{ 'customer.addresses.city' | t }}</span>
    <input class="input" type="text" id="address-city-{{ fid }}" name="address[city]" value="{{ form.city }}" autocomplete="address-level2"></label>
  <label class="mn-field form-field"><span class="mn-field__label">{{ 'customer.addresses.zip' | t }}</span>
    <input class="input" type="text" id="address-zip-{{ fid }}" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code"></label>
  <div class="mn-field form-field"><label class="mn-field__label" for="address-country-{{ fid }}">{{ 'customer.addresses.country' | t }}</label>
    <select id="address-country-{{ fid }}" name="address[country]" data-default="{{ form.country }}" autocomplete="country">{{ all_country_option_tags }}</select></div>
  <div class="mn-field form-field"><label class="mn-field__label" for="address-province-{{ fid }}">{{ 'customer.addresses.province' | t }}</label>
    <select id="address-province-{{ fid }}" name="address[province]" data-default="{{ form.province }}" autocomplete="address-level1"><option value="">{{ 'customer.addresses.province_select' | t }}</option></select></div>
  <label class="mn-field form-field mn-addr__wide"><span class="mn-field__label">{{ 'customer.addresses.phone' | t }}</span>
    <input class="input" type="tel" id="address-phone-{{ fid }}" name="address[phone]" value="{{ form.phone }}" autocomplete="tel"></label>
</div>
