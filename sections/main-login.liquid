{%- comment -%}
  Sign in, in the Claude Design reference's language: the design's fields,
  buttons and display type, with a side panel for new customers. The
  password reset form lives on this page (Shopify sends /account/login#recover)
  and replaces the sign-in form while #recover is targeted, or after a reset
  request was posted. Guest checkout appears when the store allows it.
{%- endcomment -%}
{%- liquid
  assign ss = section.settings
  assign recover_success = false
  assign recover_errors = false
-%}
{%- form 'recover_customer_password' -%}
  {%- if form.posted_successfully? -%}{%- assign recover_success = true -%}{%- endif -%}
  {%- if form.errors -%}{%- assign recover_errors = true -%}{%- endif -%}
{%- endform -%}
<div class="mn-acct mn-auth{% if recover_errors %} is-recover{% endif %}" id="section-{{ section.id }}">
  <div class="mn-container mn-auth__grid">
    <div class="mn-auth__main">
      {%- comment -%} Sign in {%- endcomment -%}
      <div class="mn-auth__view mn-auth__login">
        <span class="mn-eyebrow">{{ 'mn.acct.eyebrow' | t }}</span>
        <h1 class="section-title">{{ ss.heading }}</h1>
        {%- if recover_success -%}
          <p class="mn-alert mn-alert--ok" role="status"><svg class="icon icon--sm" aria-hidden="true"><use href="#i-check"></use></svg>{{ 'mn.acct.recover_sent' | t }}</p>
        {%- endif -%}
        {%- form 'customer_login', class: 'mn-auth__form', novalidate: 'novalidate' -%}
          {%- if form.errors -%}
            <div class="mn-alert mn-alert--error" role="alert" tabindex="-1">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <label class="mn-field">
            <span class="mn-field__label">{{ 'customer.login.email' | t }}</span>
            <input class="input" type="email" name="customer[email]" autocomplete="email" autocorrect="off" autocapitalize="off" required>
          </label>
          <div class="mn-field">
            <span class="mn-field__row">
              <label class="mn-field__label" for="LoginPassword-{{ section.id }}">{{ 'customer.login.password' | t }}</label>
              <a href="#recover" class="link-quiet mn-auth__forgot" data-auth-recover>{{ 'customer.login.forgot_password' | t }}</a>
            </span>
            {%- render 'mn-password', id: 'LoginPassword', section_id: section.id, name: 'customer[password]', autocomplete: 'current-password' -%}
          </div>
          <button type="submit" class="mn-btn mn-btn--block">{{ 'customer.login.sign_in' | t }}</button>
        {%- endform -%}

        {%- if shop.checkout.guest_login -%}
          <div class="mn-auth__guest">
            <span class="mn-auth__or">{{ 'mn.acct.or' | t }}</span>
            {%- form 'guest_login' -%}
              <button type="submit" class="mn-btn mn-btn--secondary mn-btn--block">{{ 'customer.login.guest_title' | t }}</button>
            {%- endform -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Reset password {%- endcomment -%}
      <div class="mn-auth__view mn-auth__recover" id="recover" tabindex="-1">
        <span class="mn-eyebrow">{{ 'mn.acct.eyebrow' | t }}</span>
        <h1 class="section-title">{{ 'mn.acct.recover_title_html' | t }}</h1>
        <p class="mn-auth__lead">{{ 'mn.acct.recover_lead' | t }}</p>
        {%- form 'recover_customer_password', class: 'mn-auth__form', novalidate: 'novalidate' -%}
          {%- if form.errors -%}
            <div class="mn-alert mn-alert--error" role="alert" tabindex="-1">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <label class="mn-field">
            <span class="mn-field__label">{{ 'customer.recover_password.email' | t }}</span>
            <input class="input" type="email" name="email" autocomplete="email" autocorrect="off" autocapitalize="off" required>
          </label>
          <button type="submit" class="mn-btn mn-btn--block">{{ 'customer.recover_password.submit' | t }}</button>
          <a href="#login" class="link-quiet mn-auth__back" data-auth-login>{{ 'mn.acct.back_to_sign_in' | t }}</a>
        {%- endform -%}
      </div>
    </div>

    <aside class="mn-auth__side"{% if ss.image %} data-has-image{% endif %}>
      {%- if ss.image -%}{{ ss.image | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'mn-auth__img', sizes: '(min-width: 900px) 45vw, 100vw', alt: '' }}{%- endif -%}
      <div class="mn-auth__panel">
        <span class="mn-eyebrow">{{ 'mn.acct.new_eyebrow' | t }}</span>
        <h2 class="section-title">{{ ss.side_heading }}</h2>
        <ul class="mn-auth__perks">
          {%- for i in (1..3) -%}
            {%- liquid
              assign k = 'perk_' | append: i
              assign perk = ss[k]
            -%}
            {%- if perk != blank -%}<li><svg class="icon icon--sm" aria-hidden="true"><use href="#i-check"></use></svg>{{ perk }}</li>{%- endif -%}
          {%- endfor -%}
        </ul>
        <a href="{{ routes.account_register_url }}" class="mn-btn mn-btn--secondary">{{ 'customer.register.submit' | t }}</a>
      </div>
    </aside>
  </div>
</div>

{% schema %}
{
  "name": "Login",
  "tag": "section",
  "class": "section-main-login",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Welcome <em>back</em>" },
    { "type": "header", "content": "New customer panel" },
    { "type": "inline_richtext", "id": "side_heading", "label": "Heading", "default": "Join <em>Maison Noir</em>" },
    { "type": "text", "id": "perk_1", "label": "Benefit 1", "default": "Track orders and returns in one place" },
    { "type": "text", "id": "perk_2", "label": "Benefit 2", "default": "Save addresses for a faster checkout" },
    { "type": "text", "id": "perk_3", "label": "Benefit 3", "default": "Early access to new collections" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Shown behind the panel. Leave empty for a plain panel." }
  ],
  "presets": [{ "name": "Login" }]
}
{% endschema %}
