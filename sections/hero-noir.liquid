{%- liquid
  assign s = section.settings
  assign fallback = 'https://images.unsplash.com/photo-1485231183945-fffde7cc051e?auto=format&fit=crop&w=1300&q=85'
  assign img_alt = s.heading_line1 | default: 'Editorial'
-%}

<section
  id="section-{{ section.id }}"
  class="hno-section hno--{{ s.scheme }}"
  data-section-id="{{ section.id }}"
>
  {%- if s.watermark != blank -%}
    <span class="hno-watermark" aria-hidden="true">{{ s.watermark }}</span>
  {%- endif -%}

  <div class="hno-stage">
    {%- comment -%}Vertical side rail — rotated meta, hairline, index{%- endcomment -%}
    <div class="hno-rail" aria-hidden="true">
      {%- if s.meta_left != blank -%}<span class="hno-rail__text">{{ s.meta_left }}</span>{%- endif -%}
      <span class="hno-rail__line"></span>
      {%- if s.index_label != blank -%}<span class="hno-rail__num">{{ s.index_label }}</span>{%- endif -%}
    </div>

    {%- comment -%}Copy column — headline deliberately overlaps the image slab{%- endcomment -%}
    <div class="hno-copy">
      {%- if s.meta_right != blank -%}<span class="hno-season">{{ s.meta_right }}</span>{%- endif -%}
      {%- if s.eyebrow != blank -%}<span class="hno-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}

      <h1 class="hno-title">
        {%- if s.heading_line1 != blank -%}<span class="hno-title__l">{{ s.heading_line1 }}</span>{%- endif -%}
        {%- if s.heading_line2 != blank -%}<span class="hno-title__l hno-title__l--em"><em>{{ s.heading_line2 }}</em></span>{%- endif -%}
        {%- if s.heading_line3 != blank -%}<span class="hno-title__l hno-title__l--push">{{ s.heading_line3 }}</span>{%- endif -%}
      </h1>

      {%- if s.description != blank -%}<p class="hno-desc">{{ s.description }}</p>{%- endif -%}

      <div class="hno-ctas">
        {%- if s.btn1_label != blank -%}<a href="{{ s.btn1_link | default: '#' }}" class="hno-btn hno-btn--solid">{{ s.btn1_label }}</a>{%- endif -%}
        {%- if s.btn2_label != blank -%}<a href="{{ s.btn2_link | default: '#' }}" class="hno-btn hno-btn--under">{{ s.btn2_label }} <span aria-hidden="true">&#8599;</span></a>{%- endif -%}
      </div>

      {%- if s.scroll_label != blank -%}
        <span class="hno-scroll" aria-hidden="true"><span class="hno-scroll__line"></span>{{ s.scroll_label }}</span>
      {%- endif -%}
    </div>

    {%- comment -%}Full-bleed cinematic image slab — runs to the right screen edge{%- endcomment -%}
    <div class="hno-slab">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 1300 | image_tag:
          loading: 'eager', fetchpriority: 'high', class: 'hno-slab__img',
          sizes: '(max-width:900px) 100vw, 52vw', widths: '700,1000,1300', alt: img_alt }}
      {%- else -%}
        <img class="hno-slab__img" src="{{ fallback }}" alt="{{ img_alt | escape }}" loading="eager" fetchpriority="high" />
      {%- endif -%}
      <span class="hno-slab__scrim" aria-hidden="true"></span>
      <span class="hno-slab__frame" aria-hidden="true"></span>
      {%- if s.tag_label != blank -%}
        <span class="hno-tag"><span class="hno-tag__dot"></span>{{ s.tag_label }}</span>
      {%- endif -%}
    </div>
  </div>

  {%- if s.ticker != blank -%}
    <div class="hno-ticker" aria-hidden="true">
      <div class="hno-ticker__track">
        {%- for i in (1..8) -%}<span>{{ s.ticker }}</span><span class="hno-ticker__sep">&#9670;</span>{%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

<style>
  #section-{{ section.id }}.hno--light {
    --bg:#ECE9E2; --fg:#18181A; --acc:var(--gold,#9A7B43);
    --mut:rgba(24,24,26,.55); --bdr:rgba(24,24,26,.16);
    --btn-bg:#18181A; --btn-fg:#ECE9E2; --wm:rgba(24,24,26,.05);
  }
  #section-{{ section.id }}.hno--dark {
    --bg:#161618; --fg:#ECE9E2; --acc:var(--gold,#C8A96E);
    --mut:rgba(236,233,226,.52); --bdr:rgba(236,233,226,.16);
    --btn-bg:#ECE9E2; --btn-fg:#161618; --wm:rgba(236,233,226,.05);
  }
  #section-{{ section.id }}.hno--warm {
    --bg:#E7DCCB; --fg:#241D15; --acc:var(--gold,#8E4F2A);
    --mut:rgba(36,29,21,.55); --bdr:rgba(36,29,21,.2);
    --btn-bg:#241D15; --btn-fg:#E7DCCB; --wm:rgba(36,29,21,.05);
  }
  #section-{{ section.id }}.hno--theme {
    --bg:var(--background,#161618); --fg:var(--foreground,#ECE9E2); --acc:var(--gold,#C8A96E);
    --mut:var(--muted,rgba(236,233,226,.52)); --bdr:var(--border,rgba(236,233,226,.16));
    --btn-bg:var(--gold,#C8A96E); --btn-fg:var(--black,#0A0A0A); --wm:rgba(236,233,226,.05);
  }

  #section-{{ section.id }} {
    position: relative; background: var(--bg); color: var(--fg);
    overflow: hidden; isolation: isolate;
    /* clears the absolute header + announcement bar */
    padding: clamp(118px, 15svh, 168px) 0 0 var(--side-padding,5vw);
  }

  /* Giant outlined watermark — depth layer */
  #section-{{ section.id }} .hno-watermark {
    position: absolute; z-index: 0; left: -1vw; bottom: clamp(40px, 8svh, 110px);
    font-family: var(--ff-display,'Cormorant Garamond',serif);
    font-size: clamp(110px, 20vw, 320px); font-weight: 300; line-height: 1;
    text-transform: uppercase; letter-spacing: .02em;
    color: transparent; -webkit-text-stroke: 1px var(--wm);
    pointer-events: none; user-select: none; white-space: nowrap;
  }

  #section-{{ section.id }} .hno-stage {
    position: relative; z-index: 1;
    display: grid;
    grid-template-columns: clamp(40px, 3.4vw, 64px) minmax(0, .96fr) minmax(0, 1.04fr);
    align-items: stretch;
    min-height: min(78svh, 860px);
  }

  /* — Vertical rail — */
  #section-{{ section.id }} .hno-rail {
    display: flex; flex-direction: column; align-items: center; gap: 18px;
    padding-bottom: clamp(24px, 4svh, 44px); justify-content: flex-end;
  }
  #section-{{ section.id }} .hno-rail__text {
    writing-mode: vertical-rl; transform: rotate(180deg);
    font-family: var(--ff-body,'Outfit',sans-serif); font-size: 10px; font-weight: 500;
    letter-spacing: .3em; text-transform: uppercase; color: var(--mut);
  }
  #section-{{ section.id }} .hno-rail__line { flex: 0 0 clamp(40px, 8svh, 90px); width: 1px; background: var(--acc); }
  #section-{{ section.id }} .hno-rail__num {
    font-family: var(--ff-display,'Cormorant Garamond',serif);
    font-size: clamp(22px, 2vw, 32px); color: var(--acc); line-height: 1;
  }

  /* — Copy — */
  #section-{{ section.id }} .hno-copy {
    display: flex; flex-direction: column; justify-content: center;
    padding: clamp(20px, 4svh, 48px) 0 clamp(28px, 5svh, 56px) clamp(10px, 1.6vw, 28px);
  }
  #section-{{ section.id }} .hno-season {
    font-family: var(--ff-body,'Outfit',sans-serif); font-size: 10px; font-weight: 500;
    letter-spacing: .3em; text-transform: uppercase; color: var(--mut);
    margin-bottom: clamp(14px, 2svh, 22px);
    animation: hnoUp{{ section.id }} .7s both;
  }
  #section-{{ section.id }} .hno-eyebrow {
    display: inline-flex; align-items: center; gap: 10px;
    font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: 11px; font-weight: 500; letter-spacing: .28em; text-transform: uppercase;
    color: var(--acc); margin-bottom: clamp(14px, 2.4svh, 24px);
    animation: hnoUp{{ section.id }} .7s .08s both;
  }
  #section-{{ section.id }} .hno-eyebrow::before { content:''; width: 26px; height: 1px; background: var(--acc); }

  /* Headline overlaps the image slab — magazine composition */
  #section-{{ section.id }} .hno-title {
    position: relative; z-index: 3;
    font-family: var(--ff-display,'Cormorant Garamond',serif); font-weight: 300;
    font-size: calc(clamp(44px, 6.8vw, 108px) * var(--heading-scale,1));
    line-height: .92; letter-spacing: .005em; text-transform: uppercase; margin: 0;
    margin-right: clamp(-140px, -8vw, -40px);
    pointer-events: none;
  }
  #section-{{ section.id }} .hno-title__l { display: block; animation: hnoUp{{ section.id }} .85s both; }
  #section-{{ section.id }} .hno-title__l:nth-child(1){ animation-delay:.14s; }
  #section-{{ section.id }} .hno-title__l:nth-child(2){ animation-delay:.26s; }
  #section-{{ section.id }} .hno-title__l:nth-child(3){ animation-delay:.38s; }
  #section-{{ section.id }} .hno-title__l--em { color: var(--acc); padding-left: clamp(18px, 2.6vw, 64px); }
  #section-{{ section.id }} .hno-title__l--em em { font-style: italic; }
  #section-{{ section.id }} .hno-title__l--push { padding-left: clamp(36px, 5vw, 120px); }

  #section-{{ section.id }} .hno-desc {
    font-family: var(--ff-body,'Outfit',sans-serif); font-size: clamp(14px, 1.05vw, 16px);
    line-height: 1.75; color: var(--mut); max-width: 400px;
    margin: clamp(20px, 3.2svh, 34px) 0 0; animation: hnoUp{{ section.id }} .85s .5s both;
  }
  #section-{{ section.id }} .hno-ctas { display: flex; align-items: center; flex-wrap: wrap; gap: 22px; margin-top: clamp(22px, 3.4svh, 34px); animation: hnoUp{{ section.id }} .85s .6s both; }
  #section-{{ section.id }} .hno-btn {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--ff-body,'Outfit',sans-serif); font-size: 11px; font-weight: 500;
    letter-spacing: .16em; text-transform: uppercase; text-decoration: none;
    transition: transform .22s, background .22s, color .22s, border-color .22s, box-shadow .22s;
  }
  #section-{{ section.id }} .hno-btn--solid { background: var(--btn-bg); color: var(--btn-fg); padding: 16px 32px; }
  #section-{{ section.id }} .hno-btn--solid:hover { transform: translateY(-2px); box-shadow: 0 16px 36px -16px rgba(0,0,0,.55); }
  #section-{{ section.id }} .hno-btn--under { color: var(--fg); border-bottom: 1px solid var(--acc); padding-bottom: 6px; }
  #section-{{ section.id }} .hno-btn--under:hover { color: var(--acc); }

  #section-{{ section.id }} .hno-scroll {
    display: inline-flex; align-items: center; gap: 12px;
    margin-top: clamp(28px, 5svh, 52px);
    font-family: var(--ff-body,'Outfit',sans-serif); font-size: 10px; font-weight: 500;
    letter-spacing: .26em; text-transform: uppercase; color: var(--mut);
    animation: hnoUp{{ section.id }} .85s .7s both;
  }
  #section-{{ section.id }} .hno-scroll__line { width: 44px; height: 1px; background: var(--acc); animation: hnoPulse{{ section.id }} 2.4s ease-in-out infinite; transform-origin: left; }

  /* — Cinematic slab: image runs to the right screen edge, no box — */
  #section-{{ section.id }} .hno-slab {
    position: relative; z-index: 1; overflow: hidden;
    animation: hnoFade{{ section.id }} 1.2s .15s both;
  }
  #section-{{ section.id }} .hno-slab__img {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; display: block;
    animation: hnoKen{{ section.id }} 18s ease-out forwards;
  }
  #section-{{ section.id }} .hno-slab__scrim {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(100deg, var(--bg) 0%, transparent 22%),
                linear-gradient(to top, rgba(10,10,11,.42), transparent 44%);
  }
  #section-{{ section.id }} .hno-slab__frame {
    position: absolute; z-index: 2; inset: clamp(12px, 1.6vw, 22px);
    border: 1px solid color-mix(in srgb, var(--acc) 62%, transparent);
    pointer-events: none;
  }
  #section-{{ section.id }} .hno-tag {
    position: absolute; z-index: 3; left: clamp(24px, 3vw, 44px); bottom: clamp(24px, 3.4vw, 44px);
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(16,16,17,.55);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(236,233,226,.22); color: #ECE9E2; padding: 10px 16px;
    font-family: var(--ff-body,'Outfit',sans-serif); font-size: 10px; font-weight: 500;
    letter-spacing: .2em; text-transform: uppercase;
  }
  #section-{{ section.id }} .hno-tag__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--acc); }

  /* — Ticker — */
  #section-{{ section.id }} .hno-ticker {
    position: relative; z-index: 2; overflow: hidden;
    border-top: 1px solid var(--bdr);
    margin-left: calc(-1 * var(--side-padding,5vw));
    padding: 13px 0;
  }
  #section-{{ section.id }} .hno-ticker__track { display: inline-flex; align-items: center; white-space: nowrap; animation: hnoMarq{{ section.id }} 28s linear infinite; }
  #section-{{ section.id }} .hno-ticker__track span {
    font-family: var(--ff-display,'Cormorant Garamond',serif); font-size: clamp(17px, 1.8vw, 26px);
    font-weight: 300; text-transform: uppercase; letter-spacing: .05em; padding: 0 22px; color: var(--fg); opacity: .8;
  }
  #section-{{ section.id }} .hno-ticker__sep { color: var(--acc) !important; font-size: 12px !important; opacity: 1 !important; }

  @keyframes hnoUp{{ section.id }}    { from { opacity:0; transform: translateY(26px);} to { opacity:1; transform:none; } }
  @keyframes hnoFade{{ section.id }}  { from { opacity:0;} to { opacity:1;} }
  @keyframes hnoKen{{ section.id }}   { from { transform: scale(1.07);} to { transform: scale(1);} }
  @keyframes hnoMarq{{ section.id }}  { from { transform: translateX(0);} to { transform: translateX(-50%);} }
  @keyframes hnoPulse{{ section.id }} { 0%,100% { transform: scaleX(.35); opacity:.5;} 50% { transform: scaleX(1); opacity:1;} }

  @media (max-width: 1100px) {
    #section-{{ section.id }} .hno-title { margin-right: 0; }
  }
  @media (max-width: 900px) {
    #section-{{ section.id }} { padding-top: clamp(108px, 14svh, 140px); }
    #section-{{ section.id }} .hno-stage { grid-template-columns: 1fr; min-height: 0; }
    #section-{{ section.id }} .hno-rail { display: none; }
    /* image first: full-bleed on both sides */
    #section-{{ section.id }} .hno-slab { order: -1; height: 52svh; margin-left: calc(-1 * var(--side-padding,5vw)); }
    #section-{{ section.id }} .hno-slab__scrim { background: linear-gradient(to top, rgba(10,10,11,.4), transparent 42%); }
    #section-{{ section.id }} .hno-copy { padding: 28px var(--side-padding,5vw) 34px 0; }
    #section-{{ section.id }} .hno-title__l--push { padding-left: clamp(18px, 6vw, 40px); }
    #section-{{ section.id }} .hno-watermark { display: none; }
    #section-{{ section.id }} .hno-scroll { display: none; }
  }
</style>

{% schema %}
{
  "name": "Hero Noir",
  "tag": "section",
  "class": "section-hero-noir",
  "settings": [
    {
      "type": "select", "id": "scheme", "label": "Color scheme",
      "options": [
        { "value": "light", "label": "Light (bone)" },
        { "value": "dark",  "label": "Dark (graphite)" },
        { "value": "warm",  "label": "Warm (sand)" },
        { "value": "theme", "label": "Follow theme" }
      ],
      "default": "dark"
    },
    { "type": "image_picker", "id": "image", "label": "Hero image (right slab)" },
    { "type": "header", "content": "Side rail & meta" },
    { "type": "text", "id": "meta_left",  "label": "Vertical rail text",  "default": "Maison Noir — The Collection" },
    { "type": "text", "id": "index_label", "label": "Rail index number", "default": "04" },
    { "type": "text", "id": "meta_right", "label": "Season line (above eyebrow)", "default": "Autumn / Winter 2025" },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Noir Edit" },
    { "type": "text", "id": "heading_line1", "label": "Headline line 1", "default": "Form" },
    { "type": "text", "id": "heading_line2", "label": "Headline line 2 (accent, italic)", "default": "Meets" },
    { "type": "text", "id": "heading_line3", "label": "Headline line 3", "default": "Function" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Sharp tailoring and uncompromising lines. A modern wardrobe built on contrast — architectural, deliberate, and quietly powerful." },
    { "type": "text", "id": "btn1_label", "label": "Primary button", "default": "Shop the Collection" },
    { "type": "url",  "id": "btn1_link",  "label": "Primary button link" },
    { "type": "text", "id": "btn2_label", "label": "Secondary link", "default": "View Lookbook" },
    { "type": "url",  "id": "btn2_link",  "label": "Secondary link URL" },
    { "type": "text", "id": "scroll_label", "label": "Scroll cue label", "default": "Scroll" },
    { "type": "header", "content": "Accents" },
    { "type": "text", "id": "watermark",   "label": "Watermark word (outlined, background)", "default": "Noir" },
    { "type": "text", "id": "tag_label",   "label": "Floating image tag", "default": "New Arrivals" },
    { "type": "header", "content": "Bottom ticker" },
    { "type": "text", "id": "ticker", "label": "Ticker phrase", "default": "Made to Last" }
  ],
  "presets": [ { "name": "Hero Noir" } ]
}
{% endschema %}
