<section class="section recently-viewed" id="section-{{ section.id }}">
  <div class="container recently-viewed__inner" style="display:none;">
    <div class="section-head">
      <h2 class="section-head__title">{{ section.settings.heading }}</h2>
    </div>
    <div class="product-grid product-grid--{{ section.settings.columns }}"></div>
  </div>
</section>

<style>
  .recently-viewed { padding: var(--section-spacing) 0; border-top: 1px solid var(--border, rgba(200,169,110,.18)); }
</style>

<script>
  // Recently viewed: handles kept in localStorage, each card rendered by
  // Shopify through the product.mn-card template, so it matches every other
  // product card (Theme settings → Product cards).
  (function() {
    const KEY = 'mn_recent';
    const current = {{ product.handle | json }};
    const limit = {{ section.settings.products_to_show }};
    let seen = [];
    try { seen = JSON.parse(localStorage.getItem(KEY) || '[]').filter(h => typeof h === 'string'); } catch (e) {}
    seen = seen.filter(h => h !== current);
    if (current) {
      try { localStorage.setItem(KEY, JSON.stringify([current].concat(seen).slice(0, 12))); } catch (e) {}
    }
    const show = seen.slice(0, limit);
    const container = document.querySelector('#section-{{ section.id }} .recently-viewed__inner');
    const grid = document.querySelector('#section-{{ section.id }} .product-grid');
    if (!show.length || !container || !grid) return;
    const root = ((window.routes && window.routes.root_url) || '/').replace(/\/?$/, '/');
    Promise.all(show.map(h => fetch(`${root}products/${encodeURIComponent(h)}?view=mn-card`).then(r => (r.ok ? r.text() : '')).catch(() => '')))
      .then(cards => {
        grid.innerHTML = cards.filter(c => c.includes('data-pcard')).join('');
        if (grid.children.length) container.style.display = '';
      });
  })();
</script>

{% schema %}
{
  "name": "Recently Viewed",
  "tag": "section",
  "settings": [
    { "type": "text",  "id": "heading",          "label": "Heading",          "default": "Recently Viewed" },
    { "type": "range", "id": "products_to_show", "label": "Products to Show", "min": 2, "max": 6, "step": 1, "default": 4 },
    {
      "type": "select", "id": "columns", "label": "Columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    }
  ],
  "presets": [{ "name": "Recently Viewed" }]
}
{% endschema %}
