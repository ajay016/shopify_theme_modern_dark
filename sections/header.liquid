{%- liquid
  assign header_style    = settings.header_style | default: 'v1'
  assign mega_style      = settings.mega_menu_style | default: 'v1'
  assign mega_images     = settings.mega_menu_images
  assign is_transparent  = settings.header_transparent_home
  assign is_sticky       = settings.header_sticky
  assign menu            = linklists[settings.menu]
  assign logo            = settings.logo
  assign logo_width      = settings.logo_width
  assign logo_text       = settings.logo_text
  assign show_wishlist   = settings.wishlist_enabled
  assign cart_type       = settings.cart_type

  assign transparent_class = ''
  if is_transparent and request.page_type == 'index'
    assign transparent_class = ' is-transparent'
  endif
-%}

{%- comment -%}
  Four header styles (Theme settings → Header → Header style):
    v1  Classic   logo left, menu centred, icons right
    v2  Centred   logo centred above a full-width menu row, search pill left
    v3  Minimal   menu button left, logo centred, icons right; the menu
                  opens as a drawer at every width
    v4  Floating  the Classic layout in an inset, rounded bar
  The mobile menu drawer below serves every style on small screens.
{%- endcomment -%}
<header
  class="site-header header-{{ header_style }}{{ transparent_class }}{% if is_sticky %} is-sticky{% endif %}"
  data-transparent="{{ is_transparent }}"
  data-hide-on-scroll="{{ settings.header_hide_on_scroll }}"
  role="banner"
>
  <div class="site-header__bar">
    {%- capture burger -%}
      <button
        class="header-icon-btn header-burger{% unless header_style == 'v3' %} header-burger--mobile{% endunless %}"
        data-open-mobile-menu
        aria-label="{{ 'accessibility.open_nav' | t }}"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        {%- render 'icon-menu' -%}
        {%- if header_style == 'v3' -%}<span class="header-burger__label">{{ 'accessibility.menu' | t }}</span>{%- endif -%}
      </button>
    {%- endcapture -%}

    {%- case header_style -%}
      {%- when 'v2' -%}
        <div class="site-header__start">
          {{ burger }}
          <button class="header-search-pill" data-open-search aria-label="{{ 'accessibility.open_search' | t }}" aria-expanded="false" aria-controls="search-overlay">
            {%- render 'icon-search' -%}<span>{{ 'general.search.title' | t }}</span>
          </button>
        </div>
        <div class="site-header__brand">
          {%- render 'header-logo', logo: logo, logo_width: logo_width, logo_text: logo_text -%}
        </div>
        <div class="site-header__end">
          {%- render 'header-actions', show_wishlist: show_wishlist, cart_type: cart_type, hide_search: true -%}
        </div>

      {%- when 'v3' -%}
        <div class="site-header__start">{{ burger }}</div>
        <div class="site-header__brand">
          {%- render 'header-logo', logo: logo, logo_width: logo_width, logo_text: logo_text -%}
        </div>
        <div class="site-header__end">
          {%- render 'header-actions', show_wishlist: show_wishlist, cart_type: cart_type -%}
        </div>

      {%- else -%}
        <div class="site-header__start">
          {{ burger }}
          {%- render 'header-logo', logo: logo, logo_width: logo_width, logo_text: logo_text -%}
        </div>
        {%- render 'header-nav', menu: menu, blocks: section.blocks, mega_style: mega_style, images: mega_images -%}
        <div class="site-header__end">
          {%- render 'header-actions', show_wishlist: show_wishlist, cart_type: cart_type -%}
        </div>
    {%- endcase -%}
  </div>

  {%- if header_style == 'v2' -%}
    <div class="site-header__row">
      {%- render 'header-nav', menu: menu, blocks: section.blocks, mega_style: mega_style, images: mega_images, align: 'center' -%}
    </div>
  {%- endif -%}
</header>

{%- comment -%}Mobile menu (every style on small screens; the Minimal style at every width){%- endcomment -%}
<div id="mobile-menu-overlay" class="mobile-menu-overlay" aria-hidden="true"></div>

<div
  id="mobile-menu"
  class="mobile-menu"
  role="dialog"
  aria-modal="true"
  aria-label="{{ 'accessibility.menu' | t }}"
  tabindex="-1"
>
  <div class="mobile-menu__header">
    {%- render 'header-logo', logo: logo, logo_width: logo_width, logo_text: logo_text -%}
    <button data-close-mobile-menu class="header-icon-btn" aria-label="{{ 'accessibility.close_menu' | t }}">
      {%- render 'icon-close' -%}
    </button>
  </div>

  <ul class="mobile-menu__nav" role="list">
    {%- for link in menu.links -%}
      {%- assign top = forloop.index -%}
      <li>
        {%- if link.links.size > 0 -%}
          {%- comment -%}
            One data-toggle-submenu attribute. There were two -- an empty one
            first -- and the browser keeps the first, so no submenu could open.
          {%- endcomment -%}
          <button
            class="mobile-menu__toggle"
            data-toggle-submenu="mobile-sub-{{ top }}"
            aria-expanded="false"
            aria-controls="mobile-sub-{{ top }}"
          >
            <span>{{ link.title }}</span>
            <svg class="submenu-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <ul id="mobile-sub-{{ top }}" class="mobile-menu__subnav" role="list">
            <li><a href="{{ link.url }}" class="mobile-menu__all">{{ 'general.view_all' | t }}</a></li>
            {%- for childlink in link.links -%}
              <li>
                {%- if childlink.links.size > 0 -%}
                  <button
                    class="mobile-menu__toggle mobile-menu__toggle--child"
                    data-toggle-submenu="mobile-sub-{{ top }}-{{ forloop.index }}"
                    aria-expanded="false"
                    aria-controls="mobile-sub-{{ top }}-{{ forloop.index }}"
                  >
                    <span>{{ childlink.title }}</span>
                    <svg class="submenu-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                  </button>
                  <ul id="mobile-sub-{{ top }}-{{ forloop.index }}" class="mobile-menu__subnav mobile-menu__subnav--deep" role="list">
                    <li><a href="{{ childlink.url }}" class="mobile-menu__all">{{ 'general.view_all' | t }}</a></li>
                    {%- for grandchild in childlink.links -%}
                      <li><a href="{{ grandchild.url }}"{% if grandchild.active %} aria-current="page"{% endif %}>{{ grandchild.title }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- else -%}
                  <a href="{{ childlink.url }}"{% if childlink.active %} aria-current="page"{% endif %}>{{ childlink.title }}</a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- else -%}
          <a href="{{ link.url }}" class="mobile-menu__link"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>

  <div class="mobile-menu__footer">
    {%- if shop.customer_accounts_enabled -%}
      <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="mobile-menu__account">
        {%- render 'icon-account' -%}
        <span>{{ 'customer.account.title' | t }}</span>
      </a>
    {%- endif -%}
    <div class="mobile-menu__social">
      {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}">Instagram</a>{%- endif -%}
      {%- if settings.social_pinterest != blank -%}<a href="{{ settings.social_pinterest }}">Pinterest</a>{%- endif -%}
      {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}">TikTok</a>{%- endif -%}
    </div>
  </div>
</div>

{%- comment -%}Search Overlay{%- endcomment -%}
<div
  id="search-overlay"
  class="search-overlay"
  role="dialog"
  aria-modal="true"
  aria-label="{{ 'search.title' | t }}"
>
  <button
    data-close-search
    class="search-overlay__close"
    aria-label="{{ 'accessibility.close_search' | t }}"
  >
    {%- render 'icon-close' -%}
  </button>

  <form class="search-overlay__field" action="{{ routes.search_url }}" method="get" role="search">
    <input
      type="search"
      name="q"
      class="search-overlay__input"
      placeholder="{{ 'search.placeholder' | t }}"
      autocomplete="off"
      aria-label="{{ 'search.title' | t }}"
    >
    <input type="hidden" name="type" value="product">
    <button type="submit" class="search-overlay__submit" aria-label="{{ 'general.search.submit' | t }}">
      {%- render 'icon-search' -%}
    </button>
  </form>

  <div class="search-overlay__results" id="search-results" aria-live="polite">
    <p class="search-overlay__hint">{{ 'search.placeholder' | t }}</p>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "class": "header-section",
  "limit": 1,
  "settings": [
    {
      "type": "paragraph",
      "content": "Configure header style, logo, navigation, and transparency in Theme Settings → Header."
    }
  ],
  "blocks": [
    {
      "type": "mega_menu_item",
      "name": "Mega Menu Item",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "menu_item",
          "label": "Navigation link title (exact match)",
          "info": "Must match the menu link title exactly (case-insensitive)."
        },
        {
          "type": "header",
          "content": "Featured Image / Card"
        },
        {
          "type": "image_picker",
          "id": "featured_image",
          "label": "Featured image"
        },
        {
          "type": "text",
          "id": "featured_label",
          "label": "Image label",
          "default": "New Arrival"
        },
        {
          "type": "text",
          "id": "featured_title",
          "label": "Image title",
          "default": "SS 2025"
        },
        {
          "type": "url",
          "id": "featured_link",
          "label": "Image link"
        },
        {
          "type": "header",
          "content": "Promo Banner (Mega Menu 3)"
        },
        {
          "type": "image_picker",
          "id": "promo_image",
          "label": "Promo image"
        },
        {
          "type": "text",
          "id": "promo_title",
          "label": "Promo title"
        },
        {
          "type": "text",
          "id": "promo_label",
          "label": "Promo label",
          "default": "Shop Now →"
        },
        {
          "type": "url",
          "id": "promo_link",
          "label": "Promo link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}
