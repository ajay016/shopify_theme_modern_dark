{%- comment -%}Strings for assets/mn-product.js (product page and quick view). Accepts: atc (button label){%- endcomment -%}
<script type="application/json" data-pdp-strings>{
    "atc": {{ atc | default: 'Add to bag' | json }},
    "adding": {{ 'mn.pdp.adding' | t | json }},
    "added": {{ 'mn.pdp.added' | t | json }},
    "soldout_notify": {{ 'mn.pdp.soldout_notify' | t | json }},
    "unavailable": {{ 'mn.pdp.unavailable' | t | json }},
    "tip_soldout": {{ 'mn.pdp.tip_soldout' | t: v: '__V__' | json }},
    "tip_unavailable": {{ 'mn.pdp.tip_unavailable' | t: v: '__V__' | json }},
    "meta_soldout": {{ 'mn.pdp.meta_soldout' | t | json }},
    "meta_unavailable": {{ 'mn.pdp.meta_unavailable' | t | json }},
    "only_left": {{ 'mn.pdp.only_left' | t: n: '__N__' | json }},
    "stock_in": {{ 'mn.pdp.stock_in_html' | t: v: '__V__' | json }},
    "stock_in_plain": {{ 'mn.pdp.stock_in_plain_html' | t | json }},
    "stock_low": {{ 'mn.pdp.stock_low_html' | t: n: '__N__', v: '__V__' | json }},
    "stock_out": {{ 'mn.pdp.stock_out_html' | t: v: '__V__' | json }},
    "stock_digital": {{ 'mn.pdp.stock_digital_html' | t | json }},
    "unit": {{ 'mn.pdp.unit' | t: price: '__P__', ref: '__R__' | json }},
    "new": {{ 'products.product.new_badge' | t | json }},
    "sale": {{ 'products.product.sale_badge' | t | json }},
    "soldout": {{ 'products.product.sold_out_badge' | t | json }},
    "low": {{ 'mn.card.low' | t | json }},
    "size_guide": {{ 'mn.pdp.size_guide' | t | json }},
    "compare_colours": {{ 'mn.pdp.compare_colours' | t | json }},
    "selected": {{ 'mn.pdp.selected' | t | json }},
    "current_colour": {{ 'mn.pdp.current_colour' | t | json }},
    "choose_colour": {{ 'mn.pdp.choose_colour' | t: v: '__V__' | json }},
    "copied": {{ 'mn.pdp.copied' | t | json }},
    "link_copied": {{ 'mn.pdp.link_copied' | t | json }},
    "notify_done": {{ 'mn.pdp.notify_done' | t: v: '__V__' | json }},
    "notify_body": {{ 'mn.pdp.notify_body' | t: v: '__V__' | json }},
    "ask_body": {{ 'mn.pdp.ask_body' | t: v: '__V__' | json }},
    "in_compare": {{ 'mn.pdp.in_compare' | t | json }},
    "compare": {{ 'mn.pdp.compare' | t | json }},
    "quantity": {{ 'cart.quantity' | t | json }}
  }</script>
