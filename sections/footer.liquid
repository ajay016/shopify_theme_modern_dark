{%- liquid
  assign style = settings.footer_style | default: 'columns'
  assign tone = settings.footer_tone | default: 'soft'
  assign show_news = settings.footer_newsletter
  assign wordmark = settings.footer_wordmark | default: settings.logo_text | default: shop.name

  assign socials = 'instagram,pinterest,tiktok,facebook,x' | split: ','
  assign has_social = false
  if settings.social_instagram != blank or settings.social_pinterest != blank or settings.social_tiktok != blank or settings.social_facebook != blank or settings.social_twitter != blank
    assign has_social = true
  endif
-%}

{%- comment -%}
  Three footer styles (Theme settings → Footer → Footer style):
    columns    brand, newsletter and social on the left; link columns right
    statement  a newsletter band on top, columns, and an oversized wordmark
    minimal    centred: logo, one row of links, social, compact newsletter
  Colours come from the scheme's tonal ladder (Footer surface), never a
  fixed cream, which was unreadable on the light schemes. On phones the
  link columns fold into accordions.
{%- endcomment -%}

{%- capture logo_markup -%}
  <a href="{{ routes.root_url }}" class="site-footer__logo" aria-label="{{ shop.name | escape }}">
    {%- if settings.footer_logo != blank -%}
      {{ settings.footer_logo | image_url: width: 320 | image_tag: loading: 'lazy', alt: shop.name, width: 160, height: settings.footer_logo.height | times: 160 | divided_by: settings.footer_logo.width }}
    {%- elsif settings.logo != blank -%}
      {{ settings.logo | image_url: width: 320 | image_tag: loading: 'lazy', alt: shop.name, width: 160, height: settings.logo.height | times: 160 | divided_by: settings.logo.width }}
    {%- else -%}
      {{ settings.logo_text | default: shop.name }}
    {%- endif -%}
  </a>
{%- endcapture -%}

{%- capture social_markup -%}
  {%- if has_social -%}
    <ul class="footer-social" role="list" aria-label="{{ 'footer.follow' | t }}">
      {%- for name in socials -%}
        {%- liquid
          assign key = 'social_' | append: name
          if name == 'x'
            assign key = 'social_twitter'
          endif
          assign url = settings[key]
        -%}
        {%- if url != blank -%}
          <li><a href="{{ url }}" target="_blank" rel="noopener" aria-label="{{ name | capitalize | replace: 'X', 'X (Twitter)' }}">{%- render 'icon-social', name: name -%}</a></li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  {%- endif -%}
{%- endcapture -%}

{%- capture news_markup -%}
  {%- if show_news -%}
    <div class="footer-news">
      {%- if settings.footer_newsletter_heading != blank -%}
        <p class="footer-news__heading">{{ settings.footer_newsletter_heading }}</p>
      {%- endif -%}
      {%- if settings.footer_newsletter_text != blank -%}
        <p class="footer-news__text">{{ settings.footer_newsletter_text }}</p>
      {%- endif -%}
      {%- form 'customer', id: 'FooterNewsletter', class: 'footer-news__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="footer-news__note" role="status">{{ 'newsletter.success' | t }}</p>
        {%- else -%}
          <div class="footer-news__row">
            <label for="FooterNewsletterEmail" class="visually-hidden">{{ 'newsletter.label' | t }}</label>
            <input id="FooterNewsletterEmail" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.placeholder' | t }}">
            <button type="submit" class="footer-news__submit">{{ 'newsletter.button' | t }}</button>
          </div>
          {%- if form.errors -%}<p class="footer-news__note footer-news__note--error" role="alert">{{ 'newsletter.error' | t }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
  {%- endif -%}
{%- endcapture -%}

{%- capture menus_markup -%}
  {%- for i in (1..3) -%}
    {%- liquid
      assign handle_key = 'footer_menu_' | append: i
      assign title_key = 'footer_menu_' | append: i | append: '_title'
      assign menu = linklists[settings[handle_key]]
      assign title = settings[title_key]
    -%}
    {%- if menu.links.size > 0 -%}
      <div class="footer-col" data-footer-col>
        <button type="button" class="footer-col__title" aria-expanded="false" aria-controls="FooterCol{{ i }}">
          <span>{{ title | default: menu.title }}</span>
          <svg class="footer-col__chev" width="12" height="8" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <ul class="footer-col__list" id="FooterCol{{ i }}" role="list">
          {%- for link in menu.links -%}
            <li><a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

<footer class="site-footer site-footer--{{ style }} site-footer--tone-{{ tone }}" role="contentinfo">
  <div class="site-footer__inner">

    {%- case style -%}
      {%- when 'statement' -%}
        {%- if show_news -%}
          <div class="site-footer__band">{{ news_markup }}</div>
        {%- endif -%}
        <div class="site-footer__main">
          <div class="site-footer__brand">
            {%- if settings.footer_description != blank -%}<div class="site-footer__desc">{{ settings.footer_description }}</div>{%- endif -%}
            {{ social_markup }}
          </div>
          <div class="site-footer__menus">{{ menus_markup }}</div>
        </div>
        <p class="site-footer__wordmark" aria-hidden="true">{{ wordmark }}</p>

      {%- when 'minimal' -%}
        <div class="site-footer__center">
          {{ logo_markup }}
          {%- if settings.footer_description != blank -%}<div class="site-footer__desc">{{ settings.footer_description }}</div>{%- endif -%}
          {%- assign first_menu = linklists[settings.footer_menu_1] -%}
          {%- if first_menu.links.size > 0 -%}
            <nav class="site-footer__inline" aria-label="{{ settings.footer_menu_1_title | default: first_menu.title | escape }}">
              {%- for link in first_menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
            </nav>
          {%- endif -%}
          {{ news_markup }}
          {{ social_markup }}
        </div>

      {%- else -%}
        <div class="site-footer__main">
          <div class="site-footer__brand">
            {{ logo_markup }}
            {%- if settings.footer_description != blank -%}<div class="site-footer__desc">{{ settings.footer_description }}</div>{%- endif -%}
            {{ news_markup }}
            {{ social_markup }}
          </div>
          <div class="site-footer__menus">{{ menus_markup }}</div>
        </div>
    {%- endcase -%}

    <div class="site-footer__bottom">
      <p class="site-footer__copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'footer.rights' | t }}</p>

      {%- if settings.footer_show_localization -%}
        {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
          {%- form 'localization', id: 'FooterLocalization', class: 'site-footer__locale' -%}
            {%- if localization.available_countries.size > 1 -%}
              <div class="site-footer__locale-field">
                <label for="FooterCountry" class="visually-hidden">{{ 'localization.country' | t }}</label>
                <select id="FooterCountry" name="country_code" onchange="this.form.submit()">
                  {%- for country in localization.available_countries -%}
                    <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})</option>
                  {%- endfor -%}
                </select>
              </div>
            {%- endif -%}
            {%- if localization.available_languages.size > 1 -%}
              <div class="site-footer__locale-field">
                <label for="FooterLanguage" class="visually-hidden">{{ 'localization.language' | t }}</label>
                <select id="FooterLanguage" name="language_code" onchange="this.form.submit()">
                  {%- for language in localization.available_languages -%}
                    <option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>{{ language.endonym_name | capitalize }}</option>
                  {%- endfor -%}
                </select>
              </div>
            {%- endif -%}
          {%- endform -%}
        {%- endif -%}
      {%- endif -%}

      {%- if settings.footer_show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="site-footer__payment" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if settings.footer_back_to_top -%}
        <button type="button" class="site-footer__top-btn" data-back-to-top>
          {{ 'footer.back_to_top' | t }}
          <svg width="10" height="12" viewBox="0 0 10 12" fill="none" aria-hidden="true"><path d="M5 11V1M1 5l4-4 4 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "footer-section",
  "limit": 1,
  "settings": [
    {
      "type": "paragraph",
      "content": "Configure the footer style, surface, logo, newsletter, menus, social links, country and language selectors and payment icons in Theme Settings → Footer."
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
