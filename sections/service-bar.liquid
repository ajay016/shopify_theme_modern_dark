{%- liquid
  assign s = section.settings
-%}

<section
  id="section-{{ section.id }}"
  class="svb svb--{{ s.scheme }}"
  data-section-id="{{ section.id }}"
>
  <div class="svb-track">
    {%- for block in section.blocks -%}
      <div class="svb-item" {{ block.shopify_attributes }}>
        <span class="svb-icon" aria-hidden="true">
          {%- case block.settings.icon -%}
            {%- when 'delivery' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v10H3z"/><path d="M14 10h4l3 3v4h-7z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg>
            {%- when 'returns' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 14 4 9l5-5"/><path d="M4 9h10a6 6 0 0 1 0 12H8"/></svg>
            {%- when 'appointment' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="1.5"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
            {%- when 'service' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 1 0-3.2 6.4L21 20z"/></svg>
            {%- when 'secure' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="11" rx="1.5"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L19 8"/></svg>
          {%- endcase -%}
        </span>
        <span class="svb-label">{{ block.settings.label }}</span>
      </div>
    {%- endfor -%}
  </div>
</section>

<style>
  #section-{{ section.id }}.svb--light { --bg:var(--s2-bg,#131313); --fg:var(--s2-fg,#F5F0E8); --acc:var(--gold,#C8A96E); --bdr:var(--s2-bdr,rgba(245,240,232,.16)); }
  #section-{{ section.id }}.svb--dark  { --bg:var(--s1-bg,#0A0A0A); --fg:var(--s1-fg,#F5F0E8); --acc:var(--gold,#C8A96E); --bdr:var(--s1-bdr,rgba(245,240,232,.16)); }
  #section-{{ section.id }}.svb--warm  { --bg:var(--s3-bg,#1A1714); --fg:var(--s3-fg,#F5F0E8); --acc:var(--gold,#C8A96E); --bdr:var(--s3-bdr,rgba(245,240,232,.16)); }
  #section-{{ section.id }}.svb--theme { --bg:var(--s1-bg,#0A0A0A); --fg:var(--s1-fg,#F5F0E8); --acc:var(--gold,#C8A96E); --bdr:var(--s1-bdr,rgba(245,240,232,.16)); }

  #section-{{ section.id }} {
    background: var(--bg);
    color: var(--fg);
    border-top: 1px solid var(--bdr);
    border-bottom: 1px solid var(--bdr);
  }
  #section-{{ section.id }} .svb-track {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, minmax(0, 1fr));
  }
  #section-{{ section.id }} .svb-item {
    display: flex; align-items: center; justify-content: center; gap: 11px;
    min-height: 66px; padding: 14px 20px;
    border-right: 1px solid var(--bdr);
    text-align: center;
  }
  #section-{{ section.id }} .svb-item:last-child { border-right: 0; }
  #section-{{ section.id }} .svb-icon { display: inline-flex; flex: 0 0 auto; color: var(--acc); }
  #section-{{ section.id }} .svb-icon svg { width: 19px; height: 19px; display: block; }
  #section-{{ section.id }} .svb-label {
    font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: calc(12px * var(--fs-scale, 1));
    font-weight: 600; letter-spacing: .14em; text-transform: uppercase;
    line-height: 1.35;
  }

  @media (max-width: 900px) {
    #section-{{ section.id }} .svb-track {
      display: flex; overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    #section-{{ section.id }} .svb-track::-webkit-scrollbar { display: none; }
    #section-{{ section.id }} .svb-item {
      flex: 0 0 auto; min-width: 62vw; scroll-snap-align: start;
      justify-content: flex-start;
    }
  }
  @media (max-width: 560px) {
    #section-{{ section.id }} .svb-item { min-width: 76vw; min-height: 58px; }
  }
</style>

{% schema %}
{
  "name": "Service Bar",
  "tag": "section",
  "class": "section-service-bar",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select", "id": "scheme", "label": "Surface tone",
      "options": [
        { "value": "light", "label": "Alternate surface (soft)" },
        { "value": "dark",  "label": "Primary surface" },
        { "value": "warm",  "label": "Deep surface" },
        { "value": "theme", "label": "Primary surface (follow theme)" }
      ],
      "default": "light"
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon",
          "options": [
            { "value": "delivery", "label": "Delivery" },
            { "value": "returns", "label": "Returns" },
            { "value": "appointment", "label": "Appointment" },
            { "value": "service", "label": "Client service" },
            { "value": "secure", "label": "Secure" },
            { "value": "check", "label": "Check" }
          ],
          "default": "delivery"
        },
        { "type": "text", "id": "label", "label": "Label", "default": "Complimentary delivery" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Service Bar",
      "blocks": [
        { "type": "service", "settings": { "icon": "delivery", "label": "Complimentary delivery" } },
        { "type": "service", "settings": { "icon": "returns", "label": "Returns within 30 days" } },
        { "type": "service", "settings": { "icon": "appointment", "label": "Private appointments" } },
        { "type": "service", "settings": { "icon": "service", "label": "Client services" } }
      ]
    }
  ]
}
{% endschema %}
