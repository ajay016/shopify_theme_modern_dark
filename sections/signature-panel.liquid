{%- liquid
  assign s = section.settings
  assign fallback = 'https://images.unsplash.com/photo-1539109136881-3be0616acf4b?auto=format&fit=crop&w=1600&q=85'
-%}

<section
  id="section-{{ section.id }}"
  class="sigp sigp--{{ s.scheme }} sigp--panel-{{ s.panel_fill }}"
  data-section-id="{{ section.id }}"
>
  <div class="sigp-inner">
    <div class="sigp-grid">
      <div class="sigp-panel reveal">
        <div>
          {%- if s.eyebrow != blank -%}<p class="sigp-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
          {%- if s.heading != blank -%}<h2 class="sigp-heading">{{ s.heading }}</h2>{%- endif -%}
        </div>
        <div class="sigp-panel__foot">
          {%- if s.description != blank -%}<p class="sigp-desc">{{ s.description }}</p>{%- endif -%}
          {%- if s.btn_label != blank -%}
            <a class="sigp-btn" href="{{ s.btn_link | default: '/collections/all' }}">{{ s.btn_label }}</a>
          {%- endif -%}
        </div>
      </div>

      <div class="sigp-media reveal">
        {%- if s.image != blank -%}
          {{ s.image | image_url: width: 1800 | image_tag: loading: 'lazy', class: 'sigp-img', sizes: '(max-width: 900px) 100vw, 62vw', widths: '800,1200,1800', alt: s.heading }}
        {%- else -%}
          <img class="sigp-img" src="{{ fallback }}" alt="{{ s.heading }}" loading="lazy" />
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  #section-{{ section.id }}.sigp--light { --bg:var(--s2-bg,#131313); --fg:var(--s2-fg,#F5F0E8); }
  #section-{{ section.id }}.sigp--dark  { --bg:var(--s1-bg,#0A0A0A); --fg:var(--s1-fg,#F5F0E8); }
  #section-{{ section.id }}.sigp--warm  { --bg:var(--s3-bg,#1A1714); --fg:var(--s3-fg,#F5F0E8); }
  #section-{{ section.id }}.sigp--theme { --bg:var(--s1-bg,#0A0A0A); --fg:var(--s1-fg,#F5F0E8); }

  /* The panel always takes a background/foreground PAIR that the scheme
     ships together, so it can never produce an unreadable combination —
     and the button simply inverts that same pair. */
  #section-{{ section.id }}.sigp--panel-accent   { --pbg: var(--gold, #C8A96E);  --pfg: var(--on-gold, #0A0A0A); }
  #section-{{ section.id }}.sigp--panel-contrast { --pbg: var(--s4-bg, #F5F0E8); --pfg: var(--s4-fg, #0A0A0A); }

  #section-{{ section.id }} { background: var(--bg); color: var(--fg); padding: clamp(20px,3vh,32px) 0 clamp(72px,9vh,112px); }
  #section-{{ section.id }} .sigp-inner { padding: 0 var(--side-padding,5vw); }
  #section-{{ section.id }} .sigp-grid { display: grid; grid-template-columns: .78fr 1.22fr; gap: 10px; }

  #section-{{ section.id }} .sigp-panel {
    display: flex; flex-direction: column;
    align-items: flex-start; justify-content: space-between;
    min-height: clamp(520px,66vh,660px);
    padding: clamp(34px,3.4vw,52px);
    background: var(--pbg); color: var(--pfg);
  }
  #section-{{ section.id }} .sigp-eyebrow {
    margin: 0 0 14px;
    font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: calc(12px * var(--fs-scale, 1));
    font-weight: 600; letter-spacing: .22em; text-transform: uppercase;
    color: currentColor;
  }
  #section-{{ section.id }} .sigp-heading {
    margin: 0;
    font-family: var(--ff-display,'Cormorant Garamond',serif);
    font-weight: 300;
    font-size: calc(clamp(36px,4.4vw,58px) * var(--heading-scale,1));
    line-height: 1.02;
  }
  #section-{{ section.id }} .sigp-panel__foot { margin-top: clamp(30px,5vh,52px); }
  #section-{{ section.id }} .sigp-desc {
    max-width: 350px; margin: 0 0 28px;
    font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: calc(15px * var(--fs-scale, 1));
    line-height: 1.66; color: currentColor; opacity: .86;
  }
  #section-{{ section.id }} .sigp-btn {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 48px; padding: 0 28px;
    font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: calc(12px * var(--fs-scale, 1));
    font-weight: 600; letter-spacing: .16em; text-transform: uppercase;
    text-decoration: none;
    background: var(--pfg); color: var(--pbg);
    border: 1px solid var(--pfg);
    transition: background .22s ease, color .22s ease;
  }
  #section-{{ section.id }} .sigp-btn:hover { background: transparent; color: var(--pfg); }

  #section-{{ section.id }} .sigp-media {
    min-height: clamp(520px,66vh,660px); overflow: hidden;
    background: var(--img-placeholder, #1A1714);
  }
  #section-{{ section.id }} .sigp-img {
    display: block; width: 100%; height: 100%;
    object-fit: cover; object-position: center 28%;
    filter: saturate(.62);
  }

  #section-{{ section.id }} .reveal.reveal-armed { opacity: 0; transform: translateY(22px); transition: opacity .75s ease, transform .75s ease; }
  #section-{{ section.id }} .reveal.is-visible { opacity: 1; transform: none; }

  @media (max-width: 900px) {
    #section-{{ section.id }} .sigp-grid { grid-template-columns: 1fr; }
    #section-{{ section.id }} .sigp-media { order: -1; min-height: 460px; }
    #section-{{ section.id }} .sigp-panel { min-height: 0; padding: clamp(32px,7vw,44px); }
    #section-{{ section.id }} .sigp-panel__foot { margin-top: 28px; }
    #section-{{ section.id }} .sigp-btn { width: 100%; }
  }
</style>

<script>
(function(){
  var SEC='{{ section.id }}';
  function arm(root){
    var els=root.querySelectorAll('.reveal');
    els.forEach(function(el){el.classList.add('reveal-armed');});
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('is-visible');io.unobserve(e.target);}});},{threshold:.12});
    els.forEach(function(el){io.observe(el);});
    setTimeout(function(){els.forEach(function(el){el.classList.add('is-visible');});},800);
  }
  function root(){return document.getElementById('section-'+SEC);}
  document.addEventListener('DOMContentLoaded',function(){var r=root();if(r)arm(r);});
  document.addEventListener('shopify:section:load',function(e){if(e.detail.sectionId!==SEC)return;var r=root();if(r){arm(r);r.querySelectorAll('.reveal').forEach(function(el){el.classList.add('is-visible');});}});
})();
</script>

{% schema %}
{
  "name": "Signature Panel",
  "tag": "section",
  "class": "section-signature-panel",
  "settings": [
    {
      "type": "select", "id": "scheme", "label": "Surface tone",
      "options": [
        { "value": "light", "label": "Alternate surface (soft)" },
        { "value": "dark",  "label": "Primary surface" },
        { "value": "warm",  "label": "Deep surface" },
        { "value": "theme", "label": "Primary surface (follow theme)" }
      ],
      "default": "dark"
    },
    {
      "type": "select", "id": "panel_fill", "label": "Panel fill",
      "info": "Accent uses the scheme's accent colour. Contrast uses the scheme's inverted band.",
      "options": [
        { "value": "accent",   "label": "Accent" },
        { "value": "contrast", "label": "Contrast band" }
      ],
      "default": "accent"
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Maison signatures" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The enduring silhouette" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "One coat. A measured shoulder. A line that falls cleanly through the body. Designed as a foundation, not a statement for one season." },
    { "type": "text", "id": "btn_label", "label": "Button label", "default": "Shop outerwear" },
    { "type": "url",  "id": "btn_link",  "label": "Button link" }
  ],
  "presets": [{ "name": "Signature Panel" }]
}
{% endschema %}
