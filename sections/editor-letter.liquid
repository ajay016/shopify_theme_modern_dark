{%- liquid
  assign s = section.settings
  assign portrait_fallback = 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=300&q=80'
-%}

<section
  id="section-{{ section.id }}"
  class="edl-section edl--{{ s.scheme }}"
  data-section-id="{{ section.id }}"
>
  <div class="edl-inner reveal">
    <span class="edl-rule edl-rule--l" aria-hidden="true"></span>

    <div class="edl-letter">
      <span class="edl-orn" aria-hidden="true">&#10022;</span>
      {%- if s.eyebrow != blank -%}<span class="edl-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="edl-heading">{{ s.heading }}</h2>{%- endif -%}

      {%- if s.body != blank -%}
        <div class="edl-body">{{ s.body }}</div>
      {%- endif -%}

      <div class="edl-sign">
        <span class="edl-sign__media">
          {%- if s.portrait != blank -%}
            {{ s.portrait | image_url: width: 300 | image_tag: loading: 'lazy', class: 'edl-sign__img', widths: '150,300', alt: s.signer | default: 'Editor' }}
          {%- else -%}
            <img class="edl-sign__img" src="{{ portrait_fallback }}" alt="{{ s.signer | escape }}" loading="lazy" />
          {%- endif -%}
        </span>
        <span class="edl-sign__text">
          {%- if s.signer != blank -%}<span class="edl-sign__name"><em>{{ s.signer }}</em></span>{%- endif -%}
          {%- if s.role != blank -%}<span class="edl-sign__role">{{ s.role }}</span>{%- endif -%}
        </span>
      </div>
    </div>

    <span class="edl-rule edl-rule--r" aria-hidden="true"></span>
  </div>
</section>

<style>
  #section-{{ section.id }}.edl--light { --bg:#F4F1EA; --fg:#17141B; --acc:var(--gold,#A8874C); --mut:rgba(23,20,27,.6); --bdr:rgba(23,20,27,.15); }
  #section-{{ section.id }}.edl--dark  { --bg:#131118; --fg:#EFEBE2; --acc:var(--gold,#C6A15B); --mut:rgba(239,235,226,.6); --bdr:rgba(239,235,226,.16); }
  #section-{{ section.id }}.edl--warm  { --bg:#EBE2D2; --fg:#241D15; --acc:var(--gold,#8E5A2A); --mut:rgba(36,29,21,.6); --bdr:rgba(36,29,21,.18); }
  #section-{{ section.id }}.edl--theme { --bg:var(--background,#F4F1EA); --fg:var(--foreground,#17141B); --acc:var(--gold,#A8874C); --mut:var(--muted,rgba(23,20,27,.6)); --bdr:var(--border,rgba(23,20,27,.15)); }

  #section-{{ section.id }} { background: var(--bg); color: var(--fg); padding: var(--section-spacing,80px) var(--side-padding,5vw); }

  #section-{{ section.id }} .edl-inner {
    display: grid; grid-template-columns: 1fr minmax(0, 720px) 1fr;
    align-items: center; gap: clamp(24px,4vw,64px);
    max-width: var(--container-width,1440px); margin: 0 auto;
  }
  #section-{{ section.id }} .edl-rule { height: 1px; background: var(--bdr); }

  #section-{{ section.id }} .edl-letter { text-align: center; }
  #section-{{ section.id }} .edl-orn { display: block; color: var(--acc); font-size: 14px; margin-bottom: 16px; }
  #section-{{ section.id }} .edl-eyebrow {
    display: block; font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: 11px; font-weight: 500; letter-spacing: .32em; text-transform: uppercase;
    color: var(--acc); margin-bottom: 14px;
  }
  #section-{{ section.id }} .edl-heading {
    font-family: var(--ff-display,'Cormorant Garamond',serif);
    font-size: calc(clamp(28px,3.4vw,46px) * var(--heading-scale,1));
    font-weight: 300; line-height: 1.08; margin: 0 0 clamp(20px,3vh,30px);
  }

  /* Letter body with a drop cap — magazine editorial */
  #section-{{ section.id }} .edl-body p {
    font-family: var(--ff-display,'Cormorant Garamond',serif);
    font-size: clamp(17px,1.5vw,22px); font-weight: 400; line-height: 1.66;
    color: var(--fg); margin: 0 0 1em;
  }
  #section-{{ section.id }} .edl-body p:first-of-type::first-letter {
    font-size: 3.1em; line-height: .82; float: left;
    padding: .06em .12em 0 0; color: var(--acc); font-style: italic;
  }
  #section-{{ section.id }} .edl-body em { color: var(--acc); }

  #section-{{ section.id }} .edl-sign {
    display: inline-flex; align-items: center; gap: 16px;
    margin-top: clamp(18px,2.6vh,26px);
  }
  #section-{{ section.id }} .edl-sign__media {
    width: 52px; height: 52px; border-radius: 50%; overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--acc) 55%, transparent);
    padding: 3px; flex: 0 0 auto;
  }
  #section-{{ section.id }} .edl-sign__img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; display: block; }
  #section-{{ section.id }} .edl-sign__text { text-align: left; }
  #section-{{ section.id }} .edl-sign__name {
    display: block; font-family: var(--ff-display,'Cormorant Garamond',serif);
    font-size: clamp(19px,1.6vw,24px); line-height: 1.15;
  }
  #section-{{ section.id }} .edl-sign__name em { font-style: italic; }
  #section-{{ section.id }} .edl-sign__role {
    display: block; margin-top: 4px;
    font-family: var(--ff-body,'Outfit',sans-serif); font-size: 10px; font-weight: 500;
    letter-spacing: .22em; text-transform: uppercase; color: var(--mut);
  }

  #section-{{ section.id }} .reveal.reveal-armed { opacity: 0; transform: translateY(26px); transition: opacity .8s ease, transform .8s ease; }
  #section-{{ section.id }} .reveal.is-visible { opacity: 1; transform: none; }

  @media (max-width: 760px) {
    #section-{{ section.id }} .edl-inner { grid-template-columns: 1fr; }
    #section-{{ section.id }} .edl-rule { display: none; }
  }
</style>

<script>
(function(){
  var SEC='{{ section.id }}';
  function arm(root){
    var els=root.querySelectorAll('.reveal');
    els.forEach(function(el){el.classList.add('reveal-armed');});
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('is-visible');io.unobserve(e.target);}});},{threshold:.2});
    els.forEach(function(el){io.observe(el);});
    setTimeout(function(){els.forEach(function(el){el.classList.add('is-visible');});},800);
  }
  function root(){return document.getElementById('section-'+SEC);}
  document.addEventListener('DOMContentLoaded',function(){var r=root();if(r)arm(r);});
  document.addEventListener('shopify:section:load',function(e){if(e.detail.sectionId!==SEC)return;var r=root();if(r){arm(r);r.querySelectorAll('.reveal').forEach(function(el){el.classList.add('is-visible');});}});
})();
</script>

{% schema %}
{
  "name": "Editor's Letter",
  "tag": "section",
  "class": "section-editor-letter",
  "settings": [
    {
      "type": "select", "id": "scheme", "label": "Color scheme",
      "options": [
        { "value": "light", "label": "Light (pearl)" },
        { "value": "dark",  "label": "Dark (velvet)" },
        { "value": "warm",  "label": "Warm (champagne)" },
        { "value": "theme", "label": "Follow theme" }
      ],
      "default": "light"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From the Editor" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A Note on Light" },
    { "type": "richtext", "id": "body", "label": "Letter body", "default": "<p>Some seasons arrive loudly. This one arrives the way afternoon light crosses a marble floor — slowly, then all at once. We cut silk to hold that hour, set pearls to catch it, and tailored wool to carve its shadow. Wear it gently.</p>" },
    { "type": "image_picker", "id": "portrait", "label": "Portrait" },
    { "type": "text", "id": "signer", "label": "Signature name", "default": "Isabelle Moreau" },
    { "type": "text", "id": "role", "label": "Role", "default": "Creative Director" }
  ],
  "presets": [ { "name": "Editor's Letter" } ]
}
{% endschema %}
