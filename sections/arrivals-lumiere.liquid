{%- liquid
  assign s = section.settings
  assign col = collections[s.collection]

  assign demo_names = 'Champagne Silk Blouse,Pearl-Button Cardigan,Column Midi Skirt,Gold-Clasp Clutch,Satin Wide Trouser,Sculpted Blazer,Drop Pearl Necklace,Bias Slip Dress' | split: ','
  assign demo_prices = '$390|$450|$420|$520|$480|$890|$310|$620' | split: '|'
  assign demo_cats = 'Shirts,Knitwear,Skirts,Accessories,Trousers,Tailoring,Jewellery,Dresses' | split: ','
  assign a1 = 'https://images.unsplash.com/photo-1485462537746-965f33f7f6a7?auto=format&fit=crop&w=700&q=80'
  assign a2 = 'https://images.unsplash.com/photo-1520975954732-35dd22299614?auto=format&fit=crop&w=700&q=80'
  assign a3 = 'https://images.unsplash.com/photo-1594633312681-425c7b97ccd1?auto=format&fit=crop&w=700&q=80'
  assign a4 = 'https://images.unsplash.com/photo-1590874103328-eac38a683ce7?auto=format&fit=crop&w=700&q=80'
  assign a5 = 'https://images.unsplash.com/photo-1509631179647-0177331693ae?auto=format&fit=crop&w=700&q=80'
  assign a6 = 'https://images.unsplash.com/photo-1566174053879-31528523f8ae?auto=format&fit=crop&w=700&q=80'
  assign a7 = 'https://images.unsplash.com/photo-1543163521-1bf539c55dd2?auto=format&fit=crop&w=700&q=80'
  assign a8 = 'https://images.unsplash.com/photo-1496217590455-aa63a8350eea?auto=format&fit=crop&w=700&q=80'
  assign demo_imgs_str = a1 | append: '||' | append: a2 | append: '||' | append: a3 | append: '||' | append: a4 | append: '||' | append: a5 | append: '||' | append: a6 | append: '||' | append: a7 | append: '||' | append: a8
  assign demo_imgs = demo_imgs_str | split: '||'
-%}

<section
  id="section-{{ section.id }}"
  class="arl-section arl--{{ s.scheme }}"
  data-section-id="{{ section.id }}"
  data-qv-scheme="{{ s.scheme }}"
>
  <div class="arl-inner">
    <div class="arl-head reveal">
      <div>
        {%- if s.eyebrow != blank -%}<span class="arl-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="arl-heading">{{ s.heading }}</h2>{%- endif -%}
      </div>
      {%- if s.cta_label != blank -%}
        <a href="{{ col.url | default: s.cta_url | default: '/collections/all' }}" class="arl-cta">{{ s.cta_label }} <span aria-hidden="true">&#8594;</span></a>
      {%- endif -%}
    </div>

    <div class="arl-grid">
      {%- if col != blank and col.products.size > 0 -%}
        {%- for product in col.products limit: s.products_to_show -%}
          <div class="arl-item reveal">{%- render 'product-card', product: product, scheme: s.scheme, number: forloop.index -%}</div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..8) -%}
          {%- if forloop.index > s.products_to_show -%}{%- break -%}{%- endif -%}
          {%- assign idx = forloop.index0 -%}
          <div class="arl-item reveal">{%- render 'product-card',
            scheme: s.scheme, number: forloop.index,
            demo_index: idx,
            demo_title: demo_names[idx],
            demo_price: demo_prices[idx],
            demo_category: demo_cats[idx],
            demo_image: demo_imgs[idx],
            demo_url: '/collections/all' -%}</div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  #section-{{ section.id }}.arl--light { --bg:#F4F1EA; --fg:#17141B; --acc:var(--gold,#A8874C); --mut:rgba(23,20,27,.55); --bdr:rgba(23,20,27,.15); }
  #section-{{ section.id }}.arl--dark  { --bg:#131118; --fg:#EFEBE2; --acc:var(--gold,#C6A15B); --mut:rgba(239,235,226,.52); --bdr:rgba(239,235,226,.16); }
  #section-{{ section.id }}.arl--warm  { --bg:#EBE2D2; --fg:#241D15; --acc:var(--gold,#8E5A2A); --mut:rgba(36,29,21,.55); --bdr:rgba(36,29,21,.18); }
  #section-{{ section.id }}.arl--theme { --bg:var(--background,#F4F1EA); --fg:var(--foreground,#17141B); --acc:var(--gold,#A8874C); --mut:var(--muted,rgba(23,20,27,.55)); --bdr:var(--border,rgba(23,20,27,.15)); }

  #section-{{ section.id }} { background: var(--bg); color: var(--fg); padding: var(--section-spacing,80px) var(--side-padding,5vw); }
  #section-{{ section.id }} .arl-inner { max-width: var(--container-width,1440px); margin: 0 auto; }

  #section-{{ section.id }} .arl-head {
    display: flex; align-items: flex-end; justify-content: space-between; gap: 24px;
    margin-bottom: clamp(28px,3.6vw,48px); padding-bottom: 18px;
    border-bottom: 1px solid var(--bdr); flex-wrap: wrap;
  }
  #section-{{ section.id }} .arl-eyebrow { display: block; font-family: var(--ff-body,'Outfit',sans-serif); font-size: 11px; font-weight: 500; letter-spacing: .28em; text-transform: uppercase; color: var(--acc); margin-bottom: 13px; }
  #section-{{ section.id }} .arl-heading { font-family: var(--ff-display,'Cormorant Garamond',serif); font-size: calc(clamp(30px,4vw,56px) * var(--heading-scale,1)); font-weight: 300; line-height: 1.02; text-transform: uppercase; margin: 0; }
  #section-{{ section.id }} .arl-cta {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--ff-body,'Outfit',sans-serif); font-size: 11px; font-weight: 500;
    letter-spacing: .16em; text-transform: uppercase; color: var(--fg); text-decoration: none;
    border-bottom: 1px solid var(--acc); padding-bottom: 5px; transition: color .2s;
  }
  #section-{{ section.id }} .arl-cta:hover { color: var(--acc); }

  #section-{{ section.id }} .arl-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(16px,2vw,32px); }

  #section-{{ section.id }} .reveal.reveal-armed { opacity: 0; transform: translateY(26px); transition: opacity .7s ease, transform .7s ease; }
  #section-{{ section.id }} .reveal.is-visible { opacity: 1; transform: none; }
  #section-{{ section.id }} .arl-grid .arl-item:nth-child(2){transition-delay:.05s;}
  #section-{{ section.id }} .arl-grid .arl-item:nth-child(3){transition-delay:.1s;}
  #section-{{ section.id }} .arl-grid .arl-item:nth-child(4){transition-delay:.15s;}

  @media (max-width: 1100px) { #section-{{ section.id }} .arl-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 760px)  { #section-{{ section.id }} .arl-grid { grid-template-columns: repeat(2, 1fr); } }
</style>

<script>
(function(){
  var SEC='{{ section.id }}';
  function arm(root){
    var els=root.querySelectorAll('.reveal');
    els.forEach(function(el){el.classList.add('reveal-armed');});
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('is-visible');io.unobserve(e.target);}});},{threshold:.08});
    els.forEach(function(el){io.observe(el);});
    setTimeout(function(){els.forEach(function(el){el.classList.add('is-visible');});},800);
  }
  function root(){return document.getElementById('section-'+SEC);}
  document.addEventListener('DOMContentLoaded',function(){var r=root();if(r)arm(r);});
  document.addEventListener('shopify:section:load',function(e){if(e.detail.sectionId!==SEC)return;var r=root();if(r){arm(r);r.querySelectorAll('.reveal').forEach(function(el){el.classList.add('is-visible');});}});
})();
</script>

{% schema %}
{
  "name": "New Arrivals Lumière",
  "tag": "section",
  "class": "section-arrivals-lumiere",
  "settings": [
    {
      "type": "select", "id": "scheme", "label": "Color scheme",
      "options": [
        { "value": "light", "label": "Light (pearl)" },
        { "value": "dark",  "label": "Dark (velvet)" },
        { "value": "warm",  "label": "Warm (champagne)" },
        { "value": "theme", "label": "Follow theme" }
      ],
      "default": "light"
    },
    { "type": "paragraph", "content": "Card design, image ratio, hover behaviour, wishlist and quick view follow Theme settings → Product Cards. Demo items show until a collection is connected." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Just In" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New This Week" },
    { "type": "collection", "id": "collection", "label": "Collection (demo items if empty)" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 8, "step": 1, "default": 8 },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "View all new arrivals" },
    { "type": "url",  "id": "cta_url",   "label": "CTA link" }
  ],
  "presets": [ { "name": "New Arrivals Lumière" } ]
}
{% endschema %}
