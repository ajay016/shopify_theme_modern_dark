{%- liquid
  assign s = section.settings
  assign f1 = 'https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=1200&q=85'
  assign f2 = 'https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=1000&q=85'
  assign f3 = 'https://images.unsplash.com/photo-1543163521-1bf539c55dd2?auto=format&fit=crop&w=1000&q=85'
  assign fb_str = f1 | append: '||' | append: f2 | append: '||' | append: f3
  assign fallbacks = fb_str | split: '||'
-%}

<section
  id="section-{{ section.id }}"
  class="cshow cshow--{{ s.scheme }}"
  data-section-id="{{ section.id }}"
>
  <div class="cshow-inner">
    {%- if s.eyebrow != blank or s.heading != blank or s.note != blank -%}
      <div class="cshow-head reveal">
        <div>
          {%- if s.eyebrow != blank -%}<p class="cshow-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
          {%- if s.heading != blank -%}<h2 class="cshow-heading">{{ s.heading }}</h2>{%- endif -%}
        </div>
        {%- if s.note != blank -%}<p class="cshow-note">{{ s.note }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="cshow-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign idx = forloop.index0 | modulo: 3
          assign fb = fallbacks[idx]
          assign col = collections[b.collection]
          assign href = b.link
          if href == blank and col != blank
            assign href = col.url
          endif
          if href == blank
            assign href = '/collections/all'
          endif
        -%}
        <a class="cshow-card reveal{% if forloop.first %} cshow-card--lead{% endif %}" href="{{ href }}" {{ block.shopify_attributes }}>
          <div class="cshow-media">
            {%- if b.image != blank -%}
              {{ b.image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'cshow-img', sizes: '(max-width: 900px) 82vw, 33vw', widths: '600,900,1200', alt: b.title }}
            {%- elsif col != blank and col.featured_image != blank -%}
              {{ col.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'cshow-img', sizes: '(max-width: 900px) 82vw, 33vw', widths: '600,900,1200', alt: b.title }}
            {%- else -%}
              <img class="cshow-img" src="{{ fb }}" alt="{{ b.title }}" loading="lazy" />
            {%- endif -%}
            <span class="cshow-veil" aria-hidden="true"></span>
          </div>
          <div class="cshow-copy">
            <h3 class="cshow-title">{{ b.title }}</h3>
            {%- if b.cta != blank -%}<span class="cshow-cta">{{ b.cta }}</span>{%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  #section-{{ section.id }}.cshow--light { --bg:var(--s2-bg,#131313); --fg:var(--s2-fg,#F5F0E8); --acc:var(--gold,#C8A96E); --mut:var(--s2-mut,rgba(245,240,232,.62)); }
  #section-{{ section.id }}.cshow--dark  { --bg:var(--s1-bg,#0A0A0A); --fg:var(--s1-fg,#F5F0E8); --acc:var(--gold,#C8A96E); --mut:var(--s1-mut,rgba(245,240,232,.62)); }
  #section-{{ section.id }}.cshow--warm  { --bg:var(--s3-bg,#1A1714); --fg:var(--s3-fg,#F5F0E8); --acc:var(--gold,#C8A96E); --mut:var(--s3-mut,rgba(245,240,232,.62)); }
  #section-{{ section.id }}.cshow--theme { --bg:var(--s1-bg,#0A0A0A); --fg:var(--s1-fg,#F5F0E8); --acc:var(--gold,#C8A96E); --mut:var(--s1-mut,rgba(245,240,232,.62)); }

  #section-{{ section.id }} { background: var(--bg); color: var(--fg); padding: clamp(72px,9vh,112px) 0; }
  #section-{{ section.id }} .cshow-inner { padding: 0 var(--side-padding,5vw); }

  #section-{{ section.id }} .cshow-head {
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: clamp(24px,4vw,48px); margin-bottom: clamp(28px,4vh,42px);
  }
  #section-{{ section.id }} .cshow-eyebrow {
    margin: 0 0 12px;
    font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: calc(12px * var(--fs-scale, 1));
    font-weight: 600; letter-spacing: .22em; text-transform: uppercase;
    color: var(--acc);
  }
  #section-{{ section.id }} .cshow-heading {
    margin: 0;
    font-family: var(--ff-display,'Cormorant Garamond',serif);
    font-weight: 300;
    font-size: calc(clamp(34px,4.4vw,58px) * var(--heading-scale,1));
    line-height: 1.02;
  }
  #section-{{ section.id }} .cshow-note {
    max-width: 360px; margin: 0;
    font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: calc(14px * var(--fs-scale, 1));
    line-height: 1.68; color: var(--mut);
  }

  #section-{{ section.id }} .cshow-grid {
    display: grid; gap: 10px;
    grid-template-columns: 1.15fr .85fr .85fr;
  }
  #section-{{ section.id }} .cshow-card {
    position: relative; display: block;
    min-height: 540px; overflow: hidden;
    text-decoration: none;
    background: var(--img-placeholder, #1A1714);
  }
  #section-{{ section.id }} .cshow-card--lead { min-height: 620px; }
  #section-{{ section.id }} .cshow-media { position: absolute; inset: 0; }
  #section-{{ section.id }} .cshow-img {
    display: block; width: 100%; height: 100%;
    object-fit: cover; filter: saturate(.72);
    transition: transform .7s ease;
  }
  #section-{{ section.id }} .cshow-card:hover .cshow-img { transform: scale(1.03); }
  /* Veil is scheme-independent — it exists so the white caption stays
     readable over any photograph the merchant uploads. */
  #section-{{ section.id }} .cshow-veil {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(10,10,11,.06) 40%, rgba(10,10,11,.60) 100%);
    transition: background .3s ease;
  }
  #section-{{ section.id }} .cshow-card:hover .cshow-veil {
    background: linear-gradient(180deg, rgba(10,10,11,.02) 34%, rgba(10,10,11,.52) 100%);
  }

  #section-{{ section.id }} .cshow-copy {
    position: absolute; z-index: 2; right: 26px; bottom: 24px; left: 26px;
    display: flex; align-items: flex-end; justify-content: space-between; gap: 16px;
  }
  #section-{{ section.id }} .cshow-title {
    margin: 0;
    font-family: var(--ff-display,'Cormorant Garamond',serif);
    font-weight: 300;
    font-size: calc(clamp(26px,2.6vw,40px) * var(--heading-scale,1));
    line-height: 1.02;
    color: var(--on-image, #FFFFFF);
  }
  #section-{{ section.id }} .cshow-cta {
    flex: 0 0 auto; padding-bottom: 3px;
    border-bottom: 1px solid currentColor;
    font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: calc(12px * var(--fs-scale, 1));
    font-weight: 600; letter-spacing: .16em; text-transform: uppercase;
    color: var(--on-image, #FFFFFF);
  }

  #section-{{ section.id }} .reveal.reveal-armed { opacity: 0; transform: translateY(24px); transition: opacity .75s ease, transform .75s ease; }
  #section-{{ section.id }} .reveal.is-visible { opacity: 1; transform: none; }

  @media (max-width: 1100px) {
    #section-{{ section.id }} .cshow-grid { grid-template-columns: 1.1fr .9fr; }
    #section-{{ section.id }} .cshow-card,
    #section-{{ section.id }} .cshow-card--lead { min-height: 460px; }
    #section-{{ section.id }} .cshow-card:nth-child(3) { grid-column: span 2; min-height: 400px; }
  }
  @media (max-width: 760px) {
    #section-{{ section.id }} .cshow-head { flex-direction: column; align-items: flex-start; gap: 16px; }
    #section-{{ section.id }} .cshow-grid {
      display: flex; gap: 10px;
      margin-right: calc(var(--side-padding,5vw) * -1);
      padding-right: var(--side-padding,5vw);
      overflow-x: auto; scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch; scrollbar-width: none;
    }
    #section-{{ section.id }} .cshow-grid::-webkit-scrollbar { display: none; }
    #section-{{ section.id }} .cshow-card,
    #section-{{ section.id }} .cshow-card--lead,
    #section-{{ section.id }} .cshow-card:nth-child(3) {
      flex: 0 0 auto; min-width: 80vw; min-height: 470px;
      grid-column: auto; scroll-snap-align: start;
    }
    #section-{{ section.id }} .cshow-copy { right: 20px; bottom: 20px; left: 20px; }
  }
</style>

<script>
(function(){
  var SEC='{{ section.id }}';
  function arm(root){
    var els=root.querySelectorAll('.reveal');
    els.forEach(function(el){el.classList.add('reveal-armed');});
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('is-visible');io.unobserve(e.target);}});},{threshold:.15});
    els.forEach(function(el){io.observe(el);});
    setTimeout(function(){els.forEach(function(el){el.classList.add('is-visible');});},800);
  }
  function root(){return document.getElementById('section-'+SEC);}
  document.addEventListener('DOMContentLoaded',function(){var r=root();if(r)arm(r);});
  document.addEventListener('shopify:section:load',function(e){if(e.detail.sectionId!==SEC)return;var r=root();if(r){arm(r);r.querySelectorAll('.reveal').forEach(function(el){el.classList.add('is-visible');});}});
})();
</script>

{% schema %}
{
  "name": "Category Showcase",
  "tag": "section",
  "class": "section-category-showcase",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select", "id": "scheme", "label": "Surface tone",
      "options": [
        { "value": "light", "label": "Alternate surface (soft)" },
        { "value": "dark",  "label": "Primary surface" },
        { "value": "warm",  "label": "Deep surface" },
        { "value": "theme", "label": "Primary surface (follow theme)" }
      ],
      "default": "light"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The wardrobe" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "textarea", "id": "note", "label": "Note", "default": "A concise wardrobe built around proportion, texture, and ease." }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Falls back to the collection image, then to a demo image." },
        { "type": "text", "id": "title", "label": "Title", "default": "Ready-to-wear" },
        { "type": "text", "id": "cta", "label": "Link label", "default": "Explore" },
        { "type": "url", "id": "link", "label": "Link", "info": "Overrides the collection link." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Showcase",
      "blocks": [
        { "type": "category", "settings": { "title": "Ready-to-wear", "cta": "Explore" } },
        { "type": "category", "settings": { "title": "Leather goods", "cta": "Explore" } },
        { "type": "category", "settings": { "title": "Shoes", "cta": "Explore" } }
      ]
    }
  ]
}
{% endschema %}
