{%- liquid
  assign s = section.settings
  assign nli_form_id = 'nli-form-' | append: section.id
-%}

<section
  id="section-{{ section.id }}"
  class="nli-section nli--{{ s.scheme }}"
  data-section-id="{{ section.id }}"
>
  <div class="nli-card reveal">
    <span class="nli-card__border" aria-hidden="true"></span>

    <span class="nli-orn" aria-hidden="true">&#10022;</span>
    {%- if s.eyebrow != blank -%}<span class="nli-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
    {%- if s.heading != blank -%}<h2 class="nli-heading">{{ s.heading }}</h2>{%- endif -%}
    {%- if s.subtext != blank -%}<p class="nli-sub">{{ s.subtext }}</p>{%- endif -%}

    {%- form 'customer', id: nli_form_id, class: 'nli-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="nli-success">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <div class="nli-row">
          <input
            type="email"
            name="contact[email]"
            id="nli-email-{{ section.id }}"
            placeholder="{{ s.placeholder | default: 'Your email address' }}"
            autocorrect="off" autocapitalize="off"
            required
            {%- if form.errors -%} aria-invalid="true"{%- endif -%}
          >
          <button type="submit">{{ s.btn_label | default: 'RSVP' }}</button>
        </div>
        {%- if form.errors -%}
          <p class="nli-error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}

    {%- if s.disclaimer != blank -%}<p class="nli-disc">{{ s.disclaimer }}</p>{%- endif -%}

    {%- if s.foot_left != blank or s.foot_right != blank -%}
      <div class="nli-foot" aria-hidden="true">
        <span>{{ s.foot_left }}</span>
        <span class="nli-foot__dia">&#10022;</span>
        <span>{{ s.foot_right }}</span>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  #section-{{ section.id }}.nli--light { --bg:var(--s2-bg); --card:var(--s3-bg); --fg:var(--s2-fg); --acc:var(--gold); --mut:var(--s2-mut); --bdr:var(--s2-bdr); }
  #section-{{ section.id }}.nli--dark  { --bg:var(--s1-bg); --card:var(--s2-bg); --fg:var(--s1-fg); --acc:var(--gold); --mut:var(--s1-mut); --bdr:var(--s1-bdr); }
  #section-{{ section.id }}.nli--warm  { --bg:var(--s3-bg); --card:var(--s2-bg); --fg:var(--s3-fg); --acc:var(--gold); --mut:var(--s3-mut); --bdr:var(--s3-bdr); }
  #section-{{ section.id }}.nli--theme { --bg:var(--s1-bg); --card:var(--s2-bg); --fg:var(--s1-fg); --acc:var(--gold); --mut:var(--s1-mut); --bdr:var(--s1-bdr); }

  #section-{{ section.id }} {
    background: var(--bg); color: var(--fg);
    padding: var(--section-spacing,80px) var(--side-padding,5vw);
    display: flex; justify-content: center;
  }

  /* — The invitation card — */
  #section-{{ section.id }} .nli-card {
    position: relative; width: 100%; max-width: 680px;
    background: var(--card); text-align: center;
    padding: clamp(44px, 6vw, 76px) clamp(24px, 5vw, 72px);
    border: 1px solid color-mix(in srgb, var(--acc) 55%, transparent);
    box-shadow: 0 40px 90px -40px rgba(0,0,0,.45);
  }
  #section-{{ section.id }} .nli-card__border {
    position: absolute; inset: 9px; pointer-events: none;
    border: 1px solid color-mix(in srgb, var(--acc) 32%, transparent);
  }

  #section-{{ section.id }} .nli-orn { display: block; font-size: calc(15px * var(--fs-scale, 1)); color: var(--acc); margin-bottom: 18px; }
  #section-{{ section.id }} .nli-eyebrow {
    display: block; font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: calc(10px * var(--fs-scale, 1)); font-weight: 500; letter-spacing: .34em; text-transform: uppercase;
    color: var(--acc); margin-bottom: 16px;
  }
  #section-{{ section.id }} .nli-heading {
    font-family: var(--ff-display,'Cormorant Garamond',serif);
    font-size: calc(clamp(30px, 3.6vw, 48px) * var(--heading-scale,1));
    font-weight: 300; line-height: 1.08; margin: 0 0 14px;
  }
  #section-{{ section.id }} .nli-sub {
    font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: calc(clamp(13px, 1vw, 15px) * var(--fs-scale, 1)); line-height: 1.7; color: var(--mut);
    max-width: 420px; margin: 0 auto clamp(24px, 3.4vh, 34px);
  }

  #section-{{ section.id }} .nli-row {
    display: flex; gap: 0; max-width: 440px; margin: 0 auto;
    border: 1px solid var(--bdr); border-radius: 999px; overflow: hidden;
    background: color-mix(in srgb, var(--card) 60%, transparent);
    transition: border-color .25s;
  }
  #section-{{ section.id }} .nli-row:focus-within { border-color: var(--acc); }
  #section-{{ section.id }} .nli-row input {
    flex: 1; min-width: 0; border: none; background: transparent; outline: none;
    padding: 16px 22px; color: var(--fg);
    font-family: var(--ff-body,'Outfit',sans-serif); font-size: calc(13px * var(--fs-scale, 1)); letter-spacing: .04em;
  }
  #section-{{ section.id }} .nli-row input::placeholder { color: var(--mut); }
  #section-{{ section.id }} .nli-row button {
    border: none; cursor: pointer; background: var(--acc); color: var(--on-gold);
    font-family: var(--ff-body,'Outfit',sans-serif); font-size: calc(11px * var(--fs-scale, 1)); font-weight: 600;
    letter-spacing: .18em; text-transform: uppercase; padding: 0 30px;
    transition: filter .2s;
  }
  #section-{{ section.id }} .nli-row button:hover { filter: brightness(1.08); }

  #section-{{ section.id }} .nli-success { font-family: var(--ff-body,'Outfit',sans-serif); font-size: calc(13px * var(--fs-scale, 1)); letter-spacing: .06em; color: var(--acc); }
  #section-{{ section.id }} .nli-error   { font-family: var(--ff-body,'Outfit',sans-serif); font-size: calc(12px * var(--fs-scale, 1)); color: #C97B7B; margin-top: 10px; }

  #section-{{ section.id }} .nli-disc {
    font-family: var(--ff-body,'Outfit',sans-serif); font-size: calc(11px * var(--fs-scale, 1)); line-height: 1.6;
    color: var(--mut); opacity: .8; margin-top: 16px;
  }

  #section-{{ section.id }} .nli-foot {
    display: flex; align-items: center; justify-content: center; gap: 14px;
    margin-top: clamp(24px, 3.4vh, 34px); padding-top: 18px;
    border-top: 1px solid var(--bdr);
    font-family: var(--ff-body,'Outfit',sans-serif); font-size: calc(9px * var(--fs-scale, 1)); font-weight: 500;
    letter-spacing: .3em; text-transform: uppercase; color: var(--mut);
  }
  #section-{{ section.id }} .nli-foot__dia { color: var(--acc); font-size: calc(9px * var(--fs-scale, 1)); }

  #section-{{ section.id }} .reveal.reveal-armed { opacity: 0; transform: translateY(26px); transition: opacity .8s ease, transform .8s ease; }
  #section-{{ section.id }} .reveal.is-visible { opacity: 1; transform: none; }

  @media (max-width: 560px) {
    #section-{{ section.id }} .nli-row { flex-direction: column; border-radius: 14px; }
    #section-{{ section.id }} .nli-row input { text-align: center; padding: 15px 16px; }
    #section-{{ section.id }} .nli-row button { padding: 14px; }
  }
</style>

<script>
(function(){
  var SEC='{{ section.id }}';
  function arm(root){
    var els=root.querySelectorAll('.reveal');
    els.forEach(function(el){el.classList.add('reveal-armed');});
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('is-visible');io.unobserve(e.target);}});},{threshold:.2});
    els.forEach(function(el){io.observe(el);});
    setTimeout(function(){els.forEach(function(el){el.classList.add('is-visible');});},800);
  }
  function root(){return document.getElementById('section-'+SEC);}
  document.addEventListener('DOMContentLoaded',function(){var r=root();if(r)arm(r);});
  document.addEventListener('shopify:section:load',function(e){if(e.detail.sectionId!==SEC)return;var r=root();if(r){arm(r);r.querySelectorAll('.reveal').forEach(function(el){el.classList.add('is-visible');});}});
})();
</script>

{% schema %}
{
  "name": "Newsletter Invitation",
  "tag": "section",
  "class": "section-newsletter-invitation",
  "settings": [
    {
      "type": "select", "id": "scheme", "label": "Surface tone",
      "options": [
        { "value": "light", "label": "Alternate surface (soft)" },
        { "value": "dark",  "label": "Primary surface" },
        { "value": "warm",  "label": "Deep surface" },
        { "value": "theme", "label": "Primary surface (follow theme)" }
      ],
      "default": "dark"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "You Are Invited" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Private Salon" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "First viewings, midnight releases, and pieces reserved for the inner circle — delivered like an invitation, never a newsletter." },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Your email address" },
    { "type": "text", "id": "btn_label", "label": "Button label", "default": "RSVP" },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer", "default": "By subscribing you agree to our Privacy Policy. Unsubscribe at any time." },
    { "type": "header", "content": "Card footline" },
    { "type": "text", "id": "foot_left",  "label": "Foot left",  "default": "Maison Noir" },
    { "type": "text", "id": "foot_right", "label": "Foot right", "default": "Est. 2009" }
  ],
  "presets": [ { "name": "Newsletter Invitation" } ]
}
{% endschema %}
