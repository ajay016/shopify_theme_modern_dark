{%- comment -%}
  Product Card Snippet — unified "Atelier" card used site-wide.

  Renders one consistent, scheme-aware product card on collection, search,
  cart, recommendations AND the bespoke homepage sections (product-rail,
  product-showcase, featured-products). All visual options are driven by
  Theme Settings → Product Cards, with per-render overrides.

  Accepts:
    - product {Object}            a real product. If blank, demo_* params are used.
    - scheme {String}             'theme' (default) | 'light' | 'dark' | 'warm'
    - card_style {String}         'atelier' (default) | 'minimal' | 'overlay' | 'bordered'
    - image_ratio {String}        'portrait' | 'square' | 'landscape'
    - media_hover {String}        'zoom' | 'second_image' | 'carousel' | 'none'
    - quickadd_style {String}     'slide_up' | 'popup' | 'always'
    - show_vendor / show_category / show_number {Boolean}
    - show_wishlist / show_quickview {Boolean}
    - show_price_compare {Boolean}
    - text_align {String}         'left' | 'center'
    - radius {String}             'none' | 'subtle' | 'rounded'
    - number {Number}             index used for the 01–08 corner badge (optional)
    - rail {Boolean}              true when placed in a horizontal scroll rail
    - lazy {Boolean}              lazy-load images (default true)

  Demo fallback (when product is blank):
    - demo_title, demo_price, demo_category, demo_image, demo_url, demo_index
{%- endcomment -%}

{%- liquid
  assign card_style    = card_style    | default: settings.product_card_style    | default: 'atelier'
  assign image_ratio   = image_ratio   | default: settings.product_card_image_ratio | default: 'portrait'
  assign media_hover   = media_hover   | default: settings.product_card_media_hover | default: 'zoom'
  assign quickadd_style = quickadd_style | default: settings.product_card_quickadd_style | default: 'slide_up'
  assign text_align    = text_align    | default: settings.product_card_text_align | default: 'left'
  assign radius        = radius        | default: settings.product_card_radius   | default: 'subtle'
  assign scheme        = scheme        | default: 'theme'

  assign show_vendor   = show_vendor   | default: settings.product_card_show_vendor
  assign show_category = show_category | default: settings.product_card_show_category
  assign show_number   = show_number   | default: settings.product_card_show_number
  assign show_wishlist = show_wishlist | default: settings.product_card_show_wishlist
  assign show_quickview = show_quickview | default: settings.product_card_show_quickview
  assign show_price_compare = show_price_compare | default: settings.product_card_show_price_compare
  assign show_sizes    = show_sizes    | default: settings.product_card_show_sizes
  assign show_material = show_material | default: settings.product_card_show_material
  assign show_swatches = show_swatches | default: settings.product_card_show_swatches
  assign show_rating   = show_rating   | default: settings.product_card_show_rating
  assign show_low_stock = show_low_stock | default: settings.product_card_show_low_stock
  assign low_stock_threshold = settings.product_card_low_stock_threshold | default: 5

  assign img_loading = 'lazy'
  if lazy == false
    assign img_loading = 'eager'
  endif

  assign is_demo = false
  if product == blank
    assign is_demo = true
  endif

  assign wl_on = false
  if settings.wishlist_enabled and show_wishlist
    assign wl_on = true
  endif
  assign qv_on = false
  if settings.quickview_enabled and show_quickview
    assign qv_on = true
  endif
-%}

{%- if is_demo -%}
  {%- comment -%}— Demo card (no collection connected) —{%- endcomment -%}
  {%- liquid
    assign d_title = demo_title | default: 'Atelier Piece'
    assign d_url   = demo_url   | default: '/collections/all'
    assign d_cat   = demo_category | default: 'Atelier'
    assign d_price = demo_price | default: '$0'
    assign d_img   = demo_image
    # derive cents from the display price so the quick-view popup shows it
    assign d_cents = d_price | remove: '$' | remove: '€' | remove: '£' | remove: ',' | strip | times: 100
  -%}
  {%- liquid
    # Demo cards carry the same facets a real product would, so the filter
    # panel on a store with no catalogue is a working demonstration rather
    # than two lonely groups. Values are deterministic from demo_index, so
    # the filters and the cards always agree.
    assign di = demo_index | default: 0 | modulo: 6
    assign d_sizes_all = 'XS|S|M|L~S|M|L|XL~XS|S|M~M|L|XL~S|M|L~XS|S|M|L|XL' | split: '~'
    assign d_cols_all  = 'Black|Ivory~Ivory|Sand~Black|Wine~Sand|Charcoal~Black|Ivory|Sand~Charcoal|Wine' | split: '~'
    assign d_vendors   = 'Maison Noir~Atelier Series~Maison Noir~Maison Noir~Atelier Series~Maison Noir' | split: '~'
    assign d_tagsets   = 'new|essentials~sale|archive~new|limited~essentials~sale|essentials~new|limited' | split: '~'
    assign d_discounts = '0~30~0~20~50~0' | split: '~'
    assign d_ages      = '7~120~21~200~45~9' | split: '~'
    assign d_ratings   = '5~4~4~3~5~4' | split: '~'

    assign d_opts = d_sizes_all[di] | append: '|' | append: d_cols_all[di] | append: '|'
    assign d_disc = d_discounts[di] | plus: 0
    assign d_onsale = false
    if d_disc > 0
      assign d_onsale = true
    endif
  -%}
  <div
    class="product-card pcard pcard--{{ scheme }} pcard--{{ card_style }} pcard--align-{{ text_align }} pcard--rad-{{ radius }}{% if rail %} pcard--rail{% endif %}"
    data-pcard
    data-quickadd="{{ quickadd_style }}"
    data-price="{{ d_cents }}"
    data-available="true"
    data-onsale="{{ d_onsale }}"
    data-vendor="{{ d_vendors[di] }}"
    data-type="{{ d_cat }}"
    data-tags="{{ d_tagsets[di] }}"
    data-options="{{ d_opts }}"
    data-options-instock="{{ d_opts }}"
    data-discount="{{ d_disc }}"
    data-age="{{ d_ages[di] }}"
    data-rating="{{ d_ratings[di] }}"
    data-colours="{{ d_cols_all[di] | split: '|' | size }}"
  >
    <script type="application/json" class="product-card__json">{"id":0,"title":{{ d_title | json }},"vendor":{{ shop.name | json }},"url":{{ d_url | json }},"price":{{ d_cents }},"compare_at_price":0,"body_html":"Demo product — connect a collection in the theme editor to show your own pieces.","images":[{{ d_img | json }}],"options":["Title"],"variants":[{"id":0,"price":{{ d_cents }},"compare_at_price":0,"available":true,"options":["Default Title"]}]}</script>

    <div class="pcard__media pcard__media--{{ image_ratio }} pcard__media--hov-{{ media_hover }}">
      <a href="{{ d_url }}" class="pcard__imglink" aria-label="{{ d_title | escape }}">
        <img class="pcard__img pcard__img--a" src="{{ d_img }}" alt="{{ d_title | escape }}" loading="{{ img_loading }}" />
      </a>
      {%- if show_number and demo_index -%}
        <span class="pcard__num">{{ demo_index | plus: 1 | prepend: '0' | slice: -2, 2 }}</span>
      {%- endif -%}

      <div class="pcard__icons">
        {%- if wl_on -%}
          <button class="pcard-icon-btn" data-wishlist-id="demo-{{ demo_index | default: 0 }}" aria-label="Add to wishlist" aria-pressed="false">{%- render 'icon-wishlist' -%}</button>
        {%- endif -%}
        {%- if qv_on -%}
          <button class="pcard-icon-btn" data-open-quickview data-product-url="{{ d_url }}" aria-label="Quick view {{ d_title | escape }}">{%- render 'icon-eye' -%}</button>
        {%- endif -%}
      </div>

      {%- comment -%}Demo Add to Bag — opens the quick-view popup from the embedded
        JSON (same behaviour real multi-variant products get), so the hover
        flow can be previewed before any collection is connected.{%- endcomment -%}
      {%- if settings.quickview_enabled -%}
        <button class="pcard-atc pcard-btn--atc" data-open-quickview data-product-url="{{ d_url }}">
          {%- render 'icon-bag' -%}
          <span class="pcard-atc__label">Add to Bag</span>
        </button>
      {%- else -%}
        <a href="{{ d_url }}" class="pcard-atc pcard-btn--atc">
          {%- render 'icon-bag' -%}
          <span class="pcard-atc__label">View Product</span>
        </a>
      {%- endif -%}
    </div>

    <div class="pcard__info">
      {%- if show_category -%}<span class="pcard__cat">{{ d_cat }}</span>{%- endif -%}
      <span class="pcard__name"><a href="{{ d_url }}">{{ d_title }}</a></span>
      <span class="pcard__price">{{ d_price }}</span>
    </div>
  </div>

{%- else -%}
  {%- comment -%}— Real product card —{%- endcomment -%}
  {%- liquid
    assign p_alt = product.title | escape
    assign first_variant = product.first_available_variant | default: product.variants.first

    assign imgs_j = '['
    for img in product.images limit: 8
      assign img_src = img | image_url: width: 800
      if forloop.first
        assign imgs_j = imgs_j | append: '"' | append: img_src | append: '"'
      else
        assign imgs_j = imgs_j | append: ',"' | append: img_src | append: '"'
      endif
    endfor
    assign imgs_j = imgs_j | append: ']'

    assign vars_j = '['
    for v in product.variants
      assign opt1_j = v.option1 | json
      assign opts_j = '[' | append: opt1_j
      if v.option2 != blank
        assign opt2_j = v.option2 | json
        assign opts_j = opts_j | append: ',' | append: opt2_j
      endif
      if v.option3 != blank
        assign opt3_j = v.option3 | json
        assign opts_j = opts_j | append: ',' | append: opt3_j
      endif
      assign opts_j = opts_j | append: ']'
      assign v_cmp = v.compare_at_price | default: 0
      assign v_avail = 'false'
      if v.available
        assign v_avail = 'true'
      endif
      assign v_obj = '{"id":' | append: v.id | append: ',"price":' | append: v.price | append: ',"compare_at_price":' | append: v_cmp | append: ',"available":' | append: v_avail | append: ',"options":' | append: opts_j | append: '}'
      if forloop.first
        assign vars_j = vars_j | append: v_obj
      else
        assign vars_j = vars_j | append: ',' | append: v_obj
      endif
    endfor
    assign vars_j = vars_j | append: ']'
  -%}
  {%- comment -%}
    Facets published on the card itself, so the collection page can filter
    without Shopify's Search & Discovery app. Option values are flattened into
    one list because a filter only needs to know "does this product offer
    Large" — not which option position holds it.
  {%- endcomment -%}
  {%- liquid
    assign opt_vals = ''
    for opt in product.options_with_values
      for val in opt.values
        assign opt_vals = opt_vals | append: val | append: '|'
      endfor
    endfor

      # Option values that are ACTUALLY BUYABLE, not merely offered. "Large" on
      # the card above means the product comes in Large; here it means a Large is
      # in stock — which is what a shopper filtering by their size wants.
    assign opt_instock = ''
    for v in product.variants
      if v.available
        for ov in v.options
          if ov != blank
            assign opt_instock = opt_instock | append: ov | append: '|'
          endif
        endfor
      endif
    endfor

    assign on_sale = false
    assign discount_pc = 0
    if product.compare_at_price > product.price
      assign on_sale = true
      assign discount_pc = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price
    endif

      # Age in days, so a "New in" filter can ask for the last 14/30/60 without
      # the browser having to parse a date on every card.
    assign now_s = 'now' | date: '%s' | plus: 0
    assign pub_s = product.published_at | date: '%s' | plus: 0
    assign age_days = now_s | minus: pub_s | divided_by: 86400

    assign card_rating = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value | default: 0
    assign colour_count = 0
    for opt in product.options_with_values
      assign ok2 = opt.name | downcase | strip
      if ok2 == 'color' or ok2 == 'colour'
        assign colour_count = opt.values.size
      endif
    endfor
  -%}
  <div
    class="product-card pcard pcard--{{ scheme }} pcard--{{ card_style }} pcard--align-{{ text_align }} pcard--rad-{{ radius }}{% if rail %} pcard--rail{% endif %}"
    data-pcard
    data-product-id="{{ product.id }}"
    data-quickadd="{{ quickadd_style }}"
    data-price="{{ product.price }}"
    data-available="{{ product.available }}"
    data-onsale="{{ on_sale }}"
    data-vendor="{{ product.vendor | escape }}"
    data-type="{{ product.type | escape }}"
    data-tags="{{ product.tags | join: '|' | escape }}"
    data-options="{{ opt_vals | escape }}"
    data-options-instock="{{ opt_instock | escape }}"
    data-discount="{{ discount_pc }}"
    data-age="{{ age_days }}"
    data-rating="{{ card_rating }}"
    data-colours="{{ colour_count }}"
  >
    <script type="application/json" class="product-card__json">{"id":{{ product.id }},"title":{{ product.title | json }},"vendor":{{ product.vendor | json }},"url":{{ product.url | json }},"price":{{ product.price }},"compare_at_price":{{ product.compare_at_price | default: 0 }},"body_html":{{ product.description | json }},"images":{{ imgs_j }},"options":{{ product.options | json }},"variants":{{ vars_j }}}</script>

    <div class="pcard__media pcard__media--{{ image_ratio }} pcard__media--hov-{{ media_hover }}">
      <a href="{{ product.url }}" class="pcard__imglink" aria-label="{{ p_alt }}">
        {%- if product.featured_image != blank -%}
          {{ product.featured_image | image_url: width: 700 | image_tag:
            loading: img_loading, class: 'pcard__img pcard__img--a',
            sizes: '(max-width:700px) 64vw, (max-width:1100px) 33vw, 24vw',
            widths: '350,500,700,900', alt: p_alt }}
          {%- if media_hover == 'second_image' and product.images.size > 1 -%}
            {{ product.images[1] | image_url: width: 700 | image_tag:
              loading: 'lazy', class: 'pcard__img pcard__img--b', alt: p_alt }}
          {%- endif -%}
          {%- if media_hover == 'carousel' and product.images.size > 1 -%}
            {%- for img in product.images offset: 1 limit: 3 -%}
              {{ img | image_url: width: 700 | image_tag:
                loading: 'lazy', class: 'pcard__img pcard__img--cycle', alt: p_alt }}
            {%- endfor -%}
          {%- endif -%}
        {%- else -%}
          <span class="pcard__img pcard__img--a pcard__img--placeholder">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
          </span>
        {%- endif -%}
      </a>

      {%- if show_number and number -%}
        <span class="pcard__num">{{ number | prepend: '0' | slice: -2, 2 }}</span>
      {%- endif -%}

      {%- liquid
          # Low stock reads real inventory, so it only speaks when Shopify is
          # actually tracking it. An untracked variant reports null, which would
          # otherwise read as zero and mark every product "last few".
        assign stock_total = 0
        assign stock_tracked = false
        for v in product.variants
          if v.inventory_management != blank
            assign stock_tracked = true
            if v.inventory_quantity > 0
              assign stock_total = stock_total | plus: v.inventory_quantity
            endif
          endif
        endfor
      -%}

      {%- if product.available == false -%}
        <span class="pcard__badge">{{ 'products.product.sold_out_badge' | t }}</span>
      {%- elsif product.compare_at_price > product.price -%}
        {%- assign discount_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
        <span class="pcard__badge pcard__badge--sale">−{{ discount_pct }}%</span>
      {%- elsif show_low_stock and stock_tracked and stock_total > 0 and stock_total <= low_stock_threshold -%}
        <span class="pcard__badge pcard__badge--low">Only {{ stock_total }} left</span>
      {%- elsif product.tags contains 'new' or product.tags contains 'New' -%}
        <span class="pcard__badge">{{ 'products.product.new_badge' | t }}</span>
      {%- endif -%}

      {%- comment -%}
        Sizes on hover. The setting has existed in the theme editor since the
        card was written but nothing read it, so switching it on did nothing.
        Each size links straight to that variant, and sizes with no stock are
        struck through rather than hidden — a shopper wants to know their size
        exists before they learn it is gone.
      {%- endcomment -%}
      {%- if show_sizes -%}
        {%- for opt in product.options_with_values -%}
          {%- assign opt_key = opt.name | downcase | strip -%}
          {%- if opt_key == 'size' -%}
            <div class="pcard__sizes" aria-label="Available sizes">
              {%- for val in opt.values limit: 8 -%}
                {%- liquid
                  assign val_available = false
                  assign val_variant = nil
                  for v in product.variants
                    if v.options contains val
                      unless val_variant
                        assign val_variant = v
                      endunless
                      if v.available
                        assign val_available = true
                        assign val_variant = v
                        break
                      endif
                    endif
                  endfor
                -%}
                <a
                  class="pcard__size{% unless val_available %} is-out{% endunless %}"
                  href="{{ product.url }}{% if val_variant %}?variant={{ val_variant.id }}{% endif %}"
                  {% unless val_available %}aria-disabled="true"{% endunless %}
                >{{ val }}</a>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      <div class="pcard__icons">
        {%- if wl_on -%}
          <button class="pcard-icon-btn" data-wishlist-id="{{ product.id }}" aria-label="{{ 'accessibility.wishlist_add' | t }}" aria-pressed="false">{%- render 'icon-wishlist' -%}</button>
        {%- endif -%}
        {%- if qv_on -%}
          <button class="pcard-icon-btn" data-open-quickview data-product-url="{{ product.url }}" aria-label="{{ 'accessibility.quick_view' | t: product_title: product.title }}">{%- render 'icon-eye' -%}</button>
        {%- endif -%}
      </div>

      {%- comment -%}Add to bag — popup opens quick view; single variant adds directly; else select options{%- endcomment -%}
      {%- unless quickadd_style == 'none' -%}
        {%- if quickadd_style == 'popup' and settings.quickview_enabled -%}
          <button class="pcard-atc pcard-btn--atc" data-open-quickview data-product-url="{{ product.url }}" aria-label="{{ 'accessibility.add_to_cart' | t: product_title: product.title }}">
            {%- render 'icon-bag' -%}
            <span class="pcard-atc__label">Add to Bag</span>
          </button>
        {%- elsif product.variants.size == 1 and first_variant -%}
          <button class="pcard-atc pcard-btn--atc" data-variant-id="{{ first_variant.id }}" aria-label="{{ 'accessibility.add_to_cart' | t: product_title: product.title }}" {% unless first_variant.available %}disabled{% endunless %}>
            {%- render 'icon-bag' -%}
            <span class="pcard-atc__label">{% if first_variant.available %}Add to Bag{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
          </button>
        {%- elsif qv_on -%}
          <button class="pcard-atc pcard-btn--atc" data-open-quickview data-product-url="{{ product.url }}">
            {%- render 'icon-bag' -%}
            <span class="pcard-atc__label">Add to Bag</span>
          </button>
        {%- else -%}
          <a href="{{ product.url }}" class="pcard-atc">
            {%- render 'icon-bag' -%}
            <span class="pcard-atc__label">Select Options</span>
          </a>
        {%- endif -%}
      {%- endunless -%}
    </div>

    <div class="pcard__info">
      {%- comment -%}
        Brand and rating share the top row, rating pushed right, as in the
        design reference. Category is its own line under the title rather
        than competing with the brand for the same slot -- previously only
        one of the two could ever show.
      {%- endcomment -%}
      {%- liquid
        assign has_rating = false
        if show_rating and product.metafields.reviews.rating.value != blank
          assign has_rating = true
        endif
        assign has_brand = false
        if show_vendor and product.vendor != blank
          assign has_brand = true
        endif
      -%}
      {%- if has_brand or has_rating -%}
        <div class="pcard__brow">
          {%- if has_brand -%}<span class="pcard__brand">{{ product.vendor }}</span>{%- endif -%}
          {%- if has_rating -%}
            {%- liquid
              assign rating_val = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value | times: 1.0
              assign rating_count = product.metafields.reviews.rating_count.value | default: 0
              assign rating_rounded = rating_val | round
            -%}
            <span class="pcard__rating" aria-label="Rated {{ rating_val }} out of 5">
              <span class="pcard__stars" aria-hidden="true">
                {%- for i in (1..5) -%}
                  <span class="pcard__star{% if i <= rating_rounded %} is-on{% endif %}">★</span>
                {%- endfor -%}
              </span>
              {%- if rating_count > 0 -%}<span class="pcard__rating-count">({{ rating_count }})</span>{%- endif -%}
            </span>
          {%- endif -%}
        </div>
      {%- endif -%}

      <span class="pcard__name"><a href="{{ product.url }}">{{ product.title }}</a></span>

      {%- if show_category and product.type != blank -%}
        <span class="pcard__cat">{{ product.type }}</span>
      {%- endif -%}

      {%- comment -%}
        Carried for the list view, where the reference shows a short
        description. Hidden in the grid by CSS.
      {%- endcomment -%}
      {%- if product.description != blank -%}
        <p class="pcard__desc">{{ product.description | strip_html | truncatewords: 22 }}</p>
      {%- endif -%}

      <span class="pcard__price">
        {%- if show_price_compare and product.compare_at_price > product.price -%}
          {%- assign off_pc = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
          <span class="pcard__price-now">{{ product.price | money }}</span>
          <s class="pcard__price-was">{{ product.compare_at_price | money }}</s>
          <span class="pcard__off">&minus;{{ off_pc }}%</span>
        {%- else -%}
          <span class="pcard__price-now">{{ product.price | money }}</span>
        {%- endif -%}
      </span>


      {%- comment -%}
        Colour swatches. Each swatch carries the image of the first variant in
        that colour, so hovering previews it without a request. The CSS named
        colour is a deliberate fallback: a merchant who names an option
        "Sand" gets a neutral chip rather than a broken one.
      {%- endcomment -%}
      {%- if show_swatches -%}
        {%- for opt in product.options_with_values -%}
          {%- assign opt_key = opt.name | downcase | strip -%}
          {%- if opt_key == 'color' or opt_key == 'colour' -%}
            <span class="pcard__swatches" aria-label="{{ opt.values.size }} colours">
              {%- for val in opt.values limit: 6 -%}
                {%- liquid
                  assign sw_variant = nil
                  for v in product.variants
                    if v.options contains val
                      assign sw_variant = v
                      break
                    endif
                  endfor

                  # Finding the image to preview. Relying on the variant having
                  # its own image only works in stores that assign one per
                  # colour, which most do not -- clicking a swatch then had
                  # nothing to swap to and appeared dead. Fall back to matching
                  # a product image by alt text, which is how merchants
                  # normally label colourways.
                  assign sw_image = nil
                  if sw_variant != nil and sw_variant.featured_image != blank
                    assign sw_image = sw_variant.featured_image
                  endif
                  assign val_key = val | downcase | strip
                  if sw_image == nil
                    for im in product.images
                      assign im_alt = im.alt | downcase
                      if im_alt contains val_key
                        assign sw_image = im
                        break
                      endif
                    endfor
                  endif
                -%}
                <button
                  type="button"
                  class="pcard__swatch"
                  style="{%- render 'swatch-style', label: val -%}"
                  title="{{ val | escape }}"
                  aria-label="{{ val | escape }}"
                  {% if sw_image != nil %}data-swatch-image="{{ sw_image | image_url: width: 700 }}"{% endif %}
                  {% if sw_variant != nil %}data-swatch-variant="{{ sw_variant.id }}"{% endif %}
                  aria-pressed="false"
                ></button>
              {%- endfor -%}
              {%- if opt.values.size > 6 -%}
                <span class="pcard__swatch-more">+{{ opt.values.size | minus: 6 }}</span>
              {%- endif -%}
            </span>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      {%- comment -%}
        Sizes as a readable line under the swatches, sold-out values struck
        through, as the reference shows. The hover chips over the image stay
        for quick-add; this is the at-a-glance version and survives on touch,
        where there is no hover.
      {%- endcomment -%}
      {%- if show_sizes -%}
        {%- for opt in product.options_with_values -%}
          {%- assign size_key = opt.name | downcase | strip -%}
          {%- if size_key contains 'size' -%}
            <span class="pcard__sizeline">
              {%- for val in opt.values -%}
                {%- liquid
                  assign val_in_stock = false
                  for v in product.variants
                    if v.options contains val and v.available
                      assign val_in_stock = true
                      break
                    endif
                  endfor
                -%}
                {%- if val_in_stock -%}{{ val }}{%- else -%}<s>{{ val }}</s>{%- endif -%}
                {%- unless forloop.last %} &middot; {% endunless -%}
              {%- endfor -%}
            </span>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      {%- comment -%}
        Material and low stock share the last row, as in the reference.
      {%- endcomment -%}
      {%- liquid
        assign show_mat = false
        if show_material and product.metafields.custom.material.value != blank
          assign show_mat = true
        endif
        assign show_low = false
        if show_low_stock and stock_tracked and stock_total > 0 and stock_total <= low_stock_threshold
          assign show_low = true
        endif
      -%}
      {%- if show_mat or show_low -%}
        <span class="pcard__meta">
          {%- if show_mat -%}<span class="pcard__material">{{ product.metafields.custom.material.value }}</span>{%- endif -%}
          {%- if show_low -%}<span class="pcard__low">{{ 'products.product.only_left' | t: count: stock_total }}</span>{%- endif -%}
        </span>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}
