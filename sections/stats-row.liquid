{%- comment -%}
  A row of figures in the design's language: an optional eyebrow and heading,
  large display numerals with small muted labels, on any of the design's
  surfaces.
{%- endcomment -%}
{%- assign ss = section.settings -%}
<section class="mn-stats mn-stats--{{ ss.align }}" id="section-{{ section.id }}"{% if ss.surface != 'base' %} data-surface="{{ ss.surface }}"{% endif %}>
  <div class="mn-container">
    {%- if ss.eyebrow != blank or ss.heading != blank -%}
      <div class="mn-stats__head">
        {%- if ss.eyebrow != blank -%}<span class="mn-eyebrow">{{ ss.eyebrow }}</span>{%- endif -%}
        {%- if ss.heading != blank -%}<h2 class="section-title">{{ ss.heading }}</h2>{%- endif -%}
      </div>
    {%- endif -%}
    <dl class="mn-stats__grid" style="--stats:{{ section.blocks.size | at_least: 1 }}">
      {%- for block in section.blocks -%}
        <div class="mn-stat" {{ block.shopify_attributes }}>
          <dt class="mn-stat__value">{{ block.settings.value }}</dt>
          <dd class="mn-stat__text">
            <span class="mn-stat__label">{{ block.settings.label }}</span>
            {%- if block.settings.description != blank -%}<span class="mn-stat__desc">{{ block.settings.description }}</span>{%- endif -%}
          </dd>
        </div>
      {%- endfor -%}
    </dl>
  </div>
</section>

{% schema %}
{
  "name": "Stats Row",
  "tag": "div",
  "class": "section-stats-row",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading" },
    {
      "type": "select", "id": "align", "label": "Alignment",
      "options": [ { "value": "center", "label": "Centre" }, { "value": "left", "label": "Left" } ],
      "default": "center"
    },
    {
      "type": "select", "id": "surface", "label": "Background",
      "options": [
        { "value": "base", "label": "Page colour" },
        { "value": "soft", "label": "Soft" },
        { "value": "deep", "label": "Deep" },
        { "value": "invert", "label": "Inverted" }
      ],
      "default": "base"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "value",       "label": "Value",       "default": "100+" },
        { "type": "text", "id": "label",       "label": "Label",       "default": "Global Stockists" },
        { "type": "text", "id": "description", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stats Row",
      "blocks": [
        { "type": "stat", "settings": { "value": "2009", "label": "Founded" } },
        { "type": "stat", "settings": { "value": "47", "label": "Artisans" } },
        { "type": "stat", "settings": { "value": "32", "label": "Countries" } },
        { "type": "stat", "settings": { "value": "100%", "label": "Made in Italy" } }
      ]
    }
  ]
}
{% endschema %}
