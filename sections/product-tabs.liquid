{%- liquid
  assign s = section.settings

  assign demo_names = 'Alba Draped Coat,Sera Silk Dress,No. 03 Soft Bag,Linea Leather Mule,Vela Wool Blazer,Onda Pleated Skirt,Rive Cashmere Knit,Sable Leather Tote' | split: ','
  assign demo_prices = '$890|$540|$620|$390|$760|$420|$480|$690' | split: '|'
  assign demo_cats = 'Outerwear,Dresses,Leather goods,Shoes,Tailoring,Skirts,Knitwear,Leather goods' | split: ','
  assign d1 = 'https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=700&q=80'
  assign d2 = 'https://images.unsplash.com/photo-1525507119028-ed4c629a60a3?auto=format&fit=crop&w=700&q=80'
  assign d3 = 'https://images.unsplash.com/photo-1543163521-1bf539c55dd2?auto=format&fit=crop&w=700&q=80'
  assign d4 = 'https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=700&q=80'
  assign d5 = 'https://images.unsplash.com/photo-1469334031218-e382a71b716b?auto=format&fit=crop&w=700&q=80'
  assign d6 = 'https://images.unsplash.com/photo-1520975954732-35dd22299614?auto=format&fit=crop&w=700&q=80'
  assign d7 = 'https://images.unsplash.com/photo-1566174053879-31528523f8ae?auto=format&fit=crop&w=700&q=80'
  assign d8 = 'https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=700&q=80'
  assign demo_imgs_str = d1 | append: '||' | append: d2 | append: '||' | append: d3 | append: '||' | append: d4 | append: '||' | append: d5 | append: '||' | append: d6 | append: '||' | append: d7 | append: '||' | append: d8
  assign demo_imgs = demo_imgs_str | split: '||'
-%}

<section
  id="section-{{ section.id }}"
  class="ptab ptab--{{ s.scheme }}"
  data-section-id="{{ section.id }}"
  data-qv-scheme="{{ s.scheme }}"
>
  <div class="ptab-inner">
    <div class="ptab-head reveal">
      <div class="ptab-head__l">
        {%- if s.eyebrow != blank -%}<p class="ptab-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="ptab-heading">{{ s.heading }}</h2>{%- endif -%}
      </div>

      {%- if section.blocks.size > 1 -%}
        <div class="ptab-tabs" role="tablist" aria-label="{{ s.heading | default: 'Product filters' | escape }}">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="ptab-tab{% if forloop.first %} is-active{% endif %}"
              role="tab"
              id="tab-{{ section.id }}-{{ forloop.index }}"
              aria-controls="panel-{{ section.id }}-{{ forloop.index }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              data-ptab-tab="{{ forloop.index }}"
              {{ block.shopify_attributes }}
            >{{ block.settings.label }}</button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      {%- liquid
        assign col = collections[block.settings.collection]
        assign offset = forloop.index0 | times: 2
      -%}
      <div
        class="ptab-panel{% if forloop.first %} is-active{% endif %}"
        id="panel-{{ section.id }}-{{ forloop.index }}"
        role="tabpanel"
        aria-labelledby="tab-{{ section.id }}-{{ forloop.index }}"
        data-ptab-panel="{{ forloop.index }}"
        {% unless forloop.first %}hidden{% endunless %}
      >
        <div class="ptab-grid" style="--ptab-cols: {{ s.columns }};">
          {%- if col != blank and col.products.size > 0 -%}
            {%- for product in col.products limit: s.products_to_show -%}
              <div class="ptab-item reveal">{%- render 'product-card', product: product, scheme: s.scheme -%}</div>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..8) -%}
              {%- if forloop.index > s.products_to_show -%}{%- break -%}{%- endif -%}
              {%- assign idx = forloop.index0 | plus: offset | modulo: 8 -%}
              <div class="ptab-item reveal">{%- render 'product-card',
                scheme: s.scheme,
                demo_index: idx,
                demo_title: demo_names[idx],
                demo_price: demo_prices[idx],
                demo_category: demo_cats[idx],
                demo_image: demo_imgs[idx],
                demo_url: '/collections/all' -%}</div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}

    {%- if s.cta_label != blank -%}
      <div class="ptab-foot reveal">
        <a class="ptab-cta" href="{{ s.cta_url | default: '/collections/all' }}">
          {{ s.cta_label }}<span aria-hidden="true">&#8594;</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  #section-{{ section.id }}.ptab--light { --bg:var(--s2-bg,#131313); --fg:var(--s2-fg,#F5F0E8); --acc:var(--gold,#C8A96E); --mut:var(--s2-mut,rgba(245,240,232,.62)); --bdr:var(--s2-bdr,rgba(245,240,232,.16)); }
  #section-{{ section.id }}.ptab--dark  { --bg:var(--s1-bg,#0A0A0A); --fg:var(--s1-fg,#F5F0E8); --acc:var(--gold,#C8A96E); --mut:var(--s1-mut,rgba(245,240,232,.62)); --bdr:var(--s1-bdr,rgba(245,240,232,.16)); }
  #section-{{ section.id }}.ptab--warm  { --bg:var(--s3-bg,#1A1714); --fg:var(--s3-fg,#F5F0E8); --acc:var(--gold,#C8A96E); --mut:var(--s3-mut,rgba(245,240,232,.62)); --bdr:var(--s3-bdr,rgba(245,240,232,.16)); }
  #section-{{ section.id }}.ptab--theme { --bg:var(--s1-bg,#0A0A0A); --fg:var(--s1-fg,#F5F0E8); --acc:var(--gold,#C8A96E); --mut:var(--s1-mut,rgba(245,240,232,.62)); --bdr:var(--s1-bdr,rgba(245,240,232,.16)); }

  #section-{{ section.id }} { background: var(--bg); color: var(--fg); padding: clamp(72px,9vh,112px) 0; }
  #section-{{ section.id }} .ptab-inner { padding: 0 var(--side-padding,5vw); }

  #section-{{ section.id }} .ptab-head {
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: clamp(20px,4vw,44px); margin-bottom: clamp(26px,3.6vh,38px);
  }
  #section-{{ section.id }} .ptab-eyebrow {
    margin: 0 0 12px;
    font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: calc(12px * var(--fs-scale, 1));
    font-weight: 600; letter-spacing: .22em; text-transform: uppercase;
    color: var(--acc);
  }
  #section-{{ section.id }} .ptab-heading {
    margin: 0;
    font-family: var(--ff-display,'Cormorant Garamond',serif);
    font-weight: 300;
    font-size: calc(clamp(34px,4.4vw,58px) * var(--heading-scale,1));
    line-height: 1.02;
  }

  #section-{{ section.id }} .ptab-tabs { display: flex; align-items: center; gap: clamp(14px,2vw,24px); flex-wrap: wrap; }
  #section-{{ section.id }} .ptab-tab {
    padding: 0 0 5px; border: 0; border-bottom: 1px solid transparent;
    background: transparent; cursor: pointer;
    font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: calc(12px * var(--fs-scale, 1));
    font-weight: 600; letter-spacing: .16em; text-transform: uppercase;
    color: var(--mut);
    transition: color .2s ease, border-color .2s ease;
  }
  #section-{{ section.id }} .ptab-tab:hover { color: var(--fg); }
  #section-{{ section.id }} .ptab-tab.is-active { color: var(--fg); border-bottom-color: var(--acc); }
  #section-{{ section.id }} .ptab-tab:focus-visible { outline: 2px solid var(--acc); outline-offset: 3px; }

  #section-{{ section.id }} .ptab-panel[hidden] { display: none; }
  #section-{{ section.id }} .ptab-grid {
    display: grid; gap: clamp(22px,2vw,30px) 10px;
    grid-template-columns: repeat(var(--ptab-cols, 4), minmax(0, 1fr));
  }
  #section-{{ section.id }} .ptab-item { min-width: 0; }

  #section-{{ section.id }} .ptab-foot { margin-top: clamp(32px,4vh,48px); text-align: center; }
  #section-{{ section.id }} .ptab-cta {
    display: inline-flex; align-items: center; gap: 10px;
    padding-bottom: 4px; border-bottom: 1px solid currentColor;
    font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: calc(12px * var(--fs-scale, 1));
    font-weight: 600; letter-spacing: .16em; text-transform: uppercase;
    text-decoration: none; color: var(--fg);
  }
  #section-{{ section.id }} .ptab-cta:hover { color: var(--acc); }

  #section-{{ section.id }} .reveal.reveal-armed { opacity: 0; transform: translateY(20px); transition: opacity .7s ease, transform .7s ease; }
  #section-{{ section.id }} .reveal.is-visible { opacity: 1; transform: none; }

  @media (max-width: 1100px) {
    #section-{{ section.id }} .ptab-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 860px) {
    #section-{{ section.id }} .ptab-head { flex-direction: column; align-items: flex-start; gap: 18px; }
    #section-{{ section.id }} .ptab-tabs {
      width: 100%; flex-wrap: nowrap; overflow-x: auto;
      -webkit-overflow-scrolling: touch; scrollbar-width: none;
    }
    #section-{{ section.id }} .ptab-tabs::-webkit-scrollbar { display: none; }
    #section-{{ section.id }} .ptab-tab { flex: 0 0 auto; }
    #section-{{ section.id }} .ptab-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>

<script>
(function(){
  var SEC='{{ section.id }}';
  function root(){return document.getElementById('section-'+SEC);}

  function bindTabs(r){
    var tabs=r.querySelectorAll('[data-ptab-tab]');
    var panels=r.querySelectorAll('[data-ptab-panel]');
    function activate(key){
      tabs.forEach(function(t){
        var on=t.getAttribute('data-ptab-tab')===key;
        t.classList.toggle('is-active',on);
        t.setAttribute('aria-selected',on?'true':'false');
      });
      panels.forEach(function(p){
        var on=p.getAttribute('data-ptab-panel')===key;
        p.classList.toggle('is-active',on);
        if(on){p.removeAttribute('hidden');}else{p.setAttribute('hidden','');}
      });
      r.querySelectorAll('.ptab-panel:not([hidden]) .reveal').forEach(function(el){el.classList.add('is-visible');});
    }
    tabs.forEach(function(t){
      t.addEventListener('click',function(){activate(t.getAttribute('data-ptab-tab'));});
      t.addEventListener('keydown',function(e){
        if(e.key!=='ArrowRight'&&e.key!=='ArrowLeft')return;
        e.preventDefault();
        var list=Array.prototype.slice.call(tabs);
        var i=list.indexOf(t);
        var n=e.key==='ArrowRight'?(i+1)%list.length:(i-1+list.length)%list.length;
        list[n].focus();
        activate(list[n].getAttribute('data-ptab-tab'));
      });
    });
  }

  function arm(r){
    var els=r.querySelectorAll('.reveal');
    els.forEach(function(el){el.classList.add('reveal-armed');});
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('is-visible');io.unobserve(e.target);}});},{threshold:.12});
    els.forEach(function(el){io.observe(el);});
    setTimeout(function(){els.forEach(function(el){el.classList.add('is-visible');});},800);
  }

  function init(){var r=root();if(!r)return;bindTabs(r);arm(r);}
  document.addEventListener('DOMContentLoaded',init);
  document.addEventListener('shopify:section:load',function(e){
    if(e.detail.sectionId!==SEC)return;
    var r=root();if(!r)return;
    bindTabs(r);arm(r);
    r.querySelectorAll('.reveal').forEach(function(el){el.classList.add('is-visible');});
  });
})();
</script>

{% schema %}
{
  "name": "Product Tabs",
  "tag": "section",
  "class": "section-product-tabs",
  "max_blocks": 4,
  "settings": [
    {
      "type": "select", "id": "scheme", "label": "Surface tone",
      "options": [
        { "value": "light", "label": "Alternate surface (soft)" },
        { "value": "dark",  "label": "Primary surface" },
        { "value": "warm",  "label": "Deep surface" },
        { "value": "theme", "label": "Primary surface (follow theme)" }
      ],
      "default": "dark"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New arrivals" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The latest edit" },
    { "type": "range", "id": "products_to_show", "label": "Products per tab", "min": 2, "max": 8, "step": 1, "default": 4 },
    {
      "type": "select", "id": "columns", "label": "Columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    { "type": "text", "id": "cta_label", "label": "Footer link label", "default": "View all new arrivals" },
    { "type": "url",  "id": "cta_url",   "label": "Footer link" }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "default": "View all" },
        { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to show demo products." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Tabs",
      "blocks": [
        { "type": "tab", "settings": { "label": "View all" } },
        { "type": "tab", "settings": { "label": "Ready-to-wear" } },
        { "type": "tab", "settings": { "label": "Accessories" } }
      ]
    }
  ]
}
{% endschema %}
