{%- comment -%}
  Password (coming soon) page, in the design's language: wordmark or logo,
  eyebrow, display heading, the store's password message, a newsletter
  sign-up and the storefront password form, which opens in place and stays
  open when the password was wrong. Optional image beside it.
{%- endcomment -%}
{%- liquid
  assign ss = section.settings
  assign pw_open = false
-%}
{%- capture pw_form -%}
  {%- form 'storefront_password', class: 'mn-pwpage__pwform' -%}
    {%- if form.errors -%}
      {%- assign pw_open = true -%}
      <div class="mn-alert mn-alert--error" role="alert">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <div class="mn-field">
      {%- assign pw_label = 'mn.pw.password' | t -%}
      {%- render 'mn-password', id: 'StorePassword', section_id: section.id, name: 'password', autocomplete: 'current-password', label: pw_label -%}
    </div>
    <button type="submit" class="mn-btn mn-btn--block">{{ 'mn.pw.enter' | t }}</button>
  {%- endform -%}
{%- endcapture -%}
<div class="mn-pwpage{% if ss.image %} mn-pwpage--image{% endif %}" id="section-{{ section.id }}">
  <div class="mn-pwpage__main">
    <a href="{{ routes.root_url }}" class="mn-pwpage__logo">
      {%- if settings.logo -%}
        {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
        {{ settings.logo | image_url: width: 400 | image_tag: alt: logo_alt, style: 'max-width:180px;height:auto' }}
      {%- else -%}
        {{ settings.logo_text | default: shop.name }}
      {%- endif -%}
    </a>

    <div class="mn-pwpage__body">
      <span class="mn-eyebrow">{{ ss.eyebrow }}</span>
      <h1 class="mn-pwpage__title">{{ ss.heading }}</h1>
      {%- if shop.password_message != blank -%}
        <p class="mn-content__lead">{{ shop.password_message }}</p>
      {%- elsif ss.text != blank -%}
        <div class="mn-content__lead rte">{{ ss.text }}</div>
      {%- endif -%}

      {%- if ss.show_newsletter -%}
        {%- form 'customer', class: 'mn-pwpage__news' -%}
          <input type="hidden" name="contact[tags]" value="newsletter, password page">
          {%- if form.posted_successfully? -%}
            <p class="mn-alert mn-alert--ok" role="status"><svg class="icon icon--sm" aria-hidden="true"><use href="#i-check"></use></svg>{{ 'mn.pw.subscribed' | t }}</p>
          {%- else -%}
            {%- if form.errors -%}<div class="mn-alert mn-alert--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
            <span class="mn-field__label">{{ ss.newsletter_label }}</span>
            <div class="mn-searchpage__form">
              <label class="mn-searchpage__field">
                <svg class="icon" aria-hidden="true"><use href="#i-mail"></use></svg>
                <input type="email" name="contact[email]" placeholder="{{ 'mn.pw.email' | t }}" aria-label="{{ 'mn.pw.email' | t }}" autocomplete="email" autocorrect="off" autocapitalize="off" required>
              </label>
              <button type="submit" class="mn-btn">{{ 'mn.pw.notify' | t }}</button>
            </div>
          {%- endif -%}
        {%- endform -%}
      {%- endif -%}

      <div class="mn-pwpage__enter">
        <button type="button" class="link-quiet" data-acct-toggle="PwPanel" aria-controls="PwPanel" aria-expanded="{{ pw_open }}"><svg class="icon icon--sm" aria-hidden="true"><use href="#i-lock"></use></svg>{{ 'mn.pw.open' | t }}</button>
        <div class="mn-acct__card mn-pwpage__panel" id="PwPanel"{% unless pw_open %} hidden{% endunless %}>{{ pw_form }}</div>
      </div>
    </div>

    <p class="mn-pwpage__foot">
      <span>{{ 'mn.pw.owner' | t }} <a href="/admin" class="link-quiet">{{ 'mn.pw.admin' | t }}</a></span>
      <span>{{ powered_by_link }}</span>
    </p>
  </div>
  {%- if ss.image -%}
    <div class="mn-pwpage__media">
      {{ ss.image | image_url: width: 1800 | image_tag: loading: 'eager', class: 'mn-fill', sizes: '50vw', alt: '' }}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Password page",
  "tag": "section",
  "class": "section-main-password",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Opening soon" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Something <em>considered</em> is coming" },
    { "type": "richtext", "id": "text", "label": "Text", "info": "Used when no message is set in Online Store → Preferences → Password protection.", "default": "<p>We are putting the finishing touches to the collection. Leave your email and you will be the first to know.</p>" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show email sign-up", "default": true },
    { "type": "text", "id": "newsletter_label", "label": "Sign-up label", "default": "Be the first to know" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Shown beside the text on wide screens." }
  ]
}
{% endschema %}
