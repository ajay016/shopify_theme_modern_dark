{%- comment -%}
  One journal article, in the design's language: breadcrumb, eyebrow, display
  title, byline, hero image, a reading column, share (copy link and
  networks), previous / next, "more from the journal" and comments with the
  design's fields. Optional sidebar left or right.
{%- endcomment -%}
{%- liquid
  assign ss = section.settings
  assign side = ss.sidebar | default: 'none'
  assign words = article.content | strip_html | split: ' '
  assign minutes = words.size | divided_by: 220 | at_least: 1
  assign share_url = shop.url | append: article.url
-%}
<article class="mn-content mn-article mn-article--{{ ss.width }}" id="section-{{ section.id }}" itemscope itemtype="http://schema.org/BlogPosting">
  <div class="mn-container">
    <nav class="mn-breadcrumb" aria-label="{{ 'mn.pdp.breadcrumb' | t }}">
      <a href="{{ routes.root_url }}">{{ 'mn.pdp.home' | t }}</a><span class="sep">/</span>
      <a href="{{ blog.url }}">{{ blog.title }}</a><span class="sep">/</span>
      <span aria-current="page">{{ article.title | truncate: 48 }}</span>
    </nav>

    <header class="mn-article__head">
      <span class="mn-eyebrow mn-post__meta">
        {%- if article.tags.size > 0 -%}<a href="{{ blog.url }}/tagged/{{ article.tags.first | handle }}">{{ article.tags.first }}</a>{%- endif -%}
        <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}" itemprop="datePublished">{{ article.published_at | date: '%B %-d, %Y' }}</time>
      </span>
      <h1 class="mn-article__title" itemprop="headline">{{ article.title }}</h1>
      {%- if article.excerpt != blank and ss.show_excerpt -%}<div class="mn-article__dek">{{ article.excerpt | strip_html }}</div>{%- endif -%}
      <p class="mn-article__byline">
        {%- if article.author != blank -%}<span itemprop="author" itemscope itemtype="http://schema.org/Person"><span itemprop="name">{{ 'mn.journal.by' | t: author: article.author }}</span></span>{%- endif -%}
        {%- if ss.show_reading_time -%}<span>{{ 'mn.journal.minutes' | t: count: minutes }}</span>{%- endif -%}
      </p>
    </header>

    {%- if article.image -%}
      <figure class="mn-article__hero" itemprop="image">
        {%- assign hero_alt = article.image.alt | default: article.title | escape -%}
        {{ article.image | image_url: width: 2000 | image_tag: loading: 'eager', fetchpriority: 'high', class: 'mn-article__hero-img', alt: hero_alt, widths: '800,1200,1600,2000', sizes: '(min-width: 1320px) 1224px, 100vw' }}
      </figure>
    {%- endif -%}

    <div class="mn-article__layout mn-article__layout--{{ side }}">
      <div class="mn-article__main">
        <div class="mn-prose rte" itemprop="articleBody">{{ article.content }}</div>

        {%- if article.tags.size > 0 -%}
          <div class="mn-article__tags search__chips">
            {%- for tag in article.tags -%}<a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="chip">{{ tag }}</a>{%- endfor -%}
          </div>
        {%- endif -%}

        {%- if ss.show_share -%}
          <div class="mn-article__share">
            <span class="mn-eyebrow">{{ 'blogs.article.share' | t }}</span>
            <button type="button" class="icon-btn" data-copy-link="{{ share_url }}" data-copied="{{ 'mn.journal.copied' | t }}" aria-label="{{ 'mn.journal.copy_link' | t }}"><svg class="icon icon--sm" aria-hidden="true"><use href="#i-link"></use></svg></button>
            <a class="icon-btn" href="https://www.facebook.com/sharer.php?u={{ share_url | url_encode }}" target="_blank" rel="noopener" aria-label="Facebook"><svg class="icon icon--sm" aria-hidden="true"><use href="#i-facebook"></use></svg></a>
            <a class="icon-btn" href="https://twitter.com/intent/tweet?url={{ share_url | url_encode }}&text={{ article.title | url_encode }}" target="_blank" rel="noopener" aria-label="X"><svg class="icon icon--sm" aria-hidden="true"><use href="#i-x"></use></svg></a>
            <a class="icon-btn" href="https://pinterest.com/pin/create/button/?url={{ share_url | url_encode }}{% if article.image %}&media={{ article.image | image_url: width: 1200 | prepend: 'https:' | url_encode }}{% endif %}&description={{ article.title | url_encode }}" target="_blank" rel="noopener" aria-label="Pinterest"><svg class="icon icon--sm" aria-hidden="true"><use href="#i-pinterest"></use></svg></a>
            <a class="icon-btn" href="mailto:?subject={{ article.title | url_encode }}&body={{ share_url | url_encode }}" aria-label="{{ 'mn.journal.email' | t }}"><svg class="icon icon--sm" aria-hidden="true"><use href="#i-mail"></use></svg></a>
          </div>
        {%- endif -%}

        {%- if blog.previous_article or blog.next_article -%}
          <nav class="mn-article__pager" aria-label="{{ 'mn.journal.more' | t }}">
            {%- if blog.previous_article -%}<a href="{{ blog.previous_article.url | default: blog.previous_article }}" class="mn-article__prev"><span class="mn-eyebrow">{{ 'mn.journal.previous' | t }}</span><span>{{ blog.previous_article.title | default: blog.title }}</span></a>{%- else -%}<span></span>{%- endif -%}
            {%- if blog.next_article -%}<a href="{{ blog.next_article.url | default: blog.next_article }}" class="mn-article__next"><span class="mn-eyebrow">{{ 'mn.journal.next' | t }}</span><span>{{ blog.next_article.title | default: blog.title }}</span></a>{%- endif -%}
          </nav>
        {%- endif -%}

        {%- if blog.comments_enabled? and ss.show_comments -%}
          <div class="mn-article__comments" id="comments">
            <h2 class="mn-acct__title">{{ 'blogs.comments.comments_with_count' | t: count: article.comments_count }}</h2>
            {%- if article.comments_count > 0 -%}
              {%- paginate article.comments by 10 -%}
                {%- for comment in article.comments -%}
                  <div class="mn-comment" id="comment-{{ comment.id }}">
                    <span class="mn-comment__avatar" aria-hidden="true">{{ comment.author | slice: 0 }}</span>
                    <div>
                      <p class="mn-comment__meta"><b>{{ comment.author }}</b><time datetime="{{ comment.created_at | date: '%Y-%m-%d' }}">{{ comment.created_at | date: '%B %-d, %Y' }}</time></p>
                      <div class="mn-comment__body rte">{{ comment.content }}</div>
                    </div>
                  </div>
                {%- endfor -%}
                {%- if paginate.pages > 1 -%}{%- render 'mn-pagination', paginate: paginate -%}{%- endif -%}
              {%- endpaginate -%}
            {%- endif -%}
            {%- form 'new_comment', article, class: 'mn-acct__card mn-comment-form' -%}
              <h3 class="mn-acct__card-title">{{ 'mn.journal.leave' | t }}</h3>
              {%- if form.posted_successfully? -%}
                <p class="mn-alert mn-alert--ok" role="status"><svg class="icon icon--sm" aria-hidden="true"><use href="#i-check"></use></svg>{%- if blog.moderated? -%}{{ 'mn.journal.moderated' | t }}{%- else -%}{{ 'blogs.comments.success' | t }}{%- endif -%}</p>
              {%- endif -%}
              {%- if form.errors -%}<div class="mn-alert mn-alert--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
              <div class="mn-auth__pair">
                <label class="mn-field"><span class="mn-field__label">{{ 'blogs.comments.name' | t }}</span><input class="input" type="text" name="comment[author]" value="{{ form.author }}" autocomplete="name" required></label>
                <label class="mn-field"><span class="mn-field__label">{{ 'blogs.comments.email' | t }}</span><input class="input" type="email" name="comment[email]" value="{{ form.email }}" autocomplete="email" required></label>
              </div>
              <label class="mn-field"><span class="mn-field__label">{{ 'blogs.comments.message' | t }}</span><textarea class="input" name="comment[body]" rows="5" required>{{ form.body }}</textarea></label>
              {%- if blog.moderated? -%}<p class="mn-acct__muted">{{ 'mn.journal.moderated_note' | t }}</p>{%- endif -%}
              <button type="submit" class="mn-btn">{{ 'blogs.comments.post' | t }}</button>
            {%- endform -%}
          </div>
        {%- endif -%}
      </div>

      {%- if side != 'none' -%}
        <aside class="mn-article__aside">
          <div class="mn-acct__card">
            <span class="mn-acct__card-title">{{ 'blogs.sidebar.recent' | t }}</span>
            <ul class="mn-blog__recent">
              {%- for a in blog.articles limit: 5 -%}
                {%- unless a.id == article.id -%}
                  <li><a href="{{ a.url }}">
                    <span class="mn-blog__recent-img">{%- if a.image -%}{{ a.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', class: 'mn-fill', sizes: '64px' }}{%- endif -%}</span>
                    <span><span class="mn-blog__recent-title">{{ a.title }}</span><time datetime="{{ a.published_at | date: '%Y-%m-%d' }}">{{ a.published_at | date: '%b %-d, %Y' }}</time></span>
                  </a></li>
                {%- endunless -%}
              {%- endfor -%}
            </ul>
          </div>
        </aside>
      {%- endif -%}
    </div>
  </div>

  {%- if ss.show_more -%}
    {%- liquid
      assign more = 0
      for a in blog.articles limit: 4
        unless a.id == article.id
          assign more = more | plus: 1
        endunless
      endfor
    -%}
    {%- if more > 0 -%}
      <section class="mn-section mn-article__more">
        <div class="mn-container">
          <div class="mn-section__head">
            <div><span class="mn-eyebrow">{{ blog.title }}</span><h2 class="section-title">{{ ss.more_heading }}</h2></div>
            <a href="{{ blog.url }}" class="link-arrow">{{ 'mn.searchpage.view_all' | t }}<svg class="icon" aria-hidden="true"><use href="#i-arrow-right"></use></svg></a>
          </div>
          <div class="mn-blog__posts mn-blog__posts--row">
            {%- assign shown = 0 -%}
            {%- for a in blog.articles limit: 4 -%}
              {%- if a.id != article.id and shown < 3 -%}
                {%- assign shown = shown | plus: 1 -%}
                {%- render 'mn-article-card', article: a, show_author: false, show_excerpt: false -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </section>
    {%- endif -%}
  {%- endif -%}
</article>

{% schema %}
{
  "name": "Article",
  "tag": "div",
  "class": "section-main-article",
  "settings": [
    {
      "type": "select", "id": "sidebar", "label": "Sidebar",
      "options": [
        { "value": "none",  "label": "None" },
        { "value": "left",  "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "none"
    },
    {
      "type": "select", "id": "width", "label": "Reading width",
      "options": [
        { "value": "narrow", "label": "Narrow" },
        { "value": "wide",   "label": "Wide" }
      ],
      "default": "narrow"
    },
    { "type": "checkbox", "id": "show_excerpt",      "label": "Show excerpt under the title", "default": true },
    { "type": "checkbox", "id": "show_reading_time", "label": "Show Reading Time",   "default": true },
    { "type": "checkbox", "id": "show_share",        "label": "Show Share Buttons",  "default": true },
    { "type": "checkbox", "id": "show_comments",     "label": "Show Comments",       "info": "Only when comments are on for the blog in Online Store → Blog posts.", "default": true },
    { "type": "checkbox", "id": "show_more",         "label": "Show more from the journal", "default": true },
    { "type": "inline_richtext", "id": "more_heading", "label": "More heading", "default": "Keep <em>reading</em>" }
  ],
  "presets": [{ "name": "Article" }]
}
{% endschema %}
