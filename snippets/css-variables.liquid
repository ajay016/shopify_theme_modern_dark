{%- comment -%}
  ============================================================
  GLOBAL DESIGN TOKENS — single source of truth for color.

  Every scheme emits a four-rung TONAL LADDER. Each rung ships
  its background together with a matched foreground, so a
  section can never produce an unreadable pairing:

    s1  base      — page background
    s2  soft      — subtle raised / alternate band
    s3  deep      — richest tone of the scheme
    s4  contrast  — deliberate inverted band

  Within a scheme every rung stays on the same side of the
  light/dark divide (except s4, which is intentionally
  inverted), so choosing "Light / Ivory" keeps the whole site
  light and choosing "Dark Luxury" keeps it dark.

  DELIBERATELY FILTER-FREE. Every value below is a literal.
  An earlier version derived the alphas with color_modify /
  color_brightness; if any of those failed the whole :root
  block was lost and the literal fallbacks scattered through
  theme.css (which are dark) repainted the entire site, making
  the scheme setting look like it did nothing. Keep it literal.
  ============================================================
{%- endcomment -%}
<style>
{%- liquid
  assign scheme = settings.color_scheme | default: 'dark'
-%}

{%- case scheme -%}

{%- when 'light' -%}
  :root {
    --s1-bg: #FFFFFF; --s1-fg: #1A1A1A; --s1-mut: rgba(26,26,26,0.66); --s1-bdr: rgba(26,26,26,0.16);
    --s2-bg: #F7F4EE; --s2-fg: #1A1A1A; --s2-mut: rgba(26,26,26,0.66); --s2-bdr: rgba(26,26,26,0.16);
    --s3-bg: #EDE8DD; --s3-fg: #1A1A1A; --s3-mut: rgba(26,26,26,0.66); --s3-bdr: rgba(26,26,26,0.16);
    --s4-bg: #1A1A1A; --s4-fg: #F7F4EE; --s4-mut: rgba(247,244,238,0.66); --s4-bdr: rgba(247,244,238,0.16);

    --black: #FFFFFF;
    --charcoal: #F7F4EE;
    --cream: #1A1A1A;
    --muted: rgba(26,26,26,0.66);
    --ivory: #0A0A0A;
    --gold: #9B7B3F;
    --gold-light: #C8A96E;
    --on-gold: #0A0A0A;
    --sale-text: #8B1A1A;
    --sale-bg: #FFD5D5;

    --border: rgba(155,123,63,0.30);
    --border-strong: rgba(155,123,63,0.55);
    --gold-dim: rgba(155,123,63,0.14);
    --gold-glow: rgba(155,123,63,0.09);
    --cream-faint: rgba(26,26,26,0.06);
    --black-overlay: rgba(255,255,255,0.78);

    --hdr-bg: #FFFFFF;
    --hdr-fg: #1A1A1A;
    --hdr-mut: rgba(26,26,26,0.66);
    --hdr-bdr: rgba(26,26,26,0.16);
    --hdr-bg-scroll: rgba(255,255,255,0.96);
