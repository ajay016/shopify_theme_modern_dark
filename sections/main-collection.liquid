{% liquid
  assign sidebar_position = section.settings.sidebar_position
  assign filter_style     = section.settings.filter_style
  assign columns          = section.settings.grid_columns | plus: 0
  assign view_default     = section.settings.view_default
  assign pagination_style = section.settings.pagination_style
  assign title_style      = section.settings.title_style
  assign products_per_page = section.settings.products_per_page
  assign container_style  = section.settings.container_style | default: 'boxed'
  assign scheme           = section.settings.scheme | default: 'theme'

    # An empty sidebar is worse than no sidebar: with no Search & Discovery app
    # installed collection.filters is empty, and the layout would otherwise hold
    # a blank 264px column open beside the grid.
  assign has_filters = false
  if collection.filters.size > 0
    assign has_filters = true
  endif
    # With Search & Discovery installed we render Shopify's own filters. Without
    # it the sidebar renders the built-in set derived from the products, so the
    # page has working filters either way and the column is never empty.
  assign use_builtin_filters = false
  if has_filters == false and section.settings.builtin_filters
    assign use_builtin_filters = true
  endif
  assign effective_sidebar = sidebar_position
  if has_filters == false and use_builtin_filters == false
    assign effective_sidebar = 'none'
  endif

    # Demo products keep an empty or brand-new store from showing a blank shop
    # page while the layouts are being reviewed. It fires only when the
    # collection genuinely has no products, and the merchant can switch it off
    # before going live.
  assign use_demo = false
  if collection.products.size == 0 and section.settings.show_demo_when_empty
    assign use_demo = true
  endif

    # A thin catalogue yields only Availability and Price, which reads as a
    # broken panel. Fall back to the demo facet set, which matches the demo
    # cards, whenever the real products cannot produce a useful filter set.
  assign facet_variety = 0
  for p in collection.products limit: 30
    if p.options_with_values.size > 1
      assign facet_variety = facet_variety | plus: 1
    endif
  endfor
  assign filters_are_demo = use_demo
  if use_builtin_filters and facet_variety == 0 and collection.all_tags.size == 0
    assign filters_are_demo = true
  endif
%}

{%- paginate collection.products by products_per_page -%}

<div
  class="collection-page collection-page--{{ container_style }} collection-page--tone-{{ scheme }}"
  id="section-{{ section.id }}"
  data-sidebar="{{ sidebar_position }}"
  data-filter-style="{{ filter_style }}"
>

  {%- comment -%}
    Image banner — a real banner above the header, separate from the title
    styles. Falls back to the collection's own image, so it works the moment a
    merchant uploads one in the admin without touching the theme.
  {%- endcomment -%}
  {%- liquid
    assign banner_img = section.settings.banner_image
    if banner_img == blank
      assign banner_img = collection.image
    endif
  assign banner_on = false
  if section.settings.show_banner and banner_img != blank
    assign banner_on = true
  endif
  -%}
  {%- if banner_on -%}
    <div class="collection-banner collection-banner--{{ section.settings.banner_text_position }}" style="--cb-h: {{ section.settings.banner_height }}vh;">
      {{ banner_img | image_url: width: 2000 | image_tag:
         loading: 'eager', fetchpriority: 'high', class: 'collection-banner__img',
         sizes: '100vw', widths: '800,1200,1600,2000', alt: collection.title }}
      <span class="collection-banner__scrim" aria-hidden="true"></span>
      <div class="collection-banner__copy">
        {%- if section.settings.banner_eyebrow != blank -%}
          <p class="collection-banner__eyebrow">{{ section.settings.banner_eyebrow }}</p>
        {%- endif -%}
        <h1 class="collection-banner__title">{{ collection.title }}</h1>
        {%- if section.settings.banner_show_count -%}
          <p class="collection-banner__count">{{ 'collections.general.items' | t: count: collection.products_count }}</p>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%}
    Collection Title Area. Skipped when the banner is showing, since the banner
    already carries the H1 — two <h1>s on one page is both a duplicate heading
    and an accessibility fault.
  {%- endcomment -%}
  {%- unless banner_on -%}
  <div class="collection-title collection-title--{{ title_style }}">
    {%- case title_style -%}
      {%- when 'style-1' -%}
        <div class="container">
          <h1 class="collection-title__text">{{ collection.title }}</h1>
          {%- if collection.description != blank -%}
            <div class="collection-title__desc rte">{{ collection.description }}</div>
          {%- endif -%}
        </div>
      {%- when 'style-2' -%}
        <div class="collection-title__banner" {% if collection.image %}style="background-image:url({{ collection.image | image_url: width: 1600 }})"{% endif %}>
          <div class="container">
            <h1 class="collection-title__text">{{ collection.title }}</h1>
          </div>
        </div>
      {%- when 'style-3' -%}
        <div class="container">
          <nav class="breadcrumb" aria-label="breadcrumb">
            <a href="/">{{ 'general.home' | t }}</a>
            <span>{{ 'general.breadcrumb_separator' | t }}</span>
            <span>{{ collection.title }}</span>
          </nav>
          <h1 class="collection-title__text collection-title__text--large">{{ collection.title }}</h1>
        </div>
      {%- when 'style-4' -%}
        <div class="collection-title__centered">
          <div class="container">
            <p class="eyebrow">{{ 'collections.general.collection' | t }}</p>
            <h1 class="collection-title__text">{{ collection.title }}</h1>
          </div>
        </div>
      {%- when 'style-5' -%}
        <div class="collection-title__split">
          <div class="container">
            <h1 class="collection-title__text">{{ collection.title }}</h1>
            <p class="collection-title__count">{{ 'collections.general.items' | t: count: collection.products_count }}</p>
          </div>
        </div>
    {%- endcase -%}
  </div>
  {%- endunless -%}

  {%- comment -%} Filter bar (drawer / dropdown styles) {%- endcomment -%}
  {%- if filter_style == 'drawer' or filter_style == 'dropdown' -%}
    <div class="collection-toolbar container">
      {%- if filter_style == 'drawer' -%}
        <button class="toolbar-btn" data-open-filter-drawer>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="14" y2="18"/></svg>
          {{ 'collections.filtering.filter_button' | t }}
          {%- assign active_count = 0 -%}
          {%- for f in collection.filters -%}{%- assign active_count = active_count | plus: f.active_values.size -%}{%- endfor -%}
          {%- if active_count > 0 -%}<span class="filter-count">{{ active_count }}</span>{%- endif -%}
        </button>
      {%- elsif filter_style == 'dropdown' -%}
        <div class="dropdown-filters">
          {%- for filter in collection.filters -%}
            <details class="dropdown-filter" data-filter-group>
              <summary>{{ filter.label }}</summary>
              <div class="dropdown-filter__panel">
                {%- for value in filter.values -%}
                  <label class="filter-check">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"
                      {% if value.active %}checked{% endif %}
                      data-filter-url="{{ value.url_to_add }}"
                      data-filter-remove="{{ value.url_to_remove }}"
                    >
                    <span>{{ value.label }}</span>
                    <span class="filter-count-pill">{{ value.count }}</span>
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="toolbar-right">
        {%- render 'collection-sort' -%}
        {%- if effective_sidebar == 'none' -%}
          {%- render 'collection-view-toggle', columns: columns, current: view_default -%}
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="collection-layout container {% if effective_sidebar != 'none' %}collection-layout--has-sidebar collection-layout--sidebar-{{ effective_sidebar }}{% endif %}">

    {%- comment -%} Left Sidebar {%- endcomment -%}
    {%- if effective_sidebar == 'left' or effective_sidebar == 'right' -%}
      <aside class="collection-sidebar" aria-label="Filters">
        {%- if filter_style != 'drawer' and filter_style != 'dropdown' -%}
          <div class="sidebar-header">
            <h2 class="sidebar-header__title">{{ 'collections.filtering.filters' | t }}</h2>
            {%- liquid
              assign applied = 0
              for f in collection.filters
                assign applied = applied | plus: f.active_values.size
              endfor
            -%}
            {%- if applied > 0 -%}
              <a href="{{ collection.url }}" class="sidebar-clear">{{ 'collections.filtering.clear_all' | t }}</a>
            {%- else -%}
              <span class="sidebar-header__count">{{ 'collections.filtering.applied' | t: count: applied }}</span>
            {%- endif -%}
          </div>

          {%- if use_builtin_filters -%}
            {%- render 'collection-filters', products: collection.products, style: filter_style, demo: filters_are_demo, swatch_style: section.settings.swatch_style -%}
          {%- endif -%}

          {%- comment -%}
            "Toggle groups" is the same sidebar with every group collapsed, so a
            long filter set reads as a short list of headings. A group holding an
            active value still opens, otherwise the applied filter is hidden.
          {%- endcomment -%}
          {%- for filter in collection.filters -%}
            {%- liquid
              assign group_open = true
              if filter_style == 'toggle'
                assign group_open = false
                if filter.active_values.size > 0 or filter.min_value.value or filter.max_value.value
                  assign group_open = true
                endif
              endif
            -%}
            <div class="filter-group" data-filter-group>
              <button class="filter-group__toggle" aria-expanded="{% if group_open %}true{% else %}false{% endif %}">
                {{ filter.label }}
                <span class="fgrp-pm" aria-hidden="true"></span>
              </button>
              <div class="filter-group__body{% unless group_open %} is-collapsed{% endunless %}">
                {%- case filter.type -%}
                  {%- when 'list' -%}
                    {%- comment -%}
                      Shopify ships swatch data on colour filters — value.swatch
                      carries either a colour or an uploaded image. The previous
                      markup ignored it and drew a checkbox, so a Colour filter
                      rendered as a column of empty boxes. When a swatch exists
                      the value becomes a swatch; otherwise it stays a checkbox.
                    {%- endcomment -%}
                    {%- comment -%}
                      A colour filter is detected from the filter itself, not
                      from Shopify swatch data: that metadata only exists once
                      swatches are configured in Search & Discovery, so keying
                      off it showed checkboxes where swatches belong.

                      Swatch presence is probed by rendering the values to a
                      string. `value.swatch != blank` is not reliable for an
                      unset swatch, and treating unset as present turned
                      Availability and Brand into columns of grey dots.
                    {%- endcomment -%}
                    {%- capture sw_probe -%}
                      {%- for value in filter.values -%}{{ value.swatch }}{%- endfor -%}
                    {%- endcapture -%}
                    {%- liquid
                      assign filter_key = filter.label | downcase | strip
                      assign is_swatch_group = false
                      if filter_key contains 'color' or filter_key contains 'colour'
                        assign is_swatch_group = true
                      elsif sw_probe != ''
                        assign is_swatch_group = true
                      endif
                    -%}

                    {%- comment -%}
                      Size reads as something you press, not a tickbox list.
                      Detected from the filter label so it works for "Size",
                      "Shoe size" and so on.
                    {%- endcomment -%}
                    {%- assign is_size_group = false -%}
                    {%- if filter_key contains 'size' -%}{%- assign is_size_group = true -%}{%- endif -%}

                    {%- if is_size_group -%}
                      <div class="cfilter-pills">
                        {%- for value in filter.values -%}
                          <label class="cfilter-pill{% if value.count == 0 %} is-unavailable{% endif %}" title="{{ value.label }}">
                            <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"
                              {% if value.active %}checked{% endif %}
                              data-filter-url="{{ value.url_to_add }}"
                              data-filter-remove="{{ value.url_to_remove }}"
                            >
                            <span>{{ value.label }}</span>
                            <b class="cfilter-pill__n">{{ value.count }}</b>
                          </label>
                        {%- endfor -%}
                      </div>
                    {%- elsif is_swatch_group -%}
                      {%- comment -%}
                        Three presentations, chosen in the theme editor. Only
                        "dots" hides the colour name, and it is not the default:
                        a grid of unlabelled circles forces a shopper to guess
                        what "the beige one" is called.
                      {%- endcomment -%}
                      {%- assign sw_style = section.settings.swatch_style | default: 'list' -%}
                      {%- if filter.values.size > 8 -%}
                        <input type="search" class="filter-search" data-filter-search
                               placeholder="{{ 'collections.filtering.search_values' | t: count: filter.values.size }}"
                               aria-label="{{ 'collections.filtering.search_values' | t: count: filter.values.size }}">
                      {%- endif -%}
                      <div class="filter-swatches filter-swatches--{{ sw_style }}">
                        {%- for value in filter.values -%}
                          <label class="filter-swatch{% if value.active %} is-active{% endif %}" title="{{ value.label }} ({{ value.count }})">
                            <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"
                              {% if value.active %}checked{% endif %}
                              data-filter-url="{{ value.url_to_add }}"
                              data-filter-remove="{{ value.url_to_remove }}"
                            >
                            <span class="filter-swatch__box" aria-hidden="true"></span>
                            <span class="filter-swatch__dot"
                              style="{%- render 'swatch-style', label: value.label, swatch: value.swatch -%}"
                              aria-hidden="true"></span>
                            {%- if sw_style == 'dots' -%}
                              <span class="visually-hidden">{{ value.label }}</span>
                            {%- else -%}
                              <span class="filter-swatch__name">{{ value.label }}</span>
                              <span class="filter-swatch__count">{{ value.count }}</span>
                            {%- endif -%}
                          </label>
                        {%- endfor -%}
                      </div>
                    {%- else -%}
                      <ul class="filter-list">
                        {%- for value in filter.values -%}
                          <li>
                            <label class="filter-check">
                              <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"
                                {% if value.active %}checked{% endif %}
                                data-filter-url="{{ value.url_to_add }}"
                                data-filter-remove="{{ value.url_to_remove }}"
                              >
                              <span>{{ value.label }}</span>
                              <span class="filter-count-pill">{{ value.count }}</span>
                            </label>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  {%- when 'price_range' -%}
                    <div class="price-range-filter">
                      {%- comment -%}
                        This was an empty div carrying data attributes that no
                        script ever read, so the slider rendered as a dead line
                        above the number inputs. It now emits two real range
                        inputs using the same classes as the built-in filter
                        set, so one stylesheet and one initialiser cover both.
                      {%- endcomment -%}
                      {%- comment -%}
                        Shopify gives these in cents, so money_without_currency
                        yields values like "82.12". A range input steps by 1 by
                        default, so 82.12 is not a valid stop and the browser
                        clamps it to 82 -- the max handle then sits short of the
                        end of its own rail. Bounds are taken to whole currency
                        units, floor for the minimum and ceiling for the
                        maximum, so the rail covers the real range and both
                        handles can reach their ends.

                        min_value.value / max_value.value are already in
                        currency units when a filter is applied, unlike
                        range_min / range_max which are cents. They must not be
                        passed through money_without_currency a second time.
                      {%- endcomment -%}
                      {%- comment -%}
                        Presence is tested by rendering to a string, not with
                        `== blank`, which does not report an unset value
                        reliably. Getting that wrong here silently set the
                        maximum to zero and collapsed the whole rail.
                      {%- endcomment -%}
                      {%- capture pmin_raw %}{{ filter.min_value.value }}{% endcapture -%}
                      {%- capture pmax_raw %}{{ filter.max_value.value }}{% endcapture -%}
                      {%- liquid
                        assign p_floor = filter.range_min | money_without_currency | remove: ',' | floor
                        assign p_ceil  = filter.range_max | money_without_currency | remove: ',' | ceil

                        assign p_min = p_floor
                        if pmin_raw != ''
                          assign p_min = pmin_raw | remove: ',' | floor
                        endif

                        assign p_max = p_ceil
                        if pmax_raw != ''
                          assign p_max = pmax_raw | remove: ',' | ceil
                        endif
                      -%}
                      <div class="cfilter-price__track" data-price-track>
                        <span class="cfilter-price__fill" data-price-fill></span>
                        <input class="cfilter-price__range" type="range" data-price-range="min" step="1"
                               min="{{ p_floor }}" max="{{ p_ceil }}" value="{{ p_min }}"
                               aria-label="{{ 'collections.filtering.price_min' | t | default: 'Minimum price' }}">
                        <input class="cfilter-price__range" type="range" data-price-range="max" step="1"
                               min="{{ p_floor }}" max="{{ p_ceil }}" value="{{ p_max }}"
                               aria-label="{{ 'collections.filtering.price_max' | t | default: 'Maximum price' }}">
                      </div>
                      {%- comment -%}
                        The two inputs used to render with no value, only a
                        faint placeholder, so an untouched price filter looked
                        like two empty boxes. They are seeded with the current
                        bounds instead, and a readout above the slider states
                        the range in the shop's currency.
                      {%- endcomment -%}
                      <div class="cfilter-price__readout" aria-hidden="true">
                        <span data-price-out="min">{{ p_min | times: 100 | money }}</span>
                        <span class="cfilter-price__dash">&ndash;</span>
                        <span data-price-out="max">{{ p_max | times: 100 | money }}</span>
                      </div>
                      {%- assign cur_sym = cart.currency.symbol | default: shop.currency -%}
                      <div class="price-range-inputs">
                        <label class="cfilter-price__field">
                          <span aria-hidden="true">{{ cur_sym }}</span>
                          <input type="number" name="{{ filter.min_value.param_name }}"
                                 value="{{ p_min }}" min="{{ p_floor }}" max="{{ p_ceil }}"
                                 aria-label="{{ 'collections.filtering.price_min' | t }}">
                        </label>
                        <span class="cfilter-price__dash">&mdash;</span>
                        <label class="cfilter-price__field">
                          <span aria-hidden="true">{{ cur_sym }}</span>
                          <input type="number" name="{{ filter.max_value.param_name }}"
                                 value="{{ p_max }}" min="{{ p_floor }}" max="{{ p_ceil }}"
                                 aria-label="{{ 'collections.filtering.price_max' | t }}">
                        </label>
                      </div>

                      {%- comment -%}
                        Preset bands, cut from the collection's own price
                        range so they suit the catalogue rather than assuming
                        a currency or a price bracket. They drive the number
                        fields, which already carry the navigation.
                      {%- endcomment -%}
                      {%- liquid
                        assign span = p_ceil | minus: p_floor
                        assign q1 = span | times: 25 | divided_by: 100 | plus: p_floor | round
                        assign q2 = span | times: 50 | divided_by: 100 | plus: p_floor | round
                        assign q3 = span | times: 75 | divided_by: 100 | plus: p_floor | round
                      -%}
                      <div class="cfilter-pills cfilter-pills--price">
                        <button type="button" data-price-band data-lo="{{ p_floor }}" data-hi="{{ q1 }}">{{ 'collections.filtering.under' | t }} {{ q1 | times: 100 | money_without_trailing_zeros }}</button>
                        <button type="button" data-price-band data-lo="{{ q1 }}" data-hi="{{ q2 }}">{{ q1 | times: 100 | money_without_trailing_zeros }} &ndash; {{ q2 | times: 100 | money_without_trailing_zeros }}</button>
                        <button type="button" data-price-band data-lo="{{ q2 }}" data-hi="{{ q3 }}">{{ q2 | times: 100 | money_without_trailing_zeros }} &ndash; {{ q3 | times: 100 | money_without_trailing_zeros }}</button>
                        <button type="button" data-price-band data-lo="{{ q3 }}" data-hi="{{ p_ceil }}">{{ q3 | times: 100 | money_without_trailing_zeros }}+</button>
                      </div>
                    </div>
                  {%- comment -%}
                    Shopify's third filter type. "Availability" is a boolean
                    filter, and it was not handled here at all — it fell
                    through the case and rendered a heading with an empty body.
                  {%- endcomment -%}
                  {%- when 'boolean' -%}
                    <ul class="filter-list">
                      {%- for value in filter.values -%}
                        <li>
                          <label class="filter-check">
                            <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"
                              {% if value.active %}checked{% endif %}
                              data-filter-url="{{ value.url_to_add }}"
                              data-filter-remove="{{ value.url_to_remove }}"
                            >
                            <span>{{ value.label }}</span>
                            {%- if value.count -%}<span class="filter-count-pill">{{ value.count }}</span>{%- endif -%}
                          </label>
                        </li>
                      {%- endfor -%}
                    </ul>
                {%- endcase -%}
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="sidebar-sort">
            {%- render 'collection-sort' -%}
            {%- render 'collection-view-toggle', columns: columns, current: view_default -%}
          </div>
        {%- endif -%}
      </aside>
    {%- endif -%}

    {%- comment -%} Main Products Area {%- endcomment -%}
    <div class="collection-main" id="collection-products">
      {%- comment -%}
        The toolbar used to require effective_sidebar == 'none', so the
        sidebar layouts -- the default -- rendered no sort control, no view
        toggle and no result count at all. It now shows whenever the
        drawer/dropdown bar above is not the one carrying them.
      {%- endcomment -%}
      {%- if filter_style != 'drawer' and filter_style != 'dropdown' -%}
        <div class="collection-toolbar collection-toolbar--inline">
          <span class="toolbar-count">{{ 'collections.general.items' | t: count: collection.products_count }}</span>
          <div class="toolbar-right">
            {%- render 'collection-sort' -%}
            {%- render 'collection-view-toggle', columns: columns, current: view_default -%}
          </div>
        </div>
      {%- endif -%}

      {%- comment -%}
      Best sellers. Liquid cannot sort a collection by sales, so this points at
      a collection the merchant curates or automates in the admin. Empty
      setting, no row — rather than an empty heading.
    {%- endcomment -%}
    {%- capture bestsellers_row -%}
      {%- assign bs_col = collections[section.settings.bestsellers_collection] -%}
      {%- if section.settings.show_bestsellers and bs_col != blank and bs_col.products.size > 0 -%}
        <div class="collection-bestsellers collection-bestsellers--{{ section.settings.bestsellers_position }}">
          <div class="collection-bestsellers__head">
            <h2 class="collection-bestsellers__title">{{ section.settings.bestsellers_heading }}</h2>
            <a class="collection-bestsellers__link" href="{{ bs_col.url }}">View all</a>
          </div>
          <div class="product-grid product-grid--{{ section.settings.bestsellers_count }}">
            {%- for product in bs_col.products limit: section.settings.bestsellers_count -%}
              {%- render 'product-card', product: product -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- endcapture -%}

    {%- comment -%} Active filter chips {%- endcomment -%}
      {%- assign has_active_filters = false -%}
      {%- for f in collection.filters -%}
        {%- if f.active_values.size > 0 or f.min_value.value or f.max_value.value -%}
          {%- assign has_active_filters = true -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if has_active_filters -%}
        <div class="active-filters">
          {%- for filter in collection.filters -%}
            {%- for value in filter.active_values -%}
              <a href="{{ value.url_to_remove }}" class="filter-chip filter-chip--active">
                {{ value.label }} ×
              </a>
            {%- endfor -%}
            {%- if filter.min_value.value or filter.max_value.value -%}
              <a href="{{ filter.url_to_remove }}" class="filter-chip filter-chip--active">
                {{ filter.min_value.value | default: filter.range_min | money }} – {{ filter.max_value.value | default: filter.range_max | money }} ×
              </a>
            {%- endif -%}
          {%- endfor -%}
          <a href="{{ collection.url }}" class="filter-chip filter-chip--clear">{{ 'collections.filtering.clear_all' | t }}</a>
        </div>
      {%- endif -%}

      {%- if section.settings.bestsellers_position == 'above' -%}{{ bestsellers_row }}{%- endif -%}

      {%- if use_demo and has_active_filters == false -%}
        {%- liquid
          assign demo_names = 'Alba Draped Coat,Sera Silk Dress,No. 03 Soft Bag,Linea Leather Mule,Vela Wool Blazer,Onda Pleated Skirt,Rive Cashmere Knit,Sable Leather Tote,Structured Wool Coat,Tailored Trouser,Cashmere Roll Neck,Belted Trench' | split: ','
          assign demo_prices = '$890|$540|$620|$390|$760|$420|$480|$690|$1,290|$420|$540|$1,150' | split: '|'
          assign demo_cats = 'Outerwear,Dresses,Leather goods,Shoes,Tailoring,Skirts,Knitwear,Leather goods,Outerwear,Tailoring,Knitwear,Outerwear' | split: ','
          assign k1 = 'https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=700&q=80'
          assign k2 = 'https://images.unsplash.com/photo-1525507119028-ed4c629a60a3?auto=format&fit=crop&w=700&q=80'
          assign k3 = 'https://images.unsplash.com/photo-1543163521-1bf539c55dd2?auto=format&fit=crop&w=700&q=80'
          assign k4 = 'https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=700&q=80'
          assign k5 = 'https://images.unsplash.com/photo-1469334031218-e382a71b716b?auto=format&fit=crop&w=700&q=80'
          assign k6 = 'https://images.unsplash.com/photo-1520975954732-35dd22299614?auto=format&fit=crop&w=700&q=80'
          assign k7 = 'https://images.unsplash.com/photo-1566174053879-31528523f8ae?auto=format&fit=crop&w=700&q=80'
          assign k8 = 'https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=700&q=80'
          assign k9 = 'https://images.unsplash.com/photo-1591047139829-d91aecb6caea?auto=format&fit=crop&w=700&q=80'
          assign k10 = 'https://images.unsplash.com/photo-1594633312681-425c7b97ccd1?auto=format&fit=crop&w=700&q=80'
          assign k11 = 'https://images.unsplash.com/photo-1496217590455-aa63a8350eea?auto=format&fit=crop&w=700&q=80'
          assign k12 = 'https://images.unsplash.com/photo-1487412720507-e7ab37603c6f?auto=format&fit=crop&w=700&q=80'
          assign demo_imgs_str = k1 | append: '||' | append: k2 | append: '||' | append: k3 | append: '||' | append: k4 | append: '||' | append: k5 | append: '||' | append: k6 | append: '||' | append: k7 | append: '||' | append: k8 | append: '||' | append: k9 | append: '||' | append: k10 | append: '||' | append: k11 | append: '||' | append: k12
          assign demo_imgs = demo_imgs_str | split: '||'
        -%}
        <p class="collection-demo-note">
          Showing demo products — this collection has no products yet. Turn this off in
          <strong>Collection &rarr; Show demo products when empty</strong>.
        </p>
        <div class="product-grid product-grid--{{ columns }}" id="product-grid" data-view="{{ view_default }}">
          {%- for i in (1..12) -%}
            {%- assign idx = forloop.index0 -%}
            {%- render 'product-card',
              demo_index: idx,
              demo_title: demo_names[idx],
              demo_price: demo_prices[idx],
              demo_category: demo_cats[idx],
              demo_image: demo_imgs[idx],
              demo_url: '/collections/all' -%}
          {%- endfor -%}
        </div>

      {%- elsif collection.products.size == 0 -%}
        <div class="collection-empty">
          <p>{{ 'collections.general.no_matches' | t }}</p>
          {%- if has_active_filters -%}
            <a href="{{ collection.url }}" class="btn-ghost">{{ 'collections.filtering.clear_all' | t }}</a>
          {%- endif -%}
        </div>
      {%- else -%}
        <div
          class="product-grid product-grid--{{ columns }}"
          id="product-grid"
          data-view="{{ view_default }}"
        >
          {%- for product in collection.products -%}
            {%- render 'product-card', product: product -%}
          {%- endfor -%}
        </div>

        {%- comment -%} Pagination {%- endcomment -%}
        {%- if paginate.pages > 1 -%}
          {%- if pagination_style == 'load_more' -%}
            <div class="pagination-load-more">
              {%- if paginate.next -%}
                <button class="btn-ghost" data-load-more data-next-url="{{ paginate.next.url }}">
                  {{ 'collections.general.load_more' | t }}
                  <span class="load-more-count">({{ paginate.next.title }})</span>
                </button>
              {%- endif -%}
            </div>
          {%- elsif pagination_style == 'infinite' -%}
            <div class="pagination-infinite" data-infinite-scroll {% if paginate.next %}data-next-url="{{ paginate.next.url }}"{% endif %}>
              <span class="pagination-spinner"></span>
            </div>
          {%- else -%}
            <nav class="pagination" aria-label="{{ 'accessibility.pagination' | t }}">
              {%- if paginate.previous -%}
                <a href="{{ paginate.previous.url }}" class="pagination__item pagination__item--prev">← {{ 'general.pagination.previous' | t }}</a>
              {%- endif -%}
              {%- for part in paginate.parts -%}
                {%- comment -%}
                  A non-link part is either the current page or an ellipsis.
                  Comparing part.title to paginate.current_page never matched,
                  because the title is a string and current_page an integer
                  ("1" == 1 is false in Liquid), so the current page always
                  fell through to the gap branch and rendered as a muted,
                  unclickable number instead of the highlighted page.
                {%- endcomment -%}
                {%- if part.is_link -%}
                  <a href="{{ part.url }}" class="pagination__item">{{ part.title }}</a>
                {%- else -%}
                  {%- assign part_num = part.title | plus: 0 -%}
                  {%- if part_num > 0 -%}
                    <span class="pagination__item pagination__item--current" aria-current="page">{{ part.title }}</span>
                  {%- else -%}
                    <span class="pagination__item pagination__item--gap">{{ part.title }}</span>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if paginate.next -%}
                <a href="{{ paginate.next.url }}" class="pagination__item pagination__item--next">{{ 'general.pagination.next' | t }} →</a>
              {%- endif -%}
            </nav>
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.bestsellers_position == 'below' -%}{{ bestsellers_row }}{%- endif -%}
    </div>
  </div>

  {%- comment -%} Filter Drawer (for drawer mode) {%- endcomment -%}
  {%- if filter_style == 'drawer' -%}
    <div class="filter-drawer" id="filter-drawer" role="dialog" aria-modal="true" aria-label="{{ 'collections.filtering.filters' | t }}">
      <div class="filter-drawer__header">
        <h2>{{ 'collections.filtering.filters' | t }}</h2>
        <button class="filter-drawer__close" data-close-filter-drawer aria-label="{{ 'accessibility.close' | t }}">{%- render 'icon-close' -%}</button>
      </div>
      <div class="filter-drawer__body">
        {%- if use_builtin_filters -%}
          {%- render 'collection-filters', products: collection.products, style: 'drawer', demo: filters_are_demo, swatch_style: section.settings.swatch_style -%}
        {%- endif -%}
        {%- for filter in collection.filters -%}
          <div class="filter-group" data-filter-group>
            <button class="filter-group__toggle" aria-expanded="true">
              {{ filter.label }} <span class="fgrp-pm" aria-hidden="true"></span>
            </button>
            <div class="filter-group__body">
              {%- case filter.type -%}
                {%- when 'list' -%}
                  <ul class="filter-list">
                    {%- for value in filter.values -%}
                      <li>
                        <label class="filter-check">
                          <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"
                            {% if value.active %}checked{% endif %}
                            data-filter-url="{{ value.url_to_add }}"
                            data-filter-remove="{{ value.url_to_remove }}"
                          >
                          <span>{{ value.label }}</span>
                          <span class="filter-count-pill">{{ value.count }}</span>
                        </label>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- when 'price_range' -%}
                  <div class="price-range-inputs">
                    <input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | remove: ',' }}" placeholder="{{ filter.range_min | money }}">
                    <span>–</span>
                    <input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | remove: ',' }}" placeholder="{{ filter.range_max | money }}">
                  </div>
                {%- when 'boolean' -%}
                  <ul class="filter-list">
                    {%- for value in filter.values -%}
                      <li>
                        <label class="filter-check">
                          <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"
                            {% if value.active %}checked{% endif %}
                            data-filter-url="{{ value.url_to_add }}"
                            data-filter-remove="{{ value.url_to_remove }}"
                          >
                          <span>{{ value.label }}</span>
                          {%- if value.count -%}<span class="filter-count-pill">{{ value.count }}</span>{%- endif -%}
                        </label>
                      </li>
                    {%- endfor -%}
                  </ul>
              {%- endcase -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
      <div class="filter-drawer__footer">
        <a href="{{ collection.url }}" class="btn-ghost">{{ 'collections.filtering.clear_all' | t }}</a>
        <button class="btn-primary" data-close-filter-drawer>{{ 'collections.filtering.apply' | t }}</button>
      </div>
    </div>
    <div class="filter-drawer__overlay" data-close-filter-drawer></div>
  {%- endif -%}
</div>

{%- endpaginate -%}

{% schema %}
{
  "name": "Collection",
  "tag": "div",
  "settings": [
    {
      "type": "select", "id": "title_style", "label": "Collection Title Style",
      "options": [
        { "value": "style-1", "label": "Style 1 — Simple Text" },
        { "value": "style-2", "label": "Style 2 — Banner Image" },
        { "value": "style-3", "label": "Style 3 — With Breadcrumb" },
        { "value": "style-4", "label": "Style 4 — Centered + Eyebrow" },
        { "value": "style-5", "label": "Style 5 — Left + Item Count" }
      ],
      "default": "style-1"
    },
    {
      "type": "select", "id": "sidebar_position", "label": "Sidebar Position",
      "options": [
        { "value": "left",  "label": "Left Sidebar" },
        { "value": "right", "label": "Right Sidebar" },
        { "value": "none",  "label": "No Sidebar" }
      ],
      "default": "left"
    },
    {
      "type": "select", "id": "filter_style", "label": "Filter Style",
      "options": [
        { "value": "sidebar",  "label": "Sidebar (static)" },
        { "value": "drawer",   "label": "Drawer (slide-in)" },
        { "value": "dropdown", "label": "Dropdown Bar" },
        { "value": "toggle",   "label": "Toggle Groups" }
      ],
      "default": "sidebar"
    },
    {
      "type": "select", "id": "swatch_style", "label": "Colour swatch style",
      "info": "How colour filters are presented. \"Swatch grid\" hides the colour name, so use it only when your colour names are obvious.",
      "options": [
        { "value": "list",  "label": "List — swatch, name and count" },
        { "value": "chips", "label": "Chips — pill with swatch and name" },
        { "value": "dots",  "label": "Swatch grid — colour only" }
      ],
      "default": "list"
    },
    {
      "type": "select", "id": "scheme", "label": "Surface tone",
      "info": "Picks a step on the active colour scheme's ladder, exactly like the homepage sections.",
      "options": [
        { "value": "light", "label": "Alternate surface (soft)" },
        { "value": "dark",  "label": "Primary surface" },
        { "value": "warm",  "label": "Deep surface" },
        { "value": "theme", "label": "Primary surface (follow theme)" }
      ],
      "default": "theme"
    },
    {
      "type": "select", "id": "container_style", "label": "Container Width",
      "options": [
        { "value": "boxed", "label": "Boxed — follows the theme container width" },
        { "value": "wide",  "label": "Wide — 1780px" },
        { "value": "full",  "label": "Full width" }
      ],
      "default": "boxed"
    },
    {
      "type": "select", "id": "grid_columns", "label": "Default Grid Columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" }
      ],
      "default": "3"
    },
    {
      "type": "select", "id": "view_default", "label": "Default View",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "list", "label": "List" }
      ],
      "default": "grid"
    },
    {
      "type": "select", "id": "pagination_style", "label": "Pagination Style",
      "options": [
        { "value": "numbered", "label": "Numbered Pages" },
        { "value": "load_more","label": "Load More Button" },
        { "value": "infinite", "label": "Infinite Scroll" }
      ],
      "default": "numbered"
    },
    {
      "type": "range", "id": "products_per_page", "label": "Products Per Page",
      "min": 12, "max": 48, "step": 4, "default": 24
    },
    { "type": "header", "content": "Image banner" },
    { "type": "checkbox", "id": "show_banner", "label": "Show image banner", "info": "Sits above the page and carries the collection title. Falls back to the collection's own image when no banner image is set.", "default": false },
    { "type": "image_picker", "id": "banner_image", "label": "Banner image" },
    { "type": "range", "id": "banner_height", "label": "Banner height", "min": 20, "max": 70, "step": 5, "unit": "vh", "default": 40 },
    {
      "type": "select", "id": "banner_text_position", "label": "Banner text position",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Centre" },
        { "value": "bottom", "label": "Bottom left" }
      ],
      "default": "center"
    },
    { "type": "text", "id": "banner_eyebrow", "label": "Banner eyebrow", "default": "Collection" },
    { "type": "checkbox", "id": "banner_show_count", "label": "Show product count in banner", "default": true },

    { "type": "header", "content": "Best sellers" },
    { "type": "checkbox", "id": "show_bestsellers", "label": "Show a best sellers row", "default": false },
    { "type": "collection", "id": "bestsellers_collection", "label": "Best sellers collection", "info": "Leave empty to hide the row. Shopify has no Liquid sort by sales, so this points at a collection you curate or automate." },
    { "type": "text", "id": "bestsellers_heading", "label": "Best sellers heading", "default": "Best sellers" },
    { "type": "range", "id": "bestsellers_count", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 },
    {
      "type": "select", "id": "bestsellers_position", "label": "Position",
      "options": [
        { "value": "above", "label": "Above the grid" },
        { "value": "below", "label": "Below the grid" }
      ],
      "default": "above"
    },

    { "type": "checkbox", "id": "builtin_filters", "label": "Use built-in filters when no filter app is installed", "info": "Builds Availability, On sale, Price, Size, Colour, Brand, Product type and Tag filters from your own products and applies them to the products on the page. Shopify's own filters are used instead whenever the Search & Discovery app provides them.", "default": true },

    { "type": "header", "content": "Demo" },
    {
      "type": "checkbox", "id": "show_demo_when_empty",
      "label": "Show demo products when empty",
      "info": "Fills a collection that has no products with placeholder items, so the layout can be reviewed on a store with no catalogue. Turn off before going live.",
      "default": true
    }
  ],
  "presets": [{ "name": "Collection" }]
}
{% endschema %}
