{%- comment -%}
  Create account, in the design's language, laid out like the sign-in page.
{%- endcomment -%}
{%- assign ss = section.settings -%}
<div class="mn-acct mn-auth" id="section-{{ section.id }}">
  <div class="mn-container mn-auth__grid">
    <div class="mn-auth__main">
      <div class="mn-auth__view">
        <span class="mn-eyebrow">{{ 'mn.acct.eyebrow' | t }}</span>
        <h1 class="section-title">{{ ss.heading }}</h1>
        {%- form 'create_customer', class: 'mn-auth__form', novalidate: 'novalidate' -%}
          {%- if form.errors -%}
            <div class="mn-alert mn-alert--error" role="alert" tabindex="-1">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="mn-auth__pair">
            <label class="mn-field">
              <span class="mn-field__label">{{ 'customer.register.first_name' | t }}</span>
              <input class="input" type="text" name="customer[first_name]" autocomplete="given-name" value="{{ form.first_name }}">
            </label>
            <label class="mn-field">
              <span class="mn-field__label">{{ 'customer.register.last_name' | t }}</span>
              <input class="input" type="text" name="customer[last_name]" autocomplete="family-name" value="{{ form.last_name }}">
            </label>
          </div>
          <label class="mn-field">
            <span class="mn-field__label">{{ 'customer.register.email' | t }}</span>
            <input class="input" type="email" name="customer[email]" autocomplete="email" autocorrect="off" autocapitalize="off" value="{{ form.email }}" required>
          </label>
          <div class="mn-field">
            {%- assign pw_label = 'customer.register.password' | t -%}
            {%- render 'mn-password', id: 'RegisterPassword', section_id: section.id, name: 'customer[password]', autocomplete: 'new-password', label: pw_label -%}
          </div>
          {%- if ss.show_marketing -%}
            <label class="check mn-auth__check">
              <input type="checkbox" name="customer[accepts_marketing]" value="true"{% if ss.marketing_checked %} checked{% endif %}>
              <span>{{ ss.marketing_label }}</span>
            </label>
          {%- endif -%}
          <button type="submit" class="mn-btn mn-btn--block">{{ 'customer.register.submit' | t }}</button>
          {%- if ss.terms != blank -%}<div class="mn-auth__fine rte">{{ ss.terms }}</div>{%- endif -%}
        {%- endform -%}
      </div>
    </div>

    <aside class="mn-auth__side"{% if ss.image %} data-has-image{% endif %}>
      {%- if ss.image -%}{{ ss.image | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'mn-auth__img', sizes: '(min-width: 900px) 45vw, 100vw', alt: '' }}{%- endif -%}
      <div class="mn-auth__panel">
        <span class="mn-eyebrow">{{ 'mn.acct.have_eyebrow' | t }}</span>
        <h2 class="section-title">{{ ss.side_heading }}</h2>
        <p class="mn-auth__lead">{{ 'mn.acct.have_lead' | t }}</p>
        <a href="{{ routes.account_login_url }}" class="mn-btn mn-btn--secondary">{{ 'customer.login.sign_in' | t }}</a>
      </div>
    </aside>
  </div>
</div>

{% schema %}
{
  "name": "Register",
  "tag": "section",
  "class": "section-main-register",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Create an <em>account</em>" },
    { "type": "checkbox", "id": "show_marketing", "label": "Show newsletter sign-up", "default": true },
    { "type": "text", "id": "marketing_label", "label": "Newsletter label", "default": "Email me about new collections and private sales" },
    { "type": "checkbox", "id": "marketing_checked", "label": "Ticked by default", "default": false },
    { "type": "richtext", "id": "terms", "label": "Small print", "info": "For example a link to your privacy policy." },
    { "type": "header", "content": "Side panel" },
    { "type": "inline_richtext", "id": "side_heading", "label": "Heading", "default": "Already a <em>client?</em>" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "presets": [{ "name": "Register" }]
}
{% endschema %}
