{%- comment -%}
  Saved addresses, in the design's language: address cards with a default
  badge, edit and delete, and an add form. Forms open in place
  ([data-acct-toggle], assets/mn.js) and stay open when Shopify returns
  them with errors.
{%- endcomment -%}
{%- paginate customer.addresses by 12 -%}
{%- liquid
  assign new_open = false
-%}
{%- capture new_form -%}
  {%- form 'customer_address', customer.new_address, class: 'mn-addr__form' -%}
    {%- if form.errors -%}
      {%- assign new_open = true -%}
      <div class="mn-alert mn-alert--error" role="alert">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    {%- render 'address-fields', form: form -%}
    <label class="check mn-addr__default"><input type="checkbox" name="address[default]" value="1"><span>{{ 'customer.addresses.set_default' | t }}</span></label>
    <div class="mn-addr__actions">
      <button type="submit" class="mn-btn">{{ 'customer.addresses.add' | t }}</button>
      <button type="button" class="mn-btn mn-btn--secondary" data-acct-toggle="AddrNew">{{ 'customer.addresses.cancel' | t }}</button>
    </div>
  {%- endform -%}
{%- endcapture -%}
<div class="mn-acct" id="section-{{ section.id }}">
  <div class="mn-container">
    <div class="mn-acct__head">
      <div>
        <span class="mn-eyebrow">{{ 'mn.acct.eyebrow' | t }}</span>
        <h1 class="section-title">{{ 'mn.acct.addresses_title_html' | t }}</h1>
      </div>
      <button type="button" class="mn-btn mn-btn--sm" data-acct-toggle="AddrNew" aria-controls="AddrNew" aria-expanded="{{ new_open }}"><svg class="icon icon--sm" aria-hidden="true"><use href="#i-plus"></use></svg>{{ 'customer.addresses.add_new' | t }}</button>
    </div>

    <div class="mn-acct__grid">
      {%- render 'mn-account-nav', current: 'addresses' -%}

      <div class="mn-acct__main mn-acct__main--wide">
        <div class="mn-acct__card mn-addr__panel" id="AddrNew"{% unless new_open %} hidden{% endunless %}>
          <h2 class="mn-acct__card-title">{{ 'customer.addresses.add_new' | t }}</h2>
          {{ new_form }}
        </div>

        {%- if customer.addresses.size > 0 -%}
          <div class="mn-addr__list">
            {%- for address in customer.addresses -%}
              {%- liquid
                assign edit_open = false
                assign is_default = false
                if address.id == customer.default_address.id
                  assign is_default = true
                endif
              -%}
              {%- capture edit_form -%}
                {%- form 'customer_address', address, class: 'mn-addr__form' -%}
                  {%- if form.errors -%}
                    {%- assign edit_open = true -%}
                    <div class="mn-alert mn-alert--error" role="alert">{{ form.errors | default_errors }}</div>
                  {%- endif -%}
                  {%- render 'address-fields', form: form -%}
                  <label class="check mn-addr__default"><input type="checkbox" name="address[default]" value="1"{% if is_default %} checked{% endif %}><span>{{ 'customer.addresses.set_default' | t }}</span></label>
                  <div class="mn-addr__actions">
                    <button type="submit" class="mn-btn">{{ 'customer.addresses.update' | t }}</button>
                    <button type="button" class="mn-btn mn-btn--secondary" data-acct-toggle="AddrEdit-{{ address.id }}">{{ 'customer.addresses.cancel' | t }}</button>
                  </div>
                {%- endform -%}
              {%- endcapture -%}
              <div class="mn-acct__card mn-addr__card{% if edit_open %} is-editing{% endif %}" id="address-{{ address.id }}">
                <div class="mn-addr__top">
                  {%- if is_default -%}<span class="badge badge--new">{{ 'customer.addresses.default' | t }}</span>{%- endif -%}
                  <address class="mn-acct__address">{{ address | format_address }}</address>
                  {%- if address.phone != blank -%}<p class="mn-acct__muted">{{ address.phone }}</p>{%- endif -%}
                  <div class="mn-addr__links">
                    <button type="button" class="link-quiet" data-acct-toggle="AddrEdit-{{ address.id }}" aria-controls="AddrEdit-{{ address.id }}" aria-expanded="{{ edit_open }}">{{ 'customer.addresses.edit' | t }}</button>
                    {%- form 'customer_address', address, class: 'mn-addr__delete' -%}
                      <input type="hidden" name="_method" value="delete">
                      <button type="submit" class="link-quiet mn-addr__del" data-confirm="{{ 'customer.addresses.delete_confirm' | t | escape }}">{{ 'customer.addresses.delete' | t }}</button>
                    {%- endform -%}
                  </div>
                </div>
                <div class="mn-addr__edit" id="AddrEdit-{{ address.id }}"{% unless edit_open %} hidden{% endunless %}>{{ edit_form }}</div>
              </div>
            {%- endfor -%}
          </div>
          {%- if paginate.pages > 1 -%}{%- render 'mn-pagination', paginate: paginate -%}{%- endif -%}
        {%- else -%}
          <div class="mn-acct__empty">
            <span class="mn-cartpage__empty-icon"><svg class="icon icon--lg" aria-hidden="true"><use href="#i-pin"></use></svg></span>
            <p>{{ 'mn.acct.no_addresses' | t }}</p>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Addresses",
  "tag": "section",
  "class": "section-main-addresses",
  "settings": [],
  "presets": [{ "name": "Addresses" }]
}
{% endschema %}
