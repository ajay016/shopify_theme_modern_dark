{%- comment -%}
  Contact page, in the design's language: eyebrow + display title, intro,
  contact details (blocks) and the page's own content beside the design's
  form; or the form alone, centred. Sends through Shopify's contact form.
{%- endcomment -%}
{%- assign ss = section.settings -%}
<div class="mn-content mn-contact mn-contact--{{ ss.layout }}" id="section-{{ section.id }}">
  <div class="mn-container mn-contact__grid">
    <div class="mn-contact__info">
      {%- if ss.eyebrow != blank -%}<span class="mn-eyebrow">{{ ss.eyebrow }}</span>{%- endif -%}
      <h1 class="section-title">{%- if ss.use_page_title and page.title != blank -%}{{ page.title }}{%- else -%}{{ ss.heading }}{%- endif -%}</h1>
      {%- if ss.intro != blank -%}<div class="mn-content__lead rte">{{ ss.intro }}</div>{%- endif -%}
      {%- if page.content != blank and ss.layout == 'split' -%}<div class="mn-prose rte mn-contact__page">{{ page.content }}</div>{%- endif -%}
      {%- if section.blocks.size > 0 and ss.layout == 'split' -%}
        <dl class="mn-contact__details">
          {%- for block in section.blocks -%}
            <div class="mn-contact__detail" {{ block.shopify_attributes }}>
              {%- if block.settings.label != blank -%}<dt class="mn-acct__card-title">{{ block.settings.label }}</dt>{%- endif -%}
              <dd>
                {%- liquid
                  assign v = block.settings.value
                  assign link = block.settings.link
                  if link == blank and v contains '@' and v contains '.'
                    assign link = 'mailto:' | append: v
                  endif
                -%}
                {%- if link != blank -%}<a href="{{ link }}" class="link-quiet mn-contact__value">{{ v }}</a>{%- else -%}<span class="mn-contact__value">{{ v }}</span>{%- endif -%}
                {%- if block.settings.note != blank -%}<span class="mn-acct__muted">{{ block.settings.note }}</span>{%- endif -%}
              </dd>
            </div>
          {%- endfor -%}
        </dl>
      {%- endif -%}
    </div>

    <div class="mn-contact__form">
      {%- form 'contact', id: 'ContactForm', class: 'mn-acct__card mn-contact__card' -%}
        {%- if form.posted_successfully? -%}
          <div class="mn-contact__done" role="status" tabindex="-1">
            <span class="mn-cartpage__empty-icon"><svg class="icon icon--lg" aria-hidden="true"><use href="#i-check"></use></svg></span>
            <p class="mn-searchpage__empty-title">{{ 'mn.contactpage.thanks' | t }}</p>
            <p class="mn-acct__muted">{{ 'contact.form.success' | t }}</p>
          </div>
        {%- else -%}
          {%- if form.errors -%}<div class="mn-alert mn-alert--error" role="alert" tabindex="-1">{{ form.errors | default_errors }}</div>{%- endif -%}
          <div class="mn-auth__pair">
            <label class="mn-field"><span class="mn-field__label">{{ 'contact.form.name' | t }}</span><input class="input" type="text" name="contact[name]" value="{{ form.name }}" autocomplete="name" required></label>
            <label class="mn-field"><span class="mn-field__label">{{ 'contact.form.email' | t }}</span><input class="input" type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" autocapitalize="off" required></label>
          </div>
          {%- if ss.show_phone -%}
            <label class="mn-field"><span class="mn-field__label">{{ 'contact.form.phone' | t }}</span><input class="input" type="tel" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel"></label>
          {%- endif -%}
          {%- if ss.show_subject -%}
            <label class="mn-field"><span class="mn-field__label">{{ 'contact.form.subject' | t }}</span><input class="input" type="text" name="contact[subject]" value="{{ form.subject }}"></label>
          {%- endif -%}
          {%- if ss.show_order -%}
            <label class="mn-field"><span class="mn-field__label">{{ 'mn.contactpage.order' | t }}</span><input class="input" type="text" name="contact[order]" value="{{ form.order }}" placeholder="#1001"></label>
          {%- endif -%}
          <label class="mn-field"><span class="mn-field__label">{{ 'contact.form.message' | t }}</span><textarea class="input" name="contact[body]" rows="{{ ss.textarea_rows }}" required>{{ form.body }}</textarea></label>
          <button type="submit" class="mn-btn mn-btn--block">{{ 'contact.form.send' | t }}</button>
          {%- if ss.note != blank -%}<p class="mn-auth__fine">{{ ss.note }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact",
  "tag": "section",
  "class": "section-main-contact",
  "max_blocks": 6,
  "settings": [
    { "type": "text",     "id": "eyebrow",  "label": "Eyebrow",         "default": "Client care" },
    { "type": "inline_richtext", "id": "heading",  "label": "Heading", "default": "Get in <em>touch</em>" },
    { "type": "checkbox", "id": "use_page_title", "label": "Use the page title as heading", "default": false },
    { "type": "richtext", "id": "intro",    "label": "Intro Text", "default": "<p>Questions about sizing, an order or a piece you have seen? Write to us and we will reply within one working day.</p>" },
    {
      "type": "select", "id": "layout", "label": "Layout",
      "options": [
        { "value": "split",    "label": "Split (info + form)" },
        { "value": "centered", "label": "Centered form only" }
      ],
      "default": "split"
    },
    { "type": "checkbox", "id": "show_phone",    "label": "Show Phone Field",   "default": false },
    { "type": "checkbox", "id": "show_subject",  "label": "Show Subject Field", "default": true },
    { "type": "checkbox", "id": "show_order",    "label": "Show Order Number Field", "default": false },
    { "type": "range",    "id": "textarea_rows", "label": "Message Field Rows", "min": 4, "max": 12, "step": 1, "default": 6 },
    { "type": "text",     "id": "note",          "label": "Note under the button" }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Contact Detail",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Email" },
        { "type": "text", "id": "value", "label": "Value", "default": "hello@maisonnoir.com" },
        { "type": "url",  "id": "link",  "label": "Link", "info": "Emails link themselves. Use tel:+15550000000 for a phone number." },
        { "type": "text", "id": "note",  "label": "Note", "info": "For example opening hours." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact",
      "blocks": [
        { "type": "detail", "settings": { "label": "Email", "value": "hello@maisonnoir.com" } },
        { "type": "detail", "settings": { "label": "Phone", "value": "+1 (555) 000-0000" } },
        { "type": "detail", "settings": { "label": "Address", "value": "123 Fashion Ave, New York, NY 10001" } }
      ]
    }
  ]
}
{% endschema %}
