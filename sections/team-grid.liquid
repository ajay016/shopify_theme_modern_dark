{%- comment -%}
  The people behind the house, in the design's language: eyebrow, display
  heading and intro, then portrait cards (photo or an initial on the soft
  surface), name, role, bio and social links.
{%- endcomment -%}
{%- assign ss = section.settings -%}
<section class="mn-section mn-team" id="section-{{ section.id }}"{% if ss.surface != 'base' %} data-surface="{{ ss.surface }}"{% endif %}>
  <div class="mn-container">
    {%- if ss.heading != blank or ss.eyebrow != blank -%}
      <div class="mn-section__head">
        <div>
          {%- if ss.eyebrow != blank -%}<span class="mn-eyebrow">{{ ss.eyebrow }}</span>{%- endif -%}
          {%- if ss.heading != blank -%}<h2 class="section-title">{{ ss.heading }}</h2>{%- endif -%}
        </div>
        {%- if ss.intro != blank -%}<div class="mn-team__intro rte">{{ ss.intro }}</div>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="mn-team__grid" style="--cols:{{ ss.columns }}">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <article class="mn-member" {{ block.shopify_attributes }}>
          <div class="mn-member__photo">
            {%- if b.photo -%}
              {{ b.photo | image_url: width: 900 | image_tag: loading: 'lazy', class: 'mn-fill', alt: b.name, sizes: '(min-width: 990px) 25vw, 50vw', widths: '400,600,900' }}
            {%- else -%}
              <span class="mn-member__initial" aria-hidden="true">{{ b.name | slice: 0 }}</span>
            {%- endif -%}
          </div>
          <div class="mn-member__info">
            <h3 class="mn-member__name">{{ b.name }}</h3>
            {%- if b.role != blank -%}<span class="mn-eyebrow">{{ b.role }}</span>{%- endif -%}
            {%- if b.bio != blank -%}<p class="mn-member__bio">{{ b.bio }}</p>{%- endif -%}
            {%- if b.social_instagram or b.social_linkedin -%}
              <div class="mn-member__social">
                {%- if b.social_instagram -%}<a href="{{ b.social_instagram }}" class="icon-btn" target="_blank" rel="noopener" aria-label="{{ b.name | escape }} on Instagram"><svg class="icon icon--sm" aria-hidden="true"><use href="#i-instagram"></use></svg></a>{%- endif -%}
                {%- if b.social_linkedin -%}<a href="{{ b.social_linkedin }}" class="icon-btn" target="_blank" rel="noopener" aria-label="{{ b.name | escape }} on LinkedIn"><svg class="icon icon--sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg></a>{%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Team Grid",
  "tag": "div",
  "class": "section-team-grid",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow",  "label": "Eyebrow",  "default": "Our People" },
    { "type": "inline_richtext", "id": "heading",  "label": "Heading",  "default": "Meet the <em>team</em>" },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    {
      "type": "select", "id": "columns", "label": "Columns",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" }
      ],
      "default": "4"
    },
    {
      "type": "select", "id": "surface", "label": "Background",
      "options": [
        { "value": "base", "label": "Page colour" },
        { "value": "soft", "label": "Soft" },
        { "value": "deep", "label": "Deep" },
        { "value": "invert", "label": "Inverted" }
      ],
      "default": "base"
    }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "Team Member",
      "settings": [
        { "type": "image_picker", "id": "photo",             "label": "Photo" },
        { "type": "text",         "id": "name",              "label": "Name",       "default": "Isabelle Moreau" },
        { "type": "text",         "id": "role",              "label": "Role",       "default": "Creative Director" },
        { "type": "textarea",     "id": "bio",               "label": "Bio" },
        { "type": "url",          "id": "social_instagram",  "label": "Instagram" },
        { "type": "url",          "id": "social_linkedin",   "label": "LinkedIn" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Team Grid",
      "blocks": [
        { "type": "member", "settings": { "name": "Isabelle Moreau", "role": "Creative Director" } },
        { "type": "member", "settings": { "name": "Luca Ferri", "role": "Head of Atelier" } },
        { "type": "member", "settings": { "name": "Amara Chen", "role": "Fabric Sourcing" } },
        { "type": "member", "settings": { "name": "Jonas Weber", "role": "Client Care" } }
      ]
    }
  ]
}
{% endschema %}
