{%- comment -%}
  Cart page, in the Claude Design reference's language: the cart drawer's
  lines (image, title, options, stepper, remove), the shipping progress and
  a summary panel with note, discounts, subtotal and checkout. Quantity and
  remove run through MN.cart (assets/mn.js), which re-renders this section
  and the drawer through Section Rendering. Recommendations come from the
  first item, through the same endpoint.
{%- endcomment -%}
{%- liquid
  assign ss = section.settings
  assign threshold = settings.cart_free_shipping_threshold | plus: 0 | times: 100
  assign show_bar = false
  if ss.show_shipping_bar and settings.cart_free_shipping_bar and threshold > 0
    assign show_bar = true
  endif
  assign recs_on = false
  if ss.show_recommendations and settings.cart_show_recommendations
    assign recs_on = true
  endif
-%}
<div class="mn-cartpage" id="MainCart-{{ section.id }}" data-cart-page="{{ section.id }}">
  <div class="mn-container">
    <div class="mn-cartpage__head" data-cart-part="head">
      <span class="mn-eyebrow">{{ 'mn.cartpage.eyebrow' | t }}</span>
      <h1 class="section-title">{{ 'mn.cartpage.title_html' | t }}{%- if cart.item_count > 0 -%}<span class="mn-cartpage__count">{{ 'mn.cartpage.count' | t: count: cart.item_count }}</span>{%- endif -%}</h1>
    </div>

    <div data-cart-part="body">
      {%- if cart.item_count == 0 -%}
        <div class="mn-cartpage__empty">
          <span class="mn-cartpage__empty-icon"><svg class="icon icon--lg" aria-hidden="true"><use href="#i-bag"></use></svg></span>
          <p>{{ 'mn.cart.empty' | t }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="mn-btn">{{ 'cart.continue_shopping' | t }}</a>
        </div>
      {%- else -%}
        <form action="{{ routes.cart_url }}" method="post" id="CartPageForm" class="mn-cartpage__grid" novalidate>
          <div class="mn-cartpage__lines">
            {%- if show_bar -%}
              {%- liquid
                assign left = threshold | minus: cart.total_price
                assign left_money = left | money
                assign pct = cart.total_price | times: 100 | divided_by: threshold | at_most: 100
              -%}
              <div class="ship-progress">
                <p>
                  {%- if left > 0 -%}{{ 'mn.cart.ship_remaining_html' | t: amount: left_money }}{%- else -%}<svg class="icon icon--sm" aria-hidden="true"><use href="#i-check"></use></svg>{{ 'mn.cart.ship_unlocked_html' | t }}{%- endif -%}
                </p>
                <span class="ship-progress__track"><i style="width:{{ pct }}%"></i></span>
              </div>
            {%- endif -%}

            {%- for item in cart.items -%}
              {%- liquid
                assign max = ''
                if item.variant.inventory_management == 'shopify' and item.variant.inventory_policy == 'deny'
                  assign max = item.variant.inventory_quantity
                endif
              -%}
              <div class="cart-line mn-cartpage__line" data-key="{{ item.key }}" data-qty="{{ item.quantity }}" data-unit="{{ item.final_price | money | strip_html | escape }}"{% if max != '' %} data-max="{{ max }}"{% endif %}>
                <a href="{{ item.url }}" class="cart-line__img" tabindex="-1" aria-hidden="true">
                  {%- if item.image -%}{{ item.image | image_url: width: 360 | image_tag: loading: 'lazy', alt: '', class: 'mn-fill', sizes: '120px' }}{%- endif -%}
                </a>
                <div class="cart-line__text">
                  {%- if item.vendor != blank -%}<span class="cart-line__variant mn-cartpage__vendor">{{ item.vendor }}</span>{%- endif -%}
                  <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title }}</a>
                  {%- unless item.product.has_only_default_variant -%}<span class="cart-line__variant">{{ item.variant.options | join: ' · ' }}</span>{%- endunless -%}
                  {%- if item.selling_plan_allocation -%}<span class="cart-line__variant">{{ item.selling_plan_allocation.selling_plan.name }}</span>{%- endif -%}
                  {%- for p in item.properties -%}
                    {%- assign first = p.first | slice: 0 -%}
                    {%- if p.last != blank and first != '_' -%}<span class="cart-line__variant">{{ p.first }}: {{ p.last }}</span>{%- endif -%}
                  {%- endfor -%}
                  {%- for d in item.line_level_discount_allocations -%}
                    <span class="cart-line__variant cart-line__disc"><svg class="icon icon--sm" aria-hidden="true"><use href="#i-tag"></use></svg>{{ d.discount_application.title }}</span>
                  {%- endfor -%}
                  <span class="cart-line__variant mn-cartpage__unit">{{ item.final_price | money }}{%- if item.unit_price_measurement -%} · {{ item.unit_price | money }}/{%- if item.unit_price_measurement.reference_value != 1 -%}{{ item.unit_price_measurement.reference_value }}{%- endif -%}{{ item.unit_price_measurement.reference_unit }}{%- endif -%}</span>
                  <div class="stepper" role="group" aria-label="{{ 'mn.cart.quantity_for' | t: title: item.product.title | escape }}">
                    <button type="button" data-step-q="-1" aria-label="{{ 'accessibility.decrease_quantity' | t }}"{% if item.quantity <= 1 %} disabled{% endif %}><svg class="icon icon--sm" aria-hidden="true"><use href="#i-minus"></use></svg></button>
                    <span aria-live="polite">{{ item.quantity }}</span>
                    <button type="button" data-step-q="1" aria-label="{{ 'accessibility.increase_quantity' | t }}"{% if max != '' and item.quantity >= max %} disabled{% endif %}><svg class="icon icon--sm" aria-hidden="true"><use href="#i-plus"></use></svg></button>
                  </div>
                  <input type="hidden" name="updates[]" value="{{ item.quantity }}">
                </div>
                <div class="cart-line__end">
                  <span class="cart-line__price">
                    {%- if item.original_line_price > item.final_line_price -%}<s class="cart-line__was">{{ item.original_line_price | money }}</s>{%- endif -%}
                    <span>{{ item.final_line_price | money }}</span>
                  </span>
                  <button type="button" class="link-quiet" data-remove aria-label="{{ 'mn.cart.remove_title' | t: title: item.product.title | escape }}">{{ 'cart.remove' | t }}</button>
                </div>
              </div>
            {%- endfor -%}
            <noscript><button type="submit" name="update" class="mn-btn mn-btn--secondary mn-btn--sm">{{ 'mn.cartpage.update' | t }}</button></noscript>
          </div>

          <aside class="mn-cartpage__summary">
            <h2 class="mn-cartpage__summary-title">{{ 'mn.cartpage.summary' | t }}</h2>
            <div class="mn-cartpage__rows">
              <div class="cart-sub cart-sub--disc mn-cartpage__row"><span>{{ 'mn.cartpage.items' | t: count: cart.item_count }}</span><span>{{ cart.items_subtotal_price | money }}</span></div>
              {%- for d in cart.cart_level_discount_applications -%}
                <div class="cart-sub cart-sub--disc"><span><svg class="icon icon--sm" aria-hidden="true"><use href="#i-tag"></use></svg>{{ d.title }}</span><span>&minus;{{ d.total_allocated_amount | money }}</span></div>
              {%- endfor -%}
              <div class="cart-sub mn-cartpage__total"><span>{{ 'cart.subtotal' | t }}</span><span>{{ cart.total_price | money }}</span></div>
            </div>
            <p class="mn-cart-note">{%- if cart.taxes_included or shop.taxes_included -%}{{ 'mn.cart.taxes_included' | t }}{%- else -%}{{ 'mn.cart.taxes_excluded' | t }}{%- endif -%}</p>
            {%- if ss.show_note -%}
              <label class="mn-field mn-cartpage__note">
                <span class="mn-field__label">{{ 'cart.note' | t }}</span>
                <textarea class="input" name="note" rows="3" data-cart-note placeholder="{{ 'mn.cartpage.note_placeholder' | t }}">{{ cart.note }}</textarea>
              </label>
            {%- endif -%}
            <button type="submit" name="checkout" class="mn-btn mn-btn--block mn-cartpage__checkout"><svg class="icon" aria-hidden="true"><use href="#i-lock"></use></svg>{{ 'mn.cart.checkout' | t }}</button>
            {%- if additional_checkout_buttons and ss.show_express -%}
              <div class="mn-cartpage__express">{{ content_for_additional_checkout_buttons }}</div>
            {%- endif -%}
            <a href="{{ routes.all_products_collection_url }}" class="link-arrow mn-cartpage__continue">{{ 'cart.continue_shopping' | t }}<svg class="icon" aria-hidden="true"><use href="#i-arrow-right"></use></svg></a>
            {%- if ss.show_payments and shop.enabled_payment_types.size > 0 -%}<div class="payments">{%- render 'mn-payments' -%}</div>{%- endif -%}
          </aside>
        </form>
      {%- endif -%}
    </div>
  </div>

  {%- if recs_on and cart.item_count > 0 -%}
    <section class="mn-section mn-cartpage__recs" data-cart-recs="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ cart.items.first.product_id }}&limit={{ ss.recs_count }}&intent=related">
      {%- if recommendations.performed? and recommendations.products_count > 0 -%}
        <div class="mn-container" data-recs-inner>
          <div class="mn-section__head">
            <div><span class="mn-eyebrow">{{ 'mn.cartpage.recs_eyebrow' | t }}</span><h2 class="section-title">{{ ss.recs_heading }}</h2></div>
          </div>
          <div class="row-cards" style="--cols:{{ ss.recs_count }}">
            {%- for product in recommendations.products -%}{%- render 'product-card', product: product -%}{%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </section>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart",
  "tag": "section",
  "class": "section-main-cart",
  "settings": [
    { "type": "checkbox", "id": "show_note", "label": "Show order note", "default": true },
    { "type": "checkbox", "id": "show_shipping_bar", "label": "Show free shipping progress", "info": "Threshold: Theme settings → Cart.", "default": true },
    { "type": "checkbox", "id": "show_express", "label": "Show express checkout buttons", "info": "Shop Pay, Apple Pay and others, as set in your payment settings.", "default": true },
    { "type": "checkbox", "id": "show_payments", "label": "Show payment methods", "default": true },
    { "type": "header", "content": "Recommendations" },
    { "type": "checkbox", "id": "show_recommendations", "label": "Show recommendations", "info": "Also needs Theme settings → Cart → Show product recommendations in cart.", "default": true },
    { "type": "inline_richtext", "id": "recs_heading", "label": "Heading", "default": "You may <em>also like</em>" },
    { "type": "range", "id": "recs_count", "label": "Products", "min": 2, "max": 6, "step": 1, "default": 4 }
  ]
}
{% endschema %}
