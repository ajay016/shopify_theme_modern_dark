{%- comment -%}
  The panel under a top-level link that has children.

  Three layouts (Theme settings → Header → Mega menu layout), each with
  and without images (Show images in mega menu):
    v1  Columns     every child is a column heading with its own links
                    (menu → submenu → sub-submenu); a featured card on the right
    v2  Visual      a tile per child, with the collection's image or a text tile,
                    and the child's own links underneath
    v3  Flyout      a compact panel under the link: children on the left, the
                    hovered child's links on the right, a promo card beside them

  Images come from the mega_menu_item block when one matches the link,
  otherwise from the collection or product each link points to.

  Accepts: link, index, style, block, has_mega, images
{%- endcomment -%}
{%- liquid
  assign panel_id = 'mega-' | append: link.handle | append: '-' | append: index
  assign show_images = images
  if show_images == nil
    assign show_images = true
  endif

  assign feat_img = nil
  assign feat_url = link.url
  assign feat_label = ''
  assign feat_title = ''
  if has_mega
    assign feat_img = block.settings.featured_image
    assign feat_url = block.settings.featured_link | default: link.url
    assign feat_label = block.settings.featured_label
    assign feat_title = block.settings.featured_title
  endif
  unless feat_img
    if link.type == 'collection_link'
      assign feat_img = link.object.image | default: link.object.featured_image
    elsif link.type == 'product_link'
      assign feat_img = link.object.featured_image
    endif
  endunless

  assign leaves = 0
  for child in link.links
    if child.links.size == 0
      assign leaves = leaves | plus: 1
    endif
  endfor
-%}

{%- if style == 'v2' -%}
<div class="mega-menu mega-menu--v2{% unless show_images %} mega-menu--no-images{% endunless %}" id="{{ panel_id }}" role="region" aria-label="{{ link.title | escape }}">
  <div class="mega-menu__inner">
    <div class="mega-tiles">
      {%- for child in link.links limit: 6 -%}
        {%- liquid
          assign tile_img = nil
          if show_images
            if child.type == 'collection_link'
              assign tile_img = child.object.image | default: child.object.featured_image
            elsif child.type == 'product_link'
              assign tile_img = child.object.featured_image
            endif
            if forloop.first and has_mega and tile_img == nil
              assign tile_img = block.settings.featured_image
            endif
          endif
        -%}
        <div class="mega-tile" style="--i: {{ forloop.index0 }}">
          <a href="{{ child.url }}" class="mega-tile__media{% unless tile_img %} mega-tile__media--text{% endunless %}">
            {%- if tile_img -%}
              {{ tile_img | image_url: width: 520 | image_tag: loading: 'lazy', alt: child.title, sizes: '(min-width: 1200px) 220px, 18vw' }}
            {%- else -%}
              <span class="mega-tile__initial" aria-hidden="true">{{ child.title | slice: 0 }}</span>
            {%- endif -%}
          </a>
          <a href="{{ child.url }}" class="mega-tile__title"{% if child.active %} aria-current="page"{% endif %}>{{ child.title }}</a>
          {%- if child.links.size > 0 -%}
            <ul class="mega-tile__links">
              {%- for grandchild in child.links limit: 5 -%}
                <li><a href="{{ grandchild.url }}"{% if grandchild.active %} aria-current="page"{% endif %}>{{ grandchild.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    <a href="{{ link.url }}" class="mega-menu__all">{{ 'general.view_all' | t }} <span aria-hidden="true">→</span></a>
  </div>
</div>

{%- elsif style == 'v3' -%}
{%- liquid
  assign promo_img = nil
  assign promo_url = link.url
  assign promo_title = ''
  assign promo_label = ''
  if has_mega
    assign promo_img = block.settings.promo_image | default: block.settings.featured_image
    assign promo_url = block.settings.promo_link | default: link.url
    assign promo_title = block.settings.promo_title
    assign promo_label = block.settings.promo_label
  endif
  unless promo_img
    assign promo_img = feat_img
  endunless
-%}
<div class="mega-menu mega-menu--v3{% unless show_images %} mega-menu--no-images{% endunless %}" id="{{ panel_id }}" role="region" aria-label="{{ link.title | escape }}" data-flyout>
  <div class="mega-menu__inner">
    <ul class="flyout__list">
      {%- for child in link.links -%}
        <li style="--i: {{ forloop.index0 }}">
          <a href="{{ child.url }}" class="flyout__item{% if forloop.first %} is-current{% endif %}" data-flyout-item="{{ forloop.index0 }}"{% if child.active %} aria-current="page"{% endif %}>
            <span>{{ child.title }}</span>
            {%- if child.links.size > 0 -%}
              <svg width="6" height="10" viewBox="0 0 6 10" fill="none" aria-hidden="true"><path d="M1 1l4 4-4 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
    <div class="flyout__panes">
      {%- for child in link.links -%}
        <div class="flyout__pane{% if forloop.first %} is-current{% endif %}" data-flyout-pane="{{ forloop.index0 }}">
          <p class="flyout__heading">{{ child.title }}</p>
          {%- if child.links.size > 0 -%}
            <ul>
              {%- for grandchild in child.links -%}
                <li style="--i: {{ forloop.index0 }}"><a href="{{ grandchild.url }}"{% if grandchild.active %} aria-current="page"{% endif %}>{{ grandchild.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
          <a href="{{ child.url }}" class="mega-menu__all">{{ 'general.view_all' | t }} <span aria-hidden="true">→</span></a>
        </div>
      {%- endfor -%}
    </div>
    {%- if show_images and promo_img -%}
      <a href="{{ promo_url }}" class="flyout__promo">
        {{ promo_img | image_url: width: 480 | image_tag: loading: 'lazy', alt: promo_title | default: link.title }}
        {%- if promo_title != blank or promo_label != blank -%}
          <span class="flyout__promo-text">
            {%- if promo_title != blank -%}<b>{{ promo_title }}</b>{%- endif -%}
            {%- if promo_label != blank -%}<i>{{ promo_label }}</i>{%- endif -%}
          </span>
        {%- endif -%}
      </a>
    {%- endif -%}
  </div>
</div>

{%- else -%}
<div class="mega-menu mega-menu--v1{% unless show_images %} mega-menu--no-images{% endunless %}" id="{{ panel_id }}" role="region" aria-label="{{ link.title | escape }}">
  <div class="mega-menu__inner">
    <div class="mega-cols">
      {%- if leaves > 0 -%}
        <div class="mega-col" style="--i: 0">
          <a href="{{ link.url }}" class="mega-col__title">{{ link.title }}</a>
          <ul>
            {%- for child in link.links -%}
              {%- if child.links.size == 0 -%}
                <li><a href="{{ child.url }}"{% if child.active %} aria-current="page"{% endif %}>{{ child.title }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
      {%- for child in link.links -%}
        {%- if child.links.size > 0 -%}
          <div class="mega-col" style="--i: {{ forloop.index }}">
            <a href="{{ child.url }}" class="mega-col__title"{% if child.active %} aria-current="page"{% endif %}>{{ child.title }}</a>
            <ul>
              {%- for grandchild in child.links -%}
                <li><a href="{{ grandchild.url }}"{% if grandchild.active %} aria-current="page"{% endif %}>{{ grandchild.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if show_images and feat_img -%}
      <a href="{{ feat_url }}" class="mega-feature">
        <span class="mega-feature__img">
          {{ feat_img | image_url: width: 560 | image_tag: loading: 'lazy', alt: feat_title | default: link.title }}
        </span>
        {%- if feat_label != blank -%}<span class="mega-feature__label">{{ feat_label }}</span>{%- endif -%}
        <span class="mega-feature__title">{{ feat_title | default: link.title }}</span>
      </a>
    {%- endif -%}
  </div>
</div>
{%- endif -%}
