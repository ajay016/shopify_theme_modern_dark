{%- comment -%}Maison homepage · Collection spotlight: a sticky panel that follows the chapters (design section "collection-spotlight"){%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign tid = 'mh-sp-' | append: section.id
  assign c0 = section.blocks.first.settings
-%}
{%- render 'mh-assets' -%}
<section class="mh mh-sp{% if s.palette != 'theme' %} mh--own{% endif %}" data-mh="collection-spotlight" data-surface aria-labelledby="{{ tid }}">
  <div class="mh-sp__grid mh-wrap">
    <div class="mh-sp__panel">
      <div class="mh-sp__intro mh-reveal">
        {%- if s.eyebrow != blank -%}<span class="mh-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
        <h2 class="mh-h2" id="{{ tid }}">{{ s.heading }}</h2>
        {%- if s.text != blank -%}<p>{{ s.text }}</p>{%- endif -%}
      </div>
      <div class="mh-sp__now" aria-hidden="true"><span class="mh-sp__numeral" data-numeral>{{ c0.numeral }}</span><span class="mh-sp__ctitle" data-ctitle>{{ c0.title }}</span></div>
      <div class="mh-sp__foot">
        <ol class="mh-sp__steps" data-steps></ol>
        {%- if s.link_label != blank -%}<a class="mh-lnk" href="{{ s.link | default: routes.all_products_collection_url }}">{{ s.link_label }} {% render 'mh-icon', name: 'arrow' %}</a>{%- endif -%}
      </div>
    </div>
    <div class="mh-sp__chapters">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          case b.title
            when 'The coat'
              assign ph = '1558718699-f36d8a294bbb'
              assign alt = 'Woman in a brown coat'
              assign tone = 4
            when 'The knit'
              assign ph = '1491245257527-395e9c480145'
              assign alt = 'A folded cream sweater on a wooden board'
              assign tone = 2
            when 'The jewellery'
              assign ph = '1580461118826-91da2d5cf0ea'
              assign alt = 'Silver and gold jewellery on grey linen'
              assign tone = 1
            when 'The tailoring'
              assign ph = '1546032188-77743214827f'
              assign alt = 'Woman in a black tailored jumpsuit, in profile'
              assign tone = 5
            else
              assign ph = ''
              assign alt = b.title
              assign tone = forloop.index0 | modulo: 6 | plus: 1
          endcase
        -%}
        <figure class="mh-sp__ch mh-reveal" data-num="{{ b.numeral | escape }}" data-title="{{ b.title | escape }}" {{ block.shopify_attributes }}>
          {%- render 'mh-img', image: b.image, photo: ph, alt: alt, tone: tone, class: 'mh-sp__img', sizes: '(max-width: 720px) 100vw, 46vw' -%}
          <figcaption class="mh-sp__cap"><span class="mh-sp__cap-n">{{ b.numeral }} · {{ b.place }}</span><span class="mh-sp__cap-t">{{ b.title }}</span>{%- if b.text != blank -%}<p>{{ b.text }}</p>{%- endif -%}</figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Maison · Spotlight",
  "class": "mh-section",
  "max_blocks": 6,
  "settings": [
    { "type": "select", "id": "palette", "label": "Colours", "options": [{ "value": "own", "label": "Maison palette" }, { "value": "theme", "label": "Theme colour scheme" }], "default": "own" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Collection spotlight" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "The winter <em>edit</em>" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Four pieces to build the season around: a coat, a knit, a little gold and one perfect black suit." },
    { "type": "text", "id": "link_label", "label": "Link", "default": "Shop the winter edit" },
    { "type": "url", "id": "link", "label": "Link to" }
  ],
  "blocks": [
    { "type": "chapter", "name": "Chapter", "settings": [
      { "type": "text", "id": "numeral", "label": "Numeral", "default": "I" },
      { "type": "text", "id": "title", "label": "Title", "default": "The coat" },
      { "type": "text", "id": "place", "label": "Category", "default": "Outerwear" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Double-faced wool and alpaca, cut long, with a soft shoulder and a silk lining. From €1,890." },
      { "type": "image_picker", "id": "image", "label": "Image", "info": "Portrait, 4:5 (the third chapter is square)." }
    ] }
  ],
  "presets": [{ "name": "Maison · Spotlight", "blocks": [
    { "type": "chapter", "settings": { "numeral": "I", "title": "The coat", "place": "Outerwear", "text": "Double-faced wool and alpaca, cut long, with a soft shoulder and a silk lining. From €1,890." } },
    { "type": "chapter", "settings": { "numeral": "II", "title": "The knit", "place": "Knitwear", "text": "Scottish cashmere in a loose rib, knitted to keep its shape winter after winter. Six colours, from €720." } },
    { "type": "chapter", "settings": { "numeral": "III", "title": "The jewellery", "place": "Fine jewellery", "text": "Silver and 18k gold vermeil, set by hand in our workshop in the Marais. Rings, hoops and chains from €320." } },
    { "type": "chapter", "settings": { "numeral": "IV", "title": "The tailoring", "place": "Tailoring", "text": "A black jumpsuit cut like a suit, from the first meeting to dinner. €1,150." } }
  ] }]
}
{% endschema %}
