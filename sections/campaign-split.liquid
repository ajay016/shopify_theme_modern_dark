{%- liquid
  assign s = section.settings
  assign fallback = 'https://images.unsplash.com/photo-1496217590455-aa63a8350eea?auto=format&fit=crop&w=1600&q=85'
-%}

<section
  id="section-{{ section.id }}"
  class="csp csp--{{ s.scheme }}{% if s.media_position == 'right' %} csp--flip{% endif %}"
  data-section-id="{{ section.id }}"
>
  <div class="csp-media reveal">
    {%- if s.image != blank -%}
      {{ s.image | image_url: width: 1800 | image_tag: loading: 'lazy', class: 'csp-img', sizes: '(max-width: 900px) 100vw, 52vw', widths: '800,1200,1800', alt: s.heading }}
    {%- else -%}
      <img class="csp-img" src="{{ fallback }}" alt="{{ s.heading }}" loading="lazy" />
    {%- endif -%}
  </div>

  <div class="csp-copy reveal">
    <div class="csp-copy__top">
      {%- if s.eyebrow != blank -%}<p class="csp-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="csp-heading">{{ s.heading }}</h2>{%- endif -%}
    </div>

    <div class="csp-copy__bottom">
      {%- if s.description != blank -%}<p class="csp-desc">{{ s.description }}</p>{%- endif -%}
      {%- if s.link_label != blank -%}
        <a class="csp-link" href="{{ s.link | default: '/collections/all' }}">
          {{ s.link_label }}<span class="csp-link__arrow" aria-hidden="true">&#8594;</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  #section-{{ section.id }}.csp--light { --bg:var(--s2-bg,#131313); --fg:var(--s2-fg,#F5F0E8); --acc:var(--gold,#C8A96E); --mut:var(--s2-mut,rgba(245,240,232,.62)); }
  #section-{{ section.id }}.csp--dark  { --bg:var(--s1-bg,#0A0A0A); --fg:var(--s1-fg,#F5F0E8); --acc:var(--gold,#C8A96E); --mut:var(--s1-mut,rgba(245,240,232,.62)); }
  #section-{{ section.id }}.csp--warm  { --bg:var(--s3-bg,#1A1714); --fg:var(--s3-fg,#F5F0E8); --acc:var(--gold,#C8A96E); --mut:var(--s3-mut,rgba(245,240,232,.62)); }
  #section-{{ section.id }}.csp--theme { --bg:var(--s1-bg,#0A0A0A); --fg:var(--s1-fg,#F5F0E8); --acc:var(--gold,#C8A96E); --mut:var(--s1-mut,rgba(245,240,232,.62)); }

  #section-{{ section.id }} {
    display: grid;
    grid-template-columns: 1.08fr .92fr;
    background: var(--bg); color: var(--fg);
  }
  #section-{{ section.id }}.csp--flip .csp-media { order: 2; }

  #section-{{ section.id }} .csp-media {
    min-height: clamp(520px,72vh,760px);
    overflow: hidden;
    background: var(--img-placeholder, #1A1714);
  }
  #section-{{ section.id }} .csp-img {
    display: block; width: 100%; height: 100%;
    object-fit: cover; object-position: center 26%;
    filter: saturate(.66);
  }

  #section-{{ section.id }} .csp-copy {
    display: flex; flex-direction: column;
    align-items: flex-start; justify-content: space-between;
    min-height: clamp(520px,72vh,760px);
    padding: clamp(40px,5vw,72px);
  }
  #section-{{ section.id }} .csp-eyebrow {
    margin: 0 0 14px;
    font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: calc(12px * var(--fs-scale, 1));
    font-weight: 600; letter-spacing: .22em; text-transform: uppercase;
    color: var(--acc);
  }
  #section-{{ section.id }} .csp-heading {
    max-width: 560px; margin: 0;
    font-family: var(--ff-display,'Cormorant Garamond',serif);
    font-weight: 300;
    font-size: calc(clamp(40px,5.4vw,72px) * var(--heading-scale,1));
    line-height: 1;
  }
  #section-{{ section.id }} .csp-copy__bottom { max-width: 420px; margin-top: clamp(32px,5vh,56px); }
  #section-{{ section.id }} .csp-desc {
    margin: 0 0 26px;
    font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: calc(15px * var(--fs-scale, 1));
    line-height: 1.68; color: var(--mut);
  }
  #section-{{ section.id }} .csp-link {
    display: inline-flex; align-items: center; gap: 10px;
    padding-bottom: 4px; border-bottom: 1px solid currentColor;
    font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: calc(12px * var(--fs-scale, 1));
    font-weight: 600; letter-spacing: .16em; text-transform: uppercase;
    text-decoration: none; color: var(--fg);
  }
  #section-{{ section.id }} .csp-link:hover { color: var(--acc); }
  #section-{{ section.id }} .csp-link__arrow { transition: transform .22s ease; }
  #section-{{ section.id }} .csp-link:hover .csp-link__arrow { transform: translateX(4px); }

  #section-{{ section.id }} .reveal.reveal-armed { opacity: 0; transform: translateY(22px); transition: opacity .75s ease, transform .75s ease; }
  #section-{{ section.id }} .reveal.is-visible { opacity: 1; transform: none; }

  @media (max-width: 900px) {
    #section-{{ section.id }} { grid-template-columns: 1fr; }
    #section-{{ section.id }}.csp--flip .csp-media { order: 0; }
    #section-{{ section.id }} .csp-media { min-height: 480px; }
    #section-{{ section.id }} .csp-copy { min-height: 0; padding: clamp(36px,7vw,52px) var(--side-padding,5vw); }
    #section-{{ section.id }} .csp-copy__bottom { margin-top: 28px; }
  }
</style>

<script>
(function(){
  var SEC='{{ section.id }}';
  function arm(root){
    var els=root.querySelectorAll('.reveal');
    els.forEach(function(el){el.classList.add('reveal-armed');});
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('is-visible');io.unobserve(e.target);}});},{threshold:.12});
    els.forEach(function(el){io.observe(el);});
    setTimeout(function(){els.forEach(function(el){el.classList.add('is-visible');});},800);
  }
  function root(){return document.getElementById('section-'+SEC);}
  document.addEventListener('DOMContentLoaded',function(){var r=root();if(r)arm(r);});
  document.addEventListener('shopify:section:load',function(e){if(e.detail.sectionId!==SEC)return;var r=root();if(r){arm(r);r.querySelectorAll('.reveal').forEach(function(el){el.classList.add('is-visible');});}});
})();
</script>

{% schema %}
{
  "name": "Campaign Split",
  "tag": "section",
  "class": "section-campaign-split",
  "settings": [
    {
      "type": "select", "id": "scheme", "label": "Surface tone",
      "options": [
        { "value": "light", "label": "Alternate surface (soft)" },
        { "value": "dark",  "label": "Primary surface" },
        { "value": "warm",  "label": "Deep surface" },
        { "value": "theme", "label": "Primary surface (follow theme)" }
      ],
      "default": "warm"
    },
    {
      "type": "select", "id": "media_position", "label": "Image position",
      "options": [
        { "value": "left",  "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Campaign study 01" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Form follows movement." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Nothing is added without purpose. Soft structures and exact proportions follow the body without restricting it, creating a wardrobe that feels composed but never fixed." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Discover the story" },
    { "type": "url",  "id": "link",       "label": "Link" }
  ],
  "presets": [{ "name": "Campaign Split" }]
}
{% endschema %}
