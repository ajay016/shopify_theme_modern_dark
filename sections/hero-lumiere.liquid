{%- liquid
  assign s = section.settings
  assign fallback = 'https://images.unsplash.com/photo-1469334031218-e382a71b716b?auto=format&fit=crop&w=900&q=85'
  assign img_alt = s.heading_left | default: 'Editorial'
-%}

<section
  id="section-{{ section.id }}"
  class="hlm-section hlm--{{ s.scheme }}"
  data-section-id="{{ section.id }}"
>
  <span class="hlm-spot" aria-hidden="true"></span>

  <div class="hlm-inner">
    {%- if s.eyebrow != blank -%}
      <span class="hlm-eyebrow"><span class="hlm-eyebrow__dia">&#10022;</span> {{ s.eyebrow }} <span class="hlm-eyebrow__dia">&#10022;</span></span>
    {%- endif -%}

    {%- comment -%}The stage: headline split around a centered image column{%- endcomment -%}
    <div class="hlm-stage">
      <h1 class="hlm-title" aria-label="{{ s.heading_left }} {{ s.heading_right }}">
        <span class="hlm-title__half hlm-title__half--l" aria-hidden="true">{{ s.heading_left }}</span>

        <span class="hlm-figure">
          <span class="hlm-figure__ring" aria-hidden="true"></span>
          <span class="hlm-figure__media">
            {%- if s.image != blank -%}
              {{ s.image | image_url: width: 900 | image_tag:
                loading: 'eager', fetchpriority: 'high', class: 'hlm-figure__img',
                sizes: '(max-width:900px) 78vw, 30vw', widths: '450,700,900', alt: img_alt }}
            {%- else -%}
              <img class="hlm-figure__img" src="{{ fallback }}" alt="{{ img_alt | escape }}" loading="eager" fetchpriority="high" />
            {%- endif -%}
          </span>
          {%- if s.accent_word != blank -%}
            <span class="hlm-figure__accent" aria-hidden="true"><em>{{ s.accent_word }}</em></span>
          {%- endif -%}
        </span>

        <span class="hlm-title__half hlm-title__half--r" aria-hidden="true">{{ s.heading_right }}</span>
      </h1>
    </div>

    {%- if s.description != blank -%}<p class="hlm-desc">{{ s.description }}</p>{%- endif -%}

    <div class="hlm-ctas">
      {%- if s.btn1_label != blank -%}<a href="{{ s.btn1_link | default: '#' }}" class="hlm-btn hlm-btn--gold">{{ s.btn1_label }}</a>{%- endif -%}
      {%- if s.btn2_label != blank -%}<a href="{{ s.btn2_link | default: '#' }}" class="hlm-btn hlm-btn--ghost">{{ s.btn2_label }}</a>{%- endif -%}
    </div>
  </div>

  <div class="hlm-foot" aria-hidden="true">
    {%- if s.corner_left != blank -%}<span>{{ s.corner_left }}</span>{%- endif -%}
    {%- if s.scroll_label != blank -%}
      <span class="hlm-cue"><span class="hlm-cue__dot"></span>{{ s.scroll_label }}</span>
    {%- endif -%}
    {%- if s.corner_right != blank -%}<span>{{ s.corner_right }}</span>{%- endif -%}
  </div>
</section>

<style>
  #section-{{ section.id }}.hlm--light { --bg:#F2EFE8; --fg:#16131A; --acc:var(--gold,#A8874C); --mut:rgba(22,19,26,.55); --bdr:rgba(22,19,26,.16); --spot:rgba(168,135,76,.14); }
  #section-{{ section.id }}.hlm--dark  { --bg:#100E14; --fg:#EFEBE2; --acc:var(--gold,#C6A15B); --mut:rgba(239,235,226,.52); --bdr:rgba(239,235,226,.16); --spot:rgba(198,161,91,.16); }
  #section-{{ section.id }}.hlm--warm  { --bg:#E9DFCE; --fg:#241D15; --acc:var(--gold,#8E5A2A); --mut:rgba(36,29,21,.55); --bdr:rgba(36,29,21,.2); --spot:rgba(142,90,42,.13); }
  #section-{{ section.id }}.hlm--theme { --bg:var(--background,#100E14); --fg:var(--foreground,#EFEBE2); --acc:var(--gold,#C6A15B); --mut:var(--muted,rgba(239,235,226,.52)); --bdr:var(--border,rgba(239,235,226,.16)); --spot:rgba(198,161,91,.14); }

  #section-{{ section.id }} {
    position: relative; background: var(--bg); color: var(--fg);
    overflow: hidden; isolation: isolate;
    display: flex; flex-direction: column;
    padding: clamp(112px, 14svh, 160px) var(--side-padding,5vw) 0;
  }

  /* Runway spotlight */
  #section-{{ section.id }} .hlm-spot {
    position: absolute; z-index: 0; inset: -12% -30%;
    background: radial-gradient(42% 52% at 50% 46%, var(--spot) 0%, transparent 72%);
    pointer-events: none;
  }

  #section-{{ section.id }} .hlm-inner {
    position: relative; z-index: 1;
    display: flex; flex-direction: column; align-items: center; text-align: center;
    width: 100%; max-width: var(--container-width,1440px); margin: 0 auto;
  }

  #section-{{ section.id }} .hlm-eyebrow {
    display: inline-flex; align-items: center; gap: 12px;
    font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: 11px; font-weight: 500; letter-spacing: .34em; text-transform: uppercase;
    color: var(--acc); margin-bottom: clamp(26px, 4.4svh, 46px);
    animation: hlmUp{{ section.id }} .8s .05s both;
  }
  #section-{{ section.id }} .hlm-eyebrow__dia { font-size: 9px; }

  /* — The stage — */
  #section-{{ section.id }} .hlm-stage { width: 100%; }
  #section-{{ section.id }} .hlm-title {
    display: grid; grid-template-columns: 1fr auto 1fr;
    align-items: center; gap: clamp(18px, 2.6vw, 44px);
    font-family: var(--ff-display,'Cormorant Garamond',serif); font-weight: 300;
    font-size: calc(clamp(40px, 6vw, 96px) * var(--heading-scale,1));
    line-height: 1; letter-spacing: .02em; text-transform: uppercase;
    margin: 0; width: 100%;
  }
  #section-{{ section.id }} .hlm-title__half--l { text-align: right; animation: hlmL{{ section.id }} 1s .2s both; }
  #section-{{ section.id }} .hlm-title__half--r { text-align: left;  animation: hlmR{{ section.id }} 1s .2s both; }

  #section-{{ section.id }} .hlm-figure { position: relative; display: inline-block; }
  #section-{{ section.id }} .hlm-figure__ring {
    position: absolute; z-index: 0; inset: -9% -22% auto;
    width: 144%; aspect-ratio: 1; left: 50%; top: 46%;
    transform: translate(-50%, -50%);
    border: 1px solid color-mix(in srgb, var(--acc) 55%, transparent);
    border-radius: 50%;
    animation: hlmRing{{ section.id }} 1.4s .5s both;
  }
  #section-{{ section.id }} .hlm-figure__media {
    position: relative; z-index: 1; display: block;
    width: clamp(220px, 24vw, 360px); aspect-ratio: 3/4.2;
    overflow: hidden; border-radius: 999px 999px 4px 4px; /* couture arch */
    background: var(--bdr);
    animation: hlmFade{{ section.id }} 1.2s .12s both;
  }
  #section-{{ section.id }} .hlm-figure__img { width: 100%; height: 100%; object-fit: cover; display: block; animation: hlmKen{{ section.id }} 16s ease-out forwards; }
  #section-{{ section.id }} .hlm-figure__accent {
    position: absolute; z-index: 2; left: 50%; bottom: -4%;
    transform: translateX(-50%); white-space: nowrap;
    font-family: var(--ff-display,'Cormorant Garamond',serif);
    font-size: calc(clamp(30px, 3.4vw, 56px) * var(--heading-scale,1));
    font-weight: 300; color: var(--acc); text-transform: none;
    text-shadow: 0 2px 22px rgba(0,0,0,.25);
    animation: hlmUp{{ section.id }} 1s .6s both;
  }
  #section-{{ section.id }} .hlm-figure__accent em { font-style: italic; }

  #section-{{ section.id }} .hlm-desc {
    font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: clamp(14px, 1.05vw, 16px); line-height: 1.75;
    color: var(--mut); max-width: 480px;
    margin: clamp(30px, 5svh, 52px) 0 0;
    animation: hlmUp{{ section.id }} .9s .7s both;
  }
  #section-{{ section.id }} .hlm-ctas { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; margin-top: clamp(22px, 3.4svh, 34px); animation: hlmUp{{ section.id }} .9s .8s both; }
  #section-{{ section.id }} .hlm-btn {
    display: inline-flex; align-items: center;
    font-family: var(--ff-body,'Outfit',sans-serif); font-size: 11px; font-weight: 500;
    letter-spacing: .18em; text-transform: uppercase; padding: 16px 36px; text-decoration: none;
    border-radius: 999px; transition: transform .22s, background .22s, color .22s, border-color .22s, box-shadow .22s;
  }
  #section-{{ section.id }} .hlm-btn--gold { background: var(--acc); color: #14110a; }
  #section-{{ section.id }} .hlm-btn--gold:hover { transform: translateY(-2px); box-shadow: 0 16px 38px -16px color-mix(in srgb, var(--acc) 70%, transparent); }
  #section-{{ section.id }} .hlm-btn--ghost { border: 1px solid var(--bdr); color: var(--fg); }
  #section-{{ section.id }} .hlm-btn--ghost:hover { border-color: var(--acc); color: var(--acc); }

  /* Invitation footline */
  #section-{{ section.id }} .hlm-foot {
    position: relative; z-index: 1;
    display: flex; align-items: center; justify-content: space-between; gap: 18px;
    max-width: var(--container-width,1440px); margin: clamp(34px, 6svh, 64px) auto 0; width: 100%;
    padding: 16px 0 22px; border-top: 1px solid var(--bdr);
    font-family: var(--ff-body,'Outfit',sans-serif); font-size: 10px; font-weight: 500;
    letter-spacing: .26em; text-transform: uppercase; color: var(--mut);
  }
  #section-{{ section.id }} .hlm-cue { display: inline-flex; align-items: center; gap: 10px; color: var(--acc); }
  #section-{{ section.id }} .hlm-cue__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--acc); animation: hlmPulse{{ section.id }} 2.2s ease-in-out infinite; }

  @keyframes hlmUp{{ section.id }}   { from { opacity:0; transform: translateY(24px);} to { opacity:1; transform:none; } }
  @keyframes hlmL{{ section.id }}    { from { opacity:0; transform: translateX(-34px);} to { opacity:1; transform:none; } }
  @keyframes hlmR{{ section.id }}    { from { opacity:0; transform: translateX(34px);} to { opacity:1; transform:none; } }
  @keyframes hlmFade{{ section.id }} { from { opacity:0;} to { opacity:1;} }
  @keyframes hlmKen{{ section.id }}  { from { transform: scale(1.08);} to { transform: scale(1);} }
  @keyframes hlmRing{{ section.id }} { from { opacity:0; transform: translate(-50%,-50%) scale(.92);} to { opacity:1; transform: translate(-50%,-50%) scale(1);} }
  @keyframes hlmPulse{{ section.id }}{ 0%,100% { opacity:.4;} 50% { opacity:1;} }

  @media (max-width: 900px) {
    #section-{{ section.id }} { padding-top: clamp(104px, 13svh, 132px); }
    #section-{{ section.id }} .hlm-title {
      grid-template-columns: 1fr; gap: 10px;
      font-size: calc(clamp(38px, 10vw, 60px) * var(--heading-scale,1));
    }
    #section-{{ section.id }} .hlm-title__half--l,
    #section-{{ section.id }} .hlm-title__half--r { text-align: center; }
    #section-{{ section.id }} .hlm-figure { order: 3; margin-top: 18px; }
    #section-{{ section.id }} .hlm-figure__media { width: min(66vw, 300px); }
    #section-{{ section.id }} .hlm-figure__ring { width: 126%; }
    #section-{{ section.id }} .hlm-foot span:first-child,
    #section-{{ section.id }} .hlm-foot span:last-child { display: none; }
    #section-{{ section.id }} .hlm-foot { justify-content: center; }
  }
</style>

{% schema %}
{
  "name": "Hero Lumière",
  "tag": "section",
  "class": "section-hero-lumiere",
  "settings": [
    {
      "type": "select", "id": "scheme", "label": "Color scheme",
      "options": [
        { "value": "light", "label": "Light (pearl)" },
        { "value": "dark",  "label": "Dark (velvet)" },
        { "value": "warm",  "label": "Warm (champagne)" },
        { "value": "theme", "label": "Follow theme" }
      ],
      "default": "dark"
    },
    { "type": "image_picker", "id": "image", "label": "Center image" },
    { "type": "header", "content": "Headline (split around the image)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Maison Noir Presents" },
    { "type": "text", "id": "heading_left",  "label": "Headline left of image",  "default": "La Belle" },
    { "type": "text", "id": "heading_right", "label": "Headline right of image", "default": "Lumière" },
    { "type": "text", "id": "accent_word", "label": "Accent word (italic, over image base)", "default": "Nº 05" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "An evening-wear study in light and shadow — champagne silks, sculpted velvet, and pieces that arrive like an invitation." },
    { "type": "text", "id": "btn1_label", "label": "Primary button", "default": "Enter the Collection" },
    { "type": "url",  "id": "btn1_link",  "label": "Primary button link" },
    { "type": "text", "id": "btn2_label", "label": "Secondary button", "default": "The Story" },
    { "type": "url",  "id": "btn2_link",  "label": "Secondary button link" },
    { "type": "header", "content": "Footline" },
    { "type": "text", "id": "corner_left",  "label": "Foot left",  "default": "Paris — Milan — Tokyo" },
    { "type": "text", "id": "scroll_label", "label": "Center cue", "default": "Begin" },
    { "type": "text", "id": "corner_right", "label": "Foot right", "default": "Autumn / Winter 2025" }
  ],
  "presets": [ { "name": "Hero Lumière" } ]
}
{% endschema %}
