{%- liquid
  assign s = section.settings
  assign fallbacks = 'https://images.unsplash.com/photo-1539109136881-3be0616acf4b?auto=format&fit=crop&w=900&q=85|https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=900&q=85|https://images.unsplash.com/photo-1485462537746-965f33f7f6a7?auto=format&fit=crop&w=900&q=85|https://images.unsplash.com/photo-1525507119028-ed4c629a60a3?auto=format&fit=crop&w=900&q=85|https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=900&q=85|https://images.unsplash.com/photo-1496217590455-aa63a8350eea?auto=format&fit=crop&w=900&q=85' | split: '|'
-%}

<section
  id="section-{{ section.id }}"
  class="cix-section cix--{{ s.scheme }}"
  data-section-id="{{ section.id }}"
>
  <div class="cix-inner">
    <div class="cix-head reveal">
      <div>
        {%- if s.eyebrow != blank -%}<span class="cix-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="cix-heading">{{ s.heading }}</h2>{%- endif -%}
      </div>
      {%- if s.intro != blank -%}<p class="cix-intro">{{ s.intro }}</p>{%- endif -%}
    </div>

    {%- comment -%}Expanding panels — hover/tap a panel and it widens open{%- endcomment -%}
    <div class="cix-panels reveal" data-cix-panels>
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign fb = fallbacks[forloop.index0] | default: fallbacks[0] -%}
          {%- assign img = block.settings.image -%}
          <a
            href="{{ block.settings.link | default: '/collections/all' }}"
            class="cix-panel{% if forloop.first %} is-open{% endif %}"
            data-cix-panel
            {{ block.shopify_attributes }}
          >
            <span class="cix-panel__media">
              {%- if img != blank -%}
                {{ img | image_url: width: 900 | image_tag: loading: 'lazy', class: 'cix-panel__img', sizes: '(max-width:860px) 92vw, 46vw', widths: '400,600,900', alt: block.settings.title }}
              {%- else -%}
                <img class="cix-panel__img" src="{{ fb }}" alt="{{ block.settings.title | escape }}" loading="lazy" />
              {%- endif -%}
            </span>
            <span class="cix-panel__shade" aria-hidden="true"></span>
            <span class="cix-panel__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <span class="cix-panel__side" aria-hidden="true">{{ block.settings.title }}</span>
            <span class="cix-panel__body">
              {%- if block.settings.kicker != blank -%}<span class="cix-panel__kicker">{{ block.settings.kicker }}</span>{%- endif -%}
              <span class="cix-panel__title">{{ block.settings.title }}</span>
              <span class="cix-panel__cta">{{ block.settings.cta | default: 'Explore' }} <span aria-hidden="true">&#8594;</span></span>
            </span>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- assign demo_titles = 'Outerwear,Tailoring,Knitwear,Accessories' | split: ',' -%}
        {%- assign demo_kick = 'The Structure,The Cut,The Comfort,The Detail' | split: ',' -%}
        {%- for i in (0..3) -%}
          <a href="/collections/all" class="cix-panel{% if forloop.first %} is-open{% endif %}" data-cix-panel>
            <span class="cix-panel__media">
              <img class="cix-panel__img" src="{{ fallbacks[i] }}" alt="{{ demo_titles[i] }}" loading="lazy" />
            </span>
            <span class="cix-panel__shade" aria-hidden="true"></span>
            <span class="cix-panel__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <span class="cix-panel__side" aria-hidden="true">{{ demo_titles[i] }}</span>
            <span class="cix-panel__body">
              <span class="cix-panel__kicker">{{ demo_kick[i] }}</span>
              <span class="cix-panel__title">{{ demo_titles[i] }}</span>
              <span class="cix-panel__cta">Explore <span aria-hidden="true">&#8594;</span></span>
            </span>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  #section-{{ section.id }}.cix--light { --bg:#ECE9E2; --fg:#18181A; --acc:var(--gold,#9A7B43); --mut:rgba(24,24,26,.55); --bdr:rgba(24,24,26,.14); }
  #section-{{ section.id }}.cix--dark  { --bg:#161618; --fg:#ECE9E2; --acc:var(--gold,#C8A96E); --mut:rgba(236,233,226,.52); --bdr:rgba(236,233,226,.14); }
  #section-{{ section.id }}.cix--warm  { --bg:#E7DCCB; --fg:#241D15; --acc:var(--gold,#8E4F2A); --mut:rgba(36,29,21,.55); --bdr:rgba(36,29,21,.18); }
  #section-{{ section.id }}.cix--theme { --bg:var(--background,#161618); --fg:var(--foreground,#ECE9E2); --acc:var(--gold,#C8A96E); --mut:var(--muted,rgba(236,233,226,.52)); --bdr:var(--border,rgba(236,233,226,.14)); }

  #section-{{ section.id }} { background: var(--bg); color: var(--fg); padding: var(--section-spacing,80px) var(--side-padding,5vw); }
  #section-{{ section.id }} .cix-inner { max-width: var(--container-width,1440px); margin: 0 auto; }

  #section-{{ section.id }} .cix-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 28px; margin-bottom: clamp(30px,3.6vw,48px); flex-wrap: wrap; }
  #section-{{ section.id }} .cix-eyebrow { display: block; font-family: var(--ff-body,'Outfit',sans-serif); font-size: 11px; font-weight: 500; letter-spacing: .26em; text-transform: uppercase; color: var(--acc); margin-bottom: 14px; }
  #section-{{ section.id }} .cix-heading { font-family: var(--ff-display,'Cormorant Garamond',serif); font-size: calc(clamp(32px,4.4vw,62px) * var(--heading-scale,1)); font-weight: 300; line-height: 1.02; text-transform: uppercase; margin: 0; }
  #section-{{ section.id }} .cix-intro { font-family: var(--ff-body,'Outfit',sans-serif); font-size: clamp(13px,1vw,15px); line-height: 1.7; color: var(--mut); max-width: 340px; }

  /* — Expanding panels — */
  #section-{{ section.id }} .cix-panels {
    display: flex; gap: clamp(8px,.9vw,14px);
    height: clamp(440px, 64vh, 680px);
  }
  #section-{{ section.id }} .cix-panel {
    position: relative; overflow: hidden; display: block; text-decoration: none;
    flex: 1 1 0%;
    transition: flex .65s cubic-bezier(.32,0,.18,1);
    background: var(--bdr);
  }
  #section-{{ section.id }} .cix-panel.is-open { flex: 3.2 1 0%; }

  #section-{{ section.id }} .cix-panel__media { position: absolute; inset: 0; }
  #section-{{ section.id }} .cix-panel__img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    filter: saturate(.85) brightness(.92);
    transition: filter .5s, transform 8s ease-out;
  }
  #section-{{ section.id }} .cix-panel.is-open .cix-panel__img { filter: saturate(1) brightness(1); transform: scale(1.04); }

  #section-{{ section.id }} .cix-panel__shade {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(to top, rgba(12,12,13,.82) 0%, rgba(12,12,13,.12) 46%, rgba(12,12,13,.22) 100%);
    transition: opacity .5s;
  }

  #section-{{ section.id }} .cix-panel__num {
    position: absolute; z-index: 2; top: 16px; left: 18px;
    font-family: var(--ff-display,'Cormorant Garamond',serif);
    font-size: clamp(22px,2.2vw,36px); line-height: 1; color: rgba(255,255,255,.92);
  }

  /* Collapsed state: vertical label along the panel */
  #section-{{ section.id }} .cix-panel__side {
    position: absolute; z-index: 2; left: 50%; bottom: 24px;
    transform: translateX(-50%);
    writing-mode: vertical-rl;
    font-family: var(--ff-display,'Cormorant Garamond',serif);
    font-size: clamp(18px,1.7vw,26px); font-weight: 400; letter-spacing: .06em;
    text-transform: uppercase; color: #fff; white-space: nowrap;
    opacity: 1; transition: opacity .3s;
  }
  #section-{{ section.id }} .cix-panel.is-open .cix-panel__side { opacity: 0; }

  /* Open state: full caption */
  #section-{{ section.id }} .cix-panel__body {
    position: absolute; z-index: 2; left: clamp(18px,2vw,30px); right: clamp(18px,2vw,30px); bottom: clamp(18px,2.2vw,30px);
    opacity: 0; transform: translateY(14px);
    transition: opacity .45s .18s, transform .5s .18s;
  }
  #section-{{ section.id }} .cix-panel.is-open .cix-panel__body { opacity: 1; transform: none; }
  #section-{{ section.id }} .cix-panel__kicker { display: block; font-family: var(--ff-body,'Outfit',sans-serif); font-size: 10px; font-weight: 500; letter-spacing: .2em; text-transform: uppercase; color: var(--acc); margin-bottom: 8px; }
  #section-{{ section.id }} .cix-panel__title { display: block; font-family: var(--ff-display,'Cormorant Garamond',serif); font-size: clamp(26px,2.8vw,48px); font-weight: 400; line-height: 1.04; color: #fff; }
  #section-{{ section.id }} .cix-panel__cta { display: inline-flex; align-items: center; gap: 8px; margin-top: 12px; font-family: var(--ff-body,'Outfit',sans-serif); font-size: 11px; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; color: rgba(255,255,255,.85); border-bottom: 1px solid var(--acc); padding-bottom: 4px; }

  #section-{{ section.id }} .reveal.reveal-armed { opacity: 0; transform: translateY(26px); transition: opacity .7s ease, transform .7s ease; }
  #section-{{ section.id }} .reveal.is-visible { opacity: 1; transform: none; }

  /* — Mobile: vertical accordion (tap to open) — */
  @media (max-width: 860px) {
    #section-{{ section.id }} .cix-panels { flex-direction: column; height: auto; }
    #section-{{ section.id }} .cix-panel { flex: none; height: 96px; transition: height .55s cubic-bezier(.32,0,.18,1); }
    #section-{{ section.id }} .cix-panel.is-open { flex: none; height: clamp(300px, 48svh, 420px); }
    #section-{{ section.id }} .cix-panel__side {
      writing-mode: horizontal-tb; left: 18px; right: auto; bottom: 50%;
      transform: translateY(50%); font-size: 20px;
    }
    #section-{{ section.id }} .cix-panel__num { top: 50%; left: auto; right: 18px; transform: translateY(-50%); font-size: 20px; }
    #section-{{ section.id }} .cix-panel.is-open .cix-panel__num { top: 16px; transform: none; }
  }
</style>

<script>
(function(){
  var SEC='{{ section.id }}';
  function arm(root){
    var els=root.querySelectorAll('.reveal');
    els.forEach(function(el){el.classList.add('reveal-armed');});
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('is-visible');io.unobserve(e.target);}});},{threshold:.12});
    els.forEach(function(el){io.observe(el);});
    setTimeout(function(){els.forEach(function(el){el.classList.add('is-visible');});},800);
  }
  function initPanels(root){
    var wrap=root.querySelector('[data-cix-panels]'); if(!wrap)return;
    var panels=wrap.querySelectorAll('[data-cix-panel]');
    function open(target){
      panels.forEach(function(p){p.classList.toggle('is-open',p===target);});
    }
    panels.forEach(function(p){
      p.addEventListener('mouseenter',function(){open(p);});
      p.addEventListener('focus',function(){open(p);},true);
      // touch: first tap opens, second tap follows the link
      p.addEventListener('click',function(e){
        if(!p.classList.contains('is-open')){e.preventDefault();open(p);}
      });
    });
  }
  function root(){return document.getElementById('section-'+SEC);}
  function init(){var r=root();if(r){arm(r);initPanels(r);}}
  document.addEventListener('DOMContentLoaded',init);
  document.addEventListener('shopify:section:load',function(e){if(e.detail.sectionId!==SEC)return;init();var r=root();if(r)r.querySelectorAll('.reveal').forEach(function(el){el.classList.add('is-visible');});});
})();
</script>

{% schema %}
{
  "name": "Category Index",
  "tag": "section",
  "class": "section-category-index",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select", "id": "scheme", "label": "Color scheme",
      "options": [
        { "value": "light", "label": "Light (bone)" },
        { "value": "dark",  "label": "Dark (graphite)" },
        { "value": "warm",  "label": "Warm (sand)" },
        { "value": "theme", "label": "Follow theme" }
      ],
      "default": "light"
    },
    { "type": "paragraph", "content": "Hover (or tap) a panel to expand it. The first panel starts open." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Browse" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Index" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Four pillars of the collection — engineered for movement, made for the modern wardrobe." }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "kicker", "label": "Kicker", "default": "The Cut" },
        { "type": "text", "id": "title",  "label": "Title",  "default": "Tailoring" },
        { "type": "text", "id": "cta",    "label": "CTA label", "default": "Explore" },
        { "type": "url",  "id": "link",   "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Index",
      "blocks": [
        { "type": "category", "settings": { "kicker": "The Structure", "title": "Outerwear" } },
        { "type": "category", "settings": { "kicker": "The Cut", "title": "Tailoring" } },
        { "type": "category", "settings": { "kicker": "The Comfort", "title": "Knitwear" } },
        { "type": "category", "settings": { "kicker": "The Detail", "title": "Accessories" } }
      ]
    }
  ]
}
{% endschema %}
