  :root {
    /* Semantic aliases used by "Follow theme" section variants */
    --background: var(--s1-bg);
    --foreground: var(--s1-fg);

    --card-bg: var(--s2-bg);
    --card-fg: var(--s2-fg);
    --card-mut: var(--s2-mut);
    --card-bdr: var(--s2-bdr);

    /* A scrim dims the page behind a modal, so it is always dark. Deriving
       it from the surface produced a white scrim under a white modal. */
    --modal-scrim: rgba(10, 10, 11, 0.74);

    /* Imagery is photographic, not themed. Anything drawn on top of a photo
       keeps its own always-legible colors in every scheme. */
    --img-placeholder: #1A1714;
    --img-scrim: rgba(10, 10, 11, 0.55);
    --img-scrim-strong: rgba(10, 10, 11, 0.78);
    --on-image: #FFFFFF;
    --on-image-mut: rgba(255, 255, 255, 0.78);
    --onphoto-light: rgba(252, 251, 249, 0.96);
    --onphoto-light-fg: #16130F;
    --onphoto-dark: rgba(20, 17, 13, 0.94);
    --onphoto-dark-fg: #F4EFE6;

    /* Typography */
    {%- liquid
      assign pairing = settings.font_pairing | default: 'newsreader_geist'
      assign body_size = settings.type_body_size | default: 14
      assign hscale = settings.type_heading_size_scale | default: 'medium'
    -%}
    /* --fw-display is the heading weight each display face reads best at;
       --ls-display its tracking. Headings used a fixed 300, which only
       Cormorant has -- every other face fell back to 400 anyway. */
    {%- if pairing == 'newsreader_geist' -%}
      --ff-display: "Newsreader", Georgia, serif;
      --ff-body: "Geist", system-ui, sans-serif;
      --fw-display: 400; --ls-display: -0.015em;
    {%- elsif pairing == 'custom' -%}
      --ff-display: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
      --ff-body: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
      --fw-display: {{ settings.type_heading_font.weight | default: 400 }}; --ls-display: -0.01em;
    {%- elsif pairing == 'instrument_intertight' -%}
      --ff-display: "Instrument Serif", "Times New Roman", serif;
      --ff-body: "Inter Tight", system-ui, sans-serif;
      --fw-display: 400; --ls-display: -0.015em;
    {%- elsif pairing == 'intertight_solo' -%}
      --ff-display: "Inter Tight", system-ui, sans-serif;
      --ff-body: "Inter Tight", system-ui, sans-serif;
      --fw-display: 400; --ls-display: -0.035em;
    {%- elsif pairing == 'bodoni_jost' -%}
      --ff-display: "Bodoni Moda", "Times New Roman", serif;
      --ff-body: Jost, system-ui, sans-serif;
      --fw-display: 400; --ls-display: -0.01em;
    {%- elsif pairing == 'fraunces_jakarta' -%}
      --ff-display: Fraunces, Georgia, serif;
      --ff-body: "Plus Jakarta Sans", system-ui, sans-serif;
      --fw-display: 300; --ls-display: -0.02em;
    {%- elsif pairing == 'bodoni_instrument' -%}
      --ff-display: "Bodoni Moda", "Times New Roman", serif;
      --ff-body: "Instrument Sans", Helvetica, Arial, sans-serif;
      --fw-display: 400; --ls-display: -0.01em;
    {%- elsif pairing == 'playfair_inter' -%}
      --ff-display: "Playfair Display", Georgia, serif;
      --ff-body: Inter, system-ui, sans-serif;
      --fw-display: 400; --ls-display: -0.01em;
    {%- elsif pairing == 'libre_raleway' -%}
      --ff-display: "Libre Baskerville", Georgia, serif;
      --ff-body: Raleway, system-ui, sans-serif;
      --fw-display: 400; --ls-display: -0.01em;
    {%- elsif pairing == 'dm_serif_dm_sans' -%}
      --ff-display: "DM Serif Display", Georgia, serif;
      --ff-body: "DM Sans", system-ui, sans-serif;
      --fw-display: 400; --ls-display: -0.01em;
    {%- else -%}
      --ff-display: "Cormorant Garamond", Georgia, serif;
      --ff-body: Outfit, system-ui, sans-serif;
      --fw-display: 300; --ls-display: -0.01em;
    {%- endif -%}

    /* Numerals -- filter counts, size counts, pagination -- are set in mono.
       It is a deliberate part of the look, not a fallback. */
    --ff-mono: {% if pairing == 'newsreader_geist' %}"Geist Mono"{% else %}"IBM Plex Mono"{% endif %}, ui-monospace, "SF Mono", Menlo, monospace;

    --fs-base: {{ body_size }}px;
    --fs-scale: {{ body_size | times: 1.0 | divided_by: 14.0 }};
    {%- if hscale == 'small' -%}
      --heading-scale: 0.80;
    {%- elsif hscale == 'large' -%}
      --heading-scale: 1.24;
    {%- else -%}
      --heading-scale: 1;
    {%- endif -%}

    /* Layout */
    --container-width: {{ settings.layout_container_width | default: '1440px' }};
    --section-spacing: {{ settings.layout_section_spacing | default: 80 }}px;
    --side-padding: {{ settings.layout_side_padding | default: 40 }}px;

    /* Corners — one scale for the whole store (Theme settings → Corners & Shape).
         --r-xs  badges, checkboxes, swatch boxes, tags
         --r-sm  buttons, fields, selects, pills, toolbar controls, pagination
         --r-md  dropdown panels, menus, toasts, product images, bordered cards
         --r-lg  modals, drawers (inner edge), panels, large image tiles
       --r-btn and --r-page are the button and pagination shapes; --r-pill is
       for elements designed as pills, which square off only on "Sharp". */
    {%- liquid
      assign corner = settings.corner_radius | default: 'soft'
      case corner
        when 'sharp'
          assign r_xs = 0
          assign r_sm = 0
          assign r_md = 0
          assign r_lg = 0
        when 'subtle'
          assign r_xs = 2
          assign r_sm = 4
          assign r_md = 6
          assign r_lg = 8
        when 'rounded'
          assign r_xs = 6
          assign r_sm = 12
          assign r_md = 20
          assign r_lg = 24
        else
          assign r_xs = 4
          assign r_sm = 8
          assign r_md = 12
          assign r_lg = 16
      endcase
    -%}
    --r-xs: {{ r_xs }}px;
    --r-sm: {{ r_sm }}px;
    --r-md: {{ r_md }}px;
    --r-lg: {{ r_lg }}px;
    --r-pill: {% if corner == 'sharp' %}0px{% else %}999px{% endif %};
    --r-btn: {% if settings.button_shape == 'pill' %}999px{% else %}{{ r_sm }}px{% endif %};
    --r-page: {% if settings.pagination_shape == 'circle' %}50%{% else %}{{ r_sm }}px{% endif %};
    --r-page-wide: {% if settings.pagination_shape == 'circle' %}999px{% else %}{{ r_sm }}px{% endif %};

    /* Motion (Theme settings → Animations → Motion). Every open, close and
       entrance reads these, so one setting speeds up, softens or stops the
       whole store. JS reads --dur-* too, so scripted animations follow.
         --dur-1  hovers, checks, chevrons       --dur-3  drawers, modals, panels
         --dur-2  dropdowns, selects, accordions --dur-4  scroll reveals */
    {%- liquid
      assign motion = settings.motion_level | default: 'expressive'
      case motion
        when 'off'
          assign d1 = 0
          assign d2 = 0
          assign d3 = 0
          assign d4 = 0
          assign dist = 0
        when 'subtle'
          assign d1 = 120
          assign d2 = 200
          assign d3 = 300
          assign d4 = 520
          assign dist = 14
        else
          assign d1 = 160
          assign d2 = 280
          assign d3 = 440
          assign d4 = 820
          assign dist = 30
      endcase
    -%}
    --dur-1: {{ d1 }}ms;
    --dur-2: {{ d2 }}ms;
    --dur-3: {{ d3 }}ms;
    --dur-4: {{ d4 }}ms;
    --reveal-dist: {{ dist }}px;
    --ease-out: cubic-bezier(0.25, 0.46, 0.45, 0.94);
    --ease-in: cubic-bezier(0.55, 0.055, 0.675, 0.19);
    --ease-std: cubic-bezier(.2, .8, .2, 1);
    --ease-emph: cubic-bezier(.16, 1, .3, 1);
    --ease-io: cubic-bezier(.65, 0, .35, 1);
    --transition: var(--dur-2) var(--ease-out);

    /* Z-index layers — nav must be lower than drawers/modals */
    --z-base: 1;
    --z-raised: 10;
    --z-nav: 100;
    --z-overlay: 150;
    /* Above the page and the header, but deliberately below the cart drawer
       and quick view, so the demo panel can never cover a real interaction. */
    --z-explorer: 300;
    --z-drawer: 400;
    --z-modal: 500;
    --z-cursor: 9999;
  }
  /* Design system (assets/mn-core.css) inputs that come from settings */
  :root {
    --cu-base: {{ settings.color_black }};
    --cu-text: {{ settings.color_cream }};
    --cu-accent: {{ settings.color_gold }};
    --cu-sale: {{ settings.color_sale_bg }};
  }
  {%- if settings.color_scheme == 'custom' -%}
    {%- assign accent_light = settings.color_gold | color_brightness -%}
    {%- if accent_light >= 150 -%}[data-scheme=custom]{ --on-accent: #111111; }{%- endif -%}
  {%- endif -%}
  html[data-motion-level="subtle"] { --dur-fast: 120ms; --dur: 200ms; --dur-slow: 360ms; }
  {%- if settings.font_pairing == 'custom' -%}
    {%- liquid
      assign body_medium = settings.type_body_font | font_modify: 'weight', '500'
      assign body_semi = settings.type_body_font | font_modify: 'weight', '600'
      assign body_italic = settings.type_body_font | font_modify: 'style', 'italic'
      assign head_italic = settings.type_heading_font | font_modify: 'style', 'italic'
    -%}
    {{ settings.type_heading_font | font_face: font_display: 'swap' }}
    {{ head_italic | font_face: font_display: 'swap' }}
    {{ settings.type_body_font | font_face: font_display: 'swap' }}
    {{ body_medium | font_face: font_display: 'swap' }}
    {{ body_semi | font_face: font_display: 'swap' }}
    {{ body_italic | font_face: font_display: 'swap' }}
  {%- endif -%}
</style>
