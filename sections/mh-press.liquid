{%- comment -%}Maison homepage · Press and client quotes; the names act as tabs (design section "press"){%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign tid = 'mh-pr-' | append: section.id
-%}
{%- render 'mh-assets' -%}
<section class="mh mh-pr{% if s.palette != 'theme' %} mh--own{% endif %}" data-mh="press" data-surface aria-labelledby="{{ tid }}">
  <div class="mh-pr__in mh-wrap">
    <h2 class="mh-eyebrow mh-reveal" id="{{ tid }}">{{ s.heading }}</h2>
    <div class="mh-pr__quotes mh-reveal">
      {%- for block in section.blocks -%}
        <figure class="mh-pr__q{% if forloop.first %} is-active{% endif %}" data-name="{{ block.settings.name | escape }}" data-style="{{ block.settings.style }}" {{ block.shopify_attributes }}>
          <blockquote><p>“{{ block.settings.quote }}”</p></blockquote>
          {%- if block.settings.source != blank -%}<figcaption>{{ block.settings.source }}</figcaption>{%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
    <div class="mh-pr__names mh-reveal" role="tablist" aria-label="{{ 'mn.mh.choose_publication' | t }}"></div>
  </div>
</section>

{% schema %}
{
  "name": "Maison · Press",
  "class": "mh-section",
  "max_blocks": 7,
  "settings": [
    { "type": "select", "id": "palette", "label": "Colours", "options": [{ "value": "own", "label": "Maison palette" }, { "value": "theme", "label": "Theme colour scheme" }], "default": "own" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "In the press" }
  ],
  "blocks": [
    { "type": "quote", "name": "Quote", "settings": [
      { "type": "text", "id": "name", "label": "Publication", "default": "Le Quotidien" },
      { "type": "select", "id": "style", "label": "Name style", "info": "How the name is set in the row of publications, like a masthead.", "options": [
        { "value": "a", "label": "Serif capitals" }, { "value": "b", "label": "Bold sans" }, { "value": "c", "label": "Italic serif" }, { "value": "d", "label": "Spaced mono" }, { "value": "e", "label": "Light serif capitals" }
      ], "default": "a" },
      { "type": "textarea", "id": "quote", "label": "Quote", "default": "Clothes that seem to have been in your wardrobe for years, in the best possible way." },
      { "type": "text", "id": "source", "label": "Source line", "default": "Le Quotidien · September 2026" }
    ] }
  ],
  "presets": [{ "name": "Maison · Press", "blocks": [
    { "type": "quote", "settings": { "name": "Le Quotidien", "style": "a", "quote": "Clothes that seem to have been in your wardrobe for years, in the best possible way.", "source": "Le Quotidien · September 2026" } },
    { "type": "quote", "settings": { "name": "The Atelier Review", "style": "b", "quote": "The tailoring is quietly radical: soft shoulders, exacting lines, nothing added for effect.", "source": "The Atelier Review · Issue 41" } },
    { "type": "quote", "settings": { "name": "Maison & Mode", "style": "c", "quote": "A coat from this house is less a purchase than an inheritance in waiting.", "source": "Maison & Mode · Autumn 2026" } },
    { "type": "quote", "settings": { "name": "North Journal", "style": "d", "quote": "Few labels still finish silk by hand. Fewer do it this well.", "source": "North Journal · August 2026" } },
    { "type": "quote", "settings": { "name": "Client letters", "style": "e", "quote": "My coat came back from repair after eleven winters, better than new, with a handwritten note.", "source": "A client in Lyon" } }
  ] }]
}
{% endschema %}
