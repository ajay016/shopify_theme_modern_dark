{%- comment -%}
  A standard page, in the design's language. Standard: breadcrumb, display
  title and a reading column. Editorial: a centred title with an eyebrow and
  a wider column.
{%- endcomment -%}
{%- assign ss = section.settings -%}
<div class="mn-content mn-page mn-page--{{ ss.layout }}" id="section-{{ section.id }}">
  <div class="mn-container">
    {%- if ss.layout == 'v1' -%}
      <nav class="mn-breadcrumb" aria-label="{{ 'mn.pdp.breadcrumb' | t }}">
        <a href="{{ routes.root_url }}">{{ 'mn.pdp.home' | t }}</a><span class="sep">/</span>
        <span aria-current="page">{{ page.title }}</span>
      </nav>
    {%- endif -%}
    <div class="mn-page__inner{% if ss.narrow %} mn-page__inner--narrow{% endif %}">
      <header class="mn-content__head">
        {%- if ss.eyebrow != blank -%}<span class="mn-eyebrow">{{ ss.eyebrow }}</span>{%- endif -%}
        <h1 class="section-title">{{ page.title }}</h1>
      </header>
      <div class="mn-prose rte">{{ page.content }}</div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Page",
  "tag": "section",
  "class": "section-main-page",
  "settings": [
    {
      "type": "select", "id": "layout", "label": "Layout",
      "options": [
        { "value": "v1", "label": "Standard" },
        { "value": "v2", "label": "Editorial (centred)" }
      ],
      "default": "v1"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "checkbox", "id": "narrow", "label": "Narrow reading column", "default": false }
  ],
  "presets": [{ "name": "Page" }]
}
{% endschema %}
