{%- liquid
  assign s = section.settings
-%}

<section
  id="section-{{ section.id }}"
  class="rvt-section rvt--{{ s.scheme }}"
  data-section-id="{{ section.id }}"
>
  <div class="rvt-head reveal">
    {%- if s.eyebrow != blank -%}<span class="rvt-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
    {%- if s.heading != blank -%}<h2 class="rvt-heading">{{ s.heading }}</h2>{%- endif -%}
  </div>

  {%- capture cards -%}
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <article class="rvt-card" {{ block.shopify_attributes }}>
          <span class="rvt-card__stars" aria-hidden="true">
            {%- assign rating = block.settings.rating | default: 5 -%}
            {%- for i in (1..rating) -%}&#10022;{%- endfor -%}
          </span>
          <p class="rvt-card__quote">{{ block.settings.quote }}</p>
          <span class="rvt-card__who">{{ block.settings.author }}{% if block.settings.detail != blank %} — {{ block.settings.detail }}{% endif %}</span>
        </article>
      {%- endfor -%}
    {%- else -%}
      {%- assign demo_quotes = 'The silk gown arrived like something couture — the weight, the fall, the finish.|Tailoring that fits better than bespoke I have paid triple for.|Ordered on Monday, worn to a vernissage on Friday. Flawless.|The only maison whose emails I actually open.' | split: '|' -%}
      {%- assign demo_names = 'Camille R.|Sofia M.|Elena V.|Margaux D.' | split: '|' -%}
      {%- assign demo_cities = 'Paris|Milan|London|Brussels' | split: '|' -%}
      {%- for i in (0..3) -%}
        <article class="rvt-card">
          <span class="rvt-card__stars" aria-hidden="true">&#10022;&#10022;&#10022;&#10022;&#10022;</span>
          <p class="rvt-card__quote">{{ demo_quotes[i] }}</p>
          <span class="rvt-card__who">{{ demo_names[i] }} — {{ demo_cities[i] }}</span>
        </article>
      {%- endfor -%}
    {%- endif -%}
  {%- endcapture -%}

  <div class="rvt-band" aria-label="Customer reviews">
    <div class="rvt-track">
      {{ cards }}
      {{ cards }}
    </div>
  </div>
</section>

<style>
  #section-{{ section.id }}.rvt--light { --bg:var(--s2-bg, #131313); --card:var(--s3-bg, #1A1714); --fg:var(--s2-fg, #F5F0E8); --acc:var(--gold, #C8A96E); --mut:var(--s2-mut, rgba(245,240,232,.62)); --bdr:var(--s2-bdr, rgba(245,240,232,.16)); }
  #section-{{ section.id }}.rvt--dark  { --bg:var(--s1-bg, #0A0A0A); --card:var(--s2-bg, #131313); --fg:var(--s1-fg, #F5F0E8); --acc:var(--gold, #C8A96E); --mut:var(--s1-mut, rgba(245,240,232,.62)); --bdr:var(--s1-bdr, rgba(245,240,232,.16)); }
  #section-{{ section.id }}.rvt--warm  { --bg:var(--s3-bg, #1A1714); --card:var(--s2-bg, #131313); --fg:var(--s3-fg, #F5F0E8); --acc:var(--gold, #C8A96E); --mut:var(--s3-mut, rgba(245,240,232,.62)); --bdr:var(--s3-bdr, rgba(245,240,232,.16)); }
  #section-{{ section.id }}.rvt--theme { --bg:var(--s1-bg, #0A0A0A); --card:var(--s2-bg, #131313); --fg:var(--s1-fg, #F5F0E8); --acc:var(--gold, #C8A96E); --mut:var(--s1-mut, rgba(245,240,232,.62)); --bdr:var(--s1-bdr, rgba(245,240,232,.16)); }

  #section-{{ section.id }} { background: var(--bg); color: var(--fg); padding: var(--section-spacing,80px) 0; overflow: hidden; }

  #section-{{ section.id }} .rvt-head { text-align: center; padding: 0 var(--side-padding,5vw); margin-bottom: clamp(28px,3.6vw,46px); }
  #section-{{ section.id }} .rvt-eyebrow { display: block; font-family: var(--ff-body,'Outfit',sans-serif); font-size: calc(11px * var(--fs-scale, 1)); font-weight: 500; letter-spacing: .3em; text-transform: uppercase; color: var(--acc); margin-bottom: 13px; }
  #section-{{ section.id }} .rvt-heading { font-family: var(--ff-display,'Cormorant Garamond',serif); font-size: calc(clamp(28px,3.6vw,52px) * var(--heading-scale,1)); font-weight: 300; line-height: 1.05; text-transform: uppercase; margin: 0; }

  /* — Auto-scrolling band; pauses on hover — */
  #section-{{ section.id }} .rvt-band { overflow: hidden; padding: 6px 0 10px; }
  #section-{{ section.id }} .rvt-track {
    display: inline-flex; gap: clamp(14px,1.8vw,26px);
    padding-left: clamp(14px,1.8vw,26px);
    animation: rvtScroll{{ section.id }} 46s linear infinite;
    will-change: transform;
  }
  #section-{{ section.id }} .rvt-band:hover .rvt-track { animation-play-state: paused; }

  #section-{{ section.id }} .rvt-card {
    flex: 0 0 auto; width: clamp(280px, 30vw, 420px);
    background: var(--card); border: 1px solid var(--bdr);
    padding: clamp(22px,2.2vw,32px);
    transition: border-color .3s;
  }
  #section-{{ section.id }} .rvt-card:hover { border-color: color-mix(in srgb, var(--acc) 55%, transparent); }
  #section-{{ section.id }} .rvt-card__stars { display: block; color: var(--acc); font-size: calc(12px * var(--fs-scale, 1)); letter-spacing: .3em; margin-bottom: 14px; }
  #section-{{ section.id }} .rvt-card__quote {
    font-family: var(--ff-display,'Cormorant Garamond',serif);
    font-size: calc(clamp(17px,1.4vw,21px) * var(--fs-scale, 1)); font-weight: 400; font-style: italic;
    line-height: 1.45; margin: 0 0 16px;
  }
  #section-{{ section.id }} .rvt-card__who {
    font-family: var(--ff-body,'Outfit',sans-serif); font-size: calc(10px * var(--fs-scale, 1)); font-weight: 500;
    letter-spacing: .2em; text-transform: uppercase; color: var(--mut);
  }

  #section-{{ section.id }} .reveal.reveal-armed { opacity: 0; transform: translateY(24px); transition: opacity .7s ease, transform .7s ease; }
  #section-{{ section.id }} .reveal.is-visible { opacity: 1; transform: none; }

  @keyframes rvtScroll{{ section.id }} { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  @media (prefers-reduced-motion: reduce) {
    #section-{{ section.id }} .rvt-track { animation: none; overflow-x: auto; }
  }
  @media (max-width: 700px) {
    #section-{{ section.id }} .rvt-card { width: 76vw; }
  }
</style>

<script>
(function(){
  var SEC='{{ section.id }}';
  function arm(root){
    var els=root.querySelectorAll('.reveal');
    els.forEach(function(el){el.classList.add('reveal-armed');});
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('is-visible');io.unobserve(e.target);}});},{threshold:.2});
    els.forEach(function(el){io.observe(el);});
    setTimeout(function(){els.forEach(function(el){el.classList.add('is-visible');});},800);
  }
  function root(){return document.getElementById('section-'+SEC);}
  document.addEventListener('DOMContentLoaded',function(){var r=root();if(r)arm(r);});
  document.addEventListener('shopify:section:load',function(e){if(e.detail.sectionId!==SEC)return;var r=root();if(r){arm(r);r.querySelectorAll('.reveal').forEach(function(el){el.classList.add('is-visible');});}});
})();
</script>

{% schema %}
{
  "name": "Reviews Ticker",
  "tag": "section",
  "class": "section-reviews-ticker",
  "max_blocks": 8,
  "settings": [
    {
      "type": "select", "id": "scheme", "label": "Surface tone",
      "options": [
        { "value": "light", "label": "Alternate surface (soft)" },
        { "value": "dark",  "label": "Primary surface" },
        { "value": "warm",  "label": "Deep surface" },
        { "value": "theme", "label": "Primary surface (follow theme)" }
      ],
      "default": "light"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Le Carnet" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Words from the Clientele" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "The silk gown arrived like something couture — the weight, the fall, the finish." },
        { "type": "text", "id": "author", "label": "Author", "default": "Camille R." },
        { "type": "text", "id": "detail", "label": "Detail (city / role)", "default": "Paris" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews Ticker",
      "blocks": [
        { "type": "review", "settings": { "quote": "The silk gown arrived like something couture — the weight, the fall, the finish.", "author": "Camille R.", "detail": "Paris" } },
        { "type": "review", "settings": { "quote": "Tailoring that fits better than bespoke I have paid triple for.", "author": "Sofia M.", "detail": "Milan" } },
        { "type": "review", "settings": { "quote": "Ordered on Monday, worn to a vernissage on Friday. Flawless.", "author": "Elena V.", "detail": "London" } },
        { "type": "review", "settings": { "quote": "The only maison whose emails I actually open.", "author": "Margaux D.", "detail": "Brussels" } }
      ]
    }
  ]
}
{% endschema %}
