{%- liquid
  assign s = section.settings
  assign fallback = 'https://images.unsplash.com/photo-1509631179647-0177331693ae?auto=format&fit=crop&w=1600&q=85'
-%}

<section
  id="section-{{ section.id }}"
  class="cno-section cno--{{ s.scheme }}"
  data-section-id="{{ section.id }}"
  style="--cno-minh: {{ s.min_height }}vh;"
>
  <div class="cno-bg" aria-hidden="true">
    {%- if s.image != blank -%}
      {{ s.image | image_url: width: 1800 | image_tag: loading: 'lazy', class: 'cno-bg__img', sizes: '100vw', widths: '900,1300,1800', alt: '' }}
    {%- else -%}
      <img class="cno-bg__img" src="{{ fallback }}" alt="" loading="lazy" />
    {%- endif -%}
    <span class="cno-bg__scrim"></span>
  </div>

  <span class="cno-frame" aria-hidden="true"></span>

  <div class="cno-inner reveal">
    {%- if s.eyebrow != blank -%}<span class="cno-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
    <h2 class="cno-title">
      {%- if s.heading_line1 != blank -%}<span class="cno-title__fill">{{ s.heading_line1 }}</span>{%- endif -%}
      {%- if s.heading_line2 != blank -%}<span class="cno-title__ghost"><em>{{ s.heading_line2 }}</em></span>{%- endif -%}
    </h2>
    {%- if s.description != blank -%}<p class="cno-desc">{{ s.description }}</p>{%- endif -%}
    {%- if s.btn_label != blank -%}
      <a href="{{ s.btn_link | default: '/collections/all' }}" class="cno-btn">{{ s.btn_label }}</a>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="cno-stats">
        {%- for block in section.blocks -%}
          <div class="cno-stat" {{ block.shopify_attributes }}>
            <span class="cno-stat__value">{{ block.settings.value }}</span>
            <span class="cno-stat__label">{{ block.settings.label }}</span>
          </div>
          {%- unless forloop.last -%}<span class="cno-stat__rule" aria-hidden="true"></span>{%- endunless -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  /* scheme only drives the accent + button; the canvas is the image itself */
  #section-{{ section.id }}.cno--light,
  #section-{{ section.id }}.cno--dark,
  #section-{{ section.id }}.cno--warm { --acc:var(--gold, #C8A96E); }
  #section-{{ section.id }}.cno--theme { --acc:var(--gold, #C8A96E); }

  #section-{{ section.id }} {
    position: relative; overflow: hidden; isolation: isolate;
    min-height: var(--cno-minh, 74vh);
    display: flex; align-items: center; justify-content: center;
    padding: clamp(72px,10vh,120px) var(--side-padding,5vw);
  }
  #section-{{ section.id }} .cno-bg { position: absolute; inset: 0; z-index: 0; }
  #section-{{ section.id }} .cno-bg__img { width: 100%; height: 100%; object-fit: cover; display: block; filter: saturate(.82) contrast(1.04); }
  #section-{{ section.id }} .cno-bg__scrim { position: absolute; inset: 0; background: radial-gradient(78% 90% at 50% 55%, rgba(10,10,11,.38) 0%, rgba(10,10,11,.74) 100%); }

  #section-{{ section.id }} .cno-frame {
    position: absolute; z-index: 2; inset: clamp(14px,2vw,28px);
    border: 1px solid color-mix(in srgb, var(--acc) 65%, transparent);
    pointer-events: none;
  }

  #section-{{ section.id }} .cno-inner { position: relative; z-index: 3; text-align: center; max-width: 900px; }
  #section-{{ section.id }} .cno-eyebrow {
    display: block; font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: calc(11px * var(--fs-scale, 1)); font-weight: 500; letter-spacing: .3em; text-transform: uppercase;
    color: var(--acc); margin-bottom: clamp(18px,3vh,28px);
  }
  #section-{{ section.id }} .cno-title {
    font-family: var(--ff-display,'Cormorant Garamond',serif); font-weight: 300;
    font-size: calc(clamp(44px,7.4vw,110px) * var(--heading-scale,1));
    line-height: .96; text-transform: uppercase; letter-spacing: .01em;
    color: var(--on-image, #FFFFFF); margin: 0;
  }
  #section-{{ section.id }} .cno-title__fill { display: block; }
  #section-{{ section.id }} .cno-title__ghost {
    display: block; color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--acc) 85%, #fff 15%);
  }
  #section-{{ section.id }} .cno-title__ghost em { font-style: italic; }
  #section-{{ section.id }} .cno-desc {
    font-family: var(--ff-body,'Outfit',sans-serif); font-size: calc(clamp(14px,1.05vw,16px) * var(--fs-scale, 1));
    line-height: 1.75; color: var(--on-image-mut, rgba(255,255,255,.78)); max-width: 520px;
    margin: clamp(20px,3vh,30px) auto 0;
  }
  #section-{{ section.id }} .cno-btn {
    display: inline-block; margin-top: clamp(26px,4vh,38px);
    font-family: var(--ff-body,'Outfit',sans-serif); font-size: calc(11px * var(--fs-scale, 1)); font-weight: 500;
    letter-spacing: .18em; text-transform: uppercase; text-decoration: none;
    color: var(--on-gold, #0A0A0A); background: var(--acc); padding: 17px 42px;
    transition: transform .22s, box-shadow .22s;
  }
  #section-{{ section.id }} .cno-btn:hover { transform: translateY(-2px); box-shadow: 0 18px 40px -16px rgba(0,0,0,.6); }

  #section-{{ section.id }} .cno-stats {
    display: flex; align-items: center; justify-content: center; gap: clamp(20px,3vw,44px);
    margin-top: clamp(36px,6vh,56px); flex-wrap: wrap;
  }
  #section-{{ section.id }} .cno-stat { text-align: center; }
  #section-{{ section.id }} .cno-stat__value {
    display: block; font-family: var(--ff-display,'Cormorant Garamond',serif);
    font-size: calc(clamp(26px,2.6vw,40px) * var(--fs-scale, 1)); font-weight: 300; line-height: 1; color: var(--on-image, #FFFFFF);
  }
  #section-{{ section.id }} .cno-stat__label {
    display: block; margin-top: 8px; font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: calc(10px * var(--fs-scale, 1)); font-weight: 500; letter-spacing: .22em; text-transform: uppercase;
    color: var(--on-image-mut, rgba(255,255,255,.78));
  }
  #section-{{ section.id }} .cno-stat__rule { width: 1px; height: 34px; background: color-mix(in srgb, var(--acc) 50%, transparent); }

  #section-{{ section.id }} .reveal.reveal-armed { opacity: 0; transform: translateY(28px); transition: opacity .8s ease, transform .8s ease; }
  #section-{{ section.id }} .reveal.is-visible { opacity: 1; transform: none; }

  @media (max-width: 700px) {
    #section-{{ section.id }} .cno-stat__rule { display: none; }
    #section-{{ section.id }} .cno-stats { gap: 22px; }
  }
</style>

<script>
(function(){
  var SEC='{{ section.id }}';
  function arm(root){
    var els=root.querySelectorAll('.reveal');
    els.forEach(function(el){el.classList.add('reveal-armed');});
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('is-visible');io.unobserve(e.target);}});},{threshold:.2});
    els.forEach(function(el){io.observe(el);});
    setTimeout(function(){els.forEach(function(el){el.classList.add('is-visible');});},800);
  }
  function root(){return document.getElementById('section-'+SEC);}
  document.addEventListener('DOMContentLoaded',function(){var r=root();if(r)arm(r);});
  document.addEventListener('shopify:section:load',function(e){if(e.detail.sectionId!==SEC)return;var r=root();if(r){arm(r);r.querySelectorAll('.reveal').forEach(function(el){el.classList.add('is-visible');});}});
})();
</script>

{% schema %}
{
  "name": "Campaign Noir",
  "tag": "section",
  "class": "section-campaign-noir",
  "max_blocks": 4,
  "settings": [
    {
      "type": "select", "id": "scheme", "label": "Surface tone",
      "options": [
        { "value": "light", "label": "Alternate surface (soft)" },
        { "value": "dark",  "label": "Primary surface" },
        { "value": "warm",  "label": "Deep surface" },
        { "value": "theme", "label": "Primary surface (follow theme)" }
      ],
      "default": "dark"
    },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "range", "id": "min_height", "label": "Minimum height", "min": 50, "max": 95, "step": 5, "unit": "vh", "default": 75 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Capsule" },
    { "type": "text", "id": "heading_line1", "label": "Headline line 1 (filled)", "default": "Twelve Pieces" },
    { "type": "text", "id": "heading_line2", "label": "Headline line 2 (outlined, italic)", "default": "One Statement" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "A limited atelier capsule — made to order, numbered by hand, and gone by the end of the season." },
    { "type": "text", "id": "btn_label", "label": "Button label", "default": "Shop the Capsule" },
    { "type": "url",  "id": "btn_link",  "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "12" },
        { "type": "text", "id": "label", "label": "Label", "default": "Pieces" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Campaign Noir",
      "blocks": [
        { "type": "stat", "settings": { "value": "12", "label": "Pieces" } },
        { "type": "stat", "settings": { "value": "01", "label": "Atelier" } },
        { "type": "stat", "settings": { "value": "AW25", "label": "Season" } }
      ]
    }
  ]
}
{% endschema %}
