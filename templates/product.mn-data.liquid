{%- layout none -%}
{%- comment -%}
  Product facts as JSON for the compare table and the wishlist, fetched as
  /products/{handle}?view=mn-data. Prices are formatted by Shopify. Material,
  origin and care read the custom.material, custom.origin and custom.care
  metafields; rating reads the standard reviews metafields.
{%- endcomment -%}
{%- liquid
  assign v = product.selected_or_first_available_variant
  assign rating = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value | default: 0
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0
  assign stock_total = 0
  assign tracked = false
  for x in product.variants
    if x.inventory_management != blank
      assign tracked = true
      if x.inventory_quantity > 0
        assign stock_total = stock_total | plus: x.inventory_quantity
      endif
    endif
  endfor
  assign off = 0
  if product.compare_at_price > product.price
    assign off = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
  endif
-%}
{
  "id": {{ product.id }},
  "handle": {{ product.handle | json }},
  "title": {{ product.title | json }},
  "vendor": {{ product.vendor | json }},
  "url": {{ product.url | json }},
  "image": {{ product.featured_image | image_url: width: 600 | json }},
  "available": {{ product.available | json }},
  "single": {{ product.has_only_default_variant | json }},
  "variant_id": {{ v.id | json }},
  "price": {{ product.price | money | strip_html | json }},
  "price_varies": {{ product.price_varies | json }},
  "compare": {% if off > 0 %}{{ product.compare_at_price | money | strip_html | json }}{% else %}null{% endif %},
  "off": {{ off }},
  "rating": {{ rating | json }},
  "rating_count": {{ rating_count | json }},
  "material": {{ product.metafields.custom.material.value | default: '' | json }},
  "origin": {{ product.metafields.custom.origin.value | default: '' | json }},
  "care": {{ product.metafields.custom.care.value | default: '' | json }},
  "low": {% if tracked and stock_total > 0 and stock_total <= settings.product_card_low_stock_threshold %}{{ stock_total }}{% else %}0{% endif %},
  "options": [
    {%- for opt in product.options_with_values -%}
      {%- assign key = opt.name | downcase | strip -%}
      {
        "name": {{ opt.name | json }},
        "kind": {% if key == 'color' or key == 'colour' %}"colour"{% elsif key contains 'size' %}"size"{% else %}"other"{% endif %},
        "values": [
          {%- for val in opt.values -%}
            {%- liquid
              assign in_stock = false
              for x in product.variants
                if x.options contains val and x.available
                  assign in_stock = true
                  break
                endif
              endfor
            -%}
            {"label": {{ val | json }}, "style": {% capture st %}{% render 'swatch-style', label: val, swatch: val.swatch %}{% endcapture %}{{ st | strip | json }}, "in_stock": {{ in_stock | json }}}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
