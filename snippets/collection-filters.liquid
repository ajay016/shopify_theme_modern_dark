{%- comment -%}
  ============================================================
  BUILT-IN COLLECTION FILTERS

  Shopify only populates `collection.filters` when the Search &
  Discovery app is installed and configured. Without it a theme
  has no filters to render — which is why this page had none.

  This snippet builds a filter set out of the catalogue itself,
  so filtering works on any store with no app at all:

    Availability · On sale · Price · Size / Colour / any other
    variant option · Vendor · Product type · Tags

  It filters the products on the page, in the browser. That is
  the honest limit: it narrows the current page rather than
  re-querying the whole collection, so it is paired with a
  larger products-per-page value. Where the app IS installed,
  `main-collection` renders Shopify's native filters instead and
  this never appears.

  Accepts:
    - products {Array}  the products to derive facets from
    - style    {String} 'sidebar' | 'drawer' | 'dropdown' | 'toggle'
  ============================================================
{%- endcomment -%}

{%- liquid
  assign style = style | default: 'sidebar'

  assign vendors = ''
  assign types = ''
  assign opt_names = ''
  assign tags_all = ''
  assign price_min = 999999999
  assign price_max = 0
  assign any_sale = false
  assign any_out = false
  assign any_new = false
  assign any_rated = false
  assign now_s = 'now' | date: '%s' | plus: 0

  for p in products
    if p.price < price_min
      assign price_min = p.price
    endif
    if p.price > price_max
      assign price_max = p.price
    endif
    if p.compare_at_price > p.price
      assign any_sale = true
    endif
    unless p.available
      assign any_out = true
    endunless
    assign pub_s = p.published_at | date: '%s' | plus: 0
    assign age_d = now_s | minus: pub_s | divided_by: 86400
    if age_d <= 60
      assign any_new = true
    endif
    if p.metafields.reviews.rating.value != blank
      assign any_rated = true
    endif
    if p.vendor != blank
      assign vendors = vendors | append: p.vendor | append: '~'
    endif
    if p.type != blank
      assign types = types | append: p.type | append: '~'
    endif
    for opt in p.options_with_values
      assign opt_names = opt_names | append: opt.name | append: '~'
    endfor
  endfor

  assign vendor_list = vendors | split: '~' | uniq | sort
  assign type_list = types | split: '~' | uniq | sort
  assign opt_name_list = opt_names | split: '~' | uniq
  assign tag_list = collection.all_tags | default: tags_all
  if price_min > price_max
    assign price_min = 0
  endif
-%}

<div class="cfilter" data-cfilter data-cfilter-style="{{ style }}">

  <div class="cfilter-group" data-cfilter-group>
    <button class="filter-group__toggle" type="button" aria-expanded="true">
      Availability {%- render 'icon-chevron-down' -%}
    </button>
    <div class="filter-group__body">
      <ul class="filter-list">
        <li><label class="filter-check">
          <input type="checkbox" data-facet="available" value="true">
          <span>In stock</span>
        </label></li>
        {%- if any_out -%}
          <li><label class="filter-check">
            <input type="checkbox" data-facet="available" value="false">
            <span>Out of stock</span>
          </label></li>
        {%- endif -%}
        {%- if any_sale -%}
          <li><label class="filter-check">
            <input type="checkbox" data-facet="onsale" value="true">
            <span>On sale</span>
          </label></li>
        {%- endif -%}
      </ul>
    </div>
  </div>

  {%- if price_max > 0 -%}
    <div class="cfilter-group" data-cfilter-group>
      <button class="filter-group__toggle" type="button" aria-expanded="true">
        Price {%- render 'icon-chevron-down' -%}
      </button>
      <div class="filter-group__body">
        <div class="cfilter-pills cfilter-pills--price">
          {%- assign ceil_major = price_max | divided_by: 100 -%}
          <label class="cfilter-pill"><input type="checkbox" data-facet="price-preset" value="0-100"><span>Under 100</span></label>
          {%- if ceil_major > 100 -%}<label class="cfilter-pill"><input type="checkbox" data-facet="price-preset" value="100-250"><span>100–250</span></label>{%- endif -%}
          {%- if ceil_major > 250 -%}<label class="cfilter-pill"><input type="checkbox" data-facet="price-preset" value="250-500"><span>250–500</span></label>{%- endif -%}
          {%- if ceil_major > 500 -%}<label class="cfilter-pill"><input type="checkbox" data-facet="price-preset" value="500-999999"><span>500+</span></label>{%- endif -%}
        </div>

        <div class="cfilter-price" data-cfilter-price
             data-floor="{{ price_min | divided_by: 100 | floor }}"
             data-ceil="{{ price_max | divided_by: 100 | ceil }}">
          <div class="cfilter-price__track">
            <span class="cfilter-price__fill" data-price-fill></span>
            <input class="cfilter-price__range" type="range" data-price-range="min"
                   min="{{ price_min | divided_by: 100 | floor }}" max="{{ price_max | divided_by: 100 | ceil }}"
                   value="{{ price_min | divided_by: 100 | floor }}" aria-label="Minimum price">
            <input class="cfilter-price__range" type="range" data-price-range="max"
                   min="{{ price_min | divided_by: 100 | floor }}" max="{{ price_max | divided_by: 100 | ceil }}"
                   value="{{ price_max | divided_by: 100 | ceil }}" aria-label="Maximum price">
          </div>
          <div class="cfilter-price__vals">
            <input type="number" data-facet="price-min" aria-label="Minimum price"
                   placeholder="{{ price_min | divided_by: 100 | floor }}">
            <span>–</span>
            <input type="number" data-facet="price-max" aria-label="Maximum price"
                   placeholder="{{ price_max | divided_by: 100 | ceil }}">
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%}
    One group per variant option, rendered by what the option IS rather than as
    a uniform checkbox list: colours become swatches, sizes become pills,
    anything else stays a labelled list. A fashion filter that renders "Black"
    as a tickbox rather than a black circle is doing the shopper no favours.
  {%- endcomment -%}
  {%- for opt_name in opt_name_list -%}
    {%- if opt_name != blank and opt_name != 'Title' -%}
      {%- liquid
        assign vals = ''
        for p in products
          for opt in p.options_with_values
            if opt.name == opt_name
              for v in opt.values
                assign vals = vals | append: v | append: '~'
              endfor
            endif
          endfor
        endfor
        assign val_list = vals | split: '~' | uniq | sort

        assign key = opt_name | downcase | strip
        assign render_as = 'list'
        if key == 'color' or key == 'colour'
          assign render_as = 'swatch'
        endif
        if key == 'size'
          assign render_as = 'pill'
        endif
      -%}
      {%- if val_list.size > 0 -%}
        <div class="cfilter-group" data-cfilter-group>
          <button class="filter-group__toggle" type="button" aria-expanded="true">
            {{ opt_name }} {%- render 'icon-chevron-down' -%}
          </button>
          <div class="filter-group__body">

            {%- case render_as -%}
              {%- when 'swatch' -%}
                <div class="cfilter-swatches">
                  {%- for v in val_list -%}
                    {%- assign css_col = v | downcase | strip | replace: ' ', '' -%}
                    <label class="cfilter-swatch" title="{{ v | escape }}">
                      <input type="checkbox" data-facet="options" value="{{ v | escape }}">
                      <span class="cfilter-swatch__dot" style="--sw: {{ css_col }};" aria-hidden="true"></span>
                      <span class="visually-hidden">{{ v }}</span>
                    </label>
                  {%- endfor -%}
                </div>

              {%- when 'pill' -%}
                <div class="cfilter-pills">
                  {%- for v in val_list -%}
                    <label class="cfilter-pill">
                      <input type="checkbox" data-facet="options" value="{{ v | escape }}">
                      <span>{{ v }}</span>
                    </label>
                  {%- endfor -%}
                </div>

              {%- else -%}
                <ul class="filter-list">
                  {%- for v in val_list -%}
                    <li><label class="filter-check">
                      <input type="checkbox" data-facet="options" value="{{ v | escape }}">
                      <span>{{ v }}</span>
                    </label></li>
                  {%- endfor -%}
                </ul>
            {%- endcase -%}

          </div>
        </div>
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}

  {%- comment -%}
    Size availability. The option groups above match a product that OFFERS a
    size; this matches one where that size is actually buyable. Kept separate
    rather than replacing the other, because a shopper browsing wants to see
    everything and a shopper buying wants only what they can have.
  {%- endcomment -%}
  <div class="cfilter-group" data-cfilter-group>
    <button class="filter-group__toggle" type="button" aria-expanded="true">
      Stock {%- render 'icon-chevron-down' -%}
    </button>
    <div class="filter-group__body">
      <ul class="filter-list">
        <li><label class="filter-check">
          <input type="checkbox" data-facet="instock-only" value="true">
          <span>Only show sizes in stock</span>
        </label></li>
      </ul>
    </div>
  </div>

  {%- if any_sale -%}
    <div class="cfilter-group" data-cfilter-group>
      <button class="filter-group__toggle" type="button" aria-expanded="true">
        Discount {%- render 'icon-chevron-down' -%}
      </button>
      <div class="filter-group__body">
        <div class="cfilter-pills">
          <label class="cfilter-pill"><input type="checkbox" data-facet="discount" value="20"><span>20%+</span></label>
          <label class="cfilter-pill"><input type="checkbox" data-facet="discount" value="30"><span>30%+</span></label>
          <label class="cfilter-pill"><input type="checkbox" data-facet="discount" value="50"><span>50%+</span></label>
          <label class="cfilter-pill"><input type="checkbox" data-facet="discount" value="70"><span>70%+</span></label>
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- if any_new -%}
    <div class="cfilter-group" data-cfilter-group>
      <button class="filter-group__toggle" type="button" aria-expanded="true">
        New in {%- render 'icon-chevron-down' -%}
      </button>
      <div class="filter-group__body">
        <div class="cfilter-pills">
          <label class="cfilter-pill"><input type="checkbox" data-facet="age" value="14"><span>14 days</span></label>
          <label class="cfilter-pill"><input type="checkbox" data-facet="age" value="30"><span>30 days</span></label>
          <label class="cfilter-pill"><input type="checkbox" data-facet="age" value="60"><span>60 days</span></label>
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- if any_rated -%}
    <div class="cfilter-group" data-cfilter-group>
      <button class="filter-group__toggle" type="button" aria-expanded="true">
        Rating {%- render 'icon-chevron-down' -%}
      </button>
      <div class="filter-group__body">
        <div class="cfilter-pills">
          <label class="cfilter-pill"><input type="checkbox" data-facet="rating" value="4"><span>4★ &amp; up</span></label>
          <label class="cfilter-pill"><input type="checkbox" data-facet="rating" value="3"><span>3★ &amp; up</span></label>
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- if vendor_list.size > 1 -%}
    <div class="cfilter-group" data-cfilter-group>
      <button class="filter-group__toggle" type="button" aria-expanded="true">
        Brand {%- render 'icon-chevron-down' -%}
      </button>
      <div class="filter-group__body">
        <ul class="filter-list">
          {%- for v in vendor_list -%}
            {%- if v != blank -%}
              <li><label class="filter-check">
                <input type="checkbox" data-facet="vendor" value="{{ v | escape }}">
                <span>{{ v }}</span>
              </label></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>
  {%- endif -%}

  {%- if type_list.size > 1 -%}
    <div class="cfilter-group" data-cfilter-group>
      <button class="filter-group__toggle" type="button" aria-expanded="true">
        Product type {%- render 'icon-chevron-down' -%}
      </button>
      <div class="filter-group__body">
        <ul class="filter-list">
          {%- for v in type_list -%}
            {%- if v != blank -%}
              <li><label class="filter-check">
                <input type="checkbox" data-facet="type" value="{{ v | escape }}">
                <span>{{ v }}</span>
              </label></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>
  {%- endif -%}

  {%- if tag_list.size > 0 -%}
    <div class="cfilter-group" data-cfilter-group>
      <button class="filter-group__toggle" type="button" aria-expanded="false">
        Tags {%- render 'icon-chevron-down' -%}
      </button>
      <div class="filter-group__body is-collapsed">
        <ul class="filter-list">
          {%- for t in tag_list limit: 30 -%}
            <li><label class="filter-check">
              <input type="checkbox" data-facet="tags" value="{{ t | escape }}">
              <span>{{ t }}</span>
            </label></li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  {%- endif -%}

  <div class="cfilter-foot">
    <span class="cfilter-count" data-cfilter-count></span>
    <button type="button" class="cfilter-clear" data-cfilter-clear hidden>Clear all</button>
  </div>
</div>
