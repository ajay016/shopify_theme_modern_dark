{%- comment -%}
  Footer, built to the Claude Design reference (styles: assets/mn-footer.css).
  html[data-footer] (Theme settings → Footer → Footer style) picks the
  layout: columns · statement · minimal. Footer surface sets data-surface
  on the footer: base · soft · deep · invert.
  All parts are rendered; the style's CSS shows the ones it uses.
{%- endcomment -%}
{%- liquid
  assign tone = settings.footer_tone | default: 'deep'
  if tone == 'contrast'
    assign tone = 'invert'
  endif
  assign wordmark = settings.footer_wordmark | default: settings.logo_text | default: shop.name
  assign done_msg = settings.footer_newsletter_done
-%}

<footer class="site-footer" id="siteFooter" data-surface="{{ tone }}">
  {%- if settings.footer_newsletter -%}
    <div class="footer__band">
      <div class="mn-container footer__band-inner">
        <h2 class="footer__band-title">{{ settings.footer_band_title }}</h2>
        {%- form 'customer', id: 'FooterBandNewsletter', class: 'mn-newsletter mn-newsletter--band' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="mn-newsletter__label" for="FooterBandEmail">{{ settings.footer_newsletter_text }}</label>
          {%- if form.posted_successfully? -%}
            <p class="mn-newsletter__done" style="display:flex"><svg class="icon icon--sm" aria-hidden="true"><use href="#i-check"></use></svg>{{ done_msg }}</p>
          {%- else -%}
            <div class="mn-newsletter__field"><input id="FooterBandEmail" type="email" name="contact[email]" placeholder="{{ 'newsletter.label' | t }}" required autocomplete="email"><button type="submit">{{ 'newsletter.button' | t }}<svg class="icon icon--sm" aria-hidden="true"><use href="#i-arrow-right"></use></svg></button></div>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  {%- endif -%}

  <div class="mn-container footer__main">
    <div class="footer__brand">
      <a href="{{ routes.root_url }}" class="footer__logo">
        {%- if settings.footer_logo != blank -%}
          {{ settings.footer_logo | image_url: width: 320 | image_tag: loading: 'lazy', alt: shop.name, width: 160, class: 'header__logo-img' }}
        {%- else -%}
          {{ settings.logo_text | default: shop.name }}
        {%- endif -%}
      </a>
      {%- if settings.footer_description != blank -%}
        <p class="footer__desc">{{ settings.footer_description | strip_html }}</p>
      {%- endif -%}
      {%- assign row = linklists[settings.footer_menu_1] -%}
      {%- if row.links.size > 0 -%}
        <nav class="footer__linkrow" aria-label="{{ settings.footer_menu_1_title | default: row.title | escape }}">
          {%- for l in row.links -%}<a href="{{ l.url }}">{{ l.title }}</a>{%- endfor -%}
        </nav>
      {%- endif -%}
      {%- if settings.footer_newsletter -%}
        {%- form 'customer', id: 'FooterNewsletter', class: 'mn-newsletter' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="mn-newsletter__label" for="FooterEmail">{{ settings.footer_newsletter_heading }}</label>
          {%- if form.posted_successfully? -%}
            <p class="mn-newsletter__done" style="display:flex"><svg class="icon icon--sm" aria-hidden="true"><use href="#i-check"></use></svg>{{ done_msg }}</p>
          {%- else -%}
            <div class="mn-newsletter__field"><input id="FooterEmail" type="email" name="contact[email]" placeholder="{{ 'newsletter.label' | t }}" required autocomplete="email"><button type="submit">{{ 'newsletter.button' | t }}<svg class="icon icon--sm" aria-hidden="true"><use href="#i-arrow-right"></use></svg></button></div>
            {%- if settings.footer_newsletter_note != blank -%}<p class="mn-newsletter__note">{{ settings.footer_newsletter_note }}</p>{%- endif -%}
            {%- if form.errors -%}<p class="mn-newsletter__note" role="alert">{{ 'newsletter.error' | t }}</p>{%- endif -%}
          {%- endif -%}
        {%- endform -%}
      {%- endif -%}
      {%- render 'mn-social' -%}
    </div>

    <div class="footer__cols">
      {%- for i in (1..4) -%}
        {%- liquid
          assign hk = 'footer_menu_' | append: i
          assign tk = 'footer_menu_' | append: i | append: '_title'
          assign m = linklists[settings[hk]]
        -%}
        {%- if m.links.size > 0 -%}
          <div class="acc footer__col">
            <button type="button" class="acc__trigger" aria-expanded="false">{{ settings[tk] | default: m.title }}<span class="acc__icon"></span></button>
            <div class="acc__panel"><div class="acc__inner"><div class="acc__content">
              <ul>{%- for l in m.links -%}<li><a href="{{ l.url }}">{{ l.title }}</a></li>{%- endfor -%}</ul>
            </div></div></div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="footer__wordmark" aria-hidden="true"><span>{{ wordmark }}</span></div>

  <div class="mn-container footer__bottom">
    <span>{%- if settings.footer_copyright != blank -%}{{ settings.footer_copyright }}{%- else -%}&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}{%- endif -%}</span>
    {%- if settings.footer_show_localization -%}
      {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
        {%- form 'localization', id: 'FooterLocalization', class: 'footer__selects' -%}
          {%- render 'mn-localization', id_prefix: 'Footer' -%}
        {%- endform -%}
      {%- endif -%}
    {%- endif -%}
    {%- if settings.footer_show_payment_icons and shop.enabled_payment_types.size > 0 -%}
      <div class="footer__pay payments">
        {%- for type in shop.enabled_payment_types -%}
          {%- liquid
            case type
              when 'visa'
                assign pl = 'Visa'
              when 'master'
                assign pl = 'Mastercard'
              when 'american_express'
                assign pl = 'Amex'
              when 'paypal'
                assign pl = 'PayPal'
              when 'apple_pay'
                assign pl = 'Apple Pay'
              when 'google_pay'
                assign pl = 'Google Pay'
              when 'shopify_pay'
                assign pl = 'Shop Pay'
              when 'diners_club'
                assign pl = 'Diners Club'
              when 'unionpay'
                assign pl = 'UnionPay'
              when 'jcb'
                assign pl = 'JCB'
              else
                assign pl = type | replace: '_', ' ' | capitalize
            endcase
          -%}
          <span class="pay">{{ pl }}</span>
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if settings.footer_back_to_top -%}
      <button type="button" class="to-top" id="toTop"><span>{{ 'footer.back_to_top' | t }}</span><span><svg class="icon" aria-hidden="true"><use href="#i-arrow-up"></use></svg></span></button>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "footer-section",
  "limit": 1,
  "settings": [
    {
      "type": "paragraph",
      "content": "Footer style, surface, newsletter, menus, social links, selectors and payment icons are in Theme Settings → Footer."
    }
  ],
  "presets": [{ "name": "Footer" }]
}
{% endschema %}
