{%- comment -%}
  Maison homepage · New arrivals (design section "new-arrivals").
  Tabs are blocks, each with a collection. A tab without one shows the
  store's own products; demo pieces appear only in a store with none.
  Cards are the store's product card (snippets/product-card.liquid).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign tid = 'mh-na-' | append: section.id
  assign first_url = routes.all_products_collection_url
  assign b0 = section.blocks.first
  if b0.settings.collection != blank
    assign first_url = b0.settings.collection.url
  endif
-%}
{%- render 'mh-assets' -%}
<section class="mh mh-na{% if s.palette != 'theme' %} mh--own{% endif %}" data-mh="new-arrivals" data-surface aria-labelledby="{{ tid }}">
  <div class="mh-wrap">
    <div class="mh-na__head">
      <div class="mh-reveal">
        {%- if s.eyebrow != blank -%}<span class="mh-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
        <h2 class="mh-h2" id="{{ tid }}">{{ s.heading }}</h2>
      </div>
      <div class="mh-na__ctrl mh-reveal">
        {%- if section.blocks.size > 1 -%}
          <div class="mh-na__tabs" role="tablist" aria-label="{{ s.tabs_label | escape }}">
            {%- for block in section.blocks -%}
              <button class="mh-na__tab" type="button" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-controls="{{ tid }}-panel" data-tab="{{ forloop.index0 }}" data-url="{{ block.settings.collection.url | default: routes.all_products_collection_url }}"{% unless forloop.first %} tabindex="-1"{% endunless %} {{ block.shopify_attributes }}>{{ block.settings.label }}</button>
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if s.link_label != blank -%}<a class="mh-lnk" href="{{ s.link | default: first_url }}"{% if s.link == blank %} data-na-link{% endif %}>{{ s.link_label }} {% render 'mh-icon', name: 'arrow' %}</a>{%- endif -%}
      </div>
    </div>
    <div class="mh-na__grid" id="{{ tid }}-panel" role="tabpanel" aria-label="{{ s.heading | strip_html | escape }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign k = forloop.index0
          assign col = block.settings.collection
          assign skip = 0
          assign n_col = col.products.size | default: 0
          if n_col == 0
            assign col = collections.all
            # an unlinked tab after the first shows a different slice when there are enough
            assign skip = k | times: s.count
            assign need = skip | plus: s.count
            assign have = col.products_count | default: 0
            if have < need
              assign skip = 0
            endif
          endif
          assign n_all = col.products.size | default: 0
        -%}
        {%- if n_all > 0 -%}
          {%- for product in col.products limit: s.count offset: skip -%}
            <div class="mh-na__item mh-reveal" data-tab="{{ k }}"{% unless k == 0 %} hidden{% endunless %}>{%- render 'product-card', product: product -%}</div>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..s.count) -%}
            {%- assign di = k | times: 3 | plus: forloop.index0 -%}
            <div class="mh-na__item mh-reveal" data-tab="{{ k }}"{% unless k == 0 %} hidden{% endunless %}>{%- render 'product-card', demo_index: di -%}</div>
          {%- endfor -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Maison · New arrivals",
  "class": "mh-section",
  "max_blocks": 5,
  "settings": [
    { "type": "select", "id": "palette", "label": "Colours", "options": [{ "value": "own", "label": "Maison palette" }, { "value": "theme", "label": "Theme colour scheme" }], "default": "own" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New arrivals" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Just in, <em>this week</em>" },
    { "type": "range", "id": "count", "label": "Products per tab", "min": 4, "max": 12, "step": 2, "default": 8 },
    { "type": "text", "id": "tabs_label", "label": "Tabs name for screen readers", "default": "Filter new arrivals" },
    { "type": "text", "id": "link_label", "label": "Link", "default": "View all" },
    { "type": "url", "id": "link", "label": "Link to", "info": "Leave blank to follow the chosen tab's collection." }
  ],
  "blocks": [
    { "type": "tab", "name": "Tab", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "All" },
      { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to show your newest products." }
    ] }
  ],
  "presets": [{ "name": "Maison · New arrivals", "blocks": [
    { "type": "tab", "settings": { "label": "All" } },
    { "type": "tab", "settings": { "label": "Ready-to-wear" } },
    { "type": "tab", "settings": { "label": "Accessories" } }
  ] }]
}
{% endschema %}
