{%- comment -%}
  Journal (blog) page, in the Claude Design reference's language: eyebrow +
  display title, tag chips, editorial article cards in a grid, list or
  masonry, an optional featured first post and an optional sidebar.
{%- endcomment -%}
{%- liquid
  assign ss = section.settings
  assign layout = ss.layout
  assign show_sidebar = ss.show_sidebar
-%}
{%- paginate blog.articles by ss.posts_per_page -%}
<div class="mn-content mn-blog mn-blog--{{ layout }}" id="section-{{ section.id }}">
  <div class="mn-container">
    <div class="mn-content__head">
      <span class="mn-eyebrow">{{ ss.eyebrow }}</span>
      <h1 class="section-title">
        {%- if current_tags -%}{{ blog.title }} · <em>{{ current_tags.first }}</em>{%- else -%}{{ blog.title }}{%- endif -%}
      </h1>
      {%- if ss.intro != blank -%}<div class="mn-content__lead rte">{{ ss.intro }}</div>{%- endif -%}
    </div>

    {%- if ss.show_tag_filter and blog.all_tags.size > 0 -%}
      <nav class="mn-blog__tags search__chips" aria-label="{{ 'mn.journal.topics' | t }}">
        <a href="{{ blog.url }}" class="chip"{% unless current_tags %} aria-current="page"{% endunless %}>{{ 'mn.journal.all' | t }}</a>
        {%- for tag in blog.all_tags -%}
          <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="chip"{% if current_tags contains tag %} aria-current="page"{% endif %}>{{ tag }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    <div class="mn-blog__layout{% if show_sidebar %} mn-blog__layout--sidebar{% endif %}">
      <div class="mn-blog__posts">
        {%- if blog.articles.size == 0 -%}
          <div class="mn-acct__empty"><p>{{ 'mn.journal.empty' | t }}</p></div>
        {%- endif -%}
        {%- for article in blog.articles -%}
          {%- liquid
            assign featured = false
            if ss.feature_first and forloop.first and paginate.current_page == 1 and layout != 'list'
              assign featured = true
            endif
          -%}
          {%- render 'mn-article-card', article: article, featured: featured, show_date: ss.show_date, show_author: ss.show_author, show_tags: ss.show_tags, show_excerpt: ss.show_excerpt, ratio: ss.image_ratio -%}
        {%- endfor -%}
      </div>

      {%- if show_sidebar -%}
        <aside class="mn-blog__aside">
          {%- if ss.show_search -%}
            <form action="{{ routes.search_url }}" method="get" role="search" class="mn-acct__card mn-blog__search">
              <span class="mn-acct__card-title">{{ 'blogs.sidebar.search' | t }}</span>
              <input type="hidden" name="type" value="article">
              <label class="mn-searchpage__field">
                <svg class="icon" aria-hidden="true"><use href="#i-search"></use></svg>
                <input type="search" name="q" placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ 'blogs.sidebar.search' | t }}">
              </label>
            </form>
          {%- endif -%}
          <div class="mn-acct__card">
            <span class="mn-acct__card-title">{{ 'blogs.sidebar.recent' | t }}</span>
            <ul class="mn-blog__recent">
              {%- for a in blog.articles limit: 4 -%}
                <li>
                  <a href="{{ a.url }}">
                    <span class="mn-blog__recent-img">{%- if a.image -%}{{ a.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', class: 'mn-fill', sizes: '64px' }}{%- endif -%}</span>
                    <span><span class="mn-blog__recent-title">{{ a.title }}</span><time datetime="{{ a.published_at | date: '%Y-%m-%d' }}">{{ a.published_at | date: '%b %-d, %Y' }}</time></span>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        </aside>
      {%- endif -%}
    </div>

    {%- if paginate.pages > 1 -%}{%- render 'mn-pagination', paginate: paginate -%}{%- endif -%}
  </div>
</div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog Posts",
  "tag": "section",
  "class": "section-main-blog",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The journal" },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    {
      "type": "select", "id": "layout", "label": "Layout",
      "options": [
        { "value": "grid",    "label": "Grid" },
        { "value": "list",    "label": "List" },
        { "value": "masonry", "label": "Masonry" }
      ],
      "default": "grid"
    },
    { "type": "checkbox", "id": "feature_first", "label": "Feature the newest post", "info": "Grid and masonry: the first post on page 1 spans two columns.", "default": true },
    {
      "type": "select", "id": "image_ratio", "label": "Image shape",
      "options": [
        { "value": "landscape", "label": "Landscape" },
        { "value": "portrait",  "label": "Portrait" },
        { "value": "square",    "label": "Square" },
        { "value": "natural",   "label": "As uploaded" }
      ],
      "default": "landscape"
    },
    { "type": "checkbox", "id": "show_tag_filter", "label": "Show topic filter", "info": "Uses the article tags.", "default": true },
    { "type": "checkbox", "id": "show_sidebar", "label": "Show Sidebar",       "default": false },
    { "type": "checkbox", "id": "show_date",    "label": "Show Publish Date",  "default": true },
    { "type": "checkbox", "id": "show_author",  "label": "Show Author",        "default": true },
    { "type": "checkbox", "id": "show_tags",    "label": "Show Tags",          "default": true },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show Excerpt",       "default": true },
    { "type": "checkbox", "id": "show_search",  "label": "Show Search (sidebar)", "default": true },
    { "type": "range",    "id": "posts_per_page","label": "Posts Per Page",    "min": 4, "max": 24, "step": 2, "default": 8 }
  ],
  "presets": [{ "name": "Blog Posts" }]
}
{% endschema %}
