{%- comment -%}
  One order, in the design's language: the cart page's lines (image, title,
  options, quantity, prices, discounts, tracking) and summary panel, with
  status badges and the billing / shipping addresses.
{%- endcomment -%}
{%- assign placed = order.created_at | date: '%B %-d, %Y' -%}
<div class="mn-acct mn-order" id="section-{{ section.id }}">
  <div class="mn-container">
    <a href="{{ routes.account_url }}" class="mn-acct__back"><svg class="icon icon--sm" aria-hidden="true"><use href="#i-chevron-left"></use></svg>{{ 'customer.account.return' | t }}</a>
    <div class="mn-acct__head">
      <div>
        <span class="mn-eyebrow">{{ 'customer.order.date' | t: date: placed }}</span>
        <h1 class="section-title">{{ 'customer.order.title' | t: name: order.name }}</h1>
      </div>
      <div class="mn-order__status">
        <span class="badge mn-status mn-status--{{ order.financial_status }}">{{ order.financial_status_label }}</span>
        <span class="badge mn-status mn-status--{{ order.fulfillment_status }}">{{ order.fulfillment_status_label }}</span>
      </div>
    </div>

    {%- if order.cancelled -%}
      {%- assign cancelled_on = order.cancelled_at | date: '%B %-d, %Y' -%}
      <p class="mn-alert mn-alert--error" role="status">{{ 'mn.acct.cancelled' | t: date: cancelled_on, reason: order.cancel_reason_label }}</p>
    {%- endif -%}

    <div class="mn-order__grid">
      <div class="mn-order__lines">
        {%- for item in order.line_items -%}
          <div class="mn-order__line">
            <a href="{{ item.url | default: item.product.url }}" class="mn-order__img" tabindex="-1" aria-hidden="true">
              {%- if item.image -%}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: '', class: 'mn-fill', sizes: '96px' }}{%- endif -%}
            </a>
            <div class="mn-order__text">
              {%- if item.vendor != blank -%}<span class="mn-order__meta">{{ item.vendor }}</span>{%- endif -%}
              <a href="{{ item.url | default: item.product.url }}" class="mn-order__title">{{ item.product.title | default: item.title }}</a>
              {%- if item.variant_title != blank and item.product.has_only_default_variant != true -%}<span class="mn-order__meta">{{ item.variant_title }}</span>{%- endif -%}
              {%- for p in item.properties -%}
                {%- assign first = p.first | slice: 0 -%}
                {%- if p.last != blank and first != '_' -%}<span class="mn-order__meta">{{ p.first }}: {{ p.last }}</span>{%- endif -%}
              {%- endfor -%}
              {%- if item.sku != blank -%}<span class="mn-order__meta">{{ 'customer.order.sku' | t }} {{ item.sku }}</span>{%- endif -%}
              {%- for d in item.line_level_discount_allocations -%}
                <span class="mn-order__meta mn-order__disc"><svg class="icon icon--sm" aria-hidden="true"><use href="#i-tag"></use></svg>{{ d.discount_application.title }} (&minus;{{ d.amount | money }})</span>
              {%- endfor -%}
              <span class="mn-order__meta">{{ item.final_price | money }} &times; {{ item.quantity }}</span>
              {%- if item.fulfillment -%}
                {%- assign shipped = item.fulfillment.created_at | date: '%b %-d, %Y' -%}
                <span class="mn-order__ship">
                  <svg class="icon icon--sm" aria-hidden="true"><use href="#i-truck"></use></svg>{{ 'mn.acct.shipped' | t: date: shipped }}
                  {% if item.fulfillment.tracking_url %}<span aria-hidden="true">·</span><a href="{{ item.fulfillment.tracking_url }}" target="_blank" rel="noopener" class="link-quiet">{{ 'customer.order.track' | t }}{% if item.fulfillment.tracking_number %} {{ item.fulfillment.tracking_number }}{% endif %}</a>{% endif %}
                </span>
              {%- endif -%}
            </div>
            <span class="mn-order__price">
              {%- if item.original_line_price > item.final_line_price -%}<s>{{ item.original_line_price | money }}</s>{%- endif -%}
              <span>{{ item.final_line_price | money }}</span>
            </span>
          </div>
        {%- endfor -%}
      </div>

      <aside class="mn-order__aside">
        <div class="mn-acct__card">
          <h2 class="mn-acct__card-title">{{ 'mn.cartpage.summary' | t }}</h2>
          <div class="mn-order__rows">
            <div><span>{{ 'customer.order.subtotal' | t }}</span><span>{{ order.line_items_subtotal_price | money }}</span></div>
            {%- for d in order.cart_level_discount_applications -%}
              <div class="mn-order__row-disc"><span><svg class="icon icon--sm" aria-hidden="true"><use href="#i-tag"></use></svg>{{ d.title }}</span><span>&minus;{{ d.total_allocated_amount | money }}</span></div>
            {%- endfor -%}
            {%- for m in order.shipping_methods -%}
              <div><span>{{ 'customer.order.shipping' | t }} · {{ m.title }}</span><span>{{ m.price | money }}</span></div>
            {%- endfor -%}
            {%- for tax in order.tax_lines -%}
              <div><span>{{ 'customer.order.tax' | t }} · {{ tax.title }} {{ tax.rate | times: 100 }}%</span><span>{{ tax.price | money }}</span></div>
            {%- endfor -%}
            <div class="mn-order__total"><span>{{ 'customer.order.total' | t }}</span><span>{{ order.total_price | money_with_currency }}</span></div>
            {%- if order.total_refunded_amount > 0 -%}
              <div class="mn-order__row-disc"><span>{{ 'mn.acct.refunded' | t }}</span><span>&minus;{{ order.total_refunded_amount | money }}</span></div>
            {%- endif -%}
          </div>
        </div>
        {%- if order.shipping_address -%}
          <div class="mn-acct__card">
            <h2 class="mn-acct__card-title">{{ 'customer.order.shipping_address' | t }}</h2>
            <address class="mn-acct__address">{{ order.shipping_address | format_address }}</address>
          </div>
        {%- endif -%}
        {%- if order.billing_address -%}
          <div class="mn-acct__card">
            <h2 class="mn-acct__card-title">{{ 'customer.order.billing_address' | t }}</h2>
            <address class="mn-acct__address">{{ order.billing_address | format_address }}</address>
          </div>
        {%- endif -%}
        {%- if order.note != blank -%}
          <div class="mn-acct__card mn-acct__card--soft">
            <h2 class="mn-acct__card-title">{{ 'cart.note' | t }}</h2>
            <p class="mn-acct__muted">{{ order.note }}</p>
          </div>
        {%- endif -%}
      </aside>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Order",
  "tag": "section",
  "class": "section-main-order",
  "settings": [],
  "presets": [{ "name": "Order" }]
}
{% endschema %}
