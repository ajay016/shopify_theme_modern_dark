{%- comment -%}
  Store pickup for one variant, fetched by assets/mn-product.js as
  /variants/{id}/?section_id=mn-pickup. The summary fills the Pickup block;
  the list fills the "Pickup in store" drawer. Nothing renders when no
  pickup location stocks the variant.
{%- endcomment -%}
{%- assign v = product.selected_or_first_available_variant -%}
{%- assign stores = v.store_availabilities -%}
{%- assign pickable = stores | where: 'pick_up_enabled', true -%}
{%- if pickable.size > 0 -%}
  {%- assign first = pickable.first -%}
  <div data-pickup-summary>
    <span class="pickup__status{% unless first.available %} is-off{% endunless %}"></span>
    <div class="pickup__text">
      {%- if first.available -%}
        <b>{{ 'mn.pdp.pickup_at' | t: store: first.location.name }}</b><span>{{ first.pick_up_time }}</span>
      {%- else -%}
        <b>{{ 'mn.pdp.pickup_off_at' | t: store: first.location.name }}</b><span>{{ 'mn.pdp.pickup_off' | t }}</span>
      {%- endif -%}
      <button type="button" class="link-quiet" data-open="ov-pickup">{%- if pickable.size > 1 -%}{{ 'mn.pdp.pickup_other' | t }}{%- else -%}{{ 'mn.pdp.pickup_details' | t }}{%- endif -%}</button>
    </div>
  </div>
  <div data-pickup-list>
    <div class="store__variant">
      <span>{%- if v.featured_image or product.featured_image -%}{{ v.featured_image | default: product.featured_image | image_url: width: 120 | image_tag: alt: '', class: 'mn-fill' }}{%- endif -%}</span>
      <div><b>{{ product.title }}</b>{%- unless product.has_only_default_variant -%}<br><span class="muted-note">{{ v.title | replace: ' / ', ' · ' }}</span>{%- endunless -%}</div>
    </div>
    <div class="stores">
      {%- for s in pickable -%}
        <div class="store">
          <span class="pickup__status{% unless s.available %} is-off{% endunless %}"></span>
          <b>{{ s.location.name }}</b>
          <span>{{ s.location.address | format_address | strip_html | strip }}</span>
          <span>{%- if s.available -%}{{ 'mn.pdp.pickup_ready' | t: time: s.pick_up_time }}{%- else -%}{{ 'mn.pdp.pickup_off' | t }}{%- endif -%}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}
{% schema %}
{ "name": "Pickup availability", "class": "mn-pickup-section" }
{% endschema %}
