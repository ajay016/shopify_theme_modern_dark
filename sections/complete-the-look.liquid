{%- liquid
  assign s = section.settings
  assign col = collections[s.collection]
  assign fallback = 'https://images.unsplash.com/photo-1469334031218-e382a71b716b?auto=format&fit=crop&w=1400&q=85'

  assign demo_names = 'Alba Draped Coat,Sera Silk Dress,Linea Leather Mule' | split: ','
  assign demo_prices = '$890|$540|$390' | split: '|'
  assign demo_cats = 'Outerwear,Dresses,Shoes' | split: ','
  assign c1 = 'https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=700&q=80'
  assign c2 = 'https://images.unsplash.com/photo-1525507119028-ed4c629a60a3?auto=format&fit=crop&w=700&q=80'
  assign c3 = 'https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=700&q=80'
  assign demo_imgs_str = c1 | append: '||' | append: c2 | append: '||' | append: c3
  assign demo_imgs = demo_imgs_str | split: '||'
-%}

<section
  id="section-{{ section.id }}"
  class="ctl ctl--{{ s.scheme }}"
  data-section-id="{{ section.id }}"
  data-qv-scheme="{{ s.scheme }}"
>
  <div class="ctl-inner">
    <div class="ctl-grid">
      <div class="ctl-media reveal">
        {%- if s.image != blank -%}
          {{ s.image | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'ctl-img', sizes: '(max-width: 900px) 100vw, 42vw', widths: '700,1000,1400', alt: s.heading }}
        {%- else -%}
          <img class="ctl-img" src="{{ fallback }}" alt="{{ s.heading }}" loading="lazy" />
        {%- endif -%}
        {%- if s.look_label != blank -%}<span class="ctl-tag">{{ s.look_label }}</span>{%- endif -%}
      </div>

      <div class="ctl-side">
        <div class="ctl-head reveal">
          {%- if s.eyebrow != blank -%}<p class="ctl-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
          {%- if s.heading != blank -%}<h2 class="ctl-heading">{{ s.heading }}</h2>{%- endif -%}
          {%- if s.description != blank -%}<p class="ctl-desc">{{ s.description }}</p>{%- endif -%}
        </div>

        <div class="ctl-products">
          {%- if col != blank and col.products.size > 0 -%}
            {%- for product in col.products limit: 3 -%}
              <div class="ctl-item reveal">{%- render 'product-card', product: product, scheme: s.scheme, show_quickview: true -%}</div>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..3) -%}
              {%- assign idx = forloop.index0 -%}
              <div class="ctl-item reveal">{%- render 'product-card',
                scheme: s.scheme,
                demo_index: idx,
                demo_title: demo_names[idx],
                demo_price: demo_prices[idx],
                demo_category: demo_cats[idx],
                demo_image: demo_imgs[idx],
                demo_url: '/collections/all' -%}</div>
            {%- endfor -%}
          {%- endif -%}
        </div>

        {%- if s.cta_label != blank -%}
          <div class="ctl-foot reveal">
            <a class="ctl-cta" href="{{ col.url | default: s.cta_url | default: '/collections/all' }}">
              {{ s.cta_label }}<span aria-hidden="true">&#8594;</span>
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  #section-{{ section.id }}.ctl--light { --bg:var(--s2-bg,#131313); --fg:var(--s2-fg,#F5F0E8); --acc:var(--gold,#C8A96E); --mut:var(--s2-mut,rgba(245,240,232,.62)); }
  #section-{{ section.id }}.ctl--dark  { --bg:var(--s1-bg,#0A0A0A); --fg:var(--s1-fg,#F5F0E8); --acc:var(--gold,#C8A96E); --mut:var(--s1-mut,rgba(245,240,232,.62)); }
  #section-{{ section.id }}.ctl--warm  { --bg:var(--s3-bg,#1A1714); --fg:var(--s3-fg,#F5F0E8); --acc:var(--gold,#C8A96E); --mut:var(--s3-mut,rgba(245,240,232,.62)); }
  #section-{{ section.id }}.ctl--theme { --bg:var(--s1-bg,#0A0A0A); --fg:var(--s1-fg,#F5F0E8); --acc:var(--gold,#C8A96E); --mut:var(--s1-mut,rgba(245,240,232,.62)); }

  #section-{{ section.id }} { background: var(--bg); color: var(--fg); padding: clamp(72px,9vh,112px) 0; }
  #section-{{ section.id }} .ctl-inner { padding: 0 var(--side-padding,5vw); }
  #section-{{ section.id }} .ctl-grid { display: grid; grid-template-columns: .82fr 1.18fr; gap: clamp(24px,3vw,40px); }

  #section-{{ section.id }} .ctl-media {
    position: relative; min-height: clamp(520px,72vh,760px);
    overflow: hidden; background: var(--img-placeholder, #1A1714);
  }
  #section-{{ section.id }} .ctl-img {
    display: block; width: 100%; height: 100%;
    object-fit: cover; object-position: center 24%; filter: saturate(.66);
  }
  /* Sits on the photograph, so it uses the on-photo pair, not a surface token. */
  #section-{{ section.id }} .ctl-tag {
    position: absolute; top: 18px; left: 18px;
    padding: 8px 14px;
    background: var(--onphoto-light, rgba(252,251,249,.96));
    color: var(--onphoto-light-fg, #16130F);
    font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: calc(11px * var(--fs-scale, 1));
    font-weight: 600; letter-spacing: .18em; text-transform: uppercase;
  }

  #section-{{ section.id }} .ctl-side { display: flex; flex-direction: column; }
  #section-{{ section.id }} .ctl-eyebrow {
    margin: 0 0 12px;
    font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: calc(12px * var(--fs-scale, 1));
    font-weight: 600; letter-spacing: .22em; text-transform: uppercase;
    color: var(--acc);
  }
  #section-{{ section.id }} .ctl-heading {
    margin: 0 0 14px;
    font-family: var(--ff-display,'Cormorant Garamond',serif);
    font-weight: 300;
    font-size: calc(clamp(32px,4vw,52px) * var(--heading-scale,1));
    line-height: 1.02;
  }
  #section-{{ section.id }} .ctl-desc {
    max-width: 460px; margin: 0 0 clamp(24px,3vh,34px);
    font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: calc(15px * var(--fs-scale, 1));
    line-height: 1.66; color: var(--mut);
  }

  #section-{{ section.id }} .ctl-products {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px;
  }
  #section-{{ section.id }} .ctl-item { min-width: 0; }

  #section-{{ section.id }} .ctl-foot { margin-top: clamp(24px,3vh,34px); }
  #section-{{ section.id }} .ctl-cta {
    display: inline-flex; align-items: center; gap: 10px;
    padding-bottom: 4px; border-bottom: 1px solid currentColor;
    font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: calc(12px * var(--fs-scale, 1));
    font-weight: 600; letter-spacing: .16em; text-transform: uppercase;
    text-decoration: none; color: var(--fg);
  }
  #section-{{ section.id }} .ctl-cta:hover { color: var(--acc); }

  #section-{{ section.id }} .reveal.reveal-armed { opacity: 0; transform: translateY(22px); transition: opacity .75s ease, transform .75s ease; }
  #section-{{ section.id }} .reveal.is-visible { opacity: 1; transform: none; }

  @media (max-width: 1000px) {
    #section-{{ section.id }} .ctl-grid { grid-template-columns: 1fr; }
    #section-{{ section.id }} .ctl-media { min-height: 460px; }
  }
  @media (max-width: 600px) {
    #section-{{ section.id }} .ctl-products { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 8px; }
    #section-{{ section.id }} .ctl-item:last-child { grid-column: span 2; max-width: calc(50% - 4px); }
  }
</style>

<script>
(function(){
  var SEC='{{ section.id }}';
  function arm(root){
    var els=root.querySelectorAll('.reveal');
    els.forEach(function(el){el.classList.add('reveal-armed');});
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('is-visible');io.unobserve(e.target);}});},{threshold:.12});
    els.forEach(function(el){io.observe(el);});
    setTimeout(function(){els.forEach(function(el){el.classList.add('is-visible');});},800);
  }
  function root(){return document.getElementById('section-'+SEC);}
  document.addEventListener('DOMContentLoaded',function(){var r=root();if(r)arm(r);});
  document.addEventListener('shopify:section:load',function(e){if(e.detail.sectionId!==SEC)return;var r=root();if(r){arm(r);r.querySelectorAll('.reveal').forEach(function(el){el.classList.add('is-visible');});}});
})();
</script>

{% schema %}
{
  "name": "Complete the Look",
  "tag": "section",
  "class": "section-complete-the-look",
  "settings": [
    {
      "type": "select", "id": "scheme", "label": "Surface tone",
      "options": [
        { "value": "light", "label": "Alternate surface (soft)" },
        { "value": "dark",  "label": "Primary surface" },
        { "value": "warm",  "label": "Deep surface" },
        { "value": "theme", "label": "Primary surface (follow theme)" }
      ],
      "default": "dark"
    },
    { "type": "image_picker", "id": "image", "label": "Look image" },
    { "type": "text", "id": "look_label", "label": "Image tag", "default": "Look 04" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "The first three products are shown. Leave empty for demo products." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Styled together" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete the look" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Three pieces cut to be worn together — layered through the season, and just as easily apart." },
    { "type": "text", "id": "cta_label", "label": "Link label", "default": "Shop the full look" },
    { "type": "url",  "id": "cta_url",   "label": "Link" }
  ],
  "presets": [{ "name": "Complete the Look" }]
}
{% endschema %}
