{%- liquid
  assign s = section.settings
  assign f1 = 'https://images.unsplash.com/photo-1487412720507-e7ab37603c6f?auto=format&fit=crop&w=800&q=85'
  assign f2 = 'https://images.unsplash.com/photo-1469334031218-e382a71b716b?auto=format&fit=crop&w=900&q=85'
  assign f3 = 'https://images.unsplash.com/photo-1496217590455-aa63a8350eea?auto=format&fit=crop&w=800&q=85'
-%}

<section
  id="section-{{ section.id }}"
  class="hlm-section hlm--{{ s.scheme }}"
  data-section-id="{{ section.id }}"
>
  <div class="hlm-inner">

    {%- comment -%}Masthead row — like the top of a magazine issue{%- endcomment -%}
    <div class="hlm-masthead">
      {%- if s.mast_left != blank -%}<span>{{ s.mast_left }}</span>{%- endif -%}
      <span class="hlm-masthead__dia" aria-hidden="true">&#10022;</span>
      {%- if s.mast_center != blank -%}<span class="hlm-masthead__c">{{ s.mast_center }}</span>{%- endif -%}
      <span class="hlm-masthead__dia" aria-hidden="true">&#10022;</span>
      {%- if s.mast_right != blank -%}<span>{{ s.mast_right }}</span>{%- endif -%}
    </div>

    {%- comment -%}Giant issue title with an italic gold word{%- endcomment -%}
    <h1 class="hlm-title">
      {%- if s.heading_a != blank -%}<span class="hlm-title__w">{{ s.heading_a }}</span>{%- endif -%}
      {%- if s.heading_em != blank -%}<span class="hlm-title__em"><em>{{ s.heading_em }}</em></span>{%- endif -%}
      {%- if s.heading_b != blank -%}<span class="hlm-title__w">{{ s.heading_b }}</span>{%- endif -%}
    </h1>

    {%- if s.description != blank -%}<p class="hlm-desc">{{ s.description }}</p>{%- endif -%}

    <div class="hlm-ctas">
      {%- if s.btn1_label != blank -%}<a href="{{ s.btn1_link | default: '#' }}" class="hlm-btn hlm-btn--gold">{{ s.btn1_label }}</a>{%- endif -%}
      {%- if s.btn2_label != blank -%}<a href="{{ s.btn2_link | default: '#' }}" class="hlm-btn hlm-btn--under">{{ s.btn2_label }} <span aria-hidden="true">&#8599;</span></a>{%- endif -%}
    </div>

    {%- comment -%}Campaign triptych — three frames, center raised{%- endcomment -%}
    <div class="hlm-trip">
      <figure class="hlm-frame hlm-frame--a">
        <span class="hlm-frame__media">
          {%- if s.image_1 != blank -%}
            {{ s.image_1 | image_url: width: 800 | image_tag: loading: 'eager', class: 'hlm-frame__img', sizes: '(max-width:900px) 72vw, 30vw', widths: '400,600,800', alt: s.caption_1 | default: 'Editorial' }}
          {%- else -%}
            <img class="hlm-frame__img" src="{{ f1 }}" alt="{{ s.caption_1 | escape }}" loading="eager" />
          {%- endif -%}
        </span>
        {%- if s.caption_1 != blank -%}<figcaption class="hlm-frame__cap"><span class="hlm-frame__num">I.</span>{{ s.caption_1 }}</figcaption>{%- endif -%}
      </figure>

      <figure class="hlm-frame hlm-frame--b">
        <span class="hlm-frame__media">
          {%- if s.image_2 != blank -%}
            {{ s.image_2 | image_url: width: 900 | image_tag: loading: 'eager', fetchpriority: 'high', class: 'hlm-frame__img', sizes: '(max-width:900px) 72vw, 34vw', widths: '450,700,900', alt: s.caption_2 | default: 'Editorial' }}
          {%- else -%}
            <img class="hlm-frame__img" src="{{ f2 }}" alt="{{ s.caption_2 | escape }}" loading="eager" fetchpriority="high" />
          {%- endif -%}
          {%- if s.tag_label != blank -%}
            <span class="hlm-tag"><span class="hlm-tag__dot"></span>{{ s.tag_label }}</span>
          {%- endif -%}
        </span>
        {%- if s.caption_2 != blank -%}<figcaption class="hlm-frame__cap"><span class="hlm-frame__num">II.</span>{{ s.caption_2 }}</figcaption>{%- endif -%}
      </figure>

      <figure class="hlm-frame hlm-frame--c">
        <span class="hlm-frame__media">
          {%- if s.image_3 != blank -%}
            {{ s.image_3 | image_url: width: 800 | image_tag: loading: 'eager', class: 'hlm-frame__img', sizes: '(max-width:900px) 72vw, 30vw', widths: '400,600,800', alt: s.caption_3 | default: 'Editorial' }}
          {%- else -%}
            <img class="hlm-frame__img" src="{{ f3 }}" alt="{{ s.caption_3 | escape }}" loading="eager" />
          {%- endif -%}
        </span>
        {%- if s.caption_3 != blank -%}<figcaption class="hlm-frame__cap"><span class="hlm-frame__num">III.</span>{{ s.caption_3 }}</figcaption>{%- endif -%}
      </figure>
    </div>

  </div>
</section>

<style>
  #section-{{ section.id }}.hlm--light { --bg:#F4F1EA; --fg:#17141B; --acc:var(--gold,#A8874C); --mut:rgba(23,20,27,.55); --bdr:rgba(23,20,27,.15); }
  #section-{{ section.id }}.hlm--dark  { --bg:#131118; --fg:#EFEBE2; --acc:var(--gold,#C6A15B); --mut:rgba(239,235,226,.52); --bdr:rgba(239,235,226,.16); }
  #section-{{ section.id }}.hlm--warm  { --bg:#EBE2D2; --fg:#241D15; --acc:var(--gold,#8E5A2A); --mut:rgba(36,29,21,.55); --bdr:rgba(36,29,21,.18); }
  #section-{{ section.id }}.hlm--theme { --bg:var(--background,#F4F1EA); --fg:var(--foreground,#17141B); --acc:var(--gold,#A8874C); --mut:var(--muted,rgba(23,20,27,.55)); --bdr:var(--border,rgba(23,20,27,.15)); }

  #section-{{ section.id }} {
    background: var(--bg); color: var(--fg);
    padding: clamp(108px, 14svh, 156px) var(--side-padding,5vw) clamp(40px, 6svh, 72px);
  }
  #section-{{ section.id }} .hlm-inner { max-width: var(--container-width,1440px); margin: 0 auto; }

  /* — Masthead — */
  #section-{{ section.id }} .hlm-masthead {
    display: flex; align-items: center; justify-content: space-between; gap: 14px;
    padding-bottom: 16px; margin-bottom: clamp(28px, 4.4svh, 48px);
    border-bottom: 1px solid var(--bdr);
    font-family: var(--ff-body,'Outfit',sans-serif); font-size: 10px; font-weight: 500;
    letter-spacing: .3em; text-transform: uppercase; color: var(--mut);
    animation: hlmUp{{ section.id }} .7s both;
  }
  #section-{{ section.id }} .hlm-masthead__c { color: var(--fg); }
  #section-{{ section.id }} .hlm-masthead__dia { color: var(--acc); font-size: 9px; letter-spacing: 0; }

  /* — Issue title — */
  #section-{{ section.id }} .hlm-title {
    display: flex; flex-wrap: wrap; justify-content: center; align-items: baseline;
    column-gap: clamp(14px, 2vw, 34px);
    text-align: center; margin: 0;
    font-family: var(--ff-display,'Cormorant Garamond',serif); font-weight: 300;
    font-size: calc(clamp(52px, 9.4vw, 148px) * var(--heading-scale,1));
    line-height: .96; letter-spacing: .01em; text-transform: uppercase;
  }
  #section-{{ section.id }} .hlm-title__w  { animation: hlmUp{{ section.id }} .9s .1s both; }
  #section-{{ section.id }} .hlm-title__w:last-child { animation-delay: .3s; }
  #section-{{ section.id }} .hlm-title__em { color: var(--acc); text-transform: none; animation: hlmUp{{ section.id }} .9s .2s both; }
  #section-{{ section.id }} .hlm-title__em em { font-style: italic; }

  #section-{{ section.id }} .hlm-desc {
    font-family: var(--ff-body,'Outfit',sans-serif);
    font-size: clamp(14px, 1.05vw, 16px); line-height: 1.75;
    color: var(--mut); max-width: 540px; text-align: center;
    margin: clamp(18px, 2.8svh, 28px) auto 0;
    animation: hlmUp{{ section.id }} .9s .42s both;
  }
  #section-{{ section.id }} .hlm-ctas {
    display: flex; gap: 22px; flex-wrap: wrap; justify-content: center; align-items: center;
    margin: clamp(20px, 3svh, 30px) 0 clamp(34px, 5.4svh, 60px);
    animation: hlmUp{{ section.id }} .9s .52s both;
  }
  #section-{{ section.id }} .hlm-btn {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--ff-body,'Outfit',sans-serif); font-size: 11px; font-weight: 500;
    letter-spacing: .18em; text-transform: uppercase; text-decoration: none;
    transition: transform .22s, box-shadow .22s, color .22s;
  }
  #section-{{ section.id }} .hlm-btn--gold { background: var(--acc); color: #14110a; padding: 16px 36px; border-radius: 999px; }
  #section-{{ section.id }} .hlm-btn--gold:hover { transform: translateY(-2px); box-shadow: 0 16px 38px -16px color-mix(in srgb, var(--acc) 70%, transparent); }
  #section-{{ section.id }} .hlm-btn--under { color: var(--fg); border-bottom: 1px solid var(--acc); padding-bottom: 6px; }
  #section-{{ section.id }} .hlm-btn--under:hover { color: var(--acc); }

  /* — Triptych — */
  #section-{{ section.id }} .hlm-trip {
    display: grid; grid-template-columns: 1fr 1.18fr 1fr;
    gap: clamp(14px, 2vw, 30px); align-items: end;
  }
  #section-{{ section.id }} .hlm-frame { margin: 0; }
  #section-{{ section.id }} .hlm-frame__media {
    position: relative; display: block; overflow: hidden; background: var(--bdr); border-radius: 3px;
  }
  #section-{{ section.id }} .hlm-frame--a .hlm-frame__media,
  #section-{{ section.id }} .hlm-frame--c .hlm-frame__media { aspect-ratio: 4/5; }
  #section-{{ section.id }} .hlm-frame--b .hlm-frame__media { aspect-ratio: 3/4.35; }
  #section-{{ section.id }} .hlm-frame--a { animation: hlmUp{{ section.id }} 1s .55s both; }
  #section-{{ section.id }} .hlm-frame--b { animation: hlmUp{{ section.id }} 1s .65s both; }
  #section-{{ section.id }} .hlm-frame--c { animation: hlmUp{{ section.id }} 1s .75s both; }
  #section-{{ section.id }} .hlm-frame__img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform .8s cubic-bezier(.2,0,.2,1);
  }
  #section-{{ section.id }} .hlm-frame:hover .hlm-frame__img { transform: scale(1.04); }
  #section-{{ section.id }} .hlm-frame--b .hlm-frame__img { animation: hlmKen{{ section.id }} 16s ease-out forwards; }
  #section-{{ section.id }} .hlm-frame__cap {
    display: flex; align-items: center; gap: 10px;
    margin-top: 12px;
    font-family: var(--ff-body,'Outfit',sans-serif); font-size: 10px; font-weight: 500;
    letter-spacing: .22em; text-transform: uppercase; color: var(--mut);
  }
  #section-{{ section.id }} .hlm-frame__num { font-family: var(--ff-display,'Cormorant Garamond',serif); font-size: 14px; letter-spacing: 0; color: var(--acc); }
  #section-{{ section.id }} .hlm-tag {
    position: absolute; z-index: 2; left: 14px; bottom: 14px;
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(244,241,234,.82);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    color: #17141B; padding: 9px 15px; border-radius: 999px;
    font-family: var(--ff-body,'Outfit',sans-serif); font-size: 10px; font-weight: 500;
    letter-spacing: .18em; text-transform: uppercase;
  }
  #section-{{ section.id }} .hlm-tag__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--acc); }

  @keyframes hlmUp{{ section.id }}  { from { opacity:0; transform: translateY(26px);} to { opacity:1; transform:none; } }
  @keyframes hlmKen{{ section.id }} { from { transform: scale(1.07);} to { transform: scale(1);} }

  @media (max-width: 900px) {
    #section-{{ section.id }} { padding-top: clamp(100px, 13svh, 128px); }
    #section-{{ section.id }} .hlm-masthead span:first-child,
    #section-{{ section.id }} .hlm-masthead span:last-child { display: none; }
    #section-{{ section.id }} .hlm-masthead { justify-content: center; gap: 12px; }
    /* triptych becomes a swipeable strip — nothing hidden, nothing empty */
    #section-{{ section.id }} .hlm-trip {
      display: flex; overflow-x: auto; scroll-snap-type: x mandatory;
      margin: 0 calc(-1 * var(--side-padding,5vw));
      padding: 0 var(--side-padding,5vw) 6px;
      scrollbar-width: none;
    }
    #section-{{ section.id }} .hlm-trip::-webkit-scrollbar { display: none; }
    #section-{{ section.id }} .hlm-frame { flex: 0 0 72vw; scroll-snap-align: center; }
    #section-{{ section.id }} .hlm-frame--a .hlm-frame__media,
    #section-{{ section.id }} .hlm-frame--b .hlm-frame__media,
    #section-{{ section.id }} .hlm-frame--c .hlm-frame__media { aspect-ratio: 3/4; }
  }
</style>

{% schema %}
{
  "name": "Hero Lumière",
  "tag": "section",
  "class": "section-hero-lumiere",
  "settings": [
    {
      "type": "select", "id": "scheme", "label": "Color scheme",
      "options": [
        { "value": "light", "label": "Light (pearl)" },
        { "value": "dark",  "label": "Dark (velvet)" },
        { "value": "warm",  "label": "Warm (champagne)" },
        { "value": "theme", "label": "Follow theme" }
      ],
      "default": "light"
    },
    { "type": "header", "content": "Masthead row" },
    { "type": "text", "id": "mast_left",   "label": "Left",   "default": "Issue Nº 05" },
    { "type": "text", "id": "mast_center", "label": "Center", "default": "Maison Noir" },
    { "type": "text", "id": "mast_right",  "label": "Right",  "default": "Autumn / Winter 2025" },
    { "type": "header", "content": "Issue title" },
    { "type": "text", "id": "heading_a",  "label": "Word 1", "default": "The" },
    { "type": "text", "id": "heading_em", "label": "Word 2 (italic, accent)", "default": "Light" },
    { "type": "text", "id": "heading_b",  "label": "Word 3", "default": "Issue" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Champagne silks, pearl tailoring and jewellery that catches the afternoon — the season, photographed like a magazine and shoppable like a boutique." },
    { "type": "text", "id": "btn1_label", "label": "Primary button", "default": "Shop the Issue" },
    { "type": "url",  "id": "btn1_link",  "label": "Primary button link" },
    { "type": "text", "id": "btn2_label", "label": "Secondary link", "default": "Read the Editor's Note" },
    { "type": "url",  "id": "btn2_link",  "label": "Secondary link URL" },
    { "type": "header", "content": "Campaign triptych" },
    { "type": "image_picker", "id": "image_1", "label": "Left image" },
    { "type": "text", "id": "caption_1", "label": "Left caption", "default": "The Morning Silk" },
    { "type": "image_picker", "id": "image_2", "label": "Center image (tallest)" },
    { "type": "text", "id": "caption_2", "label": "Center caption", "default": "The Champagne Gown" },
    { "type": "text", "id": "tag_label", "label": "Center image tag", "default": "New Season" },
    { "type": "image_picker", "id": "image_3", "label": "Right image" },
    { "type": "text", "id": "caption_3", "label": "Right caption", "default": "The Pearl Tailoring" }
  ],
  "presets": [ { "name": "Hero Lumière" } ]
}
{% endschema %}
